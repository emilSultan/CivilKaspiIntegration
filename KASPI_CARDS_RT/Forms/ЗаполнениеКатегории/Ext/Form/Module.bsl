&НаКлиенте
Процедура КатегорияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
		
	ТекущиеДанные = Элементы.Категория.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь; Сообщение = "";
	ЗагрузитьРеквизитыКатегории(ТекущиеДанные.code, Отказ, Сообщение);

КонецПроцедуры






&НаКлиенте
Процедура ДобавитьВСправочник(Команда)
	
	ТекущиеДанные = Элементы.Категория.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДобавитьВСправочникНаСервере(ТекущиеДанные.code, ТекущиеДанные.title);
КонецПроцедуры


&НаКлиенте
Процедура РеквизитыТовараВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанныеКатегории = Элементы.Категория.ТекущиеДанные;
	ТекущиеДанныеРеквизиты = Элементы.РеквизитыТовара.ТекущиеДанные;
	
	Если ТекущиеДанныеКатегории = Неопределено ИЛИ ТекущиеДанныеРеквизиты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанныеРеквизиты.type = "enum" Тогда
		ЗаполнитьДанныеВыбораРеквизитаТовара(ТекущиеДанныеКатегории.code, ТекущиеДанныеРеквизиты.code);
	Иначе 
		ВозможныеЗначения.Очистить();
	КонецЕсли;
	
КонецПроцедуры


#Region Контекст


&НаСервере
Процедура ЗагрузитьКатегорииИзСервиса(Отказ, Сообщение)
	
	Перем Результат;
	
	//Контекст = Обработки.ПроксиКаспи.Создать();
	Контекст = ПолучитьКонтекст();
	Контекст.MerchantUID = Объект.MerchantUID;
	
	Отказ = Не Контекст.Товары_СписокКатегорий(Результат, Сообщение);
	Если Не Отказ Тогда
		ЗначениеВРеквизитФормы(Результат, "Категория");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРеквизитыКатегории(Код, Отказ, Сообщение)
	
	Перем Результат;
	
	//Контекст = Обработки.ПроксиКаспи.Создать();
	Контекст = ПолучитьКонтекст();
	Контекст.MerchantUID = Объект.MerchantUID;
	
	Отказ = Не Контекст.Товары_РеквизитыКатегории(Код, Результат, Сообщение);
	Если Не Отказ Тогда
		ЗначениеВРеквизитФормы(Результат, "РеквизитыТовара");
		Объект.АдресВременноеХранилище = ПоместитьВоВременноеХранилище(Результат, Объект.УникальныйИдентификатор);
	КонецЕсли;
	
	Попытка
		КатегорияСсылка = Справочники.КатегорияТоваровКаспи.НайтиПоНаименованию(Код);
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ДобавитьВСправочникНаСервере(Code, Title)
	
		
	//Контекст = Обработки.ПроксиКаспи.Создать();
	Контекст = ПолучитьКонтекст();
	Контекст.MerchantUID = Объект.MerchantUID;
	
	Отказ = Ложь; Сообщение = "";

	КатегорияСсылка = Справочники.КатегорияТоваровКаспи.НайтиПоНаименованию(Code);
		
	
	Если ЗначениеЗаполнено(КатегорияСсылка) Тогда
		КатегорияО = КатегорияСсылка.ПолучитьОбъект();
		КатегорияО.attributes.Очистить();
	Иначе
		КатегорияО = Справочники.КатегорияТоваровКаспи.СоздатьЭлемент();
		КатегорияО.Наименование = code;
		КатегорияО.title = title;
	КонецЕсли;
	
	Для Каждого Ъ Из РеквизитыТовара Цикл
		
		attr = КатегорияО.attributes.Добавить();
		ЗаполнитьЗначенияСвойств(attr, Ъ);
		Сегмент = СтрРазделить(attr.code, "*");
		attr.title = Сегмент.Получить(Сегмент.ВГраница());
		
		Если attr.type = "enum" Тогда
		
			ВозможныеЗначения = Неопределено;
			Если Контекст.Товары_ВозможныеЗначенияРеквизита(Code, attr.code, ВозможныеЗначения, Сообщение) Тогда
				attr.values = Новый ХранилищеЗначения(ВозможныеЗначения);
			КонецЕсли;
			
		КонецЕсли;

		
	КонецЦикла;
	
	КатегорияО.Записать();
	КатегорияСсылка = КатегорияО.Ссылка;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеВыбораРеквизитаТовара(category, attrcode)

	//Контекст = Обработки.ПроксиКаспи.Создать();
	Контекст = ПолучитьКонтекст();
	Контекст.MerchantUID = Объект.MerchantUID;

	Отклик = Контекст.Товары_ВозможныеЗначенияРеквизита(category, attrcode,); 
   	ВозможныеЗначения.Очистить();
	Если  Отклик <> Неопределено Тогда	
		
		Для Каждого Ъ Из Отклик Цикл
			Нов = ВозможныеЗначения.Добавить();
			Нов.code = Ъ.Get("code");
			Нов.name = Ъ.Get("name");
		КонецЦикла; 
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция ПолучитьКонтекст()
	Возврат РеквизитФормыВЗначение("Объект");
КонецФункции

&НаСервере
Функция ОбновитьКонтекст(Контекст)
	Возврат ЗначениеВРеквизитФормы(Контекст, "Объект");
КонецФункции

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()
	
	Перем Результат;
	

	Контекст = ПолучитьКонтекст();
	Отказ = Не Контекст.Товары_СписокКатегорий(Результат, "");
	Если Не Отказ Тогда
		ЗначениеВРеквизитФормы(Результат, "Категория");
	КонецЕсли;

КонецПроцедуры

