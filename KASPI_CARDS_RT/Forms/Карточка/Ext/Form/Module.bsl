&НаСервере
Процедура РасставитьРеквизитыПоКатегории(Результат, НазваниеТаблицы, ГруппаФормы)
	
	СформироватьРеквизитыИзТаблицы(Результат, НазваниеТаблицы);
	РазместитьРеквизитыВФорме(Результат, НазваниеТаблицы, ГруппаФормы);
	
КонецПроцедуры 

&НаСервере
Процедура СформироватьРеквизитыИзТаблицы(Результат, НазваниеТаблицы)

	Попытка
		УдаляемыеПоляТаблицы = ПолучитьРеквизиты(НазваниеТаблицы);
		
		Если УдаляемыеПоляТаблицы.Количество() > 0 Тогда
			
			УдаляемыеРеквизиты = Новый Массив;
			УдаляемыеРеквизиты.Добавить(НазваниеТаблицы);
			ИзменитьРеквизиты(, УдаляемыеРеквизиты);

		КонецЕсли;
	Исключение	
	КонецПопытки;

	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы(НазваниеТаблицы, Новый ОписаниеТипов("ТаблицаЗначений")));
	
	Для Каждого Ъ Из Результат.Колонки Цикл
		Если Ъ.Имя = "values" Тогда
			Продолжить;
		КонецЕсли;
		
		ТипЗначения = ОбщегоНазначения.ОписаниеТипаСтрока(999);
		Реквизиты.Добавить(Новый РеквизитФормы(Ъ.Имя, Ъ.ТипЗначения, НазваниеТаблицы, Ъ.Заголовок));
		
	КонецЦикла;
	
	ИзменитьРеквизиты(Реквизиты);

	ЗначениеВРеквизитФормы(Результат, НазваниеТаблицы);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьЭлементыФормыРеквизитовТовара()
	
	КУдалению = Новый Массив();
	Для Каждого ПЭ ИЗ Элементы.ГруппаРеквизитыТовара.ПодчиненныеЭлементы Цикл
		КУдалению.Добавить(ПЭ);
	КонецЦикла;
	
	Для Каждого ПЭ Из КУдалению Цикл
		Элементы.Удалить(ПЭ);
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура РазместитьРеквизитыВФорме(Результат, НазваниеТаблицы, ГруппаФормы)
	
	УдалитьЭлементыФормыРеквизитовТовара();
	
	Для Каждого ПолеТаблицы Из Результат Цикл
				
		ИмяРеквизита = НазваниеТаблицы + ПолеТаблицы.ИмяРеквизита;
		ИмяРеквизита = СтрЗаменить(ИмяРеквизита , " ", "");
		ИмяРеквизита = СтрЗаменить(ИмяРеквизита , "-", "");
		ИмяРеквизита = СтрЗаменить(ИмяРеквизита , "*", "");

		Рек = Элементы.Найти(ИмяРеквизита);
		Если Рек <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПутьКДанным = НазваниеТаблицы + "[" + Результат.Индекс(ПолеТаблицы) + "].ЗначениеРеквизита";

		Попытка
			
			Рек = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), ГруппаФормы);
			Рек.Вид = ВидПоляФормы.ПолеВвода;
			Рек.ПутьКДанным = ПутьКДанным;
			Рек.Заголовок = ПолеТаблицы.Заголовок;
			Рек.Подсказка = ПолеТаблицы.ИмяРеквизита;
			
			Если ПолеТаблицы.type = "enum" Тогда
				
				Для Каждого Зн Из ПолеТаблицы.values.Get() Цикл
					Рек.СписокВыбора.Добавить(Зн.Значение, Зн.Представление);
				КонецЦикла;
				
				Рек.КнопкаВыбора = Истина;
				Рек.РежимВыбораИзСписка = Истина;
			Иначе
				Рек.КнопкаВыбора = Ложь;
			КонецЕсли;
			
					
			Если ПолеТаблицы.mandatory Тогда
				Рек.ОтметкаНезаполненного = Истина;
			КонецЕсли;
			
			Рек.УстановитьДействие("ПриИзменении", НазваниеТаблицы + "ПриИзменении");
			
		Исключение
			Сообщить(СтрШаблон("%1 %2 %3 %4", ПолеТаблицы.Заголовок, ИмяРеквизита, ПутьКДанным, ОписаниеОшибки()));
		КонецПопытки;
		
	КонецЦикла;
			
КонецПроцедуры

&НаСервере
Процедура СохранитьЗначениеРеквизитаТовара(ИмяРеквизита)
	
	Перем Номенклатура, Категория;

	Объект.СоставКатегорииКаспи[0].Свойство("Категория", Категория);
	Объект.СоставКатегорииКаспи[0].Свойство("Номенклатура", Номенклатура);
	
	НаборЗаписей = РегистрыСведений.СоставКатегорииКаспи.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Категория.Установить(Категория);
	НаборЗаписей.Отбор.Номенклатура.Установить(Номенклатура);
	
	Запись = НаборЗаписей.Добавить();
	Запись.Категория = Категория;
	Запись.Номенклатура = Номенклатура;
	
	НаборЗаписей.Записать();
	
	Результат = РеквизитФормыВЗначение("РеквизитыТовара");
	Найдено = Результат.НайтиСтроки(Новый Структура("ИмяРеквизита", ИмяРеквизита));
	Если Найдено.Количество() = 1 Тогда
	
		НаборЗаписей = РегистрыСведений.РеквизитыТовараКаспи.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Номенклатура.Установить(Номенклатура);
		НаборЗаписей.Отбор.Реквизит.Установить(ИмяРеквизита);
		
		Запись = НаборЗаписей.Добавить();
		Запись.Номенклатура = Номенклатура;
		Запись.Реквизит = ИмяРеквизита;
		Запись.ЗначениеРеквизита = Найдено[0].ЗначениеРеквизита;
		НаборЗаписей.Записать();
		
	КонецЕсли;
		
	
КонецПроцедуры


