&НаКлиенте
Процедура Обзор(Команда)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Заголовок = "Выберите файл";
	ДиалогВыбора.Фильтр = "Все файлы|*.*|Изображения|*.jpeg|*.jpg";
	
	//"Все файлы|*.*|Документы|???.docx;*.[Rr][Tt][Ff];doc[0-9].txt".

	Если ДиалогВыбора.Выбрать() Тогда
		ИмяФайла = ДиалогВыбора.ПолноеИмяФайла;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;
	

	//Файл = Новый ДвоичныеДанные(ИмяФайла);
	Файл = Новый Картинка(ИмяФайла);
	Объект.АдресВременноеХранилище = ПоместитьВоВременноеХранилище(Файл, ЭтаФорма.УникальныйИдентификатор);
	
	ЗагрузитьИзображениеНаХостинг();
	
КонецПроцедуры


&НаСервере
Процедура ЗагрузитьИзображениеНаХостинг()
	
	Контекст = ПолучитьКонтекст();
	Контекст.ЗагрузитьИзображениеНаХостинг();
	ОбновитьКонтекст(Контекст);	

КонецПроцедуры

&НаСервере
Процедура ОпубликоватьНаСервере(Отказ, Сообщение)
	
	Контекст = ПолучитьКонтекст();
	Отказ = Не Контекст.ОпубликоватьКарточку(, Сообщение);
	ОбновитьКонтекст(Контекст);
	
КонецПроцедуры

&НаКлиенте
Процедура Опубликовать(Команда)
	Перем Отказ, Сообщение;
	
	ОпубликоватьНаСервере(Отказ, Сообщение);
	ВывестиУведомление(Сообщение, Отказ);
КонецПроцедуры

&НаСервере
Процедура ПроверитьСтатусНаСервере(Отказ, Сообщение)
	Контекст = ПолучитьКонтекст();
	Отказ = Не Контекст.ПроверитьСтатусКарточки(Сообщение);
	ОбновитьКонтекст(Контекст);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСтатус(Команда)
	Перем Отказ, Сообщение;
	
	ПроверитьСтатусНаСервере(Отказ, Сообщение);
	ВывестиУведомление(Сообщение, Отказ);
КонецПроцедуры



&НаКлиенте
Процедура ПереместитьВНачало(ИндексСтроки)
	
	// Сдвигаем на -1 пока не достигнем верха
	Пока ИндексСтроки > 0 Цикл
		Объект.СоставКатегорииКаспи.Сдвинуть(ИндексСтроки, -1);
		ИндексСтроки = ИндексСтроки - 1;
	КонецЦикла;

КонецПроцедуры




#КонецОбласти 



