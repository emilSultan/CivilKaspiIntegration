&НаКлиенте
Процедура ВывестиУведомление(ТекстСообщения, Отказ = Неопределено)

	Если ПустаяСтрока(ТекстСообщения) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ПанельУведомлений.Видимость = Истина;
	Элементы.ПредупреждениеКартинка.Видимость = Отказ = Истина;
	Элементы.УведомлениеКартинка.Видимость = Отказ <> Истина;
	Элементы.ПредупреждениеОписание.Заголовок = ТекстСообщения;
	УстановитьЦветФонаУведомления(Отказ);
	ПодключитьОбработчикОжидания("СкрытьУведомление", 10, Истина);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЦветФонаУведомления(Отказ)
	Если Отказ = Неопределено Тогда
		Элементы.ПанельУведомлений.ЦветФона = Новый Цвет(224, 255, 255);
	Иначе
		Если Отказ Тогда
			Элементы.ПанельУведомлений.ЦветФона = Новый Цвет(251, 212, 212); //ЦветаСтиля.ЦветФонаПредупреждения;
		Иначе
			Элементы.ПанельУведомлений.ЦветФона = Новый Цвет(215, 240, 199); //ЦветаСтиля.ЦветФонаПоложительногоЗначения;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры	

