#Region ProductCard

Функция УстановитьТовар(Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	
	"ВЫБРАТЬ
	|	Состав.familyId КАК familyId,
	|	isnull(Состав.sku, Н.Артикул) КАК sku,
	|	isnull(Состав.title, Н.Наименование) КАК title,
	|	Состав.brand КАК brand,
	|	Состав.description КАК description,
	|	Состав.code КАК code,
	|	Состав.status КАК status,
	|	Состав.images КАК images,
	|	Н.Ссылка КАК Номенклатура,
	|	Состав.Категория КАК Категория
	|ИЗ
	|	Справочник.Номенклатура КАК Н 
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставКатегорииКаспи КАК Состав 
	|		ПО (Н.Ссылка = Состав.Номенклатура)
	|ГДЕ
	|	Н.Ссылка = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальные = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальные.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СоставКатегорииКаспи.Получить(0), ВыборкаДетальные);
		Возврат Истина;
	Иначе
		СоставКатегорииКаспи.Очистить();
		СоставКатегорииКаспи.Добавить().Номенклатура = Номенклатура;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

Функция ЗначенияРеквизитовТовара() Экспорт
	
	Категория = СоставКатегорииКаспи.Получить(0).Категория;
	Номенклатура = СоставКатегорииКаспи.Получить(0).Номенклатура;
	
	СхемаКомпоновкиДанных = Справочники.КатегорияТоваровКаспи.ПолучитьМакет("РеквизитыТовара");
	
	ПараметрыОтчета = Новый Структура("КатегорияСсылка,Номенклатура", Категория, Номенклатура);
	Результат = Новый ТаблицаЗначений();
	ВывестиДанныеЧерезСКД(СхемаКомпоновкиДанных,, ПараметрыОтчета,, Результат);
	Возврат Результат;
	
КонецФУнкции

Процедура СохранитьОсновныеДанныеКарточки() Экспорт
	
	Данные = СоставКатегорииКаспи.Получить(0);
	
	Если Не ЗначениеЗаполнено(Данные.Категория) Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.СоставКатегорииКаспи.СоздатьНаборЗаписей();
	//
	НаборЗаписей.Отбор.Номенклатура.Установить(Данные.Номенклатура);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0 Тогда
		Запись = НаборЗаписей.Добавить();
	Иначе
		Запись = НаборЗаписей.Получить(0);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Запись, Данные);
	
	Если Изображения.Количество() > 0 Тогда
		
		Images = new Array();
		Для Каждого Ъ Из Изображения Цикл
			Images.Добавить(Новый Структура("Url", Ъ.src));
		КонецЦикла;
		Запись.images = Новый ХранилищеЗначения(Images);
		
	КонецЕсли;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция ЗагрузитьИзображениеНаХостинг(ЛокальныйПуть = Неопределено) Экспорт
	
	var HTTPОтвет;
	
	Изображение = ПолучитьИзВременногоХранилища(ЭтотОбъект.АдресВременноеХранилище);

	// Отправка в хостинг изображений по API
	ПараметрыЗапроса = Новый Соответствие();
	ПараметрыЗапроса.Вставить("key", "43651a876fbba4268360b06c6d015ae4");
	ПараметрыЗапроса.Вставить("expiration", 3600);
	АдресРесурса = "https://api.imgbb.com/1/upload";
	АдресРесурса = АдресРесурса + "?" + КодироватьПараметрыЗапроса(ПараметрыЗапроса); 

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");

	ДопПараметры = Новый Структура();
	ДопПараметры.Вставить("Таймаут", 180);
	ДопПараметры.Вставить("Заголовки", Заголовки);
	
	ДанныеЗапроса = Новый Структура("image", Изображение.ПолучитьДвоичныеДанные());

	Попытка
		
		ResponseData = postJSONQuery(АдресРесурса, ДанныеЗапроса, ДопПараметры, HTTPОтвет);
		JSONResponse = HTTPОтвет.ПолучитьТелоКакСтроку();
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			Сообщение = СтрШаблон("StatusCode %1", HTTPОтвет.КодСостояния);
			Возврат Ложь;
		КонецЕсли;

	Исключение
		Сообщение = ОписаниеОшибки();
		Возврат Ложь;	
	КонецПопытки;	
	
	Нов = ЭтотОбъект.Изображения.Добавить();
	Нов.АдресХранилища = ЭтотОбъект.АдресВременноеХранилище;
	Нов.src = GetMapProperty(ResponseData, "data.image.url");

	ЭтотОбъект.УникальныйИдентификатор = Новый УникальныйИдентификатор(); // Чтобы следующий адрес хранился в другом месте

	Возврат Истина;

КонецФункции


Функция ОпубликоватьКарточку(Результат, Сообщение = "") Экспорт

	var this, HTTPОтвет;
	Перем ДанныеЗапроса, ДанныеОтвета;
	wrapfor(this);
	
	Номенклатура = СоставКатегорииКаспи.Получить(0).Номенклатура;
	Контекст = Обработки.ПроксиКаспи.Создать();
	Контекст.Товары_СформироватьДанныеКарточки(Номенклатура, ДанныеЗапроса);
	
	ДанныеЗапроса.Вставить("images", Новый Массив);
	
	Для Каждого Ъ Из Изображения Цикл
		ДанныеЗапроса.images.Добавить(Новый Структура("url", Ъ.src));
	КонецЦикла;
	
	ПараметрыЗапроса = Новый Соответствие();
	ПараметрыЗапроса.Вставить("Host", "kaspi.kz");
	ПараметрыЗапроса.Вставить("HTTP/1.1", "");
	path = "/products/import?" + КодироватьПараметрыЗапроса(ПараметрыЗапроса);

	ДопПараметры = Новый Структура();
	ДопПараметры.Вставить("Таймаут", 180);
	ДопПараметры.Вставить("Заголовки", this.headers);
	ДопПараметры.Заголовки.Вставить("Content-Type", "text/plain");

	Попытка 
		ДанныеЗапроса = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеЗапроса);
		ДанныеОтвета = postJSONQuery(this.URI + path, ДанныеЗапроса, ДопПараметры, HTTPОтвет);
		JSONResponse = HTTPОтвет.ПолучитьТелоКакСтроку();
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			Сообщение = СтрШаблон("StatusCode %1", HTTPОтвет.КодСостояния);
			Возврат Ложь;
		КонецЕсли;
		
		СоставКатегорииКаспи.Получить(0).code = ДанныеОтвета.Get("code");
		СоставКатегорииКаспи.Получить(0).status = ДанныеОтвета.Get("status");
		СохранитьОсновныеДанныеКарточки();

		Возврат Истина;
	Исключение
		
	КонецПопытки;
	
	Возврат Ложь;
КонецФункции


Функция ПроверитьСтатусКарточки(Сообщение = "") Экспорт
	
var this, HTTPОтвет;
	Перем ДанныеОтвета;
	wrapfor(this);
	
	Номенклатура = СоставКатегорииКаспи.Получить(0).Номенклатура;
	КодЗагрузкиТовара = СоставКатегорииКаспи.Получить(0).code;
	sku = СоставКатегорииКаспи.Получить(0).sku;
	
	
	ПараметрыЗапроса = Новый Соответствие();
	ПараметрыЗапроса.Вставить("Host", "kaspi.kz");
	ПараметрыЗапроса.Вставить("HTTP/1.1", "");
	ПараметрыЗапроса.Вставить("i", КодЗагрузкиТовара);
	path = "/products/import/result?" + КодироватьПараметрыЗапроса(ПараметрыЗапроса);

	ДопПараметры = Новый Структура();
	ДопПараметры.Вставить("Таймаут", 180);
	ДопПараметры.Вставить("Заголовки", this.headers);
	ДопПараметры.Заголовки.Вставить("Content-Type", "text/plain");

	Попытка 
		ДанныеОтвета = getJSONQuery(this.URI + path,, ДопПараметры, HTTPОтвет);
		JSONResponse = HTTPОтвет.ПолучитьТелоКакСтроку();
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			Сообщение = СтрШаблон("StatusCode %1", HTTPОтвет.КодСостояния);
			Возврат Ложь;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеОтвета.Get("code")) Тогда
			Сообщение = ДанныеОтвета.Get("message");
			Если ДанныеОтвета.Get("code") = "RESULT_NOT_READY" Тогда
				Возврат Ложь;
			Иначе
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;

		Если ДанныеОтвета.Get("errors") > 0 Тогда
		
			warnings = GetMapProperty(ДанныеОтвета, "result." + sku + ".warnings");
			errors = GetMapProperty(ДанныеОтвета, "result." + sku + ".errors");
			Если warnings = Неопределено Тогда
				warnings = errors;
			ИначеЕсли errors <> Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(warnings, errors);
			КонецЕсли;

			Сообщение = СтрСоединить(warnings, Символы.ПС);
			
			Возврат Ложь;
		КонецЕсли;
			
		Возврат Истина;
	Исключение
		
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

