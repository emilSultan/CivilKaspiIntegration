#Region Context

Процедура ЗаполнитьПараметрыУчетаКаспи()
	Перем ЗначенияРесурсов;
	// костыль для того, чтобы сделать осязаемым структуру полей объекта расширения
	Если ПараметрыУчетаКаспи.Количество() = 0 Тогда
		Попытка
			ЗначенияРесурсов = РегистрыСведений.ПараметрыУчетаКаспи.Получить();
			Если Не ЗначенияРесурсов.Свойство("СкладКаспи") Тогда
				ЗначенияРесурсов.Вставить("СкладКаспи", Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию("Склад Kaspi"));
			КонецЕсли;
		Исключение
			ЗначенияРесурсов = Новый Структура();
		КонецПопытки;

		ЗаполнитьЗначенияСвойств(ПараметрыУчетаКаспи.Добавить(), ЗначенияРесурсов);
	КонецЕсли;
	
	Попытка
		Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
			Выборка = ПолучитьВыборкуУчетныхЗаписей();
			Выборка.Следующий();
			УстановитьУчетнуюЗапись(Выборка.Ссылка);
		КонецЕсли;		
	Исключение
	КонецПопытки;
	
	Если ИспользуемыеСклады.Количество() = 0 Тогда
		//УстановитьУчетнуюЗапись(УчетнаяЗапись);
	КонецЕсли;
	
	Если СоставКатегорииКаспи.Количество() = 0 Тогда
		СоставКатегорииКаспи.Добавить();
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьВыборкуУчетныхЗаписей()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УчетныеЗаписи.Ссылка КАК Ссылка,
		|	УчетныеЗаписи.ПометкаУдаления КАК ПометкаУдаления,
		|	УчетныеЗаписи.ИДПродавца КАК ИДПродавца
		|ИЗ
		|	Справочник.УчетныеЗаписиКаспи КАК УчетныеЗаписи";

	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Возврат ВыборкаДетальныеЗаписи;
КонецФУнкции		

