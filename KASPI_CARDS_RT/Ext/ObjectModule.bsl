Функция Товары_СписокКатегорий(Результат, Сообщение) Экспорт
	
	Перем Отклик;

	Если IsDataGotten("/products/classification/categories",, Отклик, Сообщение) Тогда
		
		Результат = Новый ТаблицаЗначений();
		Результат.Колонки.Добавить("code", ОбщегоНазначения.ОписаниеТипаСтрока(100));
		Результат.Колонки.Добавить("title", ОбщегоНазначения.ОписаниеТипаСтрока(100));
		
		Для Каждого Ъ Из Отклик Цикл
			Нов  = Результат.Добавить();
			Для Каждого КЗ ИЗ Ъ Цикл
				Нов[КЗ.Ключ] = КЗ.Значение;
			КонецЦикла;
		КонецЦикла;
		
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция Товары_РеквизитыКатегории(Код, Результат, Сообщение) Экспорт
	
	Перем Отклик;
	
	ДанныеЗапроса = New Map();
	ДанныеЗапроса.Вставить("c", Код);
	ДанныеЗапроса.Вставить("Host", "kaspi.kz");
	ДанныеЗапроса.Вставить("HTTP/1.1", "");
	
	Если IsDataGotten("/products/classification/attributes", ДанныеЗапроса, Отклик, Сообщение) Тогда
		
		Результат = Новый ТаблицаЗначений();
		Результат.Колонки.Добавить("code", ОбщегоНазначения.ОписаниеТипаСтрока(100));
		Результат.Колонки.Добавить("type", ОбщегоНазначения.ОписаниеТипаСтрока(50));
		Результат.Колонки.Добавить("multiValued", Новый ОписаниеТипов("Булево"));
		Результат.Колонки.Добавить("mandatory", Новый ОписаниеТипов("Булево"));
		
		Для Каждого Ъ Из Отклик Цикл
			Нов  = Результат.Добавить();
			Для Каждого КЗ ИЗ Ъ Цикл
				Нов[КЗ.Ключ] = КЗ.Значение;
			КонецЦикла;
		КонецЦикла;
		
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

