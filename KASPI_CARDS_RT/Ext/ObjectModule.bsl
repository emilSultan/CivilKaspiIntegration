	Сегмент = Новый Массив();
	Если СтрНайти(ИмяКоманды, "KASPI_MARKETPLACE") = 0 Тогда
		Сегмент.Добавить("KASPI_MARKETPLACE");
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяКоманды) Тогда
		Сегмент.Добавить(ИмяКоманды);
	КонецЕсли;
	
	Возврат СтрСоединить(Сегмент, ".");

КонецФункции

Процедура ЗанестиВЖурналСобытий(Событие, Идентификатор, Успех, Комментарий)
	Перем МетаданныеДляЖурнала;
	
	Уровень = ?(Успех, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка);
	Попытка 
		МетаданныеДляЖурнала = Идентификатор.Метаданные();
	Исключение	
	КонецПопытки;

	ЗаписьЖурналаРегистрации(Событие, Уровень, МетаданныеДляЖурнала, Идентификатор, Комментарий);
	
	Если Не Успех И ОстановитьПриОшибке Тогда
		ВызватьИсключение Комментарий;
	КонецЕсли;
	
КонецПроцедуры	

