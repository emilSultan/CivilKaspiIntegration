#Region HTTP_REQUEST

function postJSONQuery(absoluteURL, ДанныеЗапроса, ДопПараметры = Неопределено, HTTPОтвет = Неопределено) 

	Перем Таймаут, ПараметрыПреобразованияJSON;
	
	Заголовки	= Новый Соответствие();
	Заголовки.Вставить("Accept-Encoding",	"gzip");
	Заголовки.Вставить("Content-Type",		"application/json");
	Заголовки.Вставить("Connection",		"keep-alive");
	Заголовки.Вставить("Accept",			"*/*");
	Если ДопПараметры.Свойство("Заголовки") Тогда
		for each k in ДопПараметры.Заголовки do
			Заголовки.Вставить(k.key, k.value);
		endDo;
	КонецЕсли;
	
	Если Не ДопПараметры.Свойство("Таймаут", Таймаут) Тогда
		Таймаут = 30;
	КонецЕсли;

	RelativeURL = StrReplace(absoluteURL, "https://", "");
	IsSSL = RelativeURL <> absoluteURL;	
	RelativeURL = StrReplace(RelativeURL, "http://", "");
	host = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(RelativeURL, "/", false).Get(0);
	RelativeURL = StrReplace(RelativeURL, host, "");

	JSONRequest = "";
	Если Найти(Заголовки.Получить("Content-Type"), "application/x-www-form-urlencoded") > 0 Тогда	
		JSONRequest = КодироватьПараметрыЗапроса(ДанныеЗапроса);
		//Заголовки.Вставить("Content", JSONRequest);
		Заголовки.Вставить("Accept-Encoding", "identity");
	Иначе
		JSONRequest = ОбъектВJson(ДанныеЗапроса);
	КонецЕсли;

	HTTPЗапрос	= Новый HTTPЗапрос(RelativeURL, Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки(JSONRequest, КодировкаТекста.UTF8);
	

	Если IsSSL Тогда
		СертификатыУЦ = Новый СертификатыУдостоверяющихЦентровОС();
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(, СертификатыУЦ);
		HTTPСоединение	= Новый HTTPСоединение(host, 443,,,,Таймаут, ЗащищенноеСоединение);
	Иначе	
		HTTPСоединение	= Новый HTTPСоединение(host,,,,, Таймаут);
	КонецЕсли;

	HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	
	Если Найти(HTTPОтвет.Заголовки.Получить("Content-Type"), "json") > 0 Тогда
		Попытка
			Тело = HTTPОтвет.ПолучитьТелоКакПоток();
			ResponseData = JsonВОбъект(Тело,,ПараметрыПреобразованияJSON);
		Исключение
			JsonResponse = HTTPОтвет.ПолучитьТелоКакСтроку();
			Если Не ПустаяСтрока(JsonResponse) Тогда
				ResponseData = JsonВОбъект(JsonResponse,,ПараметрыПреобразованияJSON);
			Иначе
				ВызватьИсключение "В теле ответа нет json данных";
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;
	
	Возврат ResponseData;

endfunction

function getJSONQuery(absoluteURL, ДанныеЗапроса = Неопределено, ДопПараметры = Неопределено, HTTPОтвет = Неопределено) 

	Перем Таймаут, ПараметрыПреобразованияJSON;
	
	Заголовки	= Новый Соответствие();
	Заголовки.Вставить("Accept-Encoding",	"gzip");
	Заголовки.Вставить("Content-Type",		"application/json");
	Заголовки.Вставить("Connection",		"keep-alive");
	Заголовки.Вставить("Accept",			"*/*");
	Если ДопПараметры.Свойство("Заголовки") Тогда
		for each k in ДопПараметры.Заголовки do
			Заголовки.Вставить(k.key, k.value);
		endDo;
	КонецЕсли;
	
	Если Не ДопПараметры.Свойство("Таймаут", Таймаут) Тогда
		Таймаут = 30;
	КонецЕсли;

	RelativeURL = StrReplace(absoluteURL, "https://", "");
	IsSSL = RelativeURL <> absoluteURL;	
	RelativeURL = StrReplace(RelativeURL, "http://", "");
	host = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(RelativeURL, "/", false).Get(0);
	RelativeURL = StrReplace(RelativeURL, host, "");
	
	Если ЗначениеЗаполнено(ДанныеЗапроса) Тогда
		RelativeURL = RelativeURL + "?" + КодироватьПараметрыЗапроса(ДанныеЗапроса);
	КонецЕсли;
	
	JSONRequest =RelativeURL;

	HTTPЗапрос	= Новый HTTPЗапрос(RelativeURL, Заголовки);	

	Если IsSSL Тогда
		СертификатыУЦ = Новый СертификатыУдостоверяющихЦентровОС();
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(, СертификатыУЦ);
		HTTPСоединение	= Новый HTTPСоединение(host, 443,,,,Таймаут, ЗащищенноеСоединение);
	Иначе	
		HTTPСоединение	= Новый HTTPСоединение(host,,,,, Таймаут);
	КонецЕсли;

	HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод("GET", HTTPЗапрос);

	Попытка
		Тело = HTTPОтвет.ПолучитьТелоКакПоток();
		Если ДопПараметры <> Неопределено Тогда
			ДопПараметры.Свойство("ПараметрыПреобразованияJSON", ПараметрыПреобразованияJSON);
		КонецЕсли;
		ResponseData = JsonВОбъект(Тело,,ПараметрыПреобразованияJSON);
	Исключение	
	КонецПопытки;
	
	Возврат ResponseData;

endfunction

Функция КодироватьПараметрыЗапроса(ПараметрыЗапроса)
	
	ЧастиПараметрыЗапроса = Новый Массив;
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Если ТипЗнч(Параметр.Значение) = Тип("Массив") Тогда
			Значения = Параметр.Значение;
		Иначе
			Значения = Новый Массив;
			Значения.Добавить(Параметр.Значение);
		КонецЕсли;
		
		Для Каждого Значение Из Значения Цикл
			Если СтрНайти(Параметр.Ключ,"date") <> 0 И СтрНайти(Значение,"+") <> 0 И СтрНайти(Значение,":") <> 0 И СтрНайти(Значение,"T") <> 0 Тогда
				ЗначениеПараметра = КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
			ИначеЕсли ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
				Base64Строка = Base64Строка(Значение);
				// 2. КРИТИЧЕСКИ ВАЖНО: удаляем все служебные символы из Base64
				// Без этого сервер вернет ошибку "Invalid base64 string"
				Base64Строка = СтрЗаменить(Base64Строка, Символы.ПС, "");
				Base64Строка = СтрЗаменить(Base64Строка, Символы.ВК, "");
				Base64Строка = СтрЗаменить(Base64Строка, Символы.Таб, "");
				ЗначениеПараметра = КодироватьСтроку(Base64Строка, СпособКодированияСтроки.КодировкаURL);
			Иначе
				ЗначениеПараметра = КодироватьСтроку(Значение, СпособКодированияСтроки.URLВКодировкеURL);
			КонецЕсли;	
			ЧастиПараметрыЗапроса.Добавить(СтрШаблон("%1=%2", Параметр.Ключ, ЗначениеПараметра));
		КонецЦикла;
	КонецЦикла;
	
	Возврат СтрСоединить(ЧастиПараметрыЗапроса, "&");
	
КонецФункции


