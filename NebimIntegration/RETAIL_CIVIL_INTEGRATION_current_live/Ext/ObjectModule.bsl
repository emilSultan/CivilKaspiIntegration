// Основная процедура вызова
Процедура ВыполнитьКоманду(ИмяКоманды, ПараметрыВыполнения) Экспорт
	
	Если ИмяКоманды = "GET_PRICE" Тогда
		ПолучитьЦены();
	ИначеЕсли  ИмяКоманды = "GET_LOTS" Тогда
		ПолучитьЛоты();
	ИначеЕсли ИмяКоманды = "GET_SHIPMENT" Тогда
		ПолучитьИнвойсы(); 
	ИначеЕсли ИмяКоманды = "SEND_SALES" Тогда
		SEND_SALES();
	ИначеЕсли ИмяКоманды = "SEND_REALISATION" Тогда
		SEND_REALISATION(); 
	ИначеЕсли ИмяКоманды = "SEND_RETURN" Тогда
		SEND_RETURN();
	ИначеЕсли ИмяКоманды = "SEND_ACCEPTANCE" Тогда
	
		
		ОтправитьПриемкиТоваров();

	КонецЕсли;
	
КонецПроцедуры

