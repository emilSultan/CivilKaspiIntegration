	               |	ЕСТЬNULL(СпMopSubDepartment.Ссылка, ЗНАЧЕНИЕ(Справочник.MopSubDepartment.ПустаяСсылка)) КАК MopSubDepartment,
	               |	ЕСТЬNULL(СпMopCategory.Ссылка, ЗНАЧЕНИЕ(Справочник.MopCategory.ПустаяСсылка)) КАК MopCategory,
	               |	ЕСТЬNULL(СпMopClass.Ссылка, ЗНАЧЕНИЕ(Справочник.MopClass.Пустаяссылка)) КАК MopClass,
	               |	ЕСТЬNULL(НоменклатурныеТипыСезонов.Ссылка, ЗНАЧЕНИЕ(Справочник.НоменклатурныеТипыСезонов.ПустаяСсылка)) КАК ТипыСезонов
	               |ИЗ
	               |	ВТ_ТаблицыДанных КАК ВТ_ТаблицыДанных
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	               |		ПО ВТ_ТаблицыДанных.OptionCode = СпрНоменклатура.Артикул
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатурныеЦвета КАК НоменклатурныеЦвета
	               |		ПО ВТ_ТаблицыДанных.ColorCode = НоменклатурныеЦвета.КодИсточник
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатурныйПол КАК НоменклатурныйПол
	               |		ПО ВТ_ТаблицыДанных.GenderCode = НоменклатурныйПол.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатурныеСтраныПроизводства КАК НоменклатурныеСтраныПроизводства
	               |		ПО ВТ_ТаблицыДанных.OriginCode = НоменклатурныеСтраныПроизводства.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатурныеТипыТовара КАК НоменклатурныеТипыТовара
	               |		ПО ВТ_ТаблицыДанных.ProductTypeCode = НоменклатурныеТипыТовара.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатурныйСоставыТкани КАК НоменклатурныйСоставыТкани
	               |		ПО ВТ_ТаблицыДанных.Model = НоменклатурныйСоставыТкани.КодИсточник
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	               |		ПО ВТ_ТаблицыДанных.ProductTypeCode = ВидыНоменклатуры.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.MopDivision КАК СпMopDivision
	               |		ПО ВТ_ТаблицыДанных.MopDivision = СпMopDivision.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.MopDepartment КАК СпMopDepartment
	               |		ПО ВТ_ТаблицыДанных.MopDepartment = СпMopDepartment.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.MopSubDepartment КАК СпMopSubDepartment
	               |		ПО ВТ_ТаблицыДанных.MopSubDepartment = СпMopSubDepartment.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.MopCategory КАК СпMopCategory
	               |		ПО ВТ_ТаблицыДанных.MopCategory = СпMopCategory.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.MopClass КАК СпMopClass
	               |		ПО ВТ_ТаблицыДанных.MopClass = СпMopClass.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатурныеСезоныКоллекции КАК НоменклатурныеСезоныКоллекции
	               |		ПО ВТ_ТаблицыДанных.SeasonCollection = НоменклатурныеСезоныКоллекции.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатурныеТипыСезонов КАК НоменклатурныеТипыСезонов
	               |		ПО ВТ_ТаблицыДанных.SeasonType = НоменклатурныеТипыСезонов.Наименование";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьДанныеТоварыИзСервиса(ПараметрыИсточника, Модель, ПоШтрихкоду = Неопределено)
	
	ДополнительныеПараметры = ПолучитьДопПараметры(); 
	Если ПоШтрихкоду = ЛОжь Тогда 
		Ответ = КоннекторHTTP.GetJson(ВнешняяСистема.URL+"/api/Products/GetProductByLangCodes?LangCodes=EN&ProductCode=" + Модель,,ДополнительныеПараметры); 
	Иначе
		Ответ = КоннекторHTTP.GetJson(ВнешняяСистема.URL+"/api/Products/GetProductByLangCodes?LangCodes=EN&Barcode=" + Модель,,ДополнительныеПараметры); 	
	КонецЕсли;
	
	//Сообщить(ВывестиЖейсонКакСтроку(Ответ));
	
	Если ТипЗнч(Ответ) = Тип("Соответствие") Тогда
		Если Ответ.Получить("success") Тогда 
			Возврат Ответ.Получить("data");
		Иначе
			ЗаписатьВЖурналРегистра(ПараметрыИсточника, Модель, Ложь, ВывестиЖейсонКакСтроку(Ответ)); 
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		ЗаписатьВЖурналРегистра(ПараметрыИсточника, Модель, Ложь, "Получили не допустимое значение -/api/Products/GetProductByLangCodes?LangCodes=EN&ProductCode="+Модель);
		Возврат Неопределено;	
	КонецЕсли;
	
КонецФункции

Функция НайтиСоздатьСправочники(СпрКод, МассивНаименований, НаименованиеСправочника)
	
	//Если КодИсточника не задан, нет смысла создавать справочник
	Если ПустаяСтрока(СокрЛП(СпрКод)) Тогда 
		Возврат Справочники[НаименованиеСправочника].ПустаяСсылка();
	КонецЕсли;
	
	СпрОбъект = Справочники[НаименованиеСправочника].СоздатьЭлемент();
	СпрОбъект.КодИсточник = СпрКод;
	СпрОбъект.УстановитьНовыйКод();
	
	СпрОбъект.Наименование = СтрЗаменить(СокрЛП(МассивНаименований),Символы.НПП,"");
	СпрОбъект.Записать();
	
	Возврат СпрОбъект.Ссылка;
	
	НаименованиеСправочника = "";
	
	НаименованиеАнглийский = "";
	НаименованиеТурецкий = "";
	
	Для Каждого ТекСтрока Из МассивНаименований Цикл 
		Если ТекСтрока.Получить("LangCode") = "EN" Тогда 
			НаименованиеАнглийский = ТекСтрока.Получить("LangCodeDescription");
		ИначеЕсли ТекСтрока.Получить("LangCode") = "TR" Тогда 
			НаименованиеТурецкий = ТекСтрока.Получить("LangCodeDescription");
		КонецЕсли;
	КонецЦикла;
	
	НаименованиеСправочника = ?(НаименованиеАнглийский = ""
				Или НаименованиеАнглийский = Неопределено, НаименованиеТурецкий, НаименованиеАнглийский);
	
	Если НаименованиеСправочника = "" Тогда 
		НаименованиеСправочника = СпрКод;
	КонецЕсли;
	
	СпрОбъект.Наименование = СтрЗаменить(СокрЛП(НаименованиеСправочника),Символы.НПП,"");
	СпрОбъект.Записать();
	
	Для Каждого ТекСтрока Из МассивНаименований Цикл
		Если ТекСтрока.Получить("LangCode") <> "EN" 
			И ТекСтрока.Получить("LangCode") <> "" Тогда 
			
			РегистрыСведений.СловарьДанных.ЗаписатьВСловарь(ТекСтрока.Получить("LangCode"), СпрОбъект.Ссылка, ТекСтрока.Получить("LangCodeDescription"));
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат СпрОбъект.Ссылка;
	
КонецФункции

