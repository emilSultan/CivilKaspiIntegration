#Область GET_SHIPMENT
Функция ПолучитьПоступлениеПоВходящемуНомеру(ВходящийНомер)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ВходящийНомер", ВходящийНомер);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ПоступлениеТоваров.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	               |ГДЕ
	               |	ПоступлениеТоваров.ВходящийНомер = &ВходящийНомер
	               |	И НЕ ПоступлениеТоваров.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Ссылка;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции 

Функция ПолучитьПоступлениеПоНомеруПоставки2(НомерПоставки2)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("НомерПоставки2", НомерПоставки2);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ПоступлениеТоваров.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	               |ГДЕ
	               |	НЕ ПоступлениеТоваров.ПометкаУдаления
	               |	И ПоступлениеТоваров.НомерПоставки2 = &НомерПоставки2
	               |	И ПоступлениеТоваров.Проведен";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Ссылка;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура ПолучитьИнвойсы() Экспорт
	
	ПараметрИсточник = ПолучитьПараметрИсточника("GET_INVOICES");
	ТаблицаДанныхПоступления = ПолучитьДеталиПоступления(,,, Истина);
	
	Если ТипЗнч(ТаблицаДанныхПоступления) = Тип("ТаблицаЗначений") Тогда

		МассивИнвойсов = ТаблицаДанныхПоступления.Скопировать();
		
		Страна = ПолучитьКазахстан();
		
		// Сворачиваем по ключевым реквизитам шапки
		МассивИнвойсов.Свернуть("НомерДокумента,Номер,ЗаголовокДокумента");
		
		Для Каждого ТекИнвойс Из МассивИнвойсов Цикл 
			
			ВходящийНомер        = СокрЛП(ТекИнвойс.НомерДокумента);
			НомерЭкспорта        = СокрЛП(ТекИнвойс.Номер); 
			ЗаголовокПоступления = СокрЛП(ТекИнвойс.ЗаголовокДокумента);
			
			ДокументСсылка = ПолучитьПоступлениеПоНомеруПоставки2(ЗаголовокПоступления);
			
			Если ДокументСсылка <> Неопределено Тогда
				ОдобритьПоступления(ЗаголовокПоступления, ПараметрИсточник);
				ЗаписатьВЖурналРегистра(ПараметрИсточник, ВходящийНомер, Ложь, "ALREADY_EXISTS");
				Продолжить;
			КонецЕсли;
			
			// Отбираем строки строго текущего инвойса/поставки
			ОтборСтрок = Новый Структура;
			ОтборСтрок.Вставить("ЗаголовокДокумента", ЗаголовокПоступления);
			
			НайденныеСтроки = ТаблицаДанныхПоступления.НайтиСтроки(ОтборСтрок);
			ТаблицаТекущегоИнвойса = ТаблицаДанныхПоступления.Скопировать(НайденныеСтроки);
			
			ЗаписатьВЖурналРегистра(ПараметрИсточник, ВходящийНомер);
			
			ДокументСсылка = СоздатьПоступлениеТоваров(ТаблицаТекущегоИнвойса, ВходящийНомер, Страна, НомерЭкспорта, ЗаголовокПоступления, Ложь);
			
			Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПоступлениеТоваров") Тогда
				
				ВидыЦен = ПолучитьВсеВидыЦен();
				
				Для Каждого ТекВидЦены Из ВидыЦен Цикл
					ПолучитьЦеныПоПоступлениям(ДокументСсылка, ТекВидЦены.Ссылка);
				КонецЦикла;
				
				ОдобритьПоступления(ЗаголовокПоступления, ПараметрИсточник);
				
			ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("Соответствие") Тогда 
				
				КлючОшибки = ДокументСсылка.Получить("ERROR_DESC");
				ОдобритьПоступления(ЗаголовокПоступления, ПараметрИсточник);
				
			Иначе 
				
				ЗаписатьВЖурналРегистра(ПараметрИсточник, ВходящийНомер, Ложь, ДокументСсылка);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьПоступлениеТоваров(ТаблицаДанныхПоступления, ВходящийНомер, Страна, НомерЭкспорта = "", ЗаголовокПоступления = "", ОбновитьЛоты = Истина) Экспорт
	
	Если ТипЗнч(ТаблицаДанныхПоступления) = Тип("Строка") Тогда 
		Возврат ТаблицаДанныхПоступления;
	КонецЕсли;
	
	Если ТаблицаДанныхПоступления.Количество() = 0 Тогда 
		Соответствие = Новый Соответствие;
		Соответствие.Вставить("ERROR_DESC", "EMPTY_DETAIL");
		Возврат Соответствие;
	КонецЕсли;
	
	СоздалиВсеОтсутствущиеНоменклатуры = СоздатьОтсутствущиеНоменклатурыПоступления(ТаблицаДанныхПоступления);
	
	Если ТипЗнч(СоздалиВсеОтсутствущиеНоменклатуры) = Тип("Строка")
		Или ТипЗнч(СоздалиВсеОтсутствущиеНоменклатуры) = Тип("Соответствие") Тогда 
			Возврат СоздалиВсеОтсутствущиеНоменклатуры;
	КонецЕсли;
	
	Поставщик = Страна.Поставщик;
	
	Если НЕ ЗначениеЗаполнено(Поставщик) Тогда 
		Возврат СтрШаблон("Vendor is not given for Country:%1", Страна.Наименование);
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТаблицаПоступления", ТаблицаДанныхПоступления);
	Запрос.УстановитьПараметр("ОбновитьЛот", Ложь);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаПоступления.НомерДокумента КАК НомерДокумента,
	|	ТаблицаПоступления.Дата КАК Дата,
	|	ТаблицаПоступления.КодМагазина КАК КодМагазина,
	|	ТаблицаПоступления.Штрихкод КАК Штрихкод,
	|	ТаблицаПоступления.Количество КАК Количество,
	|	ТаблицаПоступления.Номер КАК Номер,
	|	ТаблицаПоступления.НомерКоробки КАК НомерКоробки,
	|	ТаблицаПоступления.Размер КАК Размер,
	|	ТаблицаПоступления.Артикул КАК Артикул,
	|	ТаблицаПоступления.КодВалюты КАК КодВалюты,
	|	ТаблицаПоступления.Сумма КАК Сумма,
	|	ТаблицаПоступления.Вес КАК Вес,
	|	ТаблицаПоступления.Длина КАК Длина,
	|	ТаблицаПоступления.Ширина КАК Ширина,
	|	ТаблицаПоступления.Высота КАК Высота,
	|	ТаблицаПоступления.Модель КАК Модель
	|ПОМЕСТИТЬ ТемпТаблицаПоступления
	|ИЗ
	|	&ТаблицаПоступления КАК ТаблицаПоступления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// 1. Уникальная номенклатура по Артикулу (защита от дублей)
	|ВЫБРАТЬ
	|	Номенклатура.Артикул КАК Артикул,
	|	МАКСИМУМ(Номенклатура.Ссылка) КАК НоменклатураСсылка
	|ПОМЕСТИТЬ ВТ_УникальнаяНоменклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|	И Номенклатура.Артикул В (ВЫБРАТЬ РАЗЛИЧНЫЕ Т.Артикул ИЗ ТемпТаблицаПоступления КАК Т)
