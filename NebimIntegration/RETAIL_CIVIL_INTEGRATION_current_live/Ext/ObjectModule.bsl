КонецФункции 

Функция НайтиСоздатьСправочникиМОП(Наименование, НаименованиеСправочника)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Наименование", СокрЛП(Наименование));
	ТекстЗапроса = "ВЫБРАТЬ
	               |	MopDepartment.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.%1 КАК MopDepartment
	               |ГДЕ
	               |	MopDepartment.Наименование = &Наименование";
	
	ТекстЗапроса = СтрШаблон(ТекстЗапроса, НаименованиеСправочника);
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Ссылка;
	Иначе 
		СпрОбъект = Справочники[НаименованиеСправочника].СоздатьЭлемент();
		СпрОбъект.Наименование = СокрЛП(Наименование);
		СпрОбъект.Записать();
		Возврат СпрОбъект.Ссылка;
	КонецЕсли;
	
КонецФункции 

Функция НайтиСоздатьВидНоменклатуры(КодИсточник, Наименование)
	
	Если ПустаяСтрока(СокрЛП(КодИсточник)) Тогда 
		Возврат Справочники.ВидыНоменклатуры.НайтиПоРеквизиту("КодИсточник", "00001"); //Создать вид номенклатуру и указать код здесь!!!
	КонецЕсли;
	
	СпрОбъект = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
	СпрОбъект.Наименование 				 = Наименование;
	СпрОбъект.КодИсточник 				 = КодИсточник;
	СпрОбъект.ТипНоменклатуры 			 = Перечисления.ТипыНоменклатуры.Товар;
	СпрОбъект.ЕдиницаИзмерения 			 = Справочники.БазовыеЕдиницыИзмерения.НайтиПоКоду("796");
	СпрОбъект.ИспользоватьХарактеристики = Истина;
	СпрОбъект.ИспользованиеХарактеристик = Перечисления.ВариантыВеденияДополнительныхДанныхПоНоменклатуре.ИндивидуальныеДляНоменклатуры;
	
	СпрОбъект.Записать();
	
	Возврат СпрОбъект.Ссылка;
	
КонецФункции

Функция ОбновитьНаименованиеСправочника(СпрСсылка, Наименование)
	
	Если СпрСсылка.Наименование <> Наименование Тогда 
		СпрОбъект = СпрСсылка.ПолучитьОбъект();
		СпрОбъект.Наименование = СтрЗаменить(СокрЛП(Наименование),Символы.НПП,"");;
		СпрОбъект.Записать();
	КонецЕсли;
	
КонецФункции


Функция СоздатьНоменклатуруПоМодели(Модель, HТТPСоединение = Неопределено, ПоШтрихкоду = Ложь) Экспорт 

	Обновить = истина;
	ПараметрыИсточника = ПолучитьПараметрИсточника("GET_ITEMS");
	Результат  = ПолучитьДанныеТоварыИзСервиса(ПараметрыИсточника, Модель, ПоШтрихкоду);
	
	Для Каждого ТекСтрока Из Результат Цикл  
		
		СтруктурироватьЦены(ТекСтрока); 
		
		Если ТекСтрока.Получить("PRODUCT_GROUP") = Неопределено Тогда
			Если ТекСтрока.Получить("COMMERCIAL_PRODUCT") <> Неопределено Тогда
				ТекСтрока.Вставить("PRODUCT_GROUP", ТекСтрока.Получить("COMMERCIAL_PRODUCT"));		
			Иначе 
				ТекСтрока.Вставить("PRODUCT_GROUP", "empty_prod_group");	
			КонецЕсли;
		КонецЕсли;

		ТЗШапка = ПолучитьШапкуНоменклатуры(текСтрока); 
		
		СтрокаШапка = ТЗШапка[0];
		СпрСсылка 			   			  = СтрокаШапка.Номенклатура;
		СпрНоменклатураСтранаПроизводства = СтрокаШапка.СтранаПроизводства;
		СпрНоменклатурныеЦвета 			  = СтрокаШапка.НоменклатурныйЦвет;
		СпрНоменклатураСоставТкани		  = СтрокаШапка.СоставТкани;
		СпрНоменклатураТипТовара		  = СтрокаШапка.ТипТовара;
		ВидНоменклатуры					  = СтрокаШапка.ВидНоменклатуры;
		СпрПол							  = СтрокаШапка.НоменклатурныйПол;
		СпрСезоныКоллекции				  = СтрокаШапка.СезонКоллекции;
		СпрMopDivision					  = СтрокаШапка.MopDivision;
		СпрMopDepartment                  = СтрокаШапка.MopDepartment;
		СпрMopSubDepartment				  = СтрокаШапка.MopSubDepartment;
		СпрMopCategory					  = СтрокаШапка.MopCategory;
		СпрMopClass						  = СтрокаШапка.MopClass;
		СпрТипСезона					  = СтрокаШапка.ТипыСезонов; 
		
		Артикул = текСтрока.Получить("productCode") + ТекСтрока.Получить("colorCode");
		СпрОбъект = Неопределено;
		
		Сообщить("Создаем или меняем артикул - " + Артикул);
		
		Если ЗначениеЗаполнено(СпрСсылка) Тогда 
			СпрОбъект = СпрСсылка.ПолучитьОбъект();
		Иначе
			СпрОбъект = Справочники.Номенклатура.СоздатьЭлемент();
		КонецЕсли;

		СпрОбъект.PictureUrl = ТекСтрока.Получить("photoURL");

		Если НЕ ЗначениеЗаполнено(СпрНоменклатурныеЦвета) Тогда 
			СпрНоменклатурныеЦвета = НайтиСоздатьСправочники(текСтрока.Получить("colorCode"), текСтрока.Получить("colorDesc"), "НоменклатурныеЦвета");
		Иначе
			Если Обновить Тогда 
				ОбновитьСправочники(текСтрока.Получить("colorCode"), текСтрока.Получить("colorDesc"), СпрНоменклатурныеЦвета);
			КонецЕсли;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СпрНоменклатураСоставТкани) Тогда 
			СпрНоменклатураСоставТкани = НайтиСоздатьСправочники(текСтрока.Получить("productCode"), текСтрока.Получить("FABRIC_AND_MATERIAL"), "НоменклатурныйСоставыТкани");
		Иначе 
			Если Обновить Тогда 
				ОбновитьСправочники(текСтрока.Получить("productCode"), текСтрока.Получить("FABRIC_AND_MATERIAL"), СпрНоменклатураСоставТкани);
			КонецЕсли;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СпрНоменклатураСтранаПроизводства) Тогда 
			СпрНоменклатураСтранаПроизводства = НайтиСоздатьСправочникиМОП(текСтрока.Получить("ORIGIN"), "НоменклатурныеСтраныПроизводства");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СпрНоменклатураТипТовара) Тогда 
			СпрНоменклатураТипТовара = НайтиСоздатьСправочники(текСтрока.Получить("PRODUCT_GROUP"), текСтрока.Получить("PRODUCT_GROUP"), "НоменклатурныеТипыТовара"); 
		Иначе 
			Если Обновить Тогда 
				ОбновитьСправочники(текСтрока.Получить("PRODUCT_GROUP"), текСтрока.Получить("PRODUCT_GROUP"), СпрНоменклатураТипТовара);
			КонецЕсли;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ВидНоменклатуры) Тогда 
			ВидНоменклатуры 	  = НайтиСоздатьВидНоменклатуры(текСтрока.Получить("PRODUCT_GROUP"), текСтрока.Получить("PRODUCT_GROUP"));
		Иначе 
			Если Обновить Тогда 
				ОбновитьНаименованиеСправочника(ВидНоменклатуры, текСтрока.Получить("PRODUCT_GROUP"));
			КонецЕсли;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СпрСезоныКоллекции) Тогда 
			СпрСезоны = НайтиСоздатьСправочникиМОП(текСтрока.Получить("FIRST_SALE_SEASON"), "НоменклатурныеСезоныКоллекции");
		КонецЕсли;  
		Если НЕ ЗначениеЗаполнено(СпрТипСезона) Тогда 
			СпрСезоны = НайтиСоздатьСправочникиМОП(текСтрока.Получить("seasonDesc"), "НоменклатурныеТипыСезонов");
		КонецЕсли;  
		
		Если Не ЗначениеЗаполнено(СпрПол) Тогда
			СпрПол = НайтиСоздатьСправочникиМОП(текСтрока.Получить("GENDER"), "НоменклатурныйПол");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СпрMopDivision) Тогда
			СпрMopDivision = НайтиСоздатьСправочникиМОП(текСтрока.Получить("productHierarchyLevel01"), "MopDivision");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СпрMopDepartment) Тогда 
			СпрMopDepartment = НайтиСоздатьСправочникиМОП(текСтрока.Получить("productHierarchyLevel02"), "MopDepartment");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СпрMopSubDepartment) Тогда 
			СпрMopSubDepartment = НайтиСоздатьСправочникиМОП(текСтрока.Получить("productHierarchyLevel03"), "MopSubDepartment");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СпрMopCategory) Тогда 
			СпрMopCategory = НайтиСоздатьСправочникиМОП(текСтрока.Получить("CATEGORY"), "MopCategory");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СпрMopClass) Тогда 
			СпрMopClass = НайтиСоздатьСправочникиМОП(текСтрока.Получить("PRODUCT_GROUP"), "MopClass");
		КонецЕсли;
		СпрОбъект.Артикул 			 = Артикул;
		СпрОбъект.Модель  			 = текСтрока.Получить("productCode");
		СпрОбъект.MopCategory 		 = СпрMopCategory.Наименование;
		СпрОбъект._MopCategory		 = СпрMopCategory;
		СпрОбъект.MopClass    		 = СпрMopClass.Наименование;
		СпрОбъект._MopClass			 = СпрMopClass;
		СпрОбъект.MopDepartment 	 = СпрMopDepartment.Наименование;
		СпрОбъект._MopDepartment	 = СпрMopDepartment;
		СпрОбъект.MopDivision 		 = СпрMopDivision.Наименование;
		СпрОбъект._MopDivision		 = СпрMopDivision;
		СпрОбъект.MopSubDepartment 	 = СпрMopSubDepartment.Наименование;
		СпрОбъект._MopSubDepartment  = СпрMopSubDepartment;
		СпрОбъект.Цвет 				 = СпрНоменклатурныеЦвета;
		СпрОбъект.СтранаПроизводства = СпрНоменклатураСтранаПроизводства;
		СпрОбъект.ТипТовара 		 = СпрНоменклатураТипТовара;
		СпрОбъект.СезонКоллекции 	 = СпрСезоныКоллекции;
		СпрОбъект.КодМоделя 		 = ТекСтрока.Получить("Model");
		СпрОбъект.ТипСезона 		 = СпрТипСезона;
		СпрОбъект.СоставТкани 		 = СпрНоменклатураСоставТкани;
		СпрОбъект.Пол				 = СпрПол;
		//СпрОбъект.PictureUrl		 = текСтрока.Получить("PictureUrl");
		СпрОбъект.ТипНоменклатуры    = Перечисления.ТипыНоменклатуры.Товар;
		СпрОбъект.ВидНоменклатуры	 = ВидНоменклатуры;
		СпрОбъект.ЕдиницаИзмерения   = Справочники.БазовыеЕдиницыИзмерения.НайтиПоКоду("796");;
		СпрОбъект.Марка				 = Справочники.Марки.НайтиПоКоду("000-00001");;
		СпрОбъект.СтавкиНДС.Очистить();
		НайденныеСтавкиНДС = СпрОбъект.СтавкиНДС.НайтиСтроки(Новый Структура("Страна,СтавкаНДС", Справочники.Страны.НайтиПоКоду("12"), Перечисления.СтавкиНДС.НДС16));
		
		Если НайденныеСтавкиНДС.Количество() = 0 Тогда
			ДобСтавка = СпрОбъект.СтавкиНДС.Добавить();
			ДобСтавка.СтавкаНДС =  Перечисления.СтавкиНДС.НДС16;
			ДобСтавка.Страна = Справочники.Страны.НайтиПоКоду("12");
		КонецЕсли;
		
		НаименованиеEN = ТекСтрока.Получить("productDesc");
		НаименованиеTR = ТекСтрока.Получить("productDesc");
		Наименование = ?(НаименованиеEN <> "", НаименованиеEN, НаименованиеTR); 
		Наименование = Наименование + " " + ТекСтрока.Получить("colorDesc");
		
		СпрОбъект.Наименование = Наименование;
		СпрОбъект.НаименованиеПолное = СтрЗаменить(СокрЛП(СпрОбъект.Наименование),Символы.НПП,"");
		СпрОбъект.Наименование = СтрЗаменить(СокрЛП(СпрОбъект.Наименование),Символы.НПП,"");
		
		НачатьТранзакцию();
		
		Попытка
			СпрОбъект.ДополнительныеСвойства.Вставить("ЗарегистрироватьДляОбмена", Истина);
			СпрОбъект.Записать();  
			
			СоотШтрих = Новый Соответствие;
			
			СоотШтрих.Вставить("Barcode", ТекСтрока.Получить("barcode"));
			СоотШтрих.Вставить("Size", ТекСтрока.Получить("itemDim1Code"));
			СоотШтрих.Вставить("SizeDescr", ?(ТекСтрока.Получить("itemDim1Desc")= "",ТекСтрока.Получить("itemDim1Code"),ТекСтрока.Получить("itemDim1Desc")));
			СоотШтрих.Вставить("SizeAndAge", ТекСтрока.Получить("AGE_AND_SIZE"));
			
			МассивХаракШтрих = Новый Массив;
			МассивХаракШтрих.Добавить(СоотШтрих);
			
			СоздалиШтрихкоды = СоздатьШтрихкоды(СпрОбъект.Ссылка, МассивХаракШтрих);
			
			Если ТекСтрока.Получить("CATEGORY") = "Footwear" Тогда
				СоздатьОбновитьДополнительныеРеквизиты(СпрОбъект.Ссылка);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			ЗаписатьВЖурналРегистра(ПараметрыИсточника, Артикул, Истина);
			
		Исключение
			ОтменитьТранзакцию();
			Сообщить(ОписаниеОшибки());
			ЗаписатьВЖурналРегистра(ПараметрыИсточника, Артикул, Ложь, ОписаниеОшибки());
		КонецПопытки; 
		
		ПолучитьПереводКарточек(СпрОбъект, "RU");
		ПолучитьПереводКарточек(СпрОбъект, "KZ");

	КонецЦикла;

КонецФункции

