Функция ПолучитьВалюту(Страна, КодВалюты)
	
	Если НЕ ЗначениеЗаполнено(Страна.ВалютаРегламентированногоУчета) Тогда 
		Возврат КодВалюты;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Страна", Страна);
	Запрос.УстановитьПараметр("Код", КодВалюты);
	Запрос.Текст = "ВЫБРАТЬ
	               |	рм_Валюты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.рм_Валюты КАК рм_Валюты
	               |ГДЕ
	               |	рм_Валюты.Наименование = &Код
	               |	И НЕ рм_Валюты.ПометкаУдаления
	               |	И рм_Валюты.Страна = &Страна";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Ссылка;
	Иначе 
		Возврат КодВалюты;
	КонецЕсли;
	
КонецФункции

Функция ОдобритьПоступления(ЗаголовокДокумента, ПараметрИсточник) 
	
	ДополнительныеПараметры = ПолучитьДопПараметры();
	
	Ответ = КоннекторHTTP.PostJson(ВнешняяСистема.URL + "/api/Warehouse/LockDocByHeaderID?headerID=" + ЗаголовокДокумента, , ДополнительныеПараметры);
	
	Если Ответ.Получить("success") = Истина Тогда
		ЗаписатьВЖурналРегистра(ПараметрИсточник, ЗаголовокДокумента, Истина, "Approved!");
	Иначе
		ЗаписатьВЖурналРегистра(ПараметрИсточник, ЗаголовокДокумента, Ложь, ВывестиЖейсонКакСтроку(Ответ));
	КонецЕсли;

КонецФункции

Функция ПолучитьКонтрагентаПоИНН(ИННПоиска)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Контрагент
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И НЕ Контрагенты.ЭтоГруппа
	|	И Контрагенты.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ИНН", ИННПоиска);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		НайденныйКонтрагент = Выборка.Контрагент;
	Иначе
		НайденныйКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;	
	
	Возврат НайденныйКонтрагент;
КонецФункции
