Процедура ПолучитьЦеныПоПоступлениям(Поступления, ВидЦены) Экспорт   
	
	ДополнительныеПараметры = ПолучитьДопПараметры();

	Результат = ПолучитьЦеныПоступления(Поступления, ВидЦены);
	
	МассивЦен = Новый Массив();
	
	Если Результат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ТекСтрока ИЗ Результат Цикл 
		
		Ответ = КоннекторHTTP.GetJson(ВнешняяСистема.URL + "/api/Products/GetProductPrices?PriceGroupCodes=" + ВидЦены.КодИсточника + "&Barcode=" + ТекСтрока.Штрихкод, , ДополнительныеПараметры);
		
		Если ТипЗнч(Ответ) = Тип("Соответствие") Тогда
			Если Ответ.Получить("success") Тогда 
				data = Ответ.Получить("data");
				Если ТипЗнч(data) = Тип("Массив") И data.Количество() > 0 Тогда
					МассивЦен.Добавить(data[0]);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;  
	
	data = Новый Соответствие;
	data.Вставить("priceListHeaderID", "1");
	data.Вставить("priceListNumber", Поступления.НомерПоставки + "_" + ВидЦены.КодИсточника);
	data.Вставить("validDate", СтрЗаменить("" + День(Поступления.Дата) + "." + Месяц(Поступления.Дата) + "." + Год(Поступления.Дата), ",", ""));
	data.Вставить("validTime", "" + Час(Поступления.Дата) + ":" + Минута(Поступления.Дата) + ":" + Секунда(Поступления.Дата));
	data.Вставить("lines", МассивЦен);
	
	МассивВсехЦен = Новый Массив;
	МассивВсехЦен.Добавить(data);
	
	СоотТоваровДляЦены = Новый Соответствие;
	СоотТоваровДляЦены.Вставить("data", МассивВсехЦен);
	
	СоздатьЦеныНоменклатуры(ВидЦены, СоотТоваровДляЦены, , Ложь);

КонецПроцедуры

Функция ПолучитьЦеныПоступления(Поступления, ВидЦены) 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Поступления);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены.КодИсточника);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоступлениеТоваров.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ Вт_НеСозданныеЦеныПоПоступлениям
	               |ИЗ
	               |	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
	               |		ПО (УстановкаЦенНоменклатуры.НомерИсточника = ПоступлениеТоваров.НомерПоставки + ""_"" + &ВидЦены)
	               |ГДЕ
	               |	ПоступлениеТоваров.Ссылка = &Ссылка
	               |	И УстановкаЦенНоменклатуры.Ссылка ЕСТЬ NULL
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоступлениеТоваровТовары.Номенклатура.Модель КАК НоменклатураМодель
	               |ПОМЕСТИТЬ Вт_Поступления
	               |ИЗ
	               |	Вт_НеСозданныеЦеныПоПоступлениям КАК Вт_НеСозданныеЦеныПоПоступлениям
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
	               |		ПО Вт_НеСозданныеЦеныПоПоступлениям.Ссылка = ПоступлениеТоваровТовары.Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПоступлениеТоваровТовары.Номенклатура.Модель
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(Штрихкоды.Штрихкод) КАК Штрихкод,
	               |	Штрихкоды.Владелец.Модель КАК ВладелецМодель
	               |ПОМЕСТИТЬ Вт_Штрихкоды
	               |ИЗ
	               |	РегистрСведений.Штрихкоды КАК Штрихкоды
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Штрихкоды.Владелец.Модель
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Вт_Штрихкоды.Штрихкод КАК Штрихкод,
	               |	Вт_Штрихкоды.ВладелецМодель КАК ВладелецМодель
	               |ИЗ
	               |	Вт_Поступления КАК Вт_Поступления
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Вт_Штрихкоды КАК Вт_Штрихкоды
	               |		ПО Вт_Поступления.НоменклатураМодель = Вт_Штрихкоды.ВладелецМодель";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти


#Область SEND_GOODS_ACCEPTANCE

Функция ПолучитьПриемкиТоваровИзОбмена()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Узел", ПланыОбмена.СерверИнтеграции.ПолучитьУзел());
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПриходныйОрдерНаТовары.Дата КАК Дата,
	               |	ПриходныйОрдерНаТовары.Ссылка КАК Ссылка,
	               |	ПриходныйОрдерНаТовары.ДокументОснование.ПредставлениеДокументаОснования КАК ДокументОснованиеПредставлениеДокументаОснования,
	               |	ПеремещениеТоваров.Ссылка КАК Ссылка1
	               |ПОМЕСТИТЬ Вт_ПриемкиТоваров
	               |ИЗ
	               |	Документ.ПриходныйОрдерНаТовары.Изменения КАК ПриходныйОрдерНаТоварыИзменения
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходныйОрдерНаТовары КАК ПриходныйОрдерНаТовары
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
	               |			ПО ПриходныйОрдерНаТовары.ДокументОснование = ПеремещениеТоваров.Ссылка
	               |		ПО ПриходныйОрдерНаТоварыИзменения.Ссылка = ПриходныйОрдерНаТовары.Ссылка
	               |ГДЕ
	               |	ПриходныйОрдерНаТоварыИзменения.Узел = &Узел
	               |	И ПриходныйОрдерНаТовары.Проведен = ИСТИНА
	               |	И ПриходныйОрдерНаТовары.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(Штрихкоды.Штрихкод) КАК Штрихкод,
	               |	Штрихкоды.Характеристика КАК Характеристика,
	               |	Штрихкоды.Владелец КАК Владелец
	               |ПОМЕСТИТЬ Вт_Штрихкод
	               |ИЗ
	               |	РегистрСведений.Штрихкоды КАК Штрихкоды
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Штрихкоды.Характеристика,
	               |	Штрихкоды.Владелец
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Вт_ПриемкиТоваров.Дата КАК Дата,
	               |	Вт_ПриемкиТоваров.Ссылка КАК Ссылка,
	               |	Вт_ПриемкиТоваров.ДокументОснованиеПредставлениеДокументаОснования КАК ЗаголовокДокумента
	               |ИЗ
	               |	Вт_ПриемкиТоваров КАК Вт_ПриемкиТоваров
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Вт_Штрихкод.Штрихкод КАК Штрихкод,
	               |	Вт_ПриемкиТоваров.Ссылка КАК Ссылка,
	               |	ПеремещениеТоваровДеталиТовары.Номенклатура КАК Номенклатура,
	               |	ПеремещениеТоваровДеталиТовары.Характеристика КАК Характеристика,
	               |	СУММА(ПеремещениеТоваровДеталиТовары.ФактическоеКоличество) КАК Количество
	               |ИЗ
	               |	Документ.ПеремещениеТоваровДетали.Товары КАК ПеремещениеТоваровДеталиТовары
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Вт_Штрихкод КАК Вт_Штрихкод
	               |		ПО ПеремещениеТоваровДеталиТовары.Номенклатура = Вт_Штрихкод.Владелец
	               |			И ПеремещениеТоваровДеталиТовары.Характеристика = Вт_Штрихкод.Характеристика
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Вт_ПриемкиТоваров КАК Вт_ПриемкиТоваров
	               |		ПО ПеремещениеТоваровДеталиТовары.Ссылка.ДокументОснование = Вт_ПриемкиТоваров.Ссылка1
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Вт_Штрихкод.Штрихкод,
	               |	Вт_ПриемкиТоваров.Ссылка,
	               |	ПеремещениеТоваровДеталиТовары.Номенклатура,
	               |	ПеремещениеТоваровДеталиТовары.Характеристика";
	
	Возврат Запрос.ВыполнитьПакет();

КонецФункции                         

Процедура ОтправитьПриемкиТоваров() Экспорт
	
	Пакет = ПолучитьПриемкиТоваровИзОбмена();
	ДополнительныеПараметры = ПолучитьДопПараметры();
	ДокументПриемка = Пакет[2].Выгрузить();
	Товары = Пакет[3].Выгрузить();
	Параметры = ПолучитьПараметрИсточника("SEND_ACCEPTANCE");
	
	Для Каждого ТекПриемка Из ДокументПриемка Цикл 
		
		СтрКОтправке = Новый Структура;
		СтрКОтправке.Вставить("modelType", 0);
		СтрКОтправке.Вставить("processCode", "S");
		СтрКОтправке.Вставить("HeaderID", ТекПриемка.ЗаголовокДокумента);
		СтрКОтправке.Вставить("OperationDate", Формат(ТекПриемка.Дата, "ДФ=yyyy-MM-dd"));
		СтрКОтправке.Вставить("OperationTime", "13:55");
		СтрКОтправке.Вставить("OperationLocationCode", "07901X"); 
		СтрКОтправке.Вставить("continueSavedTransferApprove", Ложь);
		СтрКОтправке.Вставить("continueForOverStock", Истина);
		
		// Отбираем строки только текущей приемки
		НайденныеДанные = Товары.НайтиСтроки(Новый Структура("Ссылка", ТекПриемка.Ссылка));
		МассивТоваров = Новый Массив;
		
		Для Каждого ТекТовар Из НайденныеДанные Цикл 
			
			Если ТекТовар.Количество > 0 Тогда
				СтрТовары = Новый Структура;
				СтрТовары.Вставить("customKey", ТекТовар.Штрихкод); 
				СтрТовары.Вставить("incomingQty", ТекТовар.Количество);
				МассивТоваров.Добавить(СтрТовары);
			КонецЕсли;
			
		КонецЦикла;
		
		Если МассивТоваров.Количество() > 0 Тогда
			
			СтрКОтправке.Вставить("continueSavedTransferApprove", Истина);
			СтрКОтправке.Вставить("lines", МассивТоваров);
			
			Ответ = КоннекторHTTP.PostJson(ВнешняяСистема.URL + "/api/Warehouse/StoreGoodsReceiptApproval", СтрКОтправке, ДополнительныеПараметры); 
			
			Если ТипЗнч(Ответ) = Тип("Соответствие") Тогда
				Если Ответ.Получить("success") И Ответ.Получить("message") = "Messages.Success" Тогда
					ПланыОбмена.УдалитьРегистрациюИзменений(ПланыОбмена.СерверИнтеграции.ПолучитьУзел(), ТекПриемка.Ссылка);
					ЗаписатьВЖурналРегистра(Параметры, ТекПриемка.ЗаголовокДокумента, Истина);
				Иначе
					ЗаписатьВЖурналРегистра(Параметры, ТекПриемка.ЗаголовокДокумента, Ложь, ВывестиЖейсонКакСтроку(Ответ));
				КонецЕсли;
			Иначе 
				ЗаписатьВЖурналРегистра(Параметры, ТекПриемка.ЗаголовокДокумента, Ложь, ВывестиЖейсонКакСтроку(Ответ));
			КонецЕсли;
			
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

