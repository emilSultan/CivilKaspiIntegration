Функция ПолучитьВсеВидыЦен()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Страна", ПолучитьКазахстан());
	Запрос.Текст = "ВЫБРАТЬ
	|	ВидыЦен.Ссылка КАК Ссылка,
	|	ВидыЦен.КодИсточника КАК КодИсточника,
	|	ВидыЦен.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ВидыЦен КАК ВидыЦен
	|ГДЕ
	|	ВидыЦен.Страна = &Страна";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ОтсортироватьМассивЦен(МассивЦен)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("PriceListDate");
	Таблица.Колонки.Добавить("Структура");
	
	Для каждого Элемент Из МассивЦен Цикл
		СтрокаТЗ = Таблица.Добавить();
		СтрокаТЗ.PriceListDate = ПолучитьДатуПоСтрокам(Элемент["validDate"],Элемент["validTime"]);
		СтрокаТЗ.Структура     = Элемент;
	КонецЦикла;
	
	Таблица.Сортировать("PriceListDate Возр");
	Массив = Таблица.ВыгрузитьКолонку("Структура");
	
	Возврат Массив;
	
КонецФункции

Функция ПолучитьЦенуПоНомеруИсточникаИПоВидуЦен(НомерИсточника, ВидЦены, ПоМагазину)
	
	Запрос = Новый Запрос();
	
	Если ПоМагазину Тогда
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	УстановкаЦенНоменклатурыПоМагазинам.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.УстановкаЦенНоменклатурыПоМагазинам КАК УстановкаЦенНоменклатурыПоМагазинам
		               |ГДЕ
		               |	УстановкаЦенНоменклатурыПоМагазинам.Проведен
		               |	И УстановкаЦенНоменклатурыПоМагазинам.НомерИсточника = &НомерИсточника
		               |	И УстановкаЦенНоменклатурыПоМагазинам.ВидЦены = &ВидЦены";
		
		Запрос.УстановитьПараметр("ВидЦены",        ВидЦены);
		Запрос.УстановитьПараметр("НомерИсточника", НомерИсточника); 
		
		Выборка = Запрос.Выполнить().Выбрать();
		
	Иначе 
		
		Запрос.УстановитьПараметр("ВидЦены",        ВидЦены);
		Запрос.УстановитьПараметр("НомерИсточника", НомерИсточника); 
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УстановкаЦенНоменклатурыВидыЦен.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.УстановкаЦенНоменклатуры.ВидыЦен КАК УстановкаЦенНоменклатурыВидыЦен
		|ГДЕ
		|	УстановкаЦенНоменклатурыВидыЦен.Ссылка.НомерИсточника = &НомерИсточника
		|	И УстановкаЦенНоменклатурыВидыЦен.ВидЦены = &ВидЦены
		|	И УстановкаЦенНоменклатурыВидыЦен.Ссылка.Проведен";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			Возврат Выборка.Ссылка;
		Иначе 
			Возврат Неопределено;
		КонецЕсли; 
		
	КонецЕсли;
	
КонецФункции

Функция СтруктурироватьЦены(ТекСтрока) 

	Сообщить(Тип(ТекСтрока));
	
	Для Каждого ТекАттриб Из ТекСтрока.Получить("attributes") Цикл 
		
		Если ТекАттриб.Получить("attributeTypeDesc") = "PRODUCT GROUP" Тогда      // 1
			ТекСтрока.Вставить("PRODUCT_GROUP", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли;
		
		Если ТекАттриб.Получить("attributeTypeDesc") = "BRAND" Тогда           
			ТекСтрока.Вставить("BRAND", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли;
		
		Если ТекАттриб.Получить("attributeTypeDesc") = "Model" Тогда
			ТекСтрока.Вставить("Model", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли; 
		
		Если ТекАттриб.Получить("attributeTypeDesc") = "FIRST SALE SEASON" Тогда
			ТекСтрока.Вставить("FIRST_SALE_SEASON", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли;
		
		Если ТекАттриб.Получить("attributeTypeDesc") = "AGE AND SIZE" Тогда
			ТекСтрока.Вставить("AGE_AND_SIZE", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли;                                                      
		
		Если ТекАттриб.Получить("attributeTypeDesc") = "FABRIC AND MATERIAL" Тогда
			ТекСтрока.Вставить("FABRIC_AND_MATERIAL", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли;                                                      

		Если ТекАттриб.Получить("attributeTypeDesc") = "SUPPLIER" Тогда
			ТекСтрока.Вставить("SUPPLIER", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли;
		
		Если ТекАттриб.Получить("attributeTypeDesc") = "ORIGIN" Тогда
			ТекСтрока.Вставить("ORIGIN", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли; 
		
		Если ТекАттриб.Получить("attributeTypeDesc") = "B2B" Тогда
			ТекСтрока.Вставить("B2B", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли; 
		
		Если ТекАттриб.Получить("attributeTypeDesc") = "CATEGORY" Тогда
			ТекСтрока.Вставить("CATEGORY", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли;                                
		
		Если ТекАттриб.Получить("attributeTypeDesc") = "NUMBER OF PIECES" Тогда
			ТекСтрока.Вставить("NUMBER_OF_PIECES", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли;                                

		Если ТекАттриб.Получить("attributeTypeDesc") = "GENDER" Тогда
			ТекСтрока.Вставить("GENDER", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли;
		
		Если ТекАттриб.Получить("attributeTypeDesc") = "PURCHASE CATEGORY" Тогда
			ТекСтрока.Вставить("PURCHASE_CATEGORY", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли;
		
		Если ТекАттриб.Получить("attributeTypeDesc") = "CURRENT SALE SEASON" Тогда
			ТекСтрока.Вставить("CURRENT_SALE_SEASON", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли;
		
		Если ТекАттриб.Получить("attributeTypeDesc") = "COMMERCIAL PRODUCT" Тогда
			ТекСтрока.Вставить("COMMERCIAL_PRODUCT", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли;
		
		Если ТекАттриб.Получить("attributeTypeDesc") = "SHELF" Тогда
			ТекСтрока.Вставить("SHELF", ТекАттриб.Получить("attributeDesc"));
		КонецЕсли; 
		
	КонецЦикла;
	ТекСтрока.Удалить("attributes");
	
КонецФункции

Процедура ПолучитьЦены() Экспорт
	
	ПараметрИсточник = ПолучитьПараметрИсточника("GET_PRICES"); 
	ВидыЦен = ПолучитьВсеВидыЦен(); 
	ДополнительныеПараметры = ПолучитьДопПараметры();
	
	Для Каждого ВидЦены Из ВидыЦен Цикл 
		Ответ = КоннекторHTTP.GetJson(ВнешняяСистема.URL + "/api/Products/GetPriceListNumberByCodes?priceGroupCode=" + ВидЦены.КодИсточника, ,ДополнительныеПараметры);
		Если ТипЗнч(Ответ) = Тип("Соответствие") Тогда
			Если Ответ.Получить("success") ТОгда
				СтруктураОтправленныхДанных = ОтсортироватьМассивЦен(Ответ.Получить("data"));
				//Сообщить(ВывестиЖейсонКакСтроку(СтруктураОтправленныхДанных));
				
				Для Каждого ТекСтрока Из СтруктураОтправленныхДанных Цикл 
					
					
					//Сообщить("Находим прайслист номер" + ТекСтрока.Получить("priceListNumber"));
					
					НомерДокумента  = ТекСтрока.Получить("priceListNumber");
					КодВидЦены      = ТекСтрока.Получить("priceGroupCode");
					Идентификатор   = "" + НомерДокумента + "_" + КодВидЦены;
					ВидЦеныДокумента = Справочники.ВидыЦен.НайтиПоРеквизиту("КодИсточника", СокрЛП(КодВидЦены));
					
					Если НЕ ЗначениеЗаполнено(ВидЦеныДокумента) Тогда 
						ЗаписатьВЖурналРегистра(ПараметрИсточник, Идентификатор, Ложь, 
						СтрШаблон("PriceType(ВидЦены) not found:%1", КодВидЦены));
						Продолжить;
					КонецЕсли;
					
					ЕстьЦена = ПолучитьЦенуПоНомеруИсточникаИПоВидуЦен(НомерДокумента, ВидЦеныДокумента,ложь);
					
					Если ЕстьЦена <> Неопределено Тогда 
						Сообщить("Такая цена уже есть");
						Одобрить_Цены(ТекСтрока.Получить("priceListHeaderID"), ДополнительныеПараметры, ПараметрИсточник, Идентификатор);
						Продолжить;
					КонецЕсли;
					
					Ответ2 = КоннекторHTTP.GetJson(ВнешняяСистема.URL + "/api/Products/GetPriceByListNumber?PriceListNumber=" + НомерДокумента, ,ДополнительныеПараметры);
					
					//Сообщить(ВывестиЖейсонКакСтроку(Ответ2));
					
					Если Ответ2.Получить("success") Тогда
						Сообщить("Заходит правильно");
						
						Результат = СоздатьЦеныНоменклатуры(ВидЦеныДокумента,  Ответ2, ,Ложь);
						
						//Сообщить(Результат);
						
						Если ТипЗнч(Результат) = Тип("ДокументСсылка.УстановкаЦенНоменклатуры")
							Или ТипЗнч(Результат) = Тип("ДокументСсылка.УстановкаЦенНоменклатурыПоМагазинам")  Тогда 
							Одобрить_Цены(ТекСтрока.Получить("priceListHeaderID"), ДополнительныеПараметры, ПараметрИсточник, Идентификатор);
							
						Иначе
							Если ТипЗнч(Результат) = Тип("Соответствие") Тогда 
								ТекстОшибки = Результат.Получить("ERROR_CODE");
								ТекстОписаниеОшибки = Результат.Получить("DESC");
								Если ТекстОписаниеОшибки = Неопределено Тогда 
									ТекстОписаниеОшибки = "";
								КонецЕсли; 
								
								ЗаписатьВЖурналРегистра(ПараметрИсточник, Идентификатор, Ложь, ТекстОшибки + ТекстОписаниеОшибки);
						
								//Одобрить_Цены(ТекСтрока.Получить("priceListHeaderID"), КодВидЦены, ПараметрИсточник, Идентификатор);
							Иначе 
								ЗаписатьВЖурналРегистра(ПараметрИсточник, Идентификатор, Ложь, Результат);
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла; 
				
			Иначе
				ЗаписатьВЖурналРегистра(ПараметрИсточник, "SERVICE", Ложь,"Получили ошибку по адресу - /api/Products/GetPriceListNumberByCodes");
			КонецЕсли;
		Иначе
			ЗаписатьВЖурналРегистра(ПараметрИсточник, "SERVICE", Ложь,"Не получили структуру цен по адресу - /api/Products/GetPriceListNumberByCodes");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры 

Функция ПолучитьТаблицуЗначениеЦен(ПоМагазину)
	
	ТаблицуДанныхЦен = Новый ТаблицаЗначений;
	ТаблицуДанныхЦен.Колонки.Добавить("Модель", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ТаблицуДанныхЦен.Колонки.Добавить("Цена",	 ОбщегоНазначенияРТКлиентСервер.ПолучитьОписаниеТиповЧисла(15, 4));
	Если ПоМагазину Тогда 
		ТаблицуДанныхЦен.Колонки.Добавить("КодМагазина", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	КонецЕсли;	
	
	Возврат ТаблицуДанныхЦен;
	
КонецФункции

Функция ПолучитьТаблицуЦен(МассиЦен, ПоМагазинам = Ложь)
	
	ТаблицаДанныхЦен = ПолучитьТаблицуЗначениеЦен(ПоМагазинам);
	Если МассиЦен.Количество() = 0 Тогда 
		Возврат ТаблицаДанныхЦен;
	КонецЕсли;
	
	Для Каждого ТекСтрока ИЗ МассиЦен Цикл 
		
		НовСтрока = ТаблицаДанныхЦен.Добавить();
		НовСтрока.Модель = СокрЛП(ТекСтрока.Получить("itemCode"));
		НовСтрока.Цена    = ТекСтрока.Получить("price");
		Если ПоМагазинам Тогда 
			НовСтрока.КодМагазина = СокрЛП(ТекСтрока.Получить("StoreCode"));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДанныхЦен;
	
КонецФункции

Функция СоздатьОтсутствущиеНоменклатурыПоступления(ТаблицаТоваров, HТТPСоединение = Неопределено)
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаАртикулов.Модель КАК Модель,
	               |	ТаблицаАртикулов.Артикул КАК Артикул
	               |ПОМЕСТИТЬ ТемпАртикулы
	               |ИЗ
	               |	&ТаблицаАртикулов КАК ТаблицаАртикулов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТемпАртикулы.Модель КАК Модель
	               |ИЗ
	               |	ТемпАртикулы КАК ТемпАртикулы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	               |		ПО ТемпАртикулы.Артикул = Номенклатура.Артикул
	               |ГДЕ
	               |	Номенклатура.Ссылка ЕСТЬ NULL
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТемпАртикулы.Модель";
	
	Запрос.УстановитьПараметр("ТаблицаАртикулов", ТаблицаТоваров);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Сообщить("Количество не найденных товаров" + Результат.Количество());
	
	Для Каждого ТекСтрока Из Результат Цикл 
		
		Ок = СоздатьНоменклатуруПоМодели(ТекСтрока.Модель);
		
		Если ТипЗнч(Ок) = Тип("Строка") Тогда 
		    Возврат Ок + " " + ТекСтрока.Модель;
		ИначеЕсли ТипЗнч(Ок) = Тип("Соответствие") Тогда 
			Ок.Вставить("DESC", ТекСтрока.Модель);
			Возврат Ок;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция СоздатьОтсутствущиеНоменклатуры(ТаблицаТоваров, HТТPСоединение = Неопределено)
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаАртикулов.Модель КАК Модель
	               |ПОМЕСТИТЬ ТемпАртикулы
	               |ИЗ
	               |	&ТаблицаАртикулов КАК ТаблицаАртикулов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТемпАртикулы.Модель КАК Модель
	               |ИЗ
	               |	ТемпАртикулы КАК ТемпАртикулы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	               |		ПО ТемпАртикулы.Модель = Номенклатура.Модель
	               |ГДЕ
	               |	Номенклатура.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ТаблицаАртикулов", ТаблицаТоваров);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Сообщить("Количество не найденных товаров" + Результат.Количество());
	
	Для Каждого ТекСтрока Из Результат Цикл 
		
		Ок = СоздатьНоменклатуруПоМодели(ТекСтрока.Модель);

	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДатуПоСтрокам(СтрокаДата, СтрокаВремя) 

	МасДата		= СтрРазделить(СтрокаДата,".");
	МасВремя	= СтрРазделить(СтрокаВремя,":");
	Попытка
		Возврат Дата(МасДата[2],МасДата[1],МасДата[0],МасВремя[0],МасВремя[1],МасВремя[2]);
	Исключение
		Возврат Дата(1,1,1);
	КонецПопытки;

КонецФункции

Функция СоздатьЦеныНоменклатуры(ВидЦены, МассивЦенТоваров, HТТPСоединение = Неопределено, ПоМагазину = Ложь)
	
	МассивЦенТоваров = МассивЦенТоваров.Получить("data"); 
	
	ДатаДокументаСтрока = ПолучитьДатуПоСтрокам(МассивЦенТоваров[0].Получить("validDate"),МассивЦенТоваров[0].Получить("validTime"));
	НомерДокумента      = МассивЦенТоваров[0].Получить("priceListNumber");
	ДатаОкончанияСтрока	= ПолучитьДатуПоСтрокам(МассивЦенТоваров[0].Получить("disableDate"), "00:00:00");

	Попытка
		ДатаДокумента = ДатаДокументаСтрока;
		ДатаОкончания = ДатаОкончанияСтрока;
		ДатаДокумента = НачалоДня(ДатаДокумента) + Минута(ТекущаяДатаСеанса())*60 + Секунда(ТекущаяДатаСеанса());
	Исключение
		СоответствиеОшибки = Новый Соответствие;
		СоответствиеОшибки.Вставить("ERROR_CODE", "INVALID_DATE_FORMAT");
		Возврат СоответствиеОшибки;
	КонецПопытки;
	
	// Если загружаем цены поступления не меняем время, 
	// если обычная цена добавляем 5 секунд, чтобы не было коллизии цен в документах!!!
	//СтрПоиска = "ES";
	//Найден = СтрНайти(НомерДокумента, СтрПоиска);
	//Если Найден = 0 Тогда
	//	ДатаДокумента = ДатаДокумента + 5;
	//КонецЕсли;
	
	ТаблицаЦен = ПолучитьТаблицуЦен(МассивЦенТоваров[0].Получить("lines"), Ложь);
	
	СоздалиВсеОтсутствущиеНоменклатуры = СоздатьОтсутствущиеНоменклатуры(ТаблицаЦен, HТТPСоединение);

	Если ТипЗнч(СоздалиВсеОтсутствущиеНоменклатуры) <> Тип("Булево") Тогда 
		Возврат СоздалиВсеОтсутствущиеНоменклатуры;
	КонецЕсли;	
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТаблицаЦен", ТаблицаЦен);
	Запрос.УстановитьПараметр("Дата", 		КонецДня(ДатаДокумента));
	Запрос.УстановитьПараметр("ВидЦены", 	ВидЦены);
	
	Если ПоМагазину Тогда 
		
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ТаблицаЦен.Модель КАК Артикул,
		               |	ТаблицаЦен.Цена КАК Цена,
		               |	ТаблицаЦен.КодМагазина КАК КодМагазина
		               |ПОМЕСТИТЬ ТемпТаблицаЦен
		               |ИЗ
		               |	&ТаблицаЦен КАК ТаблицаЦен
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	СпНоменклатура.Ссылка КАК Номенклатура,
		               |	ТемпТаблицаЦен.Цена КАК Цена,
		               |	Магазины.Ссылка КАК Магазин,
		               |	ТемпТаблицаЦен.КодМагазина КАК КодМагазина
		               |ПОМЕСТИТЬ ВТЦеныМагазины
		               |ИЗ
		               |	Справочник.Номенклатура КАК СпНоменклатура
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТемпТаблицаЦен КАК ТемпТаблицаЦен
		               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Магазины КАК Магазины
		               |			ПО ТемпТаблицаЦен.КодМагазина = Магазины.КодИсточника
		               |		ПО СпНоменклатура.Модель = ТемпТаблицаЦен.Артикул
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		               |	ВТЦеныМагазины.Магазин КАК Магазин,
		               |	ВТЦеныМагазины.КодМагазина КАК КодМагазина
		               |ИЗ
		               |	ВТЦеныМагазины КАК ВТЦеныМагазины
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		               |	ВТЦеныМагазины.Номенклатура КАК Номенклатура,
		               |	ВТЦеныМагазины.Цена КАК Цена,
		               |	ВТЦеныМагазины.Магазин КАК Магазин
		               |ИЗ
		               |	ВТЦеныМагазины КАК ВТЦеныМагазины";
		
	Иначе
		
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ТаблицаЦен.Модель КАК Артикул,
		               |	ТаблицаЦен.Цена КАК Цена
		               |ПОМЕСТИТЬ ТемпТаблицаЦен
		               |ИЗ
		               |	&ТаблицаЦен КАК ТаблицаЦен
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		               |	Номенклатура.Ссылка КАК Номенклатура,
		               |	МИНИМУМ(ТемпТаблицаЦен.Цена) КАК Цена
		               |ПОМЕСТИТЬ ВТ_Цены
		               |ИЗ
		               |	Справочник.Номенклатура КАК Номенклатура
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТемпТаблицаЦен КАК ТемпТаблицаЦен
		               |		ПО Номенклатура.Модель = ТемпТаблицаЦен.Артикул
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	Номенклатура.Ссылка
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТ_Цены.Номенклатура КАК Номенклатура,
		               |	ВТ_Цены.Цена КАК Цена
		               |ИЗ
		               |	ВТ_Цены КАК ВТ_Цены
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, ВидЦены = &ВидЦены) КАК ЦеныНоменклатурыСрезПоследних
		               |		ПО ВТ_Цены.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
		               |ГДЕ
		               |	ВТ_Цены.Цена <> ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0)";
		
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Если ПоМагазину Тогда 
		
		МассивРезудьтатов = Запрос.ВыполнитьПакет();
		Магазины 		  = МассивРезудьтатов[2].Выгрузить();
		МассивТоваров     = МассивРезудьтатов[3].Выгрузить();
		
		НачатьТранзакцию();
		
		Для Каждого ТекМагазин Из Магазины Цикл 
			
			Если Не ЗначениеЗаполнено(ТекМагазин.Магазин) Тогда 
				ОтменитьТранзакцию();
				Возврат "Store not found with code:" + ТекМагазин.КодМагазина;
			КонецЕсли;
			
			Док 	 		   = Документы.УстановкаЦенНоменклатурыПоМагазинам.СоздатьДокумент();
			Док.Дата 		   = ДатаДокумента;
			Док.ДатаОкончания  = ДатаОкончания;
			Док.Магазин        = ТекМагазин.Магазин;
			Док.ВидЦены		   = ВидЦены;
			Док.Страна		   = ВидЦены.Страна;
			Док.КодГруппы      = ВидЦены.КодИсточника;
			Док.НомерИсточника = НомерДокумента;
			Док.Ответственный  = Пользователи.ТекущийПользователь();
			
			Товары = МассивТоваров.НайтиСтроки(Новый Структура("Магазин", ТекМагазин.Магазин));
			
			Для Каждого ТекТовар Из Товары Цикл 
				НовСтрока = Док.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, ТекТовар);
			КонецЦикла;
			
			Попытка
				Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			Исключение
				ОтменитьТранзакцию();
				Возврат ОписаниеОшибки();
			КонецПопытки;
			
		КонецЦикла;

		ЗафиксироватьТранзакцию();
		
		Возврат Док.Ссылка;
		
	Иначе 
		
		ТаблицаТоваров = Запрос.Выполнить().Выгрузить();
		
		Док = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
		Док.Дата 			 = ДатаДокумента;
		Док.НомерИсточника   = НомерДокумента;
		ТабВидЦены 			 = Док.ВидыЦен.Добавить();
		ТабВидЦены.ВидЦены   = ВидЦены;
		Док.Ответственный	 = ПараметрыСеанса.ТекущийПользователь;
		Док.Страна			 = ВидЦены.Страна;
		Док.КодГруппы		 = ВидЦены.КодИсточника;
		Док.ЦенаМаркетплейса = ВидЦены.ЦенаМаркетплейса;
		Док.Согласован		 = Истина;
		
		Для Каждого ТекСтрока Из ТаблицаТоваров Цикл 
			
			НовСтрока = Док.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, ТекСтрока);
			НовСтрока.ВидЦены = ВидЦены;
			
		КонецЦикла;
		
		НачатьТранзакцию();
		Попытка
			Док.ДополнительныеСвойства.Вставить("ЗарегистрироватьДляОбмена", Истина);
			Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);

		Исключение
			ОтменитьТранзакцию();
			Возврат ОписаниеОшибки();
		КонецПопытки;

		ЗафиксироватьТранзакцию();
		
		Возврат Док.Ссылка;
	КонецЕсли;
КонецФункции

Процедура Одобрить_Цены(ИдентификаторЗаголовка, ДопПараметры, ПараметрИсточник, Идентификатор) 
	
	Ответ = КоннекторHTTP.PostJson(ВнешняяСистема.URL + "/api/Products/LockProductDocByHeaderId?headerId=" + ИдентификаторЗаголовка,,ДопПараметры);
	
	Сообщить(ВнешняяСистема.URL + "/api/Products/LockProductDocByHeaderId?headerId=" + ИдентификаторЗаголовка);
	Если Ответ.Получить("success") Тогда
		
		ЗаписатьВЖурналРегистра(ПараметрИсточник, Идентификатор, Истина);
		
	Иначе 
		ТекстОтвета = КоннекторHTTP.КакТекст(Ответ, КодировкаТекста.UTF8);
		ТекстОшибки = СтрШаблон("Error while approving. Msg:%1", ТекстОтвета);
		ЗаписатьВЖурналРегистра(ПараметрИсточник, Идентификатор, Ложь, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область SEND_SALES

Функция ПолучитьЧекиИзОбмена(НомерДокумента) 

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Узел", РэтмайндКэш.ПолучитьУзелИнтеграции());
	Запрос.УстановитьПараметр("Номер", НомерДокумента);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 500
	               |	ЧекККМ.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ Вт_Продажа
	               |ИЗ
	               |	Документ.ЧекККМ.Изменения КАК ЧекККМИзменения
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК ЧекККМ
	               |		ПО ЧекККМИзменения.Ссылка = ЧекККМ.Ссылка
	               |ГДЕ
	               |	ЧекККМ.ПометкаУдаления = ЛОЖЬ
	               |	И ЧекККМ.Проведен = ИСТИНА
	               |	И ЧекККМИзменения.Узел = &Узел
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Вт_Продажа.Ссылка КАК Ссылка,
	               |	ЧекККМТовары.Штрихкод КАК Штрихкод,
	               |	ЧекККМТовары.Количество КАК Количество,
	               |	ЧекККМТовары.Цена КАК Цена,
	               |	ЧекККМТовары.Сумма КАК Сумма,
	               |	ЧекККМТовары.СуммаНДС КАК СуммаНДС,
	               |	ЧекККМТовары.Номенклатура.Артикул КАК НоменклатураАртикул,
	               |	ЧекККМТовары.Номенклатура.Модель КАК НоменклатураМодель,
	               |	ЧекККМТовары.СуммаАвтоматическойСкидки КАК СуммаАвтоматическойСкидки
	               |ИЗ
	               |	Вт_Продажа КАК Вт_Продажа
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ.Товары КАК ЧекККМТовары
	               |		ПО Вт_Продажа.Ссылка = ЧекККМТовары.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЧекККМОплата.ВидОплаты КАК ВидОплаты,
	               |	ЧекККМОплата.ЭквайринговыйТерминал КАК ЭквайринговыйТерминал,
	               |	ЧекККМОплата.Сумма КАК Сумма,
	               |	ЧекККМОплата.ПроцентКомиссии КАК ПроцентКомиссии,
	               |	ЧекККМОплата.СуммаКомиссии КАК СуммаКомиссии,
	               |	ЧекККМОплата.КлючСвязиОплаты КАК КлючСвязиОплаты,
	               |	Вт_Продажа.Ссылка КАК Ссылка
	               |ИЗ
	               |	Вт_Продажа КАК Вт_Продажа
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ.Оплата КАК ЧекККМОплата
	               |		ПО Вт_Продажа.Ссылка = ЧекККМОплата.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЧекККМСкидкиНаценки.Сумма КАК Сумма,
	               |	ЧекККМСкидкиНаценки.СкидкаНаценка КАК СкидкаНаценка,
	               |	ЧекККМСкидкиНаценки.ОграниченаМинимальнойЦеной КАК ОграниченаМинимальнойЦеной,
	               |	ЧекККМСкидкиНаценки.КлючСвязи КАК КлючСвязи,
	               |	Вт_Продажа.Ссылка КАК Ссылка
	               |ИЗ
	               |	Вт_Продажа КАК Вт_Продажа
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ.СкидкиНаценки КАК ЧекККМСкидкиНаценки
	               |		ПО Вт_Продажа.Ссылка = ЧекККМСкидкиНаценки.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Вт_Продажа.Ссылка КАК Ссылка,
	               |	ЧекККМ.Дата КАК Дата,
	               |	ЧекККМ.Номер КАК Номер,
	               |	ЧекККМ.ВидОперации КАК ВидОперации,
	               |	ЧекККМ.ДисконтнаяКарта КАК ДисконтнаяКарта,
	               |	ЧекККМ.Магазин КАК Магазин,
	               |	ЧекККМ.Магазин.КодИсточника КАК МагазинКодИсточника,
	               |	ЧекККМ.АдресЭП КАК АдресЭП,
	               |	ЧекККМ.Телефон КАК Телефон,
	               |	ЧекККМ.ТипЧека КАК ТипЧека,
	               |	ЧекККМ.АдресКлиента КАК АдресКлиента,
	               |	ЧекККМ.НаименованиеКлиента КАК НаименованиеКлиента,
	               |	ЧекККМ.КодКлиента КАК КодКлиента,
	               |	ЧекККМ.ТелефонКлиента КАК ТелефонКлиента,
	               |	ЧекККМ.ЧекККМПродажа.Номер КАК ЧекККМПродажаНомер
	               |ИЗ
	               |	Вт_Продажа КАК Вт_Продажа
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК ЧекККМ
	               |		ПО Вт_Продажа.Ссылка = ЧекККМ.Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата";
	Возврат	Запрос.ВыполнитьПакет();
	
КонецФункции

Процедура SEND_SALES(НомерДокумента = Неопределено) Экспорт
	
	ПараметрИсточник = ПолучитьПараметрИсточника("SEND_SALES"); 
	ДополнительныеПараметры = ПолучитьДопПараметры();
	
	ПакетПродаж = ПолучитьЧекиИзОбмена(НомерДокумента);
	
	Продажи = ПакетПродаж[4].Выгрузить(); 
	
	Товары = ПакетПродаж[1].Выгрузить();
	Оплата = ПакетПродаж[2].Выгрузить();
	Скидки = ПакетПродаж[3].Выгрузить();
	
	Для Каждого ТекПродажа Из Продажи Цикл 
		
		
		
		СтрПоиска = Новый Структура;
		СтрПоиска.Вставить("Ссылка", ТекПродажа.Ссылка);
		
		СтрПродажа = Новый Структура;
		СтрПродажа.Вставить("ModelType", 8);
		СтрПродажа.Вставить("CompanyCode", 13);
		СтрПродажа.Вставить("CustomerCode", "13-4-2");
		СтрПродажа.Вставить("CustomerTypeCode", 4);
		
		Если ТекПродажа.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат Тогда
			СтрПродажа.Вставить("Description", ТекПродажа.ЧекККМПродажаНомер);	
		Иначе
			СтрПродажа.Вставить("Description",  ТекПродажа.Номер);
		КонецЕсли;

		СтрПродажа.Вставить("IsEInvoice", 0);
		СтрПродажа.Вставить("Series", "");
		СтрПродажа.Вставить("SeriesNumber", 0);
		СтрПродажа.Вставить("TaxTypeCode", "0");
		СтрПродажа.Вставить("TaxExemptionCode", "0");
		
		СтрПродажа.Вставить("InvoiceDate", ЗаписатьДатуJSON(ТекПродажа.Дата, ФорматДатыJSON.ISO));
		СтрПродажа.Вставить("IsCompleted", истина);
		СтрПродажа.Вставить("IsSalesViaInternet", Ложь);
		СтрПродажа.Вставить("ApplyCampaign", Ложь);
		
		Если ТекПродажа.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат Тогда    
			СтрПродажа.Вставить("ApplyCampaignType", 99);
		Иначе
			СтрПродажа.Вставить("ApplyCampaignType", 0);
		КонецЕсли;
		
		СтрПродажа.Вставить("Point", 0);
		СтрПродажа.Вставить("FirstValidDate",ЗаписатьДатуJSON(ТекПродажа.Дата - 3600, ФорматДатыJSON.ISO));
		СтрПродажа.Вставить("LastValidDate",ЗаписатьДатуJSON(ТекПродажа.Дата - 3600, ФорматДатыJSON.ISO));
		СтрПродажа.Вставить("MinAmount", 0);
		СтрПродажа.Вставить("UsedAmount", 0);
		
		НайденныеТовары = Товары.НайтиСтроки(СтрПоиска);
		МассивТоваров = Новый Массив;
		
		ИтоговаяСумма = 0;
		
		Для Каждого ТекТовар Из НайденныеТовары Цикл
			
			Цена = ТекТОвар.Цена;
			Количество = ТекТовар.Количество;
			Сумма = ТекТовар.Сумма;
			
			ТоварыВМассив = Новый Структура;
			ТоварыВМассив.Вставить("UsedBarcode", ТекТовар.Штрихкод);
			
			ТоварыВМассив.Вставить("PriceVI", Сумма/Количество);
			ТоварыВМассив.Вставить("Qty1", Количество);
			
			ИтоговаяСумма = ИтоговаяСумма + Сумма;
			
			ТоварыВМассив.Вставить("TotalDisRate", 0);
			ТоварыВМассив.Вставить("TotalDisAmount", 0);
			
			//ТоварыВМассив.Вставить("TotalDisRate", Окр((ТекТовар.СуммаАвтоматическойСкидки / (Цена * Количество)) *100,0,РежимОкругления.Окр15как20));
			//ТоварыВМассив.Вставить("TotalDisAmount", ТекТовар.СуммаАвтоматическойСкидки);
			
			ТоварыВМассив.Вставить("LDisRate1", 0);
			ТоварыВМассив.Вставить("DisAmount1", 0);
			ТоварыВМассив.Вставить("LDisRate2", 0);
			ТоварыВМассив.Вставить("DisAmount2", 0);
			ТоварыВМассив.Вставить("LDisRate3", 0);
			ТоварыВМассив.Вставить("DisAmount3", 0);
			ТоварыВМассив.Вставить("LDisRate4", 0);
			ТоварыВМассив.Вставить("DisAmount4", 0);
			ТоварыВМассив.Вставить("LDisRate5", 0);
			ТоварыВМассив.Вставить("DisAmount5", 0);
			ТоварыВМассив.Вставить("ActualPriceCurrencyCode", "KZT");
			ТоварыВМассив.Вставить("ItemCode", "");  
			ТоварыВМассив.Вставить("ItemTypeCode", 0);
			ТоварыВМассив.Вставить("GiftCardChargeAmount",0.0);
			ТоварыВМассив.Вставить("SerialNumber", ""); 
			
			Если ТекПродажа.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат Тогда    
				ТоварыВМассив.Вставить("ReturnReasonCode", "04");
			КонецЕсли;
			
			МассивТоваров.Добавить(ТоварыВМассив);
			
		КонецЦикла;
		
		СтрПродажа.Вставить("Lines" , МассивТоваров);
		СтрПродажа.Вставить("PosTerminalID", 1);
		СтрПродажа.Вставить("SendInvoiceByEMail", Истина);
		СтрПродажа.Вставить("SendInvoiceBySMS",Истина);
		СтрПродажа.Вставить("OfficeCode", ТекПродажа.МагазинКодИсточника);
		СтрПродажа.Вставить("StoreCode", ТекПродажа.МагазинКодИсточника);
		СтрПродажа.Вставить("WarehouseCode", ТекПродажа.МагазинКодИсточника);
		
		НайденныеОплаты = Оплата.НайтиСтроки(СтрПоиска);
		
		МассивОплат = Новый Массив;
		
		ИтоговаяСуммаОплаты = 0;
		
		Для Каждого ТекОплата Из НайденныеОплаты Цикл
			
			ОплатыВМассив = Новый Структура; 
			
			Сумма = ТекОплата.Сумма;
			
			//Если ТекОплата.ВидОплаты.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.Наличные Тогда
			
			ОплатыВМассив.Вставить("PaymentType", "1");
			ОплатыВМассив.Вставить("Code", "100.01.079");
			ОплатыВМассив.Вставить("CreditCardTypeCode", "");
			ОплатыВМассив.Вставить("InstallmentCount",1);
			ОплатыВМассив.Вставить("CurrencyCode", "KZT");
			ОплатыВМассив.Вставить("DocCurrencyCode", "KZT");
			ОплатыВМассив.Вставить("Amount", Сумма);
			ИтоговаяСуммаОплаты = ИтоговаяСуммаОплаты + Сумма;
			//ИначеЕсли ТекОплата.ВидОплаты.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта Тогда 
			//	
			//	ОплатыВМассив.Вставить("PaymentType", "2");
			//	ОплатыВМассив.Вставить("Code", "Z01");
			//	ОплатыВМассив.Вставить("CreditCardTypeCode", "");
			//	ОплатыВМассив.Вставить("InstallmentCount",1);
			//	ОплатыВМассив.Вставить("CurrencyCode", "KZT");
			//	ОплатыВМассив.Вставить("DocCurrencyCode", "KZT");
			//	ОплатыВМассив.Вставить("Amount", Сумма);
			//	
			//Иначе
			//	
			//	ОплатыВМассив.Вставить("PaymentType", "70");
			//	ОплатыВМассив.Вставить("Code", "KZ-PAY-OTH");
			//	ОплатыВМассив.Вставить("CreditCardTypeCode", "");
			//	ОплатыВМассив.Вставить("InstallmentCount",1);
			//	ОплатыВМассив.Вставить("CurrencyCode", "KZT");
			//	ОплатыВМассив.Вставить("DocCurrencyCode", "KZT");
			//	ОплатыВМассив.Вставить("Amount", Сумма);
			//	
			//КонецЕсли;
			
			МассивОплат.Добавить(ОплатыВМассив);
			
		КонецЦикла;

		СтрПродажа.Вставить("Payments", МассивОплат); 

		Сообщить(ВывестиЖейсонКакСтроку(СтрПродажа));
		
		Если ИтоговаяСумма <> ИтоговаяСуммаОплаты Тогда
			ЗаписатьВЖурналРегистра(ПараметрИсточник, ТекПродажа.Номер, Ложь,"Итоговая сумма и итог оплаты не совпадают! " + ИтоговаяСумма + "<>" +  ИтоговаяСуммаОплаты);
			Продолжить;
		КонецЕсли;

		Ответ = КоннекторHTTP.PostJson(ВнешняяСистема.URL + "/api/Invoice/CreateInvoice", СтрПродажа ,ДополнительныеПараметры);
		
		Сообщить(ВывестиЖейсонКакСтроку(Ответ));
		
		Если Ответ.Получить("success") = Истина Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(ПланыОбмена.СерверИнтеграции.ПолучитьУзел(), ТекПродажа.Ссылка);
			ЗаписатьВЖурналРегистра(ПараметрИсточник, ТекПродажа.Номер, Истина,"ОК");
		ИначеЕсли Ответ.Получить("success") = Ложь Тогда
			
			Если СтрНайти(Ответ.Получить("messages")[0], "has already been requested") Тогда 
				ПланыОбмена.УдалитьРегистрациюИзменений(ПланыОбмена.СерверИнтеграции.ПолучитьУзел(), ТекПродажа.Ссылка);
				ЗаписатьВЖурналРегистра(ПараметрИсточник, ТекПродажа.Номер, Ложь,"has already been requested, sale has been deleted from exchange succesfully!");
		    Иначе
				ЗаписатьВЖурналРегистра(ПараметрИсточник, ТекПродажа.Номер, Ложь, ВывестиЖейсонКакСтроку(Ответ));
		    КонецЕсли;
			
		Иначе
			ЗаписатьВЖурналРегистра(ПараметрИсточник, ТекПродажа.Номер, Ложь, ВывестиЖейсонКакСтроку(Ответ));
			
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры 

Функция ПолучитьПродажиИзОбмена() 

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Узел", РэтмайндКэш.ПолучитьУзелИнтеграции());
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЧекККМИзменения.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ Вт_Продажа
	               |ИЗ
	               |	Документ.ЧекККМ.Изменения КАК ЧекККМИзменения
	               |ГДЕ
	               |	ЧекККМИзменения.Узел = &Узел
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Вт_Продажа.Ссылка КАК Ссылка,
	               |	ЧекККМТовары.Штрихкод КАК Штрихкод,
	               |	ЧекККМТовары.Количество КАК Количество,
	               |	ЧекККМТовары.Цена КАК Цена,
	               |	ЧекККМТовары.Сумма КАК Сумма,
	               |	ЧекККМТовары.СуммаНДС КАК СуммаНДС,
	               |	ЧекККМТовары.СтавкаНДС КАК СтавкаНДС,
	               |	ЧекККМТовары.Номенклатура.Артикул КАК НоменклатураАртикул,
	               |	ЧекККМТовары.Номенклатура.Модель КАК НоменклатураМодель
	               |ИЗ
	               |	Вт_Продажа КАК Вт_Продажа
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ.Товары КАК ЧекККМТовары
	               |		ПО Вт_Продажа.Ссылка = ЧекККМТовары.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЧекККМОплата.ВидОплаты КАК ВидОплаты,
	               |	ЧекККМОплата.ЭквайринговыйТерминал КАК ЭквайринговыйТерминал,
	               |	ЧекККМОплата.Сумма КАК Сумма,
	               |	ЧекККМОплата.ПроцентКомиссии КАК ПроцентКомиссии,
	               |	ЧекККМОплата.СуммаКомиссии КАК СуммаКомиссии,
	               |	ЧекККМОплата.КлючСвязиОплаты КАК КлючСвязиОплаты,
	               |	Вт_Продажа.Ссылка КАК Ссылка
	               |ИЗ
	               |	Вт_Продажа КАК Вт_Продажа
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ.Оплата КАК ЧекККМОплата
	               |		ПО Вт_Продажа.Ссылка = ЧекККМОплата.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЧекККМСкидкиНаценки.Сумма КАК Сумма,
	               |	ЧекККМСкидкиНаценки.СкидкаНаценка КАК СкидкаНаценка,
	               |	ЧекККМСкидкиНаценки.ОграниченаМинимальнойЦеной КАК ОграниченаМинимальнойЦеной,
	               |	ЧекККМСкидкиНаценки.КлючСвязи КАК КлючСвязи,
	               |	Вт_Продажа.Ссылка КАК Ссылка
	               |ИЗ
	               |	Вт_Продажа КАК Вт_Продажа,
	               |	Документ.ЧекККМ.СкидкиНаценки КАК ЧекККМСкидкиНаценки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Вт_Продажа.Ссылка КАК Ссылка,
	               |	ЧекККМ.Дата КАК Дата,
	               |	ЧекККМ.Номер КАК Номер,
	               |	ЧекККМ.ВидОперации КАК ВидОперации,
	               |	ЧекККМ.ДисконтнаяКарта КАК ДисконтнаяКарта,
	               |	ЧекККМ.Магазин КАК Магазин,
	               |	ЧекККМ.Магазин.КодИсточника КАК МагазинКодИсточника,
	               |	ЧекККМ.АдресЭП КАК АдресЭП,
	               |	ЧекККМ.Телефон КАК Телефон,
	               |	ЧекККМ.ТипЧека КАК ТипЧека,
	               |	ЧекККМ.АдресКлиента КАК АдресКлиента,
	               |	ЧекККМ.НаименованиеКлиента КАК НаименованиеКлиента,
	               |	ЧекККМ.КодКлиента КАК КодКлиента,
	               |	ЧекККМ.ТелефонКлиента КАК ТелефонКлиента
	               |ИЗ
	               |	Вт_Продажа КАК Вт_Продажа
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ КАК ЧекККМ
	               |		ПО Вт_Продажа.Ссылка = ЧекККМ.Ссылка";
	Возврат	Запрос.ВыполнитьПакет();
	
КонецФункции

#КонецОбласти
Функция ПолучитьШК(Номен, Характерис)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номен);
	Запрос.УстановитьПараметр("Характеристика", Характерис);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Штрихкоды.Штрихкод КАК Штрихкод
	               |ИЗ
	               |	РегистрСведений.Штрихкоды КАК Штрихкоды
	               |ГДЕ
	               |	Штрихкоды.Владелец = &Номенклатура
	               |	И Штрихкоды.Характеристика = &Характеристика";
	результат = Запрос.Выполнить().Выбрать();
	Если результат.Следующий() тогда
		Возврат результат.Штрихкод;
	конецЕсли;
	Возврат "";
КонецФункции
#Область SEND_REAlISATION

Функция ПолучитьРеализацииИзОбмена(НомерДокумента)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Узел", РэтмайндКэш.ПолучитьУзелИнтеграции());
	Запрос.УстановитьПараметр("Номер", НомерДокумента);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 100
	               |	РеализацияТоваров.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ Вт_Продажа
	               |ИЗ
	               |	Документ.РеализацияТоваров.Изменения КАК РеализацияТоваровИзменения
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваров КАК РеализацияТоваров
	               |		ПО РеализацияТоваровИзменения.Ссылка = РеализацияТоваров.Ссылка
	               |ГДЕ
	               |	РеализацияТоваров.ПометкаУдаления = ЛОЖЬ
	               |	И РеализацияТоваров.Проведен = ИСТИНА
	               |	И РеализацияТоваровИзменения.Узел = &Узел
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Вт_Продажа.Ссылка КАК Ссылка,
	               |	РеализацияТоваровТовары.Штрихкод КАК Штрихкод,
	               |	РеализацияТоваровТовары.Количество КАК Количество,
	               |	РеализацияТоваровТовары.Цена КАК Цена,
	               |	РеализацияТоваровТовары.Сумма КАК Сумма,
	               |	РеализацияТоваровТовары.СуммаНДС КАК СуммаНДС,
	               |	РеализацияТоваровТовары.Номенклатура.Артикул КАК НоменклатураАртикул,
	               |	РеализацияТоваровТовары.Номенклатура.Модель КАК НоменклатураМодель,
	               |	РеализацияТоваровТовары.СуммаАвтоматическойСкидки КАК СуммаАвтоматическойСкидки,
	               |	РеализацияТоваровТовары.Номенклатура КАК Номенклатура,
	               |	РеализацияТоваровТовары.Характеристика КАК Характеристика
	               |ИЗ
	               |	Вт_Продажа КАК Вт_Продажа
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
