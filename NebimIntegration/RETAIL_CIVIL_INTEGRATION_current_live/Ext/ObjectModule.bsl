Функция ПолучитьШтрихкодПоАртикулу(Артикул)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Артикул",Артикул);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Штрихкоды.Штрихкод КАК Штрихкод
	               |ИЗ
	               |	РегистрСведений.Штрихкоды КАК Штрихкоды
	               |ГДЕ
	               |	Штрихкоды.Владелец.Артикул = &Артикул
	               |	И Штрихкоды.Штрихкод <> """"";
	Выборка = 	ЗАпрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Штрихкод;
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

Функция ПолучитьЦеныПоШтрихкоду(Артикул) экспорт
	
	ПараметрИсточник = ПолучитьПараметрИсточника("GET_PRICES"); 
	ВидыЦен = ПолучитьВсеВидыЦен(); 
	ДополнительныеПараметры = ПолучитьДопПараметры();  
	
	Штрихкод = ПолучитьШтрихкодПоАртикулу(Артикул); 
	
	
	Если Штрихкод = "" Тогда
		Возврат 0;
	КонецЕсли;
	
	
	Ответ = КоннекторHTTP.GetJson(ВнешняяСистема.URL + "/api/Products/GetProductPrices?PriceGroupCodes=KZT_KM&Barcode=" + Штрихкод, ,ДополнительныеПараметры);
	
	//Сообщить(ВывестиЖейсонКакСтроку(Ответ));
	
	Если ТипЗнч(Ответ) = Тип("Соответствие") Тогда
		
		Если Ответ.Получить("success") ТОгда
			МассивЦен = Ответ.Получить("data");
			Если ТипЗнч(МассивЦен) = Тип("Массив") Тогда
				Если МассивЦен.Количество() > 0 Тогда
					Сообщить(МассивЦен[0].Получить("itemCode") + " " + МассивЦен[0].Получить("price"));
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;
		
	КонецЕсли;

КонецФункции

Функция ЗагрузитьЦенуВручну(НомерДокумента, КодВидЦены) экспорт 
	
	
	ПараметрИсточник = ПолучитьПараметрИсточника("GET_PRICES"); 
	ВидыЦен = ПолучитьВсеВидыЦен(); 
	ДополнительныеПараметры = ПолучитьДопПараметры();
	
	
	//НомерДокумента  = ТекСтрока.Получить("priceListNumber");
	//КодВидЦены      = ТекСтрока.Получить("priceGroupCode");
	
	Идентификатор   = "" + НомерДокумента + "_" + КодВидЦены;
	ВидЦеныДокумента = Справочники.ВидыЦен.НайтиПоРеквизиту("КодИсточника", СокрЛП(КодВидЦены));
	
	Если НЕ ЗначениеЗаполнено(ВидЦеныДокумента) Тогда 
		ЗаписатьВЖурналРегистра(ПараметрИсточник, Идентификатор, Ложь, 
		СтрШаблон("PriceType(ВидЦены) not found:%1", КодВидЦены));
		Возврат 0;
	КонецЕсли;
	
	ЕстьЦена = ПолучитьЦенуПоНомеруИсточникаИПоВидуЦен(НомерДокумента, ВидЦеныДокумента,ложь);
	
	Если ЕстьЦена <> Неопределено Тогда 
		Сообщить("Такая цена уже есть");
		//Одобрить_Цены(ТекСтрока.Получить("priceListHeaderID"), ДополнительныеПараметры, ПараметрИсточник, Идентификатор);
		Возврат 0;
	КонецЕсли;
	
	Ответ2 = КоннекторHTTP.GetJson(ВнешняяСистема.URL + "/api/Products/GetPriceByListNumber?PriceListNumber=" + НомерДокумента, ,ДополнительныеПараметры);
	
	//Сообщить(ВывестиЖейсонКакСтроку(Ответ2));
	
	Если Ответ2.Получить("success") Тогда
		Сообщить("Заходит правильно");
		
		Результат = СоздатьЦеныНоменклатуры(ВидЦеныДокумента,  Ответ2, ,Ложь);
		
		//Сообщить(Результат);
		
		Если ТипЗнч(Результат) = Тип("ДокументСсылка.УстановкаЦенНоменклатуры")
			Или ТипЗнч(Результат) = Тип("ДокументСсылка.УстановкаЦенНоменклатурыПоМагазинам")  Тогда 
			//Одобрить_Цены(ТекСтрока.Получить("priceListHeaderID"), ДополнительныеПараметры, ПараметрИсточник, Идентификатор);
			
		Иначе
			Если ТипЗнч(Результат) = Тип("Соответствие") Тогда 
				ТекстОшибки = Результат.Получить("ERROR_CODE");
				ТекстОписаниеОшибки = Результат.Получить("DESC");
				Если ТекстОписаниеОшибки = Неопределено Тогда 
					ТекстОписаниеОшибки = "";
				КонецЕсли; 
				
				ЗаписатьВЖурналРегистра(ПараметрИсточник, Идентификатор, Ложь, ТекстОшибки + ТекстОписаниеОшибки);
				
				//Одобрить_Цены(ТекСтрока.Получить("priceListHeaderID"), КодВидЦены, ПараметрИсточник, Идентификатор);
			Иначе 
				ЗаписатьВЖурналРегистра(ПараметрИсточник, Идентификатор, Ложь, Результат);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецФункции
	
Процедура ПолучитьЦеныПоКодуИПоШтрихкод(Штрихкод, ВидЦены) Экспорт   
	
	ДополнительныеПараметры = ПолучитьДопПараметры();

	МассивЦен = Новый Массив();
	
	Счетчик = 0;

	Ответ = КоннекторHTTP.GetJson(ВнешняяСистема.URL + "/api/Products/GetProductPrices?PriceGroupCodes=" + ВидЦены.КодИсточника+ "&Barcode=" +  Штрихкод, ,ДополнительныеПараметры);
	
	Если ТипЗнч(Ответ) = Тип("Соответствие") Тогда
		Если Ответ.Получить("success") ТОгда
			
			МассивЦен.Добавить(Ответ.Получить("data")[0]);
		Иначе
			Возврат;
		КонецЕсли; 
	Иначе
		Возврат;
	КонецЕсли;

	Если МассивЦен.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;

	Счетчик = Счетчик + 1;
	
	data = Новый Соответствие;
	data.Вставить("priceListHeaderID","1");
	data.Вставить("priceListNumber", "manual" + "_" + Штрихкод);
	data.Вставить("validDate", СтрЗаменить("" + День(ТекущаяДата()) + "." + Месяц(ТекущаяДата()) + "." + Год(ТекущаяДата()),",",""));
	data.Вставить("validTime", "" + Час(ТекущаяДата()) + ":" + Минута(ТекущаяДата()) + ":" + Секунда(ТекущаяДата()));
	data.Вставить("lines",МассивЦен);
	lines = Новый Соответствие;
	
	МассивВсехЦен = Новый Массив;
	МассивВсехЦен.Добавить(data);  
	
	СоотТоваровДляЦены = Новый Соответствие;
	СоотТоваровДляЦены.Вставить("data",МассивВсехЦен);
	
	СоздатьЦеныНоменклатуры(ВидЦены, СоотТоваровДляЦены,,ложь);

КонецПроцедуры	

