Функция ПолучитьДанныеНТИН()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Узел", РэтмайндКэш.ПолучитьУзелИнтеграции());
	Запрос.Текст = "ВЫБРАТЬ
	               |	НТИН.Страна КАК Страна,
	               |	НТИН.Номенклатура КАК Номенклатура,
	               |	НТИН.Характеристика КАК Характеристика,
	               |	НТИН.Код КАК Код,
	               |	НТИН.Номенклатура.Модель КАК НоменклатураМодель,
	               |	НТИН.Номенклатура.Цвет.Код КАК НоменклатураЦветКод,
	               |	НТИН.Номенклатура.Артикул КАК НоменклатураАртикул,
	               |	НТИН.Характеристика.Наименование КАК ХарактеристикаНаименование,
	               |	НТИН.Номенклатура.Цвет.КодИсточник КАК НоменклатураЦветКодИсточник
	               |ПОМЕСТИТЬ Вт_НТИН
	               |ИЗ
	               |	РегистрСведений.НТИН.Изменения КАК НТИНИзменения
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НТИН КАК НТИН
	               |		ПО НТИНИзменения.Страна = НТИН.Страна
	               |			И НТИНИзменения.Номенклатура = НТИН.Номенклатура
	               |			И НТИНИзменения.Характеристика = НТИН.Характеристика
	               |ГДЕ
	               |	НТИНИзменения.Узел = &Узел
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(Штрихкоды.Штрихкод) КАК Штрихкод,
	               |	Штрихкоды.Характеристика КАК Характеристика,
	               |	Штрихкоды.Владелец КАК Владелец
	               |ПОМЕСТИТЬ Вт_Штрихкоды
	               |ИЗ
	               |	РегистрСведений.Штрихкоды КАК Штрихкоды
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Штрихкоды.Характеристика,
	               |	Штрихкоды.Владелец
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Вт_НТИН.Страна КАК Страна,
	               |	Вт_НТИН.Номенклатура КАК Номенклатура,
	               |	Вт_НТИН.Характеристика КАК Характеристика,
	               |	Вт_НТИН.Код КАК Код,
	               |	Вт_Штрихкоды.Штрихкод КАК Штрихкод,
	               |	Вт_НТИН.НоменклатураМодель КАК НоменклатураМодель,
	               |	Вт_НТИН.НоменклатураЦветКод КАК НоменклатураЦветКод,
	               |	Вт_НТИН.НоменклатураАртикул КАК НоменклатураАртикул,
	               |	Вт_НТИН.ХарактеристикаНаименование КАК ХарактеристикаНаименование,
	               |	Вт_НТИН.НоменклатураЦветКодИсточник КАК НоменклатураЦветКодИсточник
	               |ИЗ
	               |	Вт_НТИН КАК Вт_НТИН
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Вт_Штрихкоды КАК Вт_Штрихкоды
	               |		ПО Вт_НТИН.Номенклатура = Вт_Штрихкоды.Владелец
	               |			И Вт_НТИН.Характеристика = Вт_Штрихкоды.Характеристика";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ОтправитьНТИН()  Экспорт
	
	ПараметрИсточник = ПолучитьПараметрИсточника("SEND_NATIONAL_CODE");
	ДополнительныеПараметры = ПолучитьДопПараметры();
	Результат = ПолучитьДанныеНТИН();  
	
	Для Каждого ТекСтрока Из Результат Цикл

		СтрТело = Новый Структура;
		СтрТело.Вставить("itemCode", ТекСтрока.НоменклатураМодель);
		СтрТело.Вставить("colorCode", ТекСтрока.НоменклатураЦветКодИсточник);
		СтрТело.Вставить("itemDim1Code", ТекСтрока.ХарактеристикаНаименование);
		
		СтрТело.Вставить("barcode", ТекСтрока.Штрихкод);
		СтрТело.Вставить("nationalCode", ТекСтрока.Код); 
		
		Сообщить(ВывестиЖейсонКакСтроку(СтрТело));
		
		Ответ = КоннекторHTTP.PostJson(ВнешняяСистема.URL + "/api/Products/InsertNationalCode", СтрТело ,ДополнительныеПараметры);
		
		Сообщить(ВывестиЖейсонКакСтроку(Ответ));
		
		Если Ответ.Получить("success") = Истина Тогда
			Набор = РегистрыСведений.НТИН.СоздатьНаборЗаписей();
			Набор.Отбор.Страна.Установить(ТекСтрока.Страна);
			Набор.Отбор.Страна.Установить(ТекСтрока.Номенклатура);
			Набор.Отбор.Страна.Установить(ТекСтрока.Характеристика);
			
			Набор.Прочитать();
			
			ПланыОбмена.УдалитьРегистрациюИзменений(ПланыОбмена.СерверИнтеграции.ПолучитьУзел(),Набор);
			ЗаписатьВЖурналРегистра(ПараметрИсточник, ТекСтрока.Код, Истина,"ОК");
			
		Иначе
			//ПланыОбмена.УдалитьРегистрациюИзменений(ПланыОбмена.СерверИнтеграции.ПолучитьУзел(),Набор);
			
			ЗаписатьВЖурналРегистра(ПараметрИсточник, ТекСтрока.Код, Ложь, ВывестиЖейсонКакСтроку(Ответ));	
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

