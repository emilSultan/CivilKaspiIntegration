	ТаблицаДанныхПоступлений.Колонки.Добавить("ЗаголовокДокумента", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ТаблицаДанныхПоступлений.Колонки.Добавить("Вес",                Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ТаблицаДанныхПоступлений.Колонки.Добавить("Длина",              Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ТаблицаДанныхПоступлений.Колонки.Добавить("ШтрихкодУпаковки",   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ТаблицаДанныхПоступлений.Колонки.Добавить("Ширина",             Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ТаблицаДанныхПоступлений.Колонки.Добавить("Высота",             Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
