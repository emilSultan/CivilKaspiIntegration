	ТаблицаКоробокИТоваров              = МассивПакетов[5].Выгрузить();
	Магазины                            = МассивПакетов[6].Выгрузить();
	ТаблицаТоваровДляПеремещениеТоваров = МассивПакетов[7].Выгрузить();
	Модели                              = МассивПакетов[8].Выгрузить();

	Если ТаблицаТоваров.Количество() = 0 Тогда 
		Возврат "No items found for invoice";
	КонецЕсли;
	
	ДатаДокумента = ТаблицаТоваров[0].Дата;
	Если Год(ДатаДокумента) = 1 Тогда 
		Возврат "Date is not given for invoice";
	КонецЕсли;
	
	КодВалюты = "KZT";
	Если Магазины.Количество() > 0 Тогда 
		КодВалюты = Магазины[0].КодВалюты;
	КонецЕсли; 
	
	// Если KZT — оформляем поступление сразу на склад магазина-получателя без перемещений
	ПоступлениеНаМагазинБезПеремещения = (ВРег(СокрЛП(КодВалюты)) = "KZT");
	
	МагазинПолучатель = ?(Магазины.Количество() > 0, Магазины[0].Магазин, Справочники.Магазины.ПустаяСсылка());
	
	Если ПоступлениеНаМагазинБезПеремещения Тогда
		// Прямое поступление на склад магазина-получателя
		Если НЕ ЗначениеЗаполнено(МагазинПолучатель) Тогда
			Возврат "Store not found for KZT invoice: " + ВходящийНомер;
		КонецЕсли;
		
		МагазинДокумента = МагазинПолучатель;
		СкладДокумента   = МагазинПолучатель.СкладПродажи;
		
		Если НЕ ЗначениеЗаполнено(СкладДокумента) Тогда
			Возврат "Destination store warehouse is not given for store: " + МагазинПолучатель.Наименование;
		КонецЕсли;
		
		ОрганизацияДокумента = СкладДокумента.Организация;
	Иначе
		// Валютные поставки (USD и др.) оформляются на транзитный склад CrossDock
		СкладДокумента = Страна.СкладПоступления;
		Если НЕ ЗначениеЗаполнено(СкладДокумента) Тогда
			СкладДокумента = Справочники.Склады.НайтиПоНаименованию("(KZ-WH) CrossDock");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СкладДокумента) Тогда
			СкладДокумента = Справочники.Склады.НайтиПоНаименованию("(KZ-WH) WH - CrossDock");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СкладДокумента) Тогда 
			Возврат СтрШаблон("Cross Doc warehouse is not given for Country:%1", Страна.Наименование);
		КонецЕсли;
		
		МагазинДокумента     = СкладДокумента.Магазин;
		ОрганизацияДокумента = СкладДокумента.Организация;
	КонецЕсли;
	
	НомерДокументаБезИНН = ВходящийНомер;
	
	Если КодВалюты = "KZT" Тогда
		Попытка
			ВходнаяСтрока = ВходящийНомер;
			ПозицияДефиса = СтрНайти(ВходнаяСтрока, " - ");
			Если ПозицияДефиса > 0 Тогда
				ИННПоиска            = СокрЛП(Лев(ВходнаяСтрока, ПозицияДефиса - 1));
				НомерДокументаБезИНН = СокрЛП(Сред(ВходнаяСтрока, ПозицияДефиса + 3));
			Иначе
				ПозицияДефиса = СтрНайти(ВходнаяСтрока, "-");
				Если ПозицияДефиса > 0 Тогда
					ИННПоиска            = СокрЛП(Лев(ВходнаяСтрока, ПозицияДефиса - 1));
					НомерДокументаБезИНН = СокрЛП(Сред(ВходнаяСтрока, ПозицияДефиса + 1));
				Иначе
					ИННПоиска            = СокрЛП(ВходнаяСтрока);
				КонецЕсли;
			КонецЕсли;
			
			НайденныйКонтрагент = ПолучитьКонтрагентаПоИНН(ИННПоиска);  
			Если ЗначениеЗаполнено(НайденныйКонтрагент) Тогда 
				Поставщик = НайденныйКонтрагент;
			КонецЕсли;
		Исключение 
			ЗаписьЖурналаРегистрации("NebimIntegration_ПолучитьКонтрагента", УровеньЖурналаРегистрации.Ошибка, 
				ВходнаяСтрока, ОписаниеОшибки()); 
		КонецПопытки;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Модели Цикл 
		ПолучитьЛоты(ТекСтрока.Модель, Истина);
	КонецЦикла;
	
	Док = Документы.ПоступлениеТоваров.СоздатьДокумент();
	Док.Дата                    = ДатаДокумента;
	Док.Контрагент              = Поставщик;
	Док.Магазин                 = МагазинДокумента;
	Док.Организация             = ОрганизацияДокумента;
	Док.Склад                   = СкладДокумента;
	Док.Страна                  = МагазинДокумента.Страна;
	Док.ВходящийНомер           = НомерДокументаБезИНН;
	Док.УчитыватьНДС            = Ложь;
	Док.ЦенаВключаетНДС         = Ложь;
	Док.НомерВходящегоДокумента = НомерДокументаБезИНН;
	Док.ДатаВходящегоДокумента  = ДатаДокумента;
	Док.Ответственный           = ПараметрыСеанса.ТекущийПользователь;
	Док.Валюта                  = ПолучитьВалюту(Док.Страна, КодВалюты);
	Док.НомерПоставки           = НомерЭкспорта;
	Док.НомерПоставки2          = ЗаголовокПоступления;
	
	Для Каждого ТекСтрока Из ТаблицаТоваров Цикл
		
		НовСтрока = Док.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, ТекСтрока);
		
		Если Не ЗначениеЗаполнено(НовСтрока.Номенклатура) ИЛИ НЕ ЗначениеЗаполнено(НовСтрока.Характеристика) Тогда
			Возврат "Purchase contains blank product or blank size.";
		КонецЕсли;
		
		НовСтрока.КоличествоУпаковок = НовСтрока.Количество;
		НовСтрока.Сумма              = ТекСтрока.Сумма;
		НовСтрока.СтавкаНДС          = Перечисления.СтавкиНДС.БезНДС;
		НовСтрока.СуммаНДС           = 0;
		НовСтрока.Цена               = ?(НовСтрока.Количество <> 0, ТекСтрока.Сумма / НовСтрока.Количество, 0);
		
	КонецЦикла;
	
	Док.СуммаДокумента = ОбработкаТабличнойЧастиТоварыКлиентСервер.ПолучитьСуммуДокумента(Док.Товары, Док.ЦенаВключаетНДС);
	
	НачатьТранзакцию();
	
	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Исключение
		ОтменитьТранзакцию();
		Возврат ОписаниеОшибки();
	КонецПопытки;
	
	// Создаем перемещения и коробки только если это НЕ KZT
	Если Не ПоступлениеНаМагазинБезПеремещения Тогда
		
		ПеремещениеСоздали = СоздатьПеремещениеТоваров(Магазины, ТаблицаКоробокИТоваров, 
			ТаблицаТоваровДляПеремещениеТоваров, Док.Магазин, Док.Ссылка, НомерЭкспорта, ЗаголовокПоступления);

		Если ТипЗнч(ПеремещениеСоздали) <> Тип("Булево") ИЛИ НЕ ПеремещениеСоздали Тогда 
			ОтменитьТранзакцию();
			Возврат ПеремещениеСоздали;
		КонецЕсли;
		
	КонецЕсли;

	ЗафиксироватьТранзакцию();
	
	Возврат Док.Ссылка;
	
КонецФункции

Функция СоздатьПеремещениеТоваров(Магазины, Товары, ТаблицаТоваровДляПеремещениеТоваров, МагазинОтпарвитель, ДокументОснование, НомерЭкспорта, ЗаголовокПоступления, ТаблицаКМ = Неопределено)
	
	Для Каждого ТекМагазин Из Магазины Цикл 
		
		Магазин = ТекМагазин.Магазин;
		
		Если НЕ ЗначениеЗаполнено(Магазин) Тогда 
			Возврат "Store not found with code: " + ТекМагазин.КодМагазина;
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Магазин", Магазин);
		
		Склад = Магазин.СкладПоступления;
		
		Док = Документы.ПеремещениеТоваров.СоздатьДокумент();

		Док.ВходящийНомер         = ?(Справочники.Магазины.НайтиПоРеквизиту("КодИсточника", "S930") = Магазин, ТекМагазин.НомерДокумента + "_" + "S930", ТекМагазин.НомерДокумента);
		Док.Дата                  = ТекМагазин.Дата;
		Док.МагазинОтправитель    = МагазинОтпарвитель;
		Док.СкладОтправитель      = МагазинОтпарвитель.СкладПоступления;
		Док.МагазинПолучатель     = Магазин;
		Док.СкладПолучатель       = Склад;
		Док.Страна                = Магазин.Страна;
		Док.Организация           = Док.СкладОтправитель.Организация;
		Док.ОрганизацияПолучатель = Док.СкладПолучатель.Организация;
		Док.Ответственный         = ПараметрыСеанса.ТекущийПользователь;
		Док.ДокументОснование     = ДокументОснование;
		Док.ТипПеремещение        = Перечисления.ТипыПеремещений.VS_401;
		Док.ТранспортныйДокумент  = НомерЭкспорта; 
		Док.ПредставлениеДокументаОснования = ЗаголовокПоступления;
		
		ТоварыМагазина = ТаблицаТоваровДляПеремещениеТоваров.НайтиСтроки(СтруктураПоиска);
		
		Для Каждого ТекСтрокаТовара Из ТоварыМагазина Цикл 
				
			НовСтрокаТовары = Док.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрокаТовары, ТекСтрокаТовара,, "Сумма");
			
			Если Не ЗначениеЗаполнено(НовСтрокаТовары.Номенклатура) ИЛИ НЕ ЗначениеЗаполнено(НовСтрокаТовары.Характеристика) Тогда
				Возврат "Transfer doc contains blank product or blank size:" + ТекМагазин.НомерДокумента;
			КонецЕсли;
		
			НовСтрокаТовары.КоличествоУпаковок = ТекСтрокаТовара.Количество;
			
		КонецЦикла;
		
		Попытка
			Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		Исключение
			Возврат ОписаниеОшибки();
		КонецПопытки;
		
		ДокДетали = Документы.ПеремещениеТоваровДетали.СоздатьДокумент();		
		
		ДокДетали.Дата               = ТекМагазин.Дата;
		ДокДетали.ВходящийНомер      = Док.ВходящийНомер;
		ДокДетали.МагазинОтправитель = МагазинОтпарвитель;
		ДокДетали.СкладОтправитель   = МагазинОтпарвитель.СкладПоступления;
		ДокДетали.МагазинПолучатель  = Магазин;
		ДокДетали.СкладПолучатель    = Склад;
		ДокДетали.Страна             = Магазин.Страна;
		ДокДетали.ДокументОснование  = Док.Ссылка;
		ДокДетали.Статус             = Перечисления.СтатусыПеремещениеТоваровДетали.ОжидаетсяПрибытие;
		
		ТоварыМагазина = Товары.НайтиСтроки(СтруктураПоиска);
		
		ТекКоробкаНомер   = "";
		УИДСтрока         = "";
		КоличествоВКоробке = 0;
		
		Для Каждого ТекСтрокаТовара Из ТоварыМагазина Цикл 
			
			Если ТекКоробкаНомер <> ТекСтрокаТовара.НомерКоробки Тогда 
				
				УИД = Новый УникальныйИдентификатор;
				УИДСтрока = Строка(УИД);
				
				КолВК = ДокДетали.Коробки.Количество();
				Если КолВК > 0 Тогда 
					ДокДетали.Коробки[КолВК - 1].Количество = КоличествоВКоробке;
					КоличествоВКоробке = 0;
				КонецЕсли;
				
				НовКоробка = ДокДетали.Коробки.Добавить();
				НовКоробка.НомерКоробки  = ТекСтрокаТовара.НомерКоробки;
				НовКоробка.НомерОтгрузки = ТекСтрокаТовара.НомерОтгрузки;
				НовКоробка.УИДКоробки    = УИДСтрока;
				НовКоробка.Статус        = Перечисления.СтатусыКоробок.НеДоставлено;
				НовКоробка.Длина         = ТекСтрокаТовара.Длина;
				НовКоробка.Высота        = ТекСтрокаТовара.Высота;
				НовКоробка.Вес           = ТекСтрокаТовара.Вес;
				НовКоробка.Ширина        = ТекСтрокаТовара.Ширина;

			КонецЕсли;
			
			НовСтрокаТовары = ДокДетали.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрокаТовары, ТекСтрокаТовара);
			НовСтрокаТовары.УИДКоробки = УИДСтрока;
			
			ТекКоробкаНомер    = ТекСтрокаТовара.НомерКоробки;
			КоличествоВКоробке = КоличествоВКоробке + ТекСтрокаТовара.Количество;
		КонецЦикла;
		
		КолВК = ДокДетали.Коробки.Количество();
		Если КолВК > 0 Тогда 
			ДокДетали.Коробки[КолВК - 1].Количество = КоличествоВКоробке;
		КонецЕсли;
		
		Попытка
			ДокДетали.Записать();
		Исключение
			Возврат ОписаниеОшибки();
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Истина;
КонецФункции

Функция ПолучитьДеталиПоступления(ВходящийНомер = Неопределено, НомерЭкспорта = Неопределено, ЗаголовокПоступления = Неопределено, ВсеПоступления = Ложь)
	
	ДополнительныеПараметры = ПолучитьДопПараметры();
	
	СтруктураОтправленныхДанных = КоннекторHTTP.GetJson(ВнешняяСистема.URL + "/api/Warehouse/GetShipmentDetailsByProcessCode?processCode=S&companyCode=13&officeCode=079-M",
	, ДополнительныеПараметры);
	
	Если ТипЗнч(СтруктураОтправленныхДанных) = Тип("Соответствие") Тогда
		Если НЕ СтруктураОтправленныхДанных.Получить("success") Тогда
			Возврат СтруктураОтправленныхДанных;
		КонецЕсли;
	Иначе
		Возврат СтруктураОтправленныхДанных;
	КонецЕсли;
	
	СтруктураОтправленныхДанных = СтруктураОтправленныхДанных.Получить("data");

	Если ТипЗнч(СтруктураОтправленныхДанных) <> Тип("Массив") Тогда 
		Возврат СтруктураОтправленныхДанных;
	КонецЕсли;

	МассивСтрок              = СтруктураОтправленныхДанных;
	ТаблицаДанныхПоступления = ПолучитьТаблицуДанныхПоступлений();

	Для Каждого ТекСтрока Из МассивСтрок Цикл 
		
		Если ВсеПоступления = Ложь Тогда 
			Если ВходящийНомер = ТекСтрока.Получить("invoiceNumber") И НомерЭкспорта = ТекСтрока.Получить("shippingNumber") Тогда   
				// Подходит под условие
			Иначе
				Продолжить;
			КонецЕсли; 
		КонецЕсли;

		НовСтрока = ТаблицаДанныхПоступления.Добавить();
		НовСтрока.НомерДокумента     = СокрЛП(ТекСтрока.Получить("invoiceNumber"));
		НовСтрока.Номер              = СокрЛП(ТекСтрока.Получить("shippingNumber"));
		НовСтрока.Дата               = ПрочитатьДатуJSON(ТекСтрока.Получить("shippingDate"), ФорматДатыJSON.ISO);
		НовСтрока.ЗаголовокДокумента = СокрЛП(ТекСтрока.Получить("shipmentHeaderID"));
		НовСтрока.КодМагазина        = СокрЛП(ТекСтрока.Получить("storeCode"));
		НовСтрока.Штрихкод           = СокрЛП(ТекСтрока.Получить("usedBarcode"));
		НовСтрока.Количество         = ТекСтрока.Получить("qty1");
		
		НовСтрока.НомерКоробки       = СокрЛП(ТекСтрока.Получить("lineDescription"));
		Если ПустаяСтрока(НовСтрока.НомерКоробки) Тогда 
			НовСтрока.НомерКоробки   = НовСтрока.Номер;
		КонецЕсли;
		
		МассивРазделенногоТовара = СтрРазделить(ТекСтрока.Получить("sku"), "-");
		
		Если МассивРазделенногоТовара.Количество() = 3 Тогда
			НовСтрока.Размер = СокрЛП(МассивРазделенногоТовара[2]);		
		Иначе
			НовСтрока.Размер = Строка(ТекСтрока.Получить("itemDim1Code"));
		КонецЕсли; 

		НовСтрока.Модель    = СокрЛП(ТекСтрока.Получить("itemCode"));
		НовСтрока.Артикул   = СокрЛП(ТекСтрока.Получить("itemCode")) + СокрЛП(ТекСтрока.Получить("colorCode"));
		НовСтрока.КодВалюты = СокрЛП(ТекСтрока.Получить("currencyCode"));
		НовСтрока.Сумма     = ТекСтрока.Получить("costAmount");

	КонецЦикла;
	
	Возврат ТаблицаДанныхПоступления;
	
КонецФункции

Функция ПолучитьТаблицуДанныхПоступлений()
	
	ТаблицаДанныхПоступлений = Новый ТаблицаЗначений;
	ТаблицаДанныхПоступлений.Колонки.Добавить("НомерДокумента",     Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ТаблицаДанныхПоступлений.Колонки.Добавить("Дата",               ОбщегоНазначенияРТКлиентСервер.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата));
	ТаблицаДанныхПоступлений.Колонки.Добавить("КодМагазина",        Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(30)));
	ТаблицаДанныхПоступлений.Колонки.Добавить("Штрихкод",           Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(13)));
	ТаблицаДанныхПоступлений.Колонки.Добавить("Количество",         ОбщегоНазначенияРТКлиентСервер.ПолучитьОписаниеТиповЧисла(15, 3));
	ТаблицаДанныхПоступлений.Колонки.Добавить("Номер",              Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
