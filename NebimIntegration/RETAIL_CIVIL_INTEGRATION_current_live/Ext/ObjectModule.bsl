								ВызватьИсключение "Не найден размер для лота - " + ТекРазмеры.ПОлучить("itemDim1Code");
							КонецЕсли;
						КонецЦикла;
						СпрОб.Записать();
					ИначеЕсли ОбновитьЛот = истина Тогда
						Сообщить("Обновляем лот - " + ТекЛот.Получить("lotBarcode"));
						
						
						СпрОб = Выборка.Ссылка.ПолучитьОбъект();
						СпрОб.Лоты.Очистить();
						СпрОб.Владелец = ПолучитьНоменклатуруПоАртикулу(Модель + ЦветКодИсточник);
						СпрОб.ЛотКод = ТекЛот.Получить("lotCode");
						СпрОб.ЛотШтрихкод = ТекЛот.Получить("lotBarcode"); 
						СпрОб.Наименование = ТекЛот.Получить("lotDescription");
						Для Каждого ТекРазмеры Из ТекЛот.Получить("detail") Цикл
							ДобЛот= СпрОб.Лоты.Добавить();
							ЗапросШтрихкод = Новый Запрос;
							ЗапросШтрихкод.УстановитьПараметр("Владелец",		СпрОб.Владелец);
							ЗапросШтрихкод.УстановитьПараметр("Наименование",	ТекРазмеры.Получить("itemDim1Code"));
							ЗапросШтрихкод.Текст = "ВЫБРАТЬ
							|	Штрихкоды.Штрихкод КАК Штрихкод,
							|	Штрихкоды.Характеристика КАК Характеристика
							|ИЗ
							|	РегистрСведений.Штрихкоды КАК Штрихкоды
							|ГДЕ
							|	Штрихкоды.Владелец = &Владелец
							|	И Штрихкоды.Характеристика.Наименование = &Наименование";
							ВыборкаШтрихкод = ЗапросШтрихкод.Выполнить().Выбрать();
							Если ВыборкаШтрихкод.Следующий() Тогда
								ДобЛот.Штрихкод = ВыборкаШтрихкод.Штрихкод;
								ДобЛот.Характеристика = ВыборкаШтрихкод.Характеристика;
								ДобЛот.Количество = ТекРазмеры.Получить("lotQty");
							Иначе                                                     
								ВызватьИсключение "Не найден размер для лота - " + ТекРазмеры.ПОлучить("itemDim1Code");
							КонецЕсли;
						КонецЦикла;
						СпрОб.Записать();
						
					КонецЕсли;   
				КонецЦикла;
				ЗафиксироватьТранзакцию();
				ЗаписатьВЖурналРегистра(ПараметрыИсточника, Модель + ЦветКодИсточник , Истина,);
			Исключение
				ОтменитьТранзакцию();
				ЗаписатьВЖурналРегистра(ПараметрыИсточника, Модель + ЦветКодИсточник , Ложь,ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла; 
	Иначе
		ЗаписатьВЖурналРегистра(ПараметрыИсточника, Модель + ЦветКодИсточник , Ложь, ВывестиЖейсонКакСтроку(Ответ));
	КонецЕсли;
	
КонецФункции

