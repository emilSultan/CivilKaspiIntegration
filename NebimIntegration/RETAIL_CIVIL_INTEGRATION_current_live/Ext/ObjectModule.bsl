Функция СоздатьОбновитьДополнительныеРеквизиты(НоменклатураСсылка)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", НоменклатураСсылка);
	Запрос.УстановитьПараметр("Страна", Справочники.Страны.НайтиПоКоду("12")); 
	Запрос.УстановитьПараметр("ВидМаркируемойПродукции", Справочники.ТТ_ВидыСерийныхНомеров.Обувь);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатурныеДополнительныеРеквизиты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.НоменклатурныеДополнительныеРеквизиты КАК НоменклатурныеДополнительныеРеквизиты
	               |ГДЕ
	               |	НоменклатурныеДополнительныеРеквизиты.Владелец = &Владелец
	               |	И НоменклатурныеДополнительныеРеквизиты.Страна = &Страна
	               |	И НоменклатурныеДополнительныеРеквизиты.ВидМаркируемойПродукции = &ВидМаркируемойПродукции
	               |	И НоменклатурныеДополнительныеРеквизиты.МаркируемаяПродукция = ИСТИНА";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
		
	Иначе 
		
		СпрЭлемент = Справочники.НоменклатурныеДополнительныеРеквизиты.СоздатьЭлемент();
		СпрЭлемент.ВидМаркируемойПродукции = Справочники.ТТ_ВидыСерийныхНомеров.Обувь;
		СпрЭлемент.Владелец = НоменклатураСсылка;
		СпрЭлемент.МаркируемаяПродукция = истина;
		СпрЭлемент.Наименование = НоменклатураСсылка.Наименование;
		СпрЭлемент.Страна = Справочники.Страны.НайтиПоКоду("12");
		//ДобРазмер = СпрЭлемент.Размеры.Добавить();  
		//ДобРазмер.Характеристика = ;
		СпрЭлемент.Записать();
		
	КонецЕсли;

КонецФункции

Функция СоздатьХарактеристики(МассивШтрихкодов, Номенклатура)
	
	ТаблицуДанных = Новый ТаблицаЗначений;
	
	ТаблицуДанных.Колонки.Добавить("Size",         Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ТаблицуДанных.Колонки.Добавить("SizeDescr",    Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(30)));
	ТаблицуДанных.Колонки.Добавить("SizeAndAge",    Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(30)));
	ТаблицуДанных.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));

	Для Каждого ТекСтрока Из МассивШтрихкодов Цикл 
		
		НовСтрока = ТаблицуДанных.Добавить();
		НовСтрока.Size    	   = ТекСтрока.Получить("Size");
		НовСтрока.Номенклатура = Номенклатура;
		НовСтрока.SizeDescr    	   = ТекСтрока.Получить("SizeDescr");
		НовСтрока.SizeAndAge    	= ТекСтрока.Получить("SizeAndAge");

	КонецЦикла;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицуДанных);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	               |	ВТ_Номенклатура.Size КАК Size,
	               |	ВТ_Номенклатура.SizeDescr КАК SizeDescr,
	               |	ВТ_Номенклатура.SizeAndAge КАК SizeAndAge
	               |ПОМЕСТИТЬ ВТ_Характеристику
	               |ИЗ
	               |	&ТаблицаДанных КАК ВТ_Номенклатура
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номенклатура,
	               |	Size
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВТ_Характеристику.Номенклатура КАК Номенклатура,
	               |	ВТ_Характеристику.Size КАК Size,
	               |	ВТ_Характеристику.SizeDescr КАК SizeDescr,
	               |	ВТ_Характеристику.SizeAndAge КАК SizeAndAge
	               |ИЗ
	               |	ВТ_Характеристику КАК ВТ_Характеристику
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	               |		ПО ВТ_Характеристику.Номенклатура = ХарактеристикиНоменклатуры.Владелец
	               |			И ВТ_Характеристику.Size = ХарактеристикиНоменклатуры.Наименование
	               |ГДЕ
	               |	ХарактеристикиНоменклатуры.Ссылка ЕСТЬ NULL";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Сообщить(Выборка.Количество()); 
	
	Сообщить(Номенклатура.Артикул);
	
	Пока Выборка.Следующий() Цикл 
		СпрОбъект = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
		СпрОбъект.Владелец			= Номенклатура;
		СпрОбъект.Наименование 		= Выборка.Size;
		СпрОбъект.Описание 			= Выборка.SizeDescr;
		СпрОбъект.ВозврастИРазмер = Выборка.SizeAndAge;
		
		Сообщить(Номенклатура);
		Сообщить(Выборка.Size);
		Сообщить(Выборка.SizeDescr);
		Сообщить(Выборка.SizeAndAge);

		Попытка
			СпрОбъект.Записать();
		Исключение
			
			Возврат "Error while creating Size: " + Выборка.Size + " for product " + Номенклатура.Артикул + " Ошибка:" + ОписаниеОшибки();
			
		КонецПопытки;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьТаблицуШтрихкодов(МассивШтрихкодов, Номенклатура)
	ТаблицуДанных = Новый ТаблицаЗначений;
	ТаблицуДанных.Колонки.Добавить("Barcode",      Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ТаблицуДанных.Колонки.Добавить("Size",         Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ТаблицуДанных.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Для Каждого ТекСтрока Из МассивШтрихкодов Цикл 
		НовСтрока = ТаблицуДанных.Добавить();
		НовСтрока.Barcode = ТекСтрока.Получить("Barcode");
		НовСтрока.Size    = ТекСтрока.Получить("Size");
		НовСтрока.Номенклатура = Номенклатура;
	КонецЦикла;
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицуДанных);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	               |	ВТ_Номенклатура.Size КАК Size,
	               |	ВТ_Номенклатура.Barcode КАК Barcode
	               |ПОМЕСТИТЬ ВТ_Характеристику
	               |ИЗ
	               |	&ТаблицаДанных КАК ВТ_Номенклатура
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номенклатура,
	               |	Size
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Характеристику.Номенклатура КАК Номенклатура,
	               |	ВТ_Характеристику.Barcode КАК Штрихкод,
	               |	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика
	               |ИЗ
	               |	ВТ_Характеристику КАК ВТ_Характеристику
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	               |		ПО ВТ_Характеристику.Номенклатура = ХарактеристикиНоменклатуры.Владелец
	               |			И ВТ_Характеристику.Size = ХарактеристикиНоменклатуры.Наименование";
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция СоздатьШтрихкоды(Владелец, МассивШтрихкодов)
	
	СоздалиХарактеристики = СоздатьХарактеристики(МассивШтрихкодов, Владелец);
	Если ТипЗнч(СоздалиХарактеристики) <> Тип("Булево") Тогда 
		ВызватьИсключение СоздалиХарактеристики;
	КонецЕсли;
	
	ТЗШтрихкодов = ПолучитьТаблицуШтрихкодов(МассивШтрихкодов, Владелец);
	//УдалитьШтрихкоды(Владелец);
	
	Для Каждого ТекСтрока Из ТЗШтрихкодов Цикл 
		Запись = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
		Запись.Владелец       = ТекСтрока.Номенклатура;
		Запись.Характеристика = ТекСтрока.Характеристика;
		Запись.ТипШтрихкода   = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
		Запись.Штрихкод       = ТекСтрока.Штрихкод;
		Запись.Записать(Истина);
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьНоменклатурыБезЛота(Модель, Обновить = Ложь)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Модель",Модель);
	Запрос.УстановитьПараметр("Обновить", Обновить);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Артикул КАК Артикул,
	               |	Номенклатура.Код КАК Код,
	               |	Номенклатура.Модель КАК Модель,
	               |	Номенклатура.Цвет.КодИсточник КАК ЦветКодИсточник
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатурныеЛоты КАК НоменклатурныеЛоты
	               |		ПО (НоменклатурныеЛоты.Владелец = Номенклатура.Ссылка)
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА &Обновить = ИСТИНА
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ НоменклатурныеЛоты.Ссылка ЕСТЬ NULL
	               |		КОНЕЦ
	               |	И Номенклатура.Модель = &Модель";
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьНоменклатуруПоАртикулу(Артикул)
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Артикул",Артикул);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.Артикул = &Артикул";
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;

КонецФункции

Функция ПолучитьЛоты(Модель = Неопределено, Обновить = ложь) Экспорт
	
	ПараметрыИсточника = ПолучитьПараметрИсточника("GET_LOT");
	
	Результат = ПолучитьНоменклатурыБезЛота(Модель, Обновить);
	
	Для Каждого ТекСтрока Из Результат Цикл 
		
		ПолучитьЛотыПоАртикулу(ТекСтрока.Модель, ТекСтрока.ЦветКодИсточник, ПараметрыИсточника, Обновить);

	КонецЦикла;

КонецФункции

Функция ПолучитьЛотыПоАртикулу(Модель, ЦветКодИсточник,ПараметрыИсточника, ОбновитьЛот = ложь)
	
	ДопПараметры =ПолучитьДопПараметры();
	Ответ = КоннекторHTTP.GetJson(ВнешняяСистема.URL +"/api/Products/GetProductLotDetail?ItemCode=" + Модель + "&colorCode=" +ЦветКодИсточник,,ДопПараметры );
	Если Ответ.Получить("success") = истина Тогда
		Для Каждого ТекСтрока Из Ответ.Получить("data") Цикл 
			Попытка 
				НачатьТранзакцию();
				Для Каждого ТекЛот Из ТекСтрока.Получить("lotBarcode") Цикл 
					Запрос = Новый Запрос;
					Запрос.УстановитьПараметр("ЛотШтрихкод",ТекЛот.Получить("lotBarcode"));
					Запрос.УстановитьПараметр("Артикул", Модель + ЦветКодИсточник);
					Запрос.Текст = "ВЫБРАТЬ
					               |	НоменклатурныеЛоты.Ссылка КАК Ссылка
					               |ИЗ
					               |	Справочник.НоменклатурныеЛоты КАК НоменклатурныеЛоты
					               |ГДЕ
					               |	НоменклатурныеЛоты.ПометкаУдаления = ЛОЖЬ
					               |	И НоменклатурныеЛоты.ЛотШтрихкод = &ЛотШтрихкод
					               |	И НоменклатурныеЛоты.Владелец.Артикул = &Артикул";
					Выборка = Запрос.Выполнить().Выбрать(); 
					Если НЕ Выборка.Следующий() Тогда
						Сообщить("Создаем лот - " + ТекЛот.Получить("lotBarcode"));
						СпрОб = Справочники.НоменклатурныеЛоты.СоздатьЭлемент();
						СпрОб.Владелец = ПолучитьНоменклатуруПоАртикулу(Модель + ЦветКодИсточник);
						СпрОб.ЛотКод = ТекЛот.Получить("lotCode");
