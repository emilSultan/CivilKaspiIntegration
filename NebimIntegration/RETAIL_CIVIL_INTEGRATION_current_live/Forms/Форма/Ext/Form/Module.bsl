Функция ПолучитьШтрихкодПоНоменклатуре()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Штрихкоды.Штрихкод КАК Штрихкод
	               |ИЗ
	               |	РегистрСведений.Штрихкоды КАК Штрихкоды
	               |ГДЕ
	               |	Штрихкоды.Владелец = &Владелец";

	Запрос.Выполнить().Выбрать();
	
КонецФункции

&НаКлиенте
Процедура ПроверитьЦену(Команда)

	Если Не ЗначениеЗаполнено(ВидЦены) Тогда 
		Сообщить("Выберите вид цены!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Номенклатура) и Штрихкод = "" Тогда 
		Сообщить("Заполните номенклатуру или штрихкод!");
		Возврат;
	КонецЕсли;
	
	ШтрихкодДляПроверки = "";
	
	Если Штрихкод <> "" ТОгда
		ШтрихкодДляПроверки  = Штрихкод;	
	Иначе
		ШтрихкодДляПроверки	= ПолучитьШтрихкодПоНоменклатуре();
	КонецЕсли;
	
	ПроверитьЦенуНаСервере(ШтрихкодДляПроверки);
	

КонецПроцедуры 

