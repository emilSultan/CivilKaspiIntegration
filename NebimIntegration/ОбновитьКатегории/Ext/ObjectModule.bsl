Перем ВнешняяСистема;


#Область Вспомогательные_функции

Функция ПолучитьСсылкуВнешнейСистемы()
	ВнешняяСистема = Справочники.ИнтеграцияВнешниеСистемы.НайтиПоНаименованию("RTL_NEBIM_INTEGRATION");
	Если Не ЗначениеЗаполнено(ВнешняяСистема) Тогда
		Спр = Справочники.ИнтеграцияВнешниеСистемы.СоздатьЭлемент();
		Спр.Наименование = "RTL_NEBIM_INTEGRATION";
		Спр.URL = "https://gateway.civil.com.tr:8080";
		Спр.Записать();
		ВнешняяСистема = Спр.Ссылка;
	КонецЕсли;
	Возврат ВнешняяСистема;
КонецФункции

Функция ПолучитьПараметрИсточника(ИмяКоманды)
	Параметр = РэтмайндКэш.ПолучитьПараметрПоИмяКоманды(ИмяКоманды, ВнешняяСистема);
	Если ЗначениеЗаполнено(Параметр) Тогда
		Возврат Параметр;
	Иначе
		//на всякий случай проверим запросом, может создали, ко кэшировать еще не успели!
		ВнешняяСистема = ПолучитьСсылкуВнешнейСистемы();
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("ИмяКоманды", ИмяКоманды);
		Запрос.УстановитьПараметр("Владелец",   ВнешняяСистема);
		Запрос.Текст = "ВЫБРАТЬ
		|	ИнтеграцияПараметры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИнтеграцияПараметры КАК ИнтеграцияПараметры
		|ГДЕ
		|	ИнтеграцияПараметры.ИмяКоманды = &ИмяКоманды
		|	И ИнтеграцияПараметры.Владелец = &Владелец";

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	Спр = Справочники.ИнтеграцияПараметры.СоздатьЭлемент();
	Спр.Наименование = ИмяКоманды;
	Спр.ИмяКоманды   = ИмяКоманды;
	Спр.Владелец     = ВнешняяСистема;
	Спр.Статус		 = Истина;
	Спр.Записать();
	Возврат Спр.Ссылка;
КонецФункции

#КонецОбласти


#Область http_сервис

Функция ПолучитьТокен(ПринудительноОбновить = Ложь)

	ИмяПользователя 	= "rmadmin";
	Токен = ХранилищеОбщихНастроек.Загрузить("CIVIL_TOKEN", "CIVIL_TOKEN",, ИмяПользователя);
	Если ПринудительноОбновить = Ложь Тогда
		Если Токен <> Неопределено Тогда
			ДатаПолучениеПоследногоТокена = ХранилищеОбщихНастроек.Загрузить("CIVIL_TOKEN_DATE", "CIVIL_TOKEN_DATE",, ИмяПользователя);
			Если ДатаПолучениеПоследногоТокена <> Неопределено Тогда
				Секунды = ТекущаяДатаСеанса() - ДатаПолучениеПоследногоТокена;
				Если Секунды < 86400 Тогда
					Возврат Токен;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Адрес  = ВнешняяСистема.URL + "/Token";
	Тело = Новый Структура;
	Тело.Вставить("userName", "kazakistan@civil.com.tr");
	Тело.Вставить("password", "A;{3Pt-th[BT|.@U");
	Ответ = КоннекторHTTP.PostJson(Адрес, Тело);
	Если ТипЗнч(Ответ) =  Тип("Строка") Тогда
		Возврат Ответ;
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

Функция ПолучитьДопПараметры()

	Токен = ПолучитьТокен();

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-type", "application/json");
	Заголовки.Вставить("Authorization","Bearer " +	Токен);
	Возврат Новый Структура("Заголовки", Заголовки);

КонецФункции

Функция ВывестиЖейсонКакСтроку(Жейсон)

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "", Истина);
	ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);

	ЗаписатьJSON(ЗаписьJSON, Жейсон);
	СтрокаДляТело = ЗаписьJSON.Закрыть();

	Возврат СтрокаДляТело;

КонецФункции

#КонецОбласти


#Область ЛОГ

Процедура ЗаписатьВЖурналРегистра(ПараметрИсточник, Идентификатор, Статус = Ложь, ТекстОшибки = "")

	УИДСтроки = РегистрыСведений.ИнтеграцияЖурналПроцессов.ПолучитьУИДСтрокиЖурнала(ПараметрИсточник, Идентификатор);

	Если УИДСтроки = Неопределено Тогда
		УИДСтроки = Новый УникальныйИдентификатор;
		РегистрыСведений.ИнтеграцияЖурналПроцессов.ЗаписатьВЖурнал(ПараметрИсточник, Идентификатор, УИДСтроки, Статус, ТекстОшибки);
	Иначе
		РегистрыСведений.ИнтеграцияЖурналПроцессов.ОбновитьЗапись(ПараметрИсточник, Идентификатор, УИДСтроки, Статус, ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область КАТЕГОРИИ

Функция НайтиСоздатьСправочникиМОП(Наименование, НаименованиеСправочника)

	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Наименование", СокрЛП(Наименование));
	ТекстЗапроса = "ВЫБРАТЬ
	               |	МОП.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.%1 КАК МОП
	               |ГДЕ
	               |	МОП.Наименование = &Наименование";

	ТекстЗапроса = СтрШаблон(ТекстЗапроса, НаименованиеСправочника);
	Запрос.Текст = ТекстЗапроса;

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		СпрОбъект = Справочники[НаименованиеСправочника].СоздатьЭлемент();
		СпрОбъект.Наименование = СокрЛП(Наименование);
		СпрОбъект.Записать();
		Возврат СпрОбъект.Ссылка;
	КонецЕсли;

КонецФункции

// Ответ сервиса не содержит GENDER/CATEGORY/PRODUCT GROUP отдельными полями -
// они лежат внутри массива "attributes" как {attributeTypeDesc, attributeDesc}.
Функция ПолучитьЗначениеАтрибута(ТекСтрока, ИмяТипаАтрибута)

	Для Каждого ТекАттриб Из ТекСтрока.Получить("attributes") Цикл
		Если ТекАттриб.Получить("attributeTypeDesc") = ИмяТипаАтрибута Тогда
			Возврат ТекАттриб.Получить("attributeDesc");
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьДанныеТоварыИзСервиса(ПараметрыИсточника, Модель)

	ДополнительныеПараметры = ПолучитьДопПараметры();
	Ответ = КоннекторHTTP.GetJson(ВнешняяСистема.URL+"/api/Products/GetProductByLangCodes?LangCodes=EN&ProductCode=" + Модель,,ДополнительныеПараметры);

	Если ТипЗнч(Ответ) = Тип("Соответствие") Тогда
		Если Ответ.Получить("success") Тогда
			Возврат Ответ.Получить("data");
		Иначе
			ЗаписатьВЖурналРегистра(ПараметрыИсточника, Модель, Ложь, ВывестиЖейсонКакСтроку(Ответ));
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		ЗаписатьВЖурналРегистра(ПараметрыИсточника, Модель, Ложь, "Получили не допустимое значение -/api/Products/GetProductByLangCodes?LangCodes=EN&ProductCode="+Модель);
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Получает с сервиса категорийность (МОП) по модели и обновляет ей
// MopDivision, MopDepartment, MopSubDepartment, MopCategory, MopClass
// (и соответствующие ссылочные реквизиты _MopDivision, _MopDepartment,
// _MopSubDepartment, _MopCategory, _MopClass) у ВСЕЙ номенклатуры с этой моделью.
Функция ОбновитьКатегорииПоМодели(Модель) Экспорт

	Модель = СокрЛП(Модель);

	Если ПустаяСтрока(Модель) Тогда
		Возврат "Не указана модель";
	КонецЕсли;

	ПараметрыИсточника = ПолучитьПараметрИсточника("UPDATE_CATEGORIES");

	Результат = ПолучитьДанныеТоварыИзСервиса(ПараметрыИсточника, Модель);

	Если Результат = Неопределено Или Результат.Количество() = 0 Тогда
		Возврат "Не удалось получить данные по модели " + Модель + " с сервиса";
	КонецЕсли;

	ТекСтрока = Результат[0];

	КлассМОП = ПолучитьЗначениеАтрибута(ТекСтрока, "PRODUCT GROUP");
	Если КлассМОП = Неопределено Тогда
		КлассМОП = ПолучитьЗначениеАтрибута(ТекСтрока, "COMMERCIAL PRODUCT");
	КонецЕсли;
	Если КлассМОП = Неопределено Тогда
		КлассМОП = "empty_prod_group";
	КонецЕсли;

	КатегорияМОП = ПолучитьЗначениеАтрибута(ТекСтрока, "CATEGORY");

	СпрMopDivision      = НайтиСоздатьСправочникиМОП(ТекСтрока.Получить("productHierarchyLevel01"), 	"MopDivision");
	СпрMopDepartment    = НайтиСоздатьСправочникиМОП(ТекСтрока.Получить("productHierarchyLevel02"), 	"MopDepartment");
	СпрMopSubDepartment = НайтиСоздатьСправочникиМОП(ТекСтрока.Получить("productHierarchyLevel03"), 	"MopSubDepartment");
	СпрMopCategory      = НайтиСоздатьСправочникиМОП(КатегорияМОП, 									"MopCategory");
	СпрMopClass         = НайтиСоздатьСправочникиМОП(КлассМОП, 										"MopClass");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Модель = &Модель";

	Выборка = Запрос.Выполнить().Выбрать();

	КоличествоОбновлено = 0;

	Пока Выборка.Следующий() Цикл

		СпрОбъект = Выборка.Ссылка.ПолучитьОбъект();

		СпрОбъект.MopDivision       = СпрMopDivision.Наименование;
		СпрОбъект._MopDivision      = СпрMopDivision;
		СпрОбъект.MopDepartment     = СпрMopDepartment.Наименование;
		СпрОбъект._MopDepartment    = СпрMopDepartment;
		СпрОбъект.MopSubDepartment  = СпрMopSubDepartment.Наименование;
		СпрОбъект._MopSubDepartment = СпрMopSubDepartment;
		СпрОбъект.MopCategory       = СпрMopCategory.Наименование;
		СпрОбъект._MopCategory      = СпрMopCategory;
		СпрОбъект.MopClass          = СпрMopClass.Наименование;
		СпрОбъект._MopClass         = СпрMopClass;

		Попытка
			СпрОбъект.ДополнительныеСвойства.Вставить("ЗарегистрироватьДляОбмена", Истина);
			СпрОбъект.Записать();
			КоличествоОбновлено = КоличествоОбновлено + 1;
		Исключение
			ЗаписатьВЖурналРегистра(ПараметрыИсточника, Модель, Ложь, ОписаниеОшибки());
			Возврат "Ошибка записи " + Выборка.Ссылка.Артикул + ": " + ОписаниеОшибки();
		КонецПопытки;

	КонецЦикла;

	Если КоличествоОбновлено = 0 Тогда
		ЗаписатьВЖурналРегистра(ПараметрыИсточника, Модель, Ложь, "Номенклатура с такой моделью не найдена в базе");
		Возврат "Номенклатура с моделью " + Модель + " не найдена в базе";
	КонецЕсли;

	ЗаписатьВЖурналРегистра(ПараметрыИсточника, Модель, Истина);

	Возврат "Обновлено позиций: " + КоличествоОбновлено;

КонецФункции

// Читает модели из первой колонки табличного документа (в него их копируют
// вручную из Excel) и для каждой обновляет категории, записывая результат
// во вторую колонку той же строки.
Процедура ОбновитьКатегорииПоТаблице(ТабДок) Экспорт

	Для Строка = 1 По ТабДок.ВысотаТаблицы Цикл

		Модель = СокрЛП(ТабДок.Область(Строка, 1).Текст);

		Если ПустаяСтрока(Модель) Тогда
			Продолжить;
		КонецЕсли;

		ТабДок.Область(Строка, 2).Текст = ОбновитьКатегорииПоМодели(Модель);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти


ВнешняяСистема = ПолучитьСсылкуВнешнейСистемы();
