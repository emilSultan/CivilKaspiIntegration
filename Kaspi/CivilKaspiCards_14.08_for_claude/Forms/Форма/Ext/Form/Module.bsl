// Списки для контроля: готовые к созданию / остаток без карточки / остаток без категории.
// Требуют трёх табличных реквизитов формы (см. CLAUDE.md или комментарий ниже):
//   СписокГотовые, СписокОстатокБезКарточки, СписокОстатокБезКатегории.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьСпискиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписки(Команда)
	ОбновитьСпискиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСпискиНаСервере()
	ОбъектСервера = НаСервере();
	ЗаполнитьСписокНаСервере(ОбъектСервера.ПолучитьСписокГотовыхКСозданию(), "СписокГотовые");
	ЗаполнитьСписокНаСервере(ОбъектСервера.ПолучитьСписокОстатокБезКарточки(), "СписокОстатокБезКарточки");
	ЗаполнитьСписокНаСервере(ОбъектСервера.ПолучитьСписокОстатокБезКатегории(), "СписокОстатокБезКатегории");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокНаСервере(Таблица, ИмяРеквизита)
	Попытка
		ЗначениеВРеквизитФормы(Таблица, ИмяРеквизита);
	Исключение
		ОписаниеКолонок = "";
		Для Каждого Колонка Из Таблица.Колонки Цикл
			ИменаТипов = "";
			Для Каждого ТекТип Из Колонка.ЗначенияТипа.Типы() Цикл
				ИменаТипов = ИменаТипов + ?(ИменаТипов = "", "", ", ") + Строка(ТекТип);
			КонецЦикла;
			ОписаниеКолонок = ОписаниеКолонок + Колонка.Имя + " (" + ИменаТипов + "); ";
		КонецЦикла;

		ТекстСообщения = "Не удалось заполнить реквизит формы """ + ИмяРеквизита + """: "
			+ "проверьте, что на форме есть табличный реквизит с точно таким именем и типом ""Таблица значений"". "
			+ "Причина: " + ОписаниеОшибки() + ". "
			+ "Колонки, которые вернул запрос: " + ОписаниеКолонок;
		Сообщить(ТекстСообщения);
	КонецПопытки;
КонецПроцедуры
