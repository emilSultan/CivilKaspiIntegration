Функция Кат_Towels(Товары, Категория, Категрия, attributes, Цвет, РазмерКапи, Пол, Сезон, СтранаИзготовитель, Number_in_sets, Рост, МассивСостава, Additional, ПолБейби, ПолБейби2)
	// Master - Towels
	МассивТайп = Новый Массив;
	CollarМассив = Новый Массив;
	TypeOfFit = Новый Массив;
	ClaspSkirt = Новый Массив;
	FillerJacket = Новый Массив;
	
			
			
			Если ЗначениеЗаполнено(Товары.LENGTH) Тогда  
				
				ДлинаСтрока = СокрЛП(Товары.LENGTH);
				
				ДлинаСтрока = СтрЗаменить(ДлинаСтрока, "см", "");
				ДлинаСтрока = СтрЗаменить(ДлинаСтрока, " ", "");
				ДлинаСтрока = СтрЗаменить(ДлинаСтрока, "СМ", "");
				ДлинаСтрока = СтрЗаменить(ДлинаСтрока, "cm", ""); 
				
				Разделитель = "";
				
				Если СтрНайти(ДлинаСтрока, "х")> 0 Тогда 
					Разделитель = "х"
				ИначеЕсли СтрНайти(ДлинаСтрока, "x") > 0 Тогда
					Разделитель = "x";
				ИначеЕсли СтрНайти(ДлинаСтрока, "X") > 0 Тогда
					Разделитель = "X";
				ИначеЕсли СтрНайти(ДлинаСтрока, "*") > 0 Тогда
					Разделитель = "*";
				КонецЕсли;
				
				Length = 0;
				Width  = 0;  
				
				Если Разделитель <> "" Тогда
					Части = СтрРазделить(ДлинаСтрока, Разделитель);
					Если Части.Количество() >= 2 Тогда
						Length = Число(СокрЛП(Части[0]));
						Width  = Число(СокрЛП(Части[1]));
					КонецЕсли;
				КонецЕсли;
			Иначе
				Возврат Ложь;
			КонецЕсли;
			
			
			attributes.Добавить(Новый Структура("code,value","Towels*Type", "полотенце"));
			attributes.Добавить(Новый Структура("code,value","Towels*Purpose", "универсальное"));
			attributes.Добавить(Новый Структура("code,value","Towels*For children", Истина));
			attributes.Добавить(Новый Структура("code,value","Towels*Waffle towel", Ложь));
			attributes.Добавить(Новый Структура("code,value","Towels*Terrycloth", Ложь));
			attributes.Добавить(Новый Структура("code,value","Towels*Brand code", "Civil"));
			attributes.Добавить(Новый Структура("code,value","Towels*Material", МассивСостава));
			attributes.Добавить(Новый Структура("code,value","Towels*Length", Length));
			attributes.Добавить(Новый Структура("code,value","Towels*Width", Width));
			attributes.Добавить(Новый Структура("code,value","Towels*Number of towels", 1));
			attributes.Добавить(Новый Структура("code,value","Home textiles*Color", Цвет));
			attributes.Добавить(Новый Структура("code,value","Towels*Size",Товары.ХарактеристикаНаименование));
	
	Возврат Истина;
