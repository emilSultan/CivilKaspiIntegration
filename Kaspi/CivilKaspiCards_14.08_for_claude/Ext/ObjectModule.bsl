Функция  GET_COMPOSITION() Экспорт
	
	Выборка  =  ПолучитьТоварыБезСостава();
	
	Пока Выборка.Следующий() Цикл 
		
		Попытка
			Адрес  =  "https://gateway.civil.com.tr:8080/api/Products/GetProductByLangCodes?LangCodes=RS&Barcode="+Выборка.Штрихкод;	
			
			Ответ= КоннекторHTTP.GetJson(Адрес,,ДопПараметрыCivil());
			
			//Сообщить(ВСтроку(Ответ));
			
			
			Если Ответ.Получить("success") Тогда
				data = Ответ.Получить("data");  
				
				Если типЗнч(data)  = Тип("Массив") Тогда 
					
					Для каждого аттрибут из   data Цикл 
						
						itemColorFabricBlend   = аттрибут.Получить("itemColorFabricBlend");  
						
						Если ТипЗнч(itemColorFabricBlend)  =  тип("Строка") Тогда
							
							Если не ПустаяСтрока(itemColorFabricBlend) Тогда
								Данные  = РазобратьСостав(itemColorFabricBlend);
								
								ЗаписатьСоставТовара(Данные,Выборка.Номенклатура,ЯзыкRU()); 
							КонецЕсли;
						КонецЕсли; 
					КонецЦикла;
				КонецЕсли;
				
			КонецЕсли; 
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
	
	
КонецФункции

