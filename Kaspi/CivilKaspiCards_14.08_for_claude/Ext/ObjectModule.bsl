Функция ПолучитьГотовыеТовары()
	
	
	Запрос  = Новый Запрос;
	Запрос.УстановитьПараметр("ИМ",Kaspi());
	Запрос.УстановитьПараметр("АттрибутПол",Справочники.мп_АттрибутыКарточек.Пол);
	Запрос.УстановитьПараметр("АттрибутЦвет",Справочники.мп_АттрибутыКарточек.Цвет);
    Запрос.УстановитьПараметр("АттрибутСезон",Справочники.мп_АттрибутыКарточек.Season);
	Запрос.УстановитьПараметр("АттрибутКатегория",Справочники.мп_АттрибутыКарточек.Категория);
	Запрос.УстановитьПараметр("АттрибутСтрана",Справочники.мп_АттрибутыКарточек.СтранаИзготовитель);
    Запрос.УстановитьПараметр("Язык",ЯзыкRU());

	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить("Master - Girl pants");
	МассивИсключений.Добавить("Master - Girl underpants");
	МассивИсключений.Добавить("Master - Newborn babies clothing sets");
	Запрос.УстановитьПараметр("ИсключённыеКатегории", МассивИсключений);
	
	
	Запрос.Текст  =  "ВЫБРАТЬ
	                 |	ИнтернетМагазинКарточки.Номенклатура КАК Номенклатура,
	                 |	ИнтернетМагазинКарточки.Характеристика КАК Характеристика
	                 |ПОМЕСТИТЬ ГотовыеТовары
	                 |ИЗ
	                 |	РегистрСведений.ИнтернетМагазинКарточки КАК ИнтернетМагазинКарточки
	                 |ГДЕ
	                 |	ИнтернетМагазинКарточки.ИнтернетМагазин = &ИМ
	                 |	И ИнтернетМагазинКарточки.ГотовКСоздании
	                 |	И ИнтернетМагазинКарточки.Создан = ЛОЖЬ
	                 |	И ИнтернетМагазинКарточки.Обработан = ЛОЖЬ
	                 |;
	                 |
	                 |////////////////////////////////////////////////////////////////////////////////
	                 |ВЫБРАТЬ
	                 |	ГотовыеТовары.Номенклатура КАК Номенклатура,
	                 |	ГотовыеТовары.Характеристика КАК Характеристика,
	                 |	Штрихкоды.Штрихкод КАК Штрихкод,
	                 |	ГотовыеТовары.Номенклатура.Артикул КАК Артикул,
	                 |	ГотовыеТовары.Номенклатура.Модель КАК Модель,
	                 |	ИнтернетМагазинРазмеры.Значение КАК РазмерПортала,
	                 |	ВЫРАЗИТЬ(СоответствиеРеквизитовИМ.Изображение1 КАК СТРОКА(200)) КАК Изображение1,
	                 |	ВЫРАЗИТЬ(СоответствиеРеквизитовИМ.Изображение2 КАК СТРОКА(200)) КАК Изображение2,
	                 |	ВЫРАЗИТЬ(СоответствиеРеквизитовИМ.Изображение3 КАК СТРОКА(200)) КАК Изображение3,
	                 |	ВЫРАЗИТЬ(СоответствиеРеквизитовИМ.Изображение4 КАК СТРОКА(200)) КАК Изображение4,
	                 |	ВЫРАЗИТЬ(СоответствиеРеквизитовИМ.Изображение5 КАК СТРОКА(200)) КАК Изображение5,
	                 |	ВЫРАЗИТЬ(СоответствиеРеквизитовИМ.Изображение6 КАК СТРОКА(200)) КАК Изображение6,
	                 |	ВЫРАЗИТЬ(СоответствиеРеквизитовИМ.Изображение7 КАК СТРОКА(200)) КАК Изображение7,
	                 |	ВЫРАЗИТЬ(СоответствиеРеквизитовИМ.Изображение8 КАК СТРОКА(200)) КАК Изображение8,
	                 |	ВЫРАЗИТЬ(СоответствиеРеквизитовИМ.Изображение9 КАК СТРОКА(200)) КАК Изображение9,
	                 |	ВЫРАЗИТЬ(СоответствиеРеквизитовИМ.Изображение10 КАК СТРОКА(200)) КАК Изображение10,
	                 |	ВЫРАЗИТЬ(мп_ДанныеКарточекПол.Значение КАК СТРОКА(30)) КАК Пол,
	                 |	ВЫРАЗИТЬ(мп_ДанныеКарточекЦвет.Значение КАК СТРОКА(50)) КАК Цвет,
	                 |	мп_Категории.Ссылка КАК Ссылка5Моп,
	                 |	ВЫРАЗИТЬ(мп_ДанныеКарточекСезоны.Значение КАК СТРОКА(100)) КАК Сезон,
	                 |	мп_АтрибутыНоменклатур.mainProductWebDescription КАК title,
	                 |	мп_АтрибутыНоменклатур.PAKETLEME КАК number_in_sets,
	                 |	ИнтернетМагазинРазмеры.РазмерПродавца КАК РазмерПродавца,
	                 |	ВЫРАЗИТЬ(мп_ДанныеКарточекСтрана.Значение КАК СТРОКА(30)) КАК СтранаПроизводства,
	                 |	мп_АтрибутыНоменклатур.COLLAR_NECKLINE_STYLE КАК COLLAR_NECKLINE_STYLE,
	                 |	мп_АтрибутыНоменклатур.PRODUCT_DETAIL КАК PRODUCT_DETAIL,
	                 |	мп_АтрибутыНоменклатур.KESİN_KONSİNYE КАК KESİN_KONSİNYE,
	                 |	мп_АтрибутыНоменклатур.SLEEVE_LENGTH КАК SLEEVE_LENGTH,
	                 |	мп_АтрибутыНоменклатур.LENGTH КАК LENGTH
	                 |ПОМЕСТИТЬ Меппинг
	                 |ИЗ
	                 |	ГотовыеТовары КАК ГотовыеТовары
	                 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИнтернетМагазинРазмеры КАК ИнтернетМагазинРазмеры
	                 |		ПО ГотовыеТовары.Номенклатура._MopDivision = ИнтернетМагазинРазмеры.MopDivision
	                 |			И ГотовыеТовары.Номенклатура._MopDepartment = ИнтернетМагазинРазмеры.MopDepartment
	                 |			И ГотовыеТовары.Номенклатура._MopSubDepartment = ИнтернетМагазинРазмеры.Пол
	                 |			И ГотовыеТовары.Номенклатура._MopCategory = ИнтернетМагазинРазмеры.MopCategory
	                 |			И ГотовыеТовары.Номенклатура._MopClass = ИнтернетМагазинРазмеры.Категория
	                 |			И ГотовыеТовары.Характеристика.Наименование = ИнтернетМагазинРазмеры.Размер
	                 |			И (ИнтернетМагазинРазмеры.ИнтернетМагазин = &ИМ)
	                 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
	                 |		ПО ГотовыеТовары.Номенклатура = Штрихкоды.Владелец
	                 |			И ГотовыеТовары.Характеристика = Штрихкоды.Характеристика
	                 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеРеквизитовИМ КАК СоответствиеРеквизитовИМ
	                 |		ПО ГотовыеТовары.Номенклатура = СоответствиеРеквизитовИМ.Номенклатура
	                 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.мп_ДанныеКарточек КАК мп_ДанныеКарточекПол
	                 |		ПО ГотовыеТовары.Номенклатура.Пол = мп_ДанныеКарточекПол.СсылкаОбъекта
	                 |			И (мп_ДанныеКарточекПол.Аттрибут = &АттрибутПол)
	                 |			И (мп_ДанныеКарточекПол.ИнтернетМагазин = &ИМ)
	                 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.мп_Категории КАК мп_Категории
	                 |		ПО ГотовыеТовары.Номенклатура._MopDivision = мп_Категории._MopDivision
	                 |			И ГотовыеТовары.Номенклатура._MopDepartment = мп_Категории._MopDepartment
	                 |			И ГотовыеТовары.Номенклатура._MopSubDepartment = мп_Категории._MopSubDepartment
	                 |			И ГотовыеТовары.Номенклатура._MopCategory = мп_Категории._MopCategory
	                 |			И ГотовыеТовары.Номенклатура._MopClass = мп_Категории._MopClass
	                 |			И ГотовыеТовары.Номенклатура.Пол = мп_Категории.Пол
	                 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.мп_ДанныеКарточек КАК мп_ДанныеКарточекЦвет
	                 |		ПО ГотовыеТовары.Номенклатура.Цвет = мп_ДанныеКарточекЦвет.СсылкаОбъекта
	                 |			И (мп_ДанныеКарточекЦвет.Аттрибут = &АттрибутЦвет)
	                 |			И (мп_ДанныеКарточекЦвет.ИнтернетМагазин = &ИМ)
