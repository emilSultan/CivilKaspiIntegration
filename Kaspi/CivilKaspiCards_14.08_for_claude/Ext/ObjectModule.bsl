Функция GET_PHOTO()  Экспорт
	
	Штрихкоды  = ПолучитьТоварыБезФото();
	
	Пока Штрихкоды.Следующий() Цикл
		
		Попытка
			Адрес  =  "https://gateway.civil.com.tr:8080/api/Pim/GetProductImageByBarcode?barcode="+Штрихкоды.Штрихкод;	
			
			Ответ= КоннекторHTTP.GetJson(Адрес,,ДопПараметрыCivil());
			
			//Сообщить(ВСтроку(Ответ));
			
			
			Если Ответ.Получить("success") Тогда
				data = Ответ.Получить("data");
				
				Если ТипЗнч(data)  = Тип("Массив") Тогда 
					
					Если data.Количество() = 0 Тогда
						Продолжить;
					КонецЕсли;
					
					
					imageUrls = data[0].Получить("imageUrls"); 
					Если imageUrls  = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					Если imageUrls.Количество() > 0  Тогда
						МЗ  =  РегистрыСведений.СоответствиеРеквизитовИМ.СоздатьМенеджерЗаписи();
						МЗ.Номенклатура  =  Штрихкоды.Номенклатура;
						Для i = 0 По imageUrls.Количество() - 1 Цикл
							
							Если i = 0 Тогда МЗ.Изображение1 = imageUrls[i]; КонецЕсли;
							Если i = 1 Тогда МЗ.Изображение2 = imageUrls[i]; КонецЕсли;
							Если i = 2 Тогда МЗ.Изображение3 = imageUrls[i]; КонецЕсли;
							Если i = 3 Тогда МЗ.Изображение4 = imageUrls[i]; КонецЕсли;
							Если i = 4 Тогда МЗ.Изображение5 = imageUrls[i]; КонецЕсли;
							Если i = 5 Тогда МЗ.Изображение6 = imageUrls[i]; КонецЕсли;
							Если i = 6 Тогда МЗ.Изображение7 = imageUrls[i]; КонецЕсли;
							Если i = 7 Тогда МЗ.Изображение8 = imageUrls[i]; КонецЕсли;
							Если i = 8 Тогда МЗ.Изображение9 = imageUrls[i]; КонецЕсли;
							Если i = 9 Тогда МЗ.Изображение10 = imageUrls[i]; КонецЕсли;
							
						КонецЦикла;
						МЗ.Записать();
					КонецЕсли;
					
					
				КонецЕсли;
			КонецЕсли;
		Исключение 
			Сообщить(ОписаниеОшибки());
			Продолжить;
		КонецПопытки;
		
	КонецЦикла;
	

	
КонецФункции

