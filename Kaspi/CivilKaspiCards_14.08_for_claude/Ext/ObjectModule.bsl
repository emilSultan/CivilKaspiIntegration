Функция ПоставитьГалочкуОбработан(Номенклатура,Характеристика,айди)
	
	МЗ  =  РегистрыСведений.ИнтернетМагазинКарточки.СоздатьНаборЗаписей();
	МЗ.Отбор.ИнтернетМагазин.Установить(Kaspi());
	МЗ.Отбор.Номенклатура.Установить(Номенклатура);
	МЗ.Отбор.Характеристика.Установить(Характеристика);
	МЗ.Прочитать();
	
	Если МЗ.Количество() > 0 Тогда
		Для Каждого тек из МЗ Цикл
			тек.Обработан =  Истина; 
			тек.айди_портала   = айди;
			тек.ДатаСоздания =  ТекущаяДатаСеанса();
		КонецЦикла;
	КонецЕсли;
	МЗ.Записать();
	
КонецФункции

Функция ЗаписатьОшибкуПриСоздании(Номенклатура,Характеристика,Ошибка,НеСоздовать=Ложь)
	
	
	МЗ  =  РегистрыСведений.ИнтернетМагазинКарточки.СоздатьНаборЗаписей();
	МЗ.Отбор.ИнтернетМагазин.Установить(Kaspi());
	МЗ.Отбор.Номенклатура.Установить(Номенклатура);
	МЗ.Отбор.Характеристика.Установить(Характеристика);
	МЗ.Прочитать();
	
	Если Мз.Количество() > 0 Тогда
		Для Каждого тек из МЗ Цикл
			тек.ОшибкаПриСоздании = Ошибка;	
			тек.НеСоздавать =  НеСоздовать;
		КонецЦикла;
	КонецЕсли;
	МЗ.Записать();
	
	
КонецФункции

Функция ПолучитьПары(Количество) Экспорт
	
	ПоследниеДве = Количество % 100;
	Последняя = Количество % 10;
	
	Если ПоследниеДве >= 11 И ПоследниеДве <= 14 Тогда
		Возврат Строка(Количество) + " пар";
	КонецЕсли;
	
	Если Последняя = 1 Тогда
		Возврат Строка(Количество) + " пара";
	ИначеЕсли Последняя >= 2 И Последняя <= 4 Тогда
		Возврат Строка(Количество) + " пары";
	Иначе
		Возврат Строка(Количество) + " пар";
	КонецЕсли;
	
КонецФункции
