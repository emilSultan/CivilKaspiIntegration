					КонецЦикла;
					
					МЗ  = РегистрыСведений.мп_АтрибутыНоменклатур.СоздатьМенеджерЗаписи();
					
					МЗ.Номенклатура = Модели.Номенклатура;
					МЗ.Язык = ЯзыкRU();
					МЗ.mainProductWebDescription = productDesc;
					МЗ.Период =  ТекущаяДатаСеанса();
					МЗ.ДатаДобавления = ТекущаяДатаСеанса();
					Если ПустаяСтрока(NUMBER_OF_PIECES) Тогда
						МЗ.PAKETLEME = "1";
					Иначе
						МЗ.PAKETLEME =  NUMBER_OF_PIECES;
					КонецЕсли;
					МЗ.Записать();
					
					
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли; 


	КонецЦикла;

