	// Master - Swaddling tables
	МассивТайп = Новый Массив;
	CollarМассив = Новый Массив;
	TypeOfFit = Новый Массив;
	ClaspSkirt = Новый Массив;
	FillerJacket = Новый Массив;
	
			
			Если ЗначениеЗаполнено(Товары.LENGTH) Тогда  
				
				ДлинаСтрока = СокрЛП(Товары.LENGTH);
				
				ДлинаСтрока = СтрЗаменить(ДлинаСтрока, "см", "");
				ДлинаСтрока = СтрЗаменить(ДлинаСтрока, " ", "");
				ДлинаСтрока = СтрЗаменить(ДлинаСтрока, "СМ", "");
				ДлинаСтрока = СтрЗаменить(ДлинаСтрока, "cm", ""); 
				
				Разделитель = "";
				
				Если СтрНайти(ДлинаСтрока, "х")> 0 Тогда 
					Разделитель = "х"
				ИначеЕсли СтрНайти(ДлинаСтрока, "x") > 0 Тогда
					Разделитель = "x";
				ИначеЕсли СтрНайти(ДлинаСтрока, "X") > 0 Тогда
					Разделитель = "X";
				ИначеЕсли СтрНайти(ДлинаСтрока, "*") > 0 Тогда
					Разделитель = "*";
				КонецЕсли;
				
				Length = 0;
				Width  = 0;  
				
				Если Разделитель <> "" Тогда
					Части = СтрРазделить(ДлинаСтрока, Разделитель);
					Если Части.Количество() >= 2 Тогда
						Length = Число(СокрЛП(Части[0]));
						Width  = Число(СокрЛП(Части[1]));
					КонецЕсли;
				КонецЕсли;
			Иначе
				Возврат Ложь;
			КонецЕсли;

			
			МассивТайп.Добавить("пеленальный матрас");
			
			attributes.Добавить(Новый Структура("code,value","Swaddling tables*Type",МассивТайп)); 
			attributes.Добавить(Новый Структура("code,value","Swaddling tables*Material",МассивСостава));
            attributes.Добавить(Новый Структура("code,value","Swaddling tables*Length", Length ));
			attributes.Добавить(Новый Структура("code,value","Swaddling tables*Width", Width));
			attributes.Добавить(Новый Структура("code,value","Swaddling tables*Color", Цвет ));
			attributes.Добавить(Новый Структура("code,value","Swaddling pads*Vendor code","Civil"));
	
	Возврат Истина;
КонецФункции

