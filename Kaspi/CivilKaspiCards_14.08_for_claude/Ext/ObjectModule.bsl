	Аккаунт.ПарольSMTP       = ПолучитьДопПараметрИМ(Kaspi(), "email_smtp_pass");

	Аккаунт.ПортSMTP         = 465; 
	Аккаунт.ИспользоватьSSLSMTP = Истина;

	
	Письмо                             = Новый ИнтернетПочтовоеСообщение;
	Письмо.Отправитель.Адрес           = "notifications@retmind.com";
	Письмо.Отправитель.ОтображаемоеИмя = "KASPI_CARDS_REPORT";      
    Письмо.Тема       = "KASPI_CARDS_REPORT";  
	
	ОднаКнига         = Новый ПакетОтображаемыхДокументов;

	
	Если   КатегорияItem.Количество() > 0  Тогда

		КатегорияItem_Таб  =  ПолучитьМакетТело(КатегорияItem,"КатегорияItem");
		Элт               = ОднаКнига.Состав.Добавить();
		Элт.Наименование  = "No Category";
		Элт.Данные        = ПоместитьВоВременноеХранилище(КатегорияItem_Таб);
		
	КонецЕсли;
	
	Если   РазмерItem.Количество() > 0  Тогда

		РазмерItem_Таб  = ПолучитьМакетТело(РазмерItem,"РазмерItem");
		Элт1              = ОднаКнига.Состав.Добавить();
		Элт1.Наименование = "No Kaspi_Size";
		Элт1.Данные       = ПоместитьВоВременноеХранилище(РазмерItem_Таб);
		
	КонецЕсли;
	

	Если   ЦветItem.Количество() > 0  Тогда
		
		ЦветItem_Таб  =    		ПолучитьМакетТело(ЦветItem,"ЦветItem");
		Элт2              = ОднаКнига.Состав.Добавить();
		Элт2.Наименование = "No Color";
		Элт2.Данные       = ПоместитьВоВременноеХранилище(ЦветItem_Таб);
	КонецЕсли;
	


	Если   ПолItem.Количество() > 0  Тогда
		
		ПолItem_Таб  =    		ПолучитьМакетТело(ПолItem,"ПолItem");
		Элт3              = ОднаКнига.Состав.Добавить();
		Элт3.Наименование = "No Gender";
		Элт3.Данные       = ПоместитьВоВременноеХранилище(ПолItem_Таб);
	КонецЕсли;
	


	Если   СоставItem.Количество() > 0  Тогда
		

		СоставItem_Таб  =    		ПолучитьМакетТело(СоставItem,"СоставItem");
		Элт4              = ОднаКнига.Состав.Добавить();
		Элт4.Наименование = "No Composition";
		Элт4.Данные       = ПоместитьВоВременноеХранилище(СоставItem_Таб);
	КонецЕсли;
		

	Если   ФотоItem.Количество() > 0  Тогда


		ФотоItem_Таб  =    		ПолучитьМакетТело(ФотоItem,"ФотоItem");
		Элт5              = ОднаКнига.Состав.Добавить();
		Элт5.Наименование = "No Photo";
		Элт5.Данные       = ПоместитьВоВременноеХранилище(ФотоItem_Таб);
	КонецЕсли;

	Для Каждого АдресПолучателя Из СтрРазделить(ПолучитьДопПараметрИМ(Kaspi(), "email_receivers"), ";", Ложь) Цикл
		АдресПолучателя = СокрЛП(АдресПолучателя);
		Если АдресПолучателя <> "" Тогда
			Письмо.Получатели.Добавить(АдресПолучателя);
		КонецЕсли;
	КонецЦикла;
	
	ТекДата  =  Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
	ИмяВремФайла      = КаталогВременныхФайловНаКлиенте()+  "Kaspi_cards_report"+ТекДата+".xlsx";

	ОднаКнига.Записать(ИмяВремФайла, ТипФайлаПакетаОтображаемыхДокументов.XLSX);
	Письмо.Вложения.Добавить( ИмяВремФайла);
	
	Попытка            
		Email.Подключиться(Аккаунт);      
	Исключение            
		Сообщить("Не удалось авторизоваться, проверьте имя пользователя и пароль" + ОписаниеОшибки(), СтатусСообщения.Важное);  
		Возврат Неопределено;      
	КонецПопытки;


	Попытка            
		Email.Послать(Письмо);                  
		Сообщить("Письмо отправлено");  
	Исключение            
		Сообщить("Ошибка" + ОписаниеОшибки(), СтатусСообщения.Важное);
	КонецПопытки;
	


	
	
