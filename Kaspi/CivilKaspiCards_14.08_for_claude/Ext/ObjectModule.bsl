	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИтогЗапроса.Модель КАК Model,
	               |	ИтогЗапроса.MopClass КАК MopClass,
	               |	ИтогЗапроса.Номенклатура.MopCategory КАК MopCategory,
	               |	ИтогЗапроса.Номенклатура.MopSubDepartment КАК MopSubDepartment,
	               |	ИтогЗапроса.Номенклатура.MopDepartment КАК MopDepartment,
	               |	ИтогЗапроса.Номенклатура.MopDivision КАК MopDivision,
	               |	ИтогЗапроса.Номенклатура.Пол КАК Gender,
	               |	СУММА(ИтогЗапроса.Stock) КАК Stock
	               |ИЗ
	               |	ИтогЗапроса КАК ИтогЗапроса
	               |ГДЕ
	               |	ИтогЗапроса.СоставТкани = """"
	               |СГРУППИРОВАТЬ ПО
	               |	ИтогЗапроса.Модель,
	               |	ИтогЗапроса.MopClass,
	               |	ИтогЗапроса.Номенклатура.MopCategory,
	               |	ИтогЗапроса.Номенклатура.MopSubDepartment,
	               |	ИтогЗапроса.Номенклатура.MopDepartment,
	               |	ИтогЗапроса.Номенклатура.MopDivision,
	               |	ИтогЗапроса.Номенклатура.Пол
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИтогЗапроса.Артикул КАК Optioncode,
	               |	ИтогЗапроса.Номенклатура.Пол КАК Gender,
	               |	СУММА(ИтогЗапроса.Stock) КАК Stock
	               |ИЗ
	               |	ИтогЗапроса КАК ИтогЗапроса
	               |ГДЕ
	               |	ИтогЗапроса.Изображение1 + ИтогЗапроса.Изображение2 + ИтогЗапроса.Изображение3 + ИтогЗапроса.Изображение4 + ИтогЗапроса.Изображение5 + ИтогЗапроса.Изображение6 + ИтогЗапроса.Изображение7 + ИтогЗапроса.Изображение8 + ИтогЗапроса.Изображение9 + ИтогЗапроса.Изображение10 = 0
	               |СГРУППИРОВАТЬ ПО
	               |	ИтогЗапроса.Артикул,
	               |	ИтогЗапроса.Номенклатура.Пол";     
	
	
	Пакет = Запрос.ВыполнитьПакет();

	Возврат Пакет;

	
	
КонецФункции


Функция ПолучитьМакетТело(Данные,ВариантОтчета)
	

	Таб = новый ТабличныйДокумент;
	Таб.Очистить();
	Макет = ПолучитьМакет("Макет");
	
	Если   ВариантОтчета =   "КатегорияItem"     Тогда
		ОбластьИмя    =  Макет.ПолучитьОбласть("ОбластьИмяКатегорияItem");
		ОбластьТело   =  Макет.ПолучитьОбласть("ОбластьТелоКатегорияItem");
		
	ИначеЕсли ВариантОтчета =   "РазмерItem" Тогда
		
		ОбластьИмя    =  Макет.ПолучитьОбласть("ОбластьИмяРазмерItem");
		ОбластьТело   =  Макет.ПолучитьОбласть("ОбластьТелоРазмерItem");

	ИначеЕсли ВариантОтчета =   "ЦветItem" Тогда
		ОбластьИмя    =  Макет.ПолучитьОбласть("ОбластьИмяЦветItem");
		ОбластьТело   =  Макет.ПолучитьОбласть("ОбластьТелоЦветItem");
 
	ИначеЕсли ВариантОтчета =   "ПолItem" Тогда
		ОбластьИмя    =  Макет.ПолучитьОбласть("ОбластьИмяПолItem");
		ОбластьТело   =  Макет.ПолучитьОбласть("ОбластьТелоПолItem");

	ИначеЕсли ВариантОтчета =   "СоставItem" Тогда
		ОбластьИмя    =  Макет.ПолучитьОбласть("ОбластьИмяСоставItem");
		ОбластьТело   =  Макет.ПолучитьОбласть("ОбластьТелоСоставItem");

	ИначеЕсли ВариантОтчета =   "ФотоItem" Тогда
		ОбластьИмя    =  Макет.ПолучитьОбласть("ОбластьИмяФотоItem");
		ОбластьТело   =  Макет.ПолучитьОбласть("ОбластьТелоФотоItem");
	КонецЕсли;
	
		
	Таб.Вывести(ОбластьИмя);
		
	Если Данные.Количество() > 0 Тогда 
		Для Каждого тек из  Данные Цикл 
			ЗаполнитьЗначенияСвойств(ОбластьТело.Параметры, тек);
           	Таб.Вывести(ОбластьТело,,,Ложь);			
		КонецЦикла;		
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
	Возврат Таб;
КонецФункции



Функция REPORT()  Экспорт
	
	Пакет = ПолучитьОтчетПоТоварам();
	
	КатегорияItem = Пакет[3].Выгрузить();
