Функция GET_COLLAR()  Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка  =  ПолучитьТоварыБезCollar();
	
	Пока  Выборка.Следующий() Цикл
		
		попытка 
			Адрес  =  "https://gateway.civil.com.tr:8080/api/Products/GetProductByLangCodes?LangCodes=RS&Barcode="+Выборка.Штрихкод;
			
			
			Ответ= КоннекторHTTP.GetJson(Адрес,,ДопПараметрыCivil());
			
			
			Если Ответ.Получить("success") Тогда
				
				data = Ответ.Получить("data");  
				NUMBER_OF_PIECES = "";
				Если типЗнч(data)  = Тип("Массив") Тогда 
					Для каждого тек из   data Цикл 					
						productDesc   =  тек.Получить("productDesc");
						attributes = тек.Получить("attributes");
						
						COLLAR_NECKLINE_STYLE = "";
						SLEEVE_LENGTH = "";  
						PRODUCT_DETAIL = "";
						Для каждого атт из attributes Цикл
							
							Если атт.Получить("attributeTypeCode") =  9 Тогда
								COLLAR_NECKLINE_STYLE  =  атт.Получить("attributeDesc");
							ИначеЕсли атт.Получить("attributeTypeCode") =  7 Тогда
								SLEEVE_LENGTH = атт.Получить("attributeDesc");
							ИначеЕсли атт.Получить("attributeTypeCode") =  26 Тогда
								PRODUCT_DETAIL = атт.Получить("attributeDesc");
							КонецЕсли;
						КонецЦикла;
						
						Если не ПустаяСтрока(COLLAR_NECKLINE_STYLE)
							Или Не ПустаяСтрока(SLEEVE_LENGTH) 
							Или Не ПустаяСтрока(PRODUCT_DETAIL)
							Тогда
							НЗ  =  РегистрыСведений.мп_АтрибутыНоменклатур.СоздатьНаборЗаписей();						
							НЗ.Отбор.Язык.Установить(ЯзыкRU());
							НЗ.Отбор.Номенклатура.Установить(Выборка.Номенклатура);						
							НЗ.Прочитать();					
							Если НЗ.Количество() > 0 Тогда							
								Для Каждого тек из  НЗ Цикл 
									Если COLLAR_NECKLINE_STYLE <> "" Тогда 
										тек.COLLAR_NECKLINE_STYLE  =  COLLAR_NECKLINE_STYLE;
									КонецЕсли;
									
									Если SLEEVE_LENGTH <> "" Тогда 
										тек.SLEEVE_LENGTH  =  SLEEVE_LENGTH;
									КонецЕсли;
									
									Если PRODUCT_DETAIL <> "" Тогда 
										тек.PRODUCT_DETAIL  =  PRODUCT_DETAIL;
									КонецЕсли;									
									
									НЗ.Записать();      	
								КонецЦикла;
							Иначе
								МЗ  = РегистрыСведений.мп_АтрибутыНоменклатур.СоздатьМенеджерЗаписи();							
								МЗ.Номенклатура = Выборка.Номенклатура;
								МЗ.Язык = ЯзыкRU(); 
								Если COLLAR_NECKLINE_STYLE <> "" Тогда 
									МЗ.COLLAR_NECKLINE_STYLE  =  COLLAR_NECKLINE_STYLE;
								КонецЕсли;
								
								Если SLEEVE_LENGTH <> "" Тогда 
									МЗ.SLEEVE_LENGTH  =  SLEEVE_LENGTH;
								КонецЕсли;    
								
								Если PRODUCT_DETAIL <> "" Тогда 
									МЗ.PRODUCT_DETAIL  =  PRODUCT_DETAIL;
								КонецЕсли;								

								МЗ.Период =  ТекущаяДатаСеанса();
								МЗ.ДатаДобавления = ТекущаяДатаСеанса();
								МЗ.Записать();
							КонецЕсли;						
						КонецЕсли;
						
					КонецЦикла;
				КонецЕсли;			
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		
	КонецЦикла;
	

КонецФункции

