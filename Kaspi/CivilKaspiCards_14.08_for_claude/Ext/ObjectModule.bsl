Функция РазобратьСостав(СтрокаСостава) Экспорт
	
	Результат = Новый Массив;
	
	Если ПустаяСтрока(СтрокаСостава) Тогда
		Возврат Результат;
	КонецЕсли;
	
	//  нормализуем переносы строк
	СтрокаСостава = СтрЗаменить(СтрокаСостава, Символы.ПС, Символы.ПС);
	Строки = СтрРазделить(СтрокаСостава, Символы.ПС);
	
	
	Для Каждого Строка Из Строки Цикл
		
		Строка = СокрЛП(Строка);
		Если ПустаяСтрока(Строка) Тогда
			Продолжить;
		КонецЕсли;
		
		
		//  делим "нижний:%56 Бамбук ..."
		Части = СтрРазделить(Строка, ":");
		
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеЧасти = СокрЛП(Части[0]);
		СоставСтрока = СокрЛП(Части[1]);
		
		
		//  делим по %
		Массив = СтрРазделить(СоставСтрока, "%");
		
		Для Каждого Элемент Из Массив Цикл
			
			Элемент = СокрЛП(Элемент);
			
			Если ПустаяСтрока(Элемент) Тогда
				Продолжить;
			КонецЕсли;
			
			
			ЧастиЭл = СтрРазделить(Элемент, " ");
			
			Если ЧастиЭл.Количество() < 2 Тогда
				Продолжить;
			КонецЕсли;
			
			
			Процент = Число(ЧастиЭл[0]);
			
			Ткань = "";
			Для i = 1 По ЧастиЭл.Количество() - 1 Цикл
				Ткань = Ткань + ?(Ткань = "", "", " ") + ЧастиЭл[i];
			КонецЦикла;
			
			
			Стр = Новый Структура;
			Стр.Вставить("СоставТкани", Ткань);
			Стр.Вставить("ОписаниеЧастиСостава", ОписаниеЧасти);
			Стр.Вставить("ПроцентноеЗначение", Процент);
			
			Результат.Добавить(Стр);
			
		КонецЦикла;
		
	КонецЦикла;
	
	
	Возврат Результат;

КонецФункции

