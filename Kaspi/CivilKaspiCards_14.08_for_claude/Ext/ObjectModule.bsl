// Товары, у которых уже стоит ГотовКСоздании = Истина и которые CARD_CREAT() отправит в Kaspi при следующем запуске.
Функция ПолучитьСписокГотовыхКСозданию() Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИМ", Kaspi());
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИнтернетМагазинКарточки.Номенклатура КАК Номенклатура,
	               |	ИнтернетМагазинКарточки.Номенклатура.Наименование КАК Наименование,
	               |	ИнтернетМагазинКарточки.Номенклатура.Артикул КАК Артикул,
	               |	ИнтернетМагазинКарточки.Характеристика КАК Характеристика,
	               |	ИнтернетМагазинКарточки.Характеристика.Наименование КАК Размер,
	               |	МАКСИМУМ(Штрихкоды.Штрихкод) КАК Штрихкод,
	               |	ИнтернетМагазинКарточки.ДатаДобавления КАК ДатаДобавления
	               |ИЗ
	               |	РегистрСведений.ИнтернетМагазинКарточки КАК ИнтернетМагазинКарточки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
	               |		ПО ИнтернетМагазинКарточки.Номенклатура = Штрихкоды.Владелец
	               |			И ИнтернетМагазинКарточки.Характеристика = Штрихкоды.Характеристика
	               |ГДЕ
	               |	ИнтернетМагазинКарточки.ИнтернетМагазин = &ИМ
	               |	И ИнтернетМагазинКарточки.ГотовКСоздании = ИСТИНА
	               |	И ИнтернетМагазинКарточки.Создан = ЛОЖЬ
	               |	И ИнтернетМагазинКарточки.Обработан = ЛОЖЬ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИнтернетМагазинКарточки.Номенклатура,
	               |	ИнтернетМагазинКарточки.Номенклатура.Наименование,
	               |	ИнтернетМагазинКарточки.Номенклатура.Артикул,
	               |	ИнтернетМагазинКарточки.Характеристика,
	               |	ИнтернетМагазинКарточки.Характеристика.Наименование,
	               |	ИнтернетМагазинКарточки.ДатаДобавления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование, Размер";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Товары с положительным остатком, у которых уже определена Kaspi-категория (мп_ДанныеКарточек),
// но которых ещё нет ни одной строки в РегистрСведений.ИнтернетМагазинКарточки.
// Это ровно тот набор, который ADD_NEW_ITEMS() добавит в регистр при следующем запуске — здесь только предпросмотр, без записи.
Функция ПолучитьСписокОстатокБезКарточки() Экспорт

	Запрос  = Новый Запрос;
	Запрос.УстановитьПараметр("ИМ",Kaspi());
	Запрос.УстановитьПараметр("Аттрибут",Справочники.мп_АттрибутыКарточек.Категория);
	Запрос.УстановитьПараметр("Дата",КонецДня(ТекущаяДатаСеанса()));
	Запрос.Текст =  "ВЫБРАТЬ
	                |	мп_ДанныеКарточек.СсылкаОбъекта._MopDivision КАК СсылкаОбъекта_MopDivision,
	                |	мп_ДанныеКарточек.СсылкаОбъекта._MopDepartment КАК СсылкаОбъекта_MopDepartment,
	                |	мп_ДанныеКарточек.СсылкаОбъекта._MopSubDepartment КАК СсылкаОбъекта_MopSubDepartment,
	                |	мп_ДанныеКарточек.СсылкаОбъекта._MopCategory КАК СсылкаОбъекта_MopCategory,
	                |	мп_ДанныеКарточек.СсылкаОбъекта._MopClass КАК СсылкаОбъекта_MopClass,
	                |	мп_ДанныеКарточек.СсылкаОбъекта.Пол КАК СсылкаОбъектаПол
	                |ПОМЕСТИТЬ категории
	                |ИЗ
	                |	РегистрСведений.мп_ДанныеКарточек КАК мп_ДанныеКарточек
	                |ГДЕ
	                |	мп_ДанныеКарточек.ИнтернетМагазин = &ИМ
	                |	И мп_ДанныеКарточек.Аттрибут = &Аттрибут
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	                |	ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
	                |	ТоварыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	                |ПОМЕСТИТЬ ТоварыОстатокБольше1
	                |ИЗ
	                |	категории КАК категории
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата, ) КАК ТоварыНаСкладахОстатки
	                |		ПО категории.СсылкаОбъекта_MopDivision = ТоварыНаСкладахОстатки.Номенклатура._MopDivision
	                |			И категории.СсылкаОбъекта_MopDepartment = ТоварыНаСкладахОстатки.Номенклатура._MopDepartment
	                |			И категории.СсылкаОбъекта_MopSubDepartment = ТоварыНаСкладахОстатки.Номенклатура._MopSubDepartment
	                |			И категории.СсылкаОбъекта_MopCategory = ТоварыНаСкладахОстатки.Номенклатура._MopCategory
	                |			И категории.СсылкаОбъекта_MopClass = ТоварыНаСкладахОстатки.Номенклатура._MopClass
	                |			И категории.СсылкаОбъектаПол = ТоварыНаСкладахОстатки.Номенклатура.Пол
	                |ГДЕ
	                |	ТоварыНаСкладахОстатки.КоличествоОстаток > 0
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ТоварыОстатокБольше1.Номенклатура КАК Номенклатура,
	                |	ТоварыОстатокБольше1.Номенклатура.Наименование КАК Наименование,
	                |	ТоварыОстатокБольше1.Номенклатура.Артикул КАК Артикул,
	                |	ТоварыОстатокБольше1.Характеристика.Наименование КАК Размер,
	                |	МАКСИМУМ(Штрихкоды.Штрихкод) КАК Штрихкод,
	                |	ВЫРАЗИТЬ(МАКСИМУМ(ТоварыОстатокБольше1.КоличествоОстаток) КАК ЧИСЛО(10,0)) КАК КоличествоОстаток
	                |ИЗ
	                |	ТоварыОстатокБольше1 КАК ТоварыОстатокБольше1
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнтернетМагазинКарточки КАК ИнтернетМагазинКарточки
	                |		ПО ТоварыОстатокБольше1.Номенклатура = ИнтернетМагазинКарточки.Номенклатура
	                |			И ТоварыОстатокБольше1.Характеристика = ИнтернетМагазинКарточки.Характеристика
	                |			И (ИнтернетМагазинКарточки.ИнтернетМагазин = &ИМ)
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
	                |		ПО ТоварыОстатокБольше1.Номенклатура = Штрихкоды.Владелец
	                |			И ТоварыОстатокБольше1.Характеристика = Штрихкоды.Характеристика
	                |ГДЕ
	                |	ИнтернетМагазинКарточки.ИнтернетМагазин ЕСТЬ NULL
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ТоварыОстатокБольше1.Номенклатура,
	                |	ТоварыОстатокБольше1.Номенклатура.Наименование,
	                |	ТоварыОстатокБольше1.Номенклатура.Артикул,
	                |	ТоварыОстатокБольше1.Характеристика,
	                |	ТоварыОстатокБольше1.Характеристика.Наименование
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	Наименование, Размер";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Товары с положительным остатком, для чьей комбинации MopDivision/.../MopClass/Пол вообще
// не задано значение Kaspi-категории в мп_ДанныеКарточек — из-за этого они не попадают
// даже в кандидаты ADD_NEW_ITEMS(). Группировка по Номенклатуре: категория задаётся на уровне
// товарной линейки, а не размера/характеристики.
Функция ПолучитьСписокОстатокБезКатегории() Экспорт

	Запрос  = Новый Запрос;
	Запрос.УстановитьПараметр("ИМ",Kaspi());
	Запрос.УстановитьПараметр("Аттрибут",Справочники.мп_АттрибутыКарточек.Категория);
	Запрос.УстановитьПараметр("Дата",КонецДня(ТекущаяДатаСеанса()));
	Запрос.Текст =  "ВЫБРАТЬ
	                |	мп_ДанныеКарточек.СсылкаОбъекта._MopDivision КАК СсылкаОбъекта_MopDivision,
	                |	мп_ДанныеКарточек.СсылкаОбъекта._MopDepartment КАК СсылкаОбъекта_MopDepartment,
	                |	мп_ДанныеКарточек.СсылкаОбъекта._MopSubDepartment КАК СсылкаОбъекта_MopSubDepartment,
	                |	мп_ДанныеКарточек.СсылкаОбъекта._MopCategory КАК СсылкаОбъекта_MopCategory,
	                |	мп_ДанныеКарточек.СсылкаОбъекта._MopClass КАК СсылкаОбъекта_MopClass,
	                |	мп_ДанныеКарточек.СсылкаОбъекта.Пол КАК СсылкаОбъектаПол
	                |ПОМЕСТИТЬ категории
	                |ИЗ
	                |	РегистрСведений.мп_ДанныеКарточек КАК мп_ДанныеКарточек
	                |ГДЕ
	                |	мп_ДанныеКарточек.ИнтернетМагазин = &ИМ
	                |	И мп_ДанныеКарточек.Аттрибут = &Аттрибут
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	                |	ТоварыНаСкладахОстатки.Номенклатура.Наименование КАК Наименование,
	                |	ТоварыНаСкладахОстатки.Номенклатура.Артикул КАК Артикул,
	                |	ТоварыНаСкладахОстатки.Номенклатура._MopDivision КАК MopDivision,
	                |	ТоварыНаСкладахОстатки.Номенклатура._MopDepartment КАК MopDepartment,
	                |	ТоварыНаСкладахОстатки.Номенклатура._MopSubDepartment КАК MopSubDepartment,
	                |	ТоварыНаСкладахОстатки.Номенклатура._MopCategory КАК MopCategory,
	                |	ТоварыНаСкладахОстатки.Номенклатура._MopClass КАК MopClass,
	                |	ТоварыНаСкладахОстатки.Номенклатура.Пол КАК Пол,
	                |	ВЫРАЗИТЬ(СУММА(ТоварыНаСкладахОстатки.КоличествоОстаток) КАК ЧИСЛО(10,0)) КАК КоличествоОстаток
	                |ИЗ
	                |	РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата, ) КАК ТоварыНаСкладахОстатки
	                |		ЛЕВОЕ СОЕДИНЕНИЕ категории КАК категории
	                |		ПО категории.СсылкаОбъекта_MopDivision = ТоварыНаСкладахОстатки.Номенклатура._MopDivision
	                |			И категории.СсылкаОбъекта_MopDepartment = ТоварыНаСкладахОстатки.Номенклатура._MopDepartment
	                |			И категории.СсылкаОбъекта_MopSubDepartment = ТоварыНаСкладахОстатки.Номенклатура._MopSubDepartment
	                |			И категории.СсылкаОбъекта_MopCategory = ТоварыНаСкладахОстатки.Номенклатура._MopCategory
	                |			И категории.СсылкаОбъекта_MopClass = ТоварыНаСкладахОстатки.Номенклатура._MopClass
	                |			И категории.СсылкаОбъектаПол = ТоварыНаСкладахОстатки.Номенклатура.Пол
	                |ГДЕ
	                |	ТоварыНаСкладахОстатки.КоличествоОстаток > 0
	                |	И категории.СсылкаОбъекта_MopDivision ЕСТЬ NULL
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ТоварыНаСкладахОстатки.Номенклатура,
	                |	ТоварыНаСкладахОстатки.Номенклатура.Наименование,
	                |	ТоварыНаСкладахОстатки.Номенклатура.Артикул,
	                |	ТоварыНаСкладахОстатки.Номенклатура._MopDivision,
	                |	ТоварыНаСкладахОстатки.Номенклатура._MopDepartment,
	                |	ТоварыНаСкладахОстатки.Номенклатура._MopSubDepartment,
	                |	ТоварыНаСкладахОстатки.Номенклатура._MopCategory,
	                |	ТоварыНаСкладахОстатки.Номенклатура._MopClass,
	                |	ТоварыНаСкладахОстатки.Номенклатура.Пол
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	Наименование";

	Возврат Запрос.Выполнить().Выгрузить();

