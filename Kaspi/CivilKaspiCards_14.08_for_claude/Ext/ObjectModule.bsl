Функция ПолучитьДопПараметрИМ(Ссылка, Ключ)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Ключ", Ключ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИнтернетМагазиныДополнительныеПараметры.Значение КАК Значение
	               |ИЗ
	               |	Справочник.ИнтернетМагазины.ДополнительныеПараметры КАК ИнтернетМагазиныДополнительныеПараметры
	               |ГДЕ
	               |	ИнтернетМагазиныДополнительныеПараметры.Ключ = &Ключ
	               |	И ИнтернетМагазиныДополнительныеПараметры.Ссылка = &Ссылка";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.Значение);
	КонецЕсли;

	Возврат "";

КонецФункции

Функция wrapfor(ServiceName = "Kaspi")

	this = New Structure("ServiceName, URI, Headers",
		ServiceName,
		"https://kaspi.kz/shop/api",
	);

	// headers
	this.headers = new Map();
	this.headers.Вставить("Content-Type", "text/plain");
	this.headers.Вставить("X-Auth-Token", ПолучитьДопПараметрИМ(Kaspi(), "X-Auth-Token"));
	this.headers.Вставить("X-Merchant-Uid", ПолучитьДопПараметрИМ(Kaspi(), "X-Merchant-Uid"));
	this.headers.Вставить("Accept-Encoding", "identity");
	
	this.Insert("host", this.URI);
	this.host = StrReplace(this.host, "http://", "");
	this.host = StrReplace(this.host, "https://", "");
	this.host = StrSplit(this.host, "/", false).Get(0);
	Возврат this;
	
КонецФункции

Функция ПолучитьПослеMaster(СтрокаТекста) Экспорт
	
	Префикс = "Master - ";
	
	Позиция = Найти(СтрокаТекста, Префикс);
	
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = Сред(
		СтрокаТекста,
		Позиция + СтрДлина(Префикс)
	);
	
	Возврат СокрЛП(Результат) + "*";

