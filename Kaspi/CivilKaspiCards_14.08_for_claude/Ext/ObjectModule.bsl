Функция СведенияОВнешнейОбработке() Экспорт
	Использование	= ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.0");
	ПараметрыРегистрации.Наименование = "KASPI_CARD_INTEGRATION";
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = "CARD_CREAT";
	НоваяКоманда.Идентификатор = "CARD_CREAT";
	НоваяКоманда.Использование = Использование;
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = "CHECK_READEY_ITEMS";
	НоваяКоманда.Идентификатор = "CHECK_READEY_ITEMS";
	НоваяКоманда.Использование = Использование;
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = "GET_PHOTO";
	НоваяКоманда.Идентификатор = "GET_PHOTO";
	НоваяКоманда.Использование = Использование;
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = "GET_COMPOSITION";
	НоваяКоманда.Идентификатор = "GET_COMPOSITION";
	НоваяКоманда.Использование = Использование;
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = "GET_DESCRIPTION";
	НоваяКоманда.Идентификатор = "GET_DESCRIPTION";
	НоваяКоманда.Использование = Использование;
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = "GET_COLLAR";
	НоваяКоманда.Идентификатор = "GET_COLLAR";
	НоваяКоманда.Использование = Использование;
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = "ADD_NEW_ITEMS";
	НоваяКоманда.Идентификатор = "ADD_NEW_ITEMS";
	НоваяКоманда.Использование = Использование;
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = "REPORT";
	НоваяКоманда.Идентификатор = "REPORT";
	НоваяКоманда.Использование = Использование;

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = "SYNC_BARCODES";
	НоваяКоманда.Идентификатор = "SYNC_BARCODES";
	НоваяКоманда.Использование = Использование;



	Возврат ПараметрыРегистрации;
	
Конецфункции

Процедура ВыполнитьКоманду(ИмяКоманды, ПараметрыВыполнения=Неопределено) Экспорт
	
	Если ИмяКоманды = "CARD_CREAT" Тогда
		CARD_CREAT();
	ИначеЕсли СтрСравнить(ИмяКоманды, "CHECK_READEY_ITEMS") = 0 Тогда
		CHECK_READEY_ITEMS();
	ИначеЕсли СтрСравнить(ИмяКоманды, "GET_PHOTO") = 0 Тогда
	    GET_PHOTO();
	ИначеЕсли СтрСравнить(ИмяКоманды, "GET_COMPOSITION") = 0 Тогда
		GET_COMPOSITION();
	ИначеЕсли СтрСравнить(ИмяКоманды, "GET_DESCRIPTION") = 0 Тогда
	    GET_DESCRIPTION();
	ИначеЕсли СтрСравнить(ИмяКоманды, "GET_COLLAR") = 0 Тогда
	    GET_COLLAR(); 
	ИначеЕсли СтрСравнить(ИмяКоманды, "ADD_NEW_ITEMS") = 0 Тогда
	    ADD_NEW_ITEMS();
	ИначеЕсли СтрСравнить(ИмяКоманды, "REPORT") = 0 Тогда
	    REPORT();
	ИначеЕсли СтрСравнить(ИмяКоманды, "SYNC_BARCODES") = 0 Тогда
	    SYNC_BARCODES();
	КонецЕсли;

	
КонецПроцедуры 


Функция ADD_NEW_ITEMS() Экспорт
	
	Запрос  = Новый Запрос;
	Запрос.УстановитьПараметр("ИМ",Kaspi());
	Запрос.УстановитьПараметр("Дата",КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ДатаНачалаПоступлений",НачалоДня(ТекущаяДатаСеанса()) - 30*86400);
	Запрос.УстановитьПараметр("MopDivisionИсключение",Справочники.MopDivision.НайтиПоКоду("000000004"));
	Запрос.УстановитьПараметр("MopCategoryИсключение",Справочники.MopCategory.НайтиПоКоду("000000003"));
	МассивMopCategoryВключение = Новый Массив;
	МассивMopCategoryВключение.Добавить(Справочники.MopCategory.НайтиПоКоду("000000001"));
	МассивMopCategoryВключение.Добавить(Справочники.MopCategory.НайтиПоКоду("000000002"));
	Запрос.УстановитьПараметр("MopCategoryВключение", МассивMopCategoryВключение);
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	                |	ТоварыНаСкладахОстатки.Характеристика КАК Характеристика
	                |ПОМЕСТИТЬ ТоварыОстатокБольше1
	                |ИЗ
	                |	РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата, ) КАК ТоварыНаСкладахОстатки
	                |ГДЕ
	                |	ТоварыНаСкладахОстатки.КоличествоОстаток > 0
	                |	И ТоварыНаСкладахОстатки.Номенклатура._MopDivision <> &MopDivisionИсключение
	                |	И ТоварыНаСкладахОстатки.Номенклатура._MopCategory <> &MopCategoryИсключение
	                |	И ТоварыНаСкладахОстатки.Номенклатура._MopCategory В (&MopCategoryВключение)
	                |
	                |ОБЪЕДИНИТЬ
	                |
	                |ВЫБРАТЬ
	                |	ПоступлениеТоваровТовары.Номенклатура,
	                |	ПоступлениеТоваровТовары.Характеристика
	                |ИЗ
	                |	Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
	                |ГДЕ
	                |	ПоступлениеТоваровТовары.Ссылка.Проведен
	                |	И ПоступлениеТоваровТовары.Ссылка.Дата >= &ДатаНачалаПоступлений
	                |	И ПоступлениеТоваровТовары.Номенклатура._MopDivision <> &MopDivisionИсключение
	                |	И ПоступлениеТоваровТовары.Номенклатура._MopCategory <> &MopCategoryИсключение
	                |	И ПоступлениеТоваровТовары.Номенклатура._MopCategory В (&MopCategoryВключение)
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ТоварыОстатокБольше1.Номенклатура КАК Номенклатура,
	                |	ТоварыОстатокБольше1.Характеристика КАК Характеристика
	                |ИЗ
	                |	ТоварыОстатокБольше1 КАК ТоварыОстатокБольше1
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнтернетМагазинКарточки КАК ИнтернетМагазинКарточки
	                |		ПО ТоварыОстатокБольше1.Номенклатура = ИнтернетМагазинКарточки.Номенклатура
	                |			И ТоварыОстатокБольше1.Характеристика = ИнтернетМагазинКарточки.Характеристика
	                |			И (ИнтернетМагазинКарточки.ИнтернетМагазин = &ИМ)
	                |ГДЕ
	                |	ИнтернетМагазинКарточки.ИнтернетМагазин ЕСТЬ NULL";
	Выборка  = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		МЗ  =  РегистрыСведений.ИнтернетМагазинКарточки.СоздатьМенеджерЗаписи();
		
		МЗ.ИнтернетМагазин =  Kaspi();
		МЗ.Номенклатура  = Выборка.Номенклатура;
		МЗ.Характеристика  =  Выборка.Характеристика;
		МЗ.ДатаДобавления =  ТекущаяДатаСеанса();
		МЗ.Записать();

КонецЦикла;

КонецФункции

Функция SYNC_BARCODES() Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИМ", Kaspi());
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИнтернетМагазинКарточки.Номенклатура КАК Номенклатура,
	               |	ИнтернетМагазинКарточки.Характеристика КАК Характеристика,
	               |	Штрихкоды.Штрихкод КАК Штрихкод
	               |ИЗ
	               |	РегистрСведений.ИнтернетМагазинКарточки КАК ИнтернетМагазинКарточки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
	               |		ПО ИнтернетМагазинКарточки.Номенклатура = Штрихкоды.Владелец
	               |			И ИнтернетМагазинКарточки.Характеристика = Штрихкоды.Характеристика
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнтернетМагазинШтриходы КАК ИнтернетМагазинШтриходы
	               |		ПО ИнтернетМагазинКарточки.Номенклатура = ИнтернетМагазинШтриходы.Номенклатура
	               |			И ИнтернетМагазинКарточки.Характеристика = ИнтернетМагазинШтриходы.Характеристика
	               |			И (ИнтернетМагазинШтриходы.ИнтернетМагазин = &ИМ)
	               |ГДЕ
	               |	ИнтернетМагазинКарточки.ИнтернетМагазин = &ИМ
	               |	И ИнтернетМагазинКарточки.Обработан = ИСТИНА
	               |	И ИнтернетМагазинШтриходы.Номенклатура ЕСТЬ NULL";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если Не ЗначениеЗаполнено(Выборка.Штрихкод) Тогда
			Продолжить;
		КонецЕсли;

		ШтрихкодЧисло = 0;
		Попытка
			ШтрихкодЧисло = Число(СокрЛП(Выборка.Штрихкод));
		Исключение
			Продолжить;
		КонецПопытки;

		Если ШтрихкодЧисло = 0 Тогда
			Продолжить;
		КонецЕсли;

		МЗ = РегистрыСведений.ИнтернетМагазинШтриходы.СоздатьНаборЗаписей();
		МЗ.Отбор.ШтрихкодИД.Установить(ШтрихкодЧисло);
		МЗ.Отбор.ИнтернетМагазин.Установить(Kaspi());
		МЗ.Прочитать();

		Если МЗ.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяЗапись = МЗ.Добавить();
		НоваяЗапись.ШтрихкодИД      = ШтрихкодЧисло;
		НоваяЗапись.ИнтернетМагазин = Kaspi();
		НоваяЗапись.Характеристика  = Выборка.Характеристика;
		НоваяЗапись.Номенклатура    = Выборка.Номенклатура;
		НоваяЗапись.ШтрихкодИД2     = ШтрихкодЧисло;
		МЗ.Записать();

	КонецЦикла;

КонецФункции


#Область CARD_CREAT

Функция CARD_CREAT()   Экспорт
	
	Пакет = ПолучитьГотовыеТовары();
	Товары  =  Пакет[2].Выбрать();
	Составы  = Пакет[3].Выгрузить();

	
	
	АдресРесурса = "https://kaspi.kz/shop/api/products/import";
	ДопПараметрыКаспи =  wrapfor();
	Тело =  Новый Массив;
	Обработан  =  Новый Массив;
	СоответствиеОбработчиковКатегорий = ПолучитьТаблицуОбработчиковКатегорий();
	Пока Товары.Следующий() Цикл
		Сообщить("Получен для создания: " + Товары.Номенклатура + " / характеристика: " + Товары.Характеристика + " / категория Kaspi: " + Товары.Категория);
		ТекОписания = "";
		Категрия =  ПолучитьПослеMaster(Товары.Категория);

		Если ПустаяСтрока(Категрия) Тогда
			Сообщить(Категрия);
			ЗаписатьОшибкуПриСоздании(Товары.Номенклатура,Товары.Характеристика,"Не удалось определить категорию Kaspi (пустая категория после Master -)");
			Продолжить;
		КонецЕсли;
		Категория  = Товары.Категория;
		текТовар  = Новый Соответствие;
		текТовар.Вставить("sku",Товары.Штрихкод);
		текТовар.Вставить("title",Товары.title);
		текТовар.Вставить("brand","Civil");
		текТовар.Вставить("category",Категория);
				
		ФлагТурция    = Символ(55356) + Символ(56825) + Символ(55356) + Символ(56823);  
		БэбиЭмодзи    = Символ(55357) + Символ(56438);                                   
		ЗвездаЭмодзи  = Символ(11088);                                                  
		ЛинейкаЭмодзи = Символ(55357) + Символ(56528);                                   
		СверкЭмодзи   = Символ(10024);                                                  
		ГлобусЭмодзи  = Символ(55356) + Символ(57101);  
		Если Товары.СтранаПроизводства = "Турция" Тогда
			ТекОписания = 
			ФлагТурция + " <b>100% Турецкое производство:</b> Разработано и произведено в Турции.<br><br>
			|" + БэбиЭмодзи + " <b>Безопасно для малышей и детей:</b> Изготовлено из гипоаллергенных и безопасных материалов, подходящих для чувствительной кожи.<br><br>
			|" + ЗвездаЭмодзи + " <b>Высокое качество пошива:</b> Соответствует международным стандартам качества, отличается прочной тканью и аккуратными швами, обеспечивающими долгий срок службы.<br><br>
			|" + ЛинейкаЭмодзи + " <b>Международные стандарты кроя:</b> Выполнено в соответствии с международными стандартами размеров для комфортной и удобной посадки.<br><br>
			|" + СверкЭмодзи + " <b>Современный и комфортный дизайн:</b> Сочетает стиль и удобство, позволяя ребенку свободно двигаться каждый день.<br><br>
			|" + ГлобусЭмодзи + " <b>Гарантия качества мирового бренда:</b> Качество Civil, которому доверяют во многих странах мира, объединяет современный дизайн и комфорт.";
		Иначе
			ТекОписания = 
			БэбиЭмодзи + " <b>Безопасно для малышей и детей:</b> Изготовлено из гипоаллергенных и безопасных материалов, подходящих для чувствительной кожи.<br><br>
			|" + ЗвездаЭмодзи + " <b>Высокое качество пошива:</b> Соответствует международным стандартам качества, отличается прочной тканью и аккуратными швами, обеспечивающими долгий срок службы.<br><br>
			|" + ЛинейкаЭмодзи + " <b>Международные стандарты кроя:</b> Выполнено в соответствии с международными стандартами размеров для комфортной и удобной посадки.<br><br>
			|" + СверкЭмодзи + " <b>Современный и комфортный дизайн:</b> Сочетает стиль и удобство, позволяя ребенку свободно двигаться каждый день.<br><br>
			|" + ГлобусЭмодзи + " <b>Гарантия качества мирового бренда:</b> Качество Civil, которому доверяют во многих странах мира, объединяет современный дизайн и комфорт.";
		КонецЕсли;   
		
		текТовар.Вставить("description", ТекОписания );
		
		attributes =  Новый Массив;
				
		Цвет  = Новый Массив;
		Цвет.Добавить(Товары.Цвет);
		РазмерКапи  = Новый Массив;
		РазмерКапи.Добавить(Товары.РазмерПортала);
		
		Если Категория = "Master - Baby socks" Тогда
			Если ЗначениеЗаполнено(Товары.РазмерПродавца) Тогда 
				РазмерКапи.Добавить(Товары.РазмерПродавца);
			КонецЕсли;
		КонецЕсли;
		
		        
		Сообщить(Категория);
		
		Если Категория <> "Master - Towels" И Категория <> "Master - Baby bibs" И Категория <> "Master - Fashion hats and caps" И Категория <> "Master - Baby bedding" И Категория <> "Master - Swaddling tables"  Тогда
			
		    attributes.Добавить(Новый Структура("code,value","Clothes*Colour",Цвет));
		    attributes.Добавить(Новый Структура("code,value","Clothes*Size",РазмерКапи));
		    attributes.Добавить(Новый Структура("code,value","Clothes*Manufacturer code",Товары.Модель));  
			
		ИначеЕсли Категория = "Master - Fashion hats and caps" Тогда 
			attributes.Добавить(Новый Структура("code,value","Fashion hats and caps*Size",РазмерКапи)); 
			attributes.Добавить(Новый Структура("code,value","Fashion accessories*Color",Цвет));
		    attributes.Добавить(Новый Структура("code,value","Fashion hats and caps*Manufacturer code",Товары.Модель));  
			
		ИначеЕсли Категория = "Master - Baby bedding" Тогда
			 
			attributes.Добавить(Новый Структура("code,value","Baby bedding*Colour",Цвет));
		    attributes.Добавить(Новый Структура("code,value","Baby bedding*Manufacturer code",Товары.Модель));  

		КонецЕсли;   
						
		СоставыТовара  = Составы.НайтиСтроки(Новый Структура("Номенклатура",Товары.Номенклатура));
		
		Если   СоставыТовара.Количество() =   0  Тогда
			Сообщить("СоставыТовара");
			ЗаписатьОшибкуПриСоздании(Товары.Номенклатура,Товары.Характеристика,"Не найден состав ткани (мп_СоставНоменклатур) для номенклатуры");
			Продолжить;
		КонецЕсли;
		
		МассивСостава  = Новый Массив;
		Additional  = "";
		Для Каждого текСостав из СоставыТовара Цикл
			СоставТкани  = текСостав.СоставТкани;
			ПроцентноеЗначение =  текСостав.ПроцентноеЗначение;
			Additional =  Additional + СоставТкани +"-" + ПроцентноеЗначение +  "% ";
			МеппингСостава  =  СоответствиеТканей.Получить(НРег(СоставТкани));
			Если  МеппингСостава <> Неопределено Тогда
				МассивСостава.Добавить(МеппингСостава);
			КонецЕсли;
		КонецЦикла;
		

