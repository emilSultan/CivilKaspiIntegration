	                |ИЗ
	                |	Меппинг КАК Меппинг
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.мп_ДанныеКарточек КАК мп_ДанныеКарточек
	                |		ПО Меппинг.Ссылка5Моп = мп_ДанныеКарточек.СсылкаОбъекта
	                |			И (мп_ДанныеКарточек.ИнтернетМагазин = &ИМ)
	                |			И (мп_ДанныеКарточек.Аттрибут = &АттрибутКатегория)
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	Диагностика.Номенклатура КАК Номенклатура,
	                |	Диагностика.Характеристика КАК Характеристика,
	                |	Диагностика.РазмерПортала КАК РазмерПортала,
	                |	Диагностика.Пол КАК Пол,
	                |	Диагностика.Цвет КАК Цвет,
	                |	Диагностика.Сезон КАК Сезон,
	                |	Диагностика.title КАК title,
	                |	Диагностика.number_in_sets КАК number_in_sets,
	                |	Диагностика.КоличествоФото КАК КоличествоФото,
	                |	Диагностика.Состав КАК Состав,
	                |	Диагностика.Штрихкод КАК Штрихкод,
	                |	Диагностика.СтранаПроизводства КАК СтранаПроизводства,
	                |	Диагностика.Категория КАК Категория
	                |ИЗ
	                |	Диагностика КАК Диагностика";
	
	Пакет  =  Запрос.ВыполнитьПакет();
	
	ДиагностикаВыборка = Пакет[3].Выбрать();
	
	Пока ДиагностикаВыборка.Следующий() Цикл
		
		ПричиныОтказа = Новый Массив;
		
		Если СокрЛП(ДиагностикаВыборка.РазмерПортала) = "" Тогда
			ПричиныОтказа.Добавить("нет размера (ИнтернетМагазинРазмеры)");
		КонецЕсли;
		Если СокрЛП(ДиагностикаВыборка.Пол) = "" Тогда
			ПричиныОтказа.Добавить("нет пола (мп_ДанныеКарточек)");
		КонецЕсли;
		Если СокрЛП(ДиагностикаВыборка.Цвет) = "" Тогда
			ПричиныОтказа.Добавить("нет цвета (мп_ДанныеКарточек)");
		КонецЕсли;
		Если СокрЛП(ДиагностикаВыборка.Сезон) = "" Тогда
			ПричиныОтказа.Добавить("нет сезона (мп_ДанныеКарточек)");
		КонецЕсли;
		Если СокрЛП(ДиагностикаВыборка.title) = "" Тогда
			ПричиныОтказа.Добавить("нет описания (мп_АтрибутыНоменклатур.mainProductWebDescription)");
		КонецЕсли;
		Если СокрЛП(ДиагностикаВыборка.number_in_sets) = "" Тогда
			ПричиныОтказа.Добавить("нет количества в комплекте (мп_АтрибутыНоменклатур.PAKETLEME)");
		КонецЕсли;
		Если ДиагностикаВыборка.КоличествоФото = 0 Тогда
			ПричиныОтказа.Добавить("нет фото (СоответствиеРеквизитовИМ)");
		КонецЕсли;
		Если СокрЛП(ДиагностикаВыборка.Категория) = "" Тогда
			ПричиныОтказа.Добавить("нет категории Kaspi (мп_ДанныеКарточек)");
		КонецЕсли;
		Если СокрЛП(ДиагностикаВыборка.Состав) = "" Тогда
			ПричиныОтказа.Добавить("нет состава ткани (мп_СоставНоменклатур)");
		КонецЕсли;
		Если СокрЛП(ДиагностикаВыборка.Штрихкод) = "" Тогда
			ПричиныОтказа.Добавить("нет штрихкода (РегистрСведений.Штрихкоды)");
		КонецЕсли;
		Если СокрЛП(ДиагностикаВыборка.СтранаПроизводства) = "" Тогда
			ПричиныОтказа.Добавить("нет страны производства (мп_ДанныеКарточек)");
		КонецЕсли;
		
		МЗ  =  РегистрыСведений.ИнтернетМагазинКарточки.СоздатьНаборЗаписей();
		МЗ.Отбор.ИнтернетМагазин.Установить(Kaspi());
		МЗ.Отбор.Номенклатура.Установить(ДиагностикаВыборка.Номенклатура);
		МЗ.Отбор.Характеристика.Установить(ДиагностикаВыборка.Характеристика);
		МЗ.Прочитать();
		
		Если МЗ.Количество() > 0 Тогда
			Для Каждого тек из МЗ Цикл
				Если ПричиныОтказа.Количество() = 0 Тогда
					тек.ГотовКСоздании = Истина;
					тек.ТексОшибки = "";
				Иначе
					тек.ГотовКСоздании = Ложь;
					тек.ТексОшибки = СтрСоединить(ПричиныОтказа, "; ");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		МЗ.Записать();
		
	КонецЦикла;
КонецФункции

