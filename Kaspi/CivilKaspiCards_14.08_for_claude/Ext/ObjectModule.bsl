Функция ДопПараметрыCivil()
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-type", "application/json");
	Заголовки.Вставить("Authorization","Bearer " +	ПолучитьТокенCivil());
	ДопПараметры	= Новый Структура("Заголовки", Заголовки);
	Возврат ДопПараметры;
	

	
КонецФункции

Функция ПолучитьТокенCivil(ПринудительноОбновить = ложь) Экспорт 
	
	ИмяПользователя 	= "rmadmin";
	Токен = ХранилищеОбщихНастроек.Загрузить("CIVIL_TOKEN", "CIVIL_TOKEN",, ИмяПользователя);
	Если ПринудительноОбновить = ложь Тогда
		Если Токен <> Неопределено Тогда 
			ДатаПолучениеПоследногоТокена = ХранилищеОбщихНастроек.Загрузить("CIVIL_TOKEN_DATE", "CIVIL_TOKEN_DATE",, ИмяПользователя);
			Если ДатаПолучениеПоследногоТокена <> Неопределено Тогда 
				ТекущаяДата = ТекущаяДатаСеанса();
				Секунды 	= ТекущаяДата - ДатаПолучениеПоследногоТокена; 
				Если Секунды < 86400 Тогда 
					Возврат Токен;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Адрес  = ПолучитьСсылкуВнешнейСистемы().URL + "/Token";
	Тело = Новый Структура;
	Тело.Вставить("userName", "kazakistan@civil.com.tr");
	Тело.Вставить("password", "A;{3Pt-th[BT|.@U");
	Ответ = КоннекторHTTP.PostJson(Адрес, Тело);
	Если ТипЗнч(Ответ) <>  Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	ХранилищеОбщихНастроек.Сохранить("CIVIL_TOKEN", 		 "CIVIL_TOKEN", 		Ответ,, ИмяПользователя);
	ХранилищеОбщихНастроек.Сохранить("CIVIL_TOKEN_DATE", 	 "CIVIL_TOKEN_DATE", 	ТекущаяДатаСеанса(),, ИмяПользователя);
	Возврат Ответ;

КонецФункции

Функция ПолучитьСсылкуВнешнейСистемы()
	ВнешняяСистема = Справочники.ИнтеграцияВнешниеСистемы.НайтиПоНаименованию("RTL_NEBIM_INTEGRATION");
	Если Не ЗначениеЗаполнено(ВнешняяСистема) Тогда 
		Спр = Справочники.ИнтеграцияВнешниеСистемы.СоздатьЭлемент();
		Спр.Наименование = "RTL_NEBIM_INTEGRATION";
		Спр.URL = "https://gateway.civil.com.tr:8080";
		Спр.Записать();
		ВнешняяСистема = Спр.Ссылка;
	КонецЕсли;
	Возврат ВнешняяСистема;
КонецФункции 

