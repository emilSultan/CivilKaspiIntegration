Функция ПолучитьЗакрытыеЗаказыБезРеализации()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата",ДобавитьМесяц(ТекущаяДатаСеанса(),-3));
	Запрос.УстановитьПараметр("Склад",kaspi().Магазин.СкладПродажи); 
	Запрос.УстановитьПараметр("Статус",Перечисления.СтатусыЗаказовПокупателей.Закрыт);
	Запрос.УстановитьПараметр("ИМ",kaspi());

	Запрос.Текст  =  "ВЫБРАТЬ
	                 |	ЗаказПокупателя.Ссылка КАК Ссылка,
	                 |	ЗаказПокупателя.Магазин КАК Магазин,
	                 |	ЗаказПокупателя.Склад КАК Склад
	                 |ПОМЕСТИТЬ ЗакрытыеЗаказы
	                 |ИЗ
	                 |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	                 |ГДЕ
	                 |	ЗаказПокупателя.Проведен
	                 |	И ЗаказПокупателя.Дата >= &Дата
	                 |	И ЗаказПокупателя.ИнтернетСклад.Владелец = &ИМ
	                 |	И ЗаказПокупателя.Статус = &Статус
	                 |	И ЗаказПокупателя.Отменено = ЛОЖЬ
	                 |;
	                 |
	                 |////////////////////////////////////////////////////////////////////////////////
	                 |ВЫБРАТЬ
	                 |	РеализацияТоваровТовары.ЗаказПокупателя КАК ЗаказПокупателя,
	                 |	РеализацияТоваровТовары.НомерЗаказа КАК НомерЗаказа
	                 |ПОМЕСТИТЬ РеализацииЗаказов
	                 |ИЗ
	                 |	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
	                 |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваров КАК РеализацияТоваров
	                 |		ПО РеализацияТоваровТовары.Ссылка = РеализацияТоваров.Ссылка
	                 |ГДЕ
	                 |	РеализацияТоваров.Проведен
	                 |	И РеализацияТоваров.Дата >= &Дата
	                 |	И РеализацияТоваров.Склад = &Склад
	                 |;
	                 |
	                 |////////////////////////////////////////////////////////////////////////////////
	                 |ВЫБРАТЬ
	                 |	ЗакрытыеЗаказы.Ссылка КАК Ссылка,
	                 |	ЗакрытыеЗаказы.Магазин КАК Магазин,
	                 |	ЗакрытыеЗаказы.Ссылка.НомерЗаказаНаСайте КАК НомерЗаказаНаСайте
	                 |ИЗ
	                 |	ЗакрытыеЗаказы КАК ЗакрытыеЗаказы
	                 |		ЛЕВОЕ СОЕДИНЕНИЕ РеализацииЗаказов КАК РеализацииЗаказов
	                 |		ПО ЗакрытыеЗаказы.Ссылка = РеализацииЗаказов.ЗаказПокупателя
	                 |ГДЕ
	                 |	РеализацииЗаказов.ЗаказПокупателя ЕСТЬ NULL";
	Возврат Запрос.Выполнить().Выбрать();
КонецФункции

