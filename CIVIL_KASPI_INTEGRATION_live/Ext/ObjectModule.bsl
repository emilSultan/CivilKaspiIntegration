Процедура ВыполнитьКоманду(ИмяКоманды, ПараметрыВыполнения) Экспорт
	
	НастройкиУстановить();
	Если ИмяКоманды = "GET_ORDERS" Тогда 
		GET_ORDERS();
	ИначеЕсли ИмяКоманды = "UPDATE_BO_STORE_STOCK" Тогда 
		UPDATE_BO_STORE_STOCK();
	ИначеЕсли ИмяКоманды = "UPDATE_KASPI_STOCK" Тогда
		UPDATE_KASPI_STOCK();
	ИначеЕсли ИмяКоманды = "GET_STATUS_DELIVERY" Тогда
		GET_STATUS_DELIVERY();
	ИначеЕсли ИмяКоманды = "GET_STATUS_COMPLETED" Тогда
		GET_STATUS_COMPLETED();
	ИначеЕсли ИмяКоманды = "GET_CANCELLED_ORDERS" Тогда
		ПолучитьОтменыЗаказовИзСайта();
	ИначеЕсли ИмяКоманды = "SEND_NEW_ORDERS" Тогда
		SEND_NEW_ORDERS();
	КонецЕсли;
	
КонецПроцедуры

