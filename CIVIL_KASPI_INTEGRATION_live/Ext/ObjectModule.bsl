			АдресРесурса = "https://kaspi.kz/shop/api/v2/orders?filter[orders][code]="+Выборка.НомерЗаказаНаСайте;
			Результат 	= КоннекторHTTP.GetJson(АдресРесурса, Неопределено, Новый Структура("Заголовки", Заголовки));
			МассивДанных = Результат.Получить("data"); 
			Для Каждого ТекСтрока Из МассивДанных Цикл 	
				
				Аттрибуты = ТекСтрока.Получить("attributes");
				Если Аттрибуты <> Неопределено Тогда 
					status = Аттрибуты.Получить("status");				
					Если status =  "COMPLETED" Тогда					
						
						Нов = Реализация.Добавить();
						Нов.ЗаказПокупателя = Выборка.Ссылка;
						Нов.Магазин         = Выборка.Магазин;
						
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		Исключение
			Сообщить(ОписаниеОшибки());
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
	Если  Реализация.Количество() > 0 тогда
		РеализацияТоваров();
	КонецЕсли;

