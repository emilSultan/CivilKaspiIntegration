КонецФункции

Функция ПолучитьОтменыЗаказовИзСайта() Экспорт 
	
	АдресРесурса = "https://kaspi.kz/shop/api/v2/orders?page[number]=0&page[size]=1000&filter[orders][state]=ARCHIVE&filter[orders][creationDate][$ge]=%1&filter[orders][creationDate][$le]=%2";
	ОбработатьВсеОтмены(АдресРесурса);	
	
КонецФункции

Процедура ОбработатьВсеЗаказы(АдресРесурса)
	СтраницаНомер = 0;
	Пока ОбработатьЗаказы(СтрЗаменить(АдресРесурса, "=0", "=" + Формат(СтраницаНомер, "ЧН=0; ЧГ=0"))) Цикл
		СтраницаНомер = СтраницаНомер + 1;
		
	КонецЦикла;
КонецПроцедуры

Процедура ОбработатьВсеОтмены(АдресРесурса)
	СтраницаНомер = 0;
	Пока ОбработатьОтменыЗаказов(СтрЗаменить(АдресРесурса, "=0", "=" + Формат(СтраницаНомер, "ЧН=0; ЧГ=0"))) Цикл
		СтраницаНомер = СтраницаНомер + 1;
		
	КонецЦикла;
КонецПроцедуры

Функция ОбработатьЗаказы(Знач АдресРесурса)
	
	ДатаНачало = ДатуВTimestamp(ТекущаяДатаСеанса() - 86400*3);
	ДатаКонец  = ДатуВTimestamp(ТекущаяДатаСеанса() + 10800, "999");
	
	АдресРесурса = СтрШаблон(АдресРесурса, ДатаНачало, ДатаКонец);
	
	Заголовки 	= ПолучитьЗаголовкиЗапросаHTTP();
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Заголовки", Заголовки);
	ДопПараметры.Вставить("Таймаут", 1800);
	
	Результат 	= КоннекторHTTP.GetJson(АдресРесурса, Неопределено, ДопПараметры);
	МассивДанных = Результат.Получить("data");
	Если МассивДанных = Неопределено Тогда
		ПараметрИсточник = ПолучитьПараметрИсточника("GET_ORDERS");
		ЗаписатьВЖурналРегистра(ПараметрИсточник, Результат.Получить("cause"), Ложь, Результат.Получить("message"));
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из МассивДанных Цикл
		ТоварыКорзины.Очистить();
		НомерЗаказа = ТекСтрока.Получить("id");
		Аттрибуты   = ТекСтрока.Получить("attributes");
		
		Если Аттрибуты <> Неопределено Тогда 
			
			КодЗаказа = Аттрибуты.Получить("code");
			Статус	  = Аттрибуты.Получить("status");
			Стейт     = Аттрибуты.Получить("state");
			ЕстьЗаказ  = ПолучитьЗаказ(КодЗаказа);
			Если  ЕстьЗаказ Тогда
				Если Стейт <> "SIGN_REQUIRED" Тогда
					Подтвердить_ЗаказКаспи2(КодЗаказа);
				КонецЕсли;
			Иначе
				Если Стейт <> "SIGN_REQUIRED" Тогда 
					СоздатьЗаказ(КодЗаказа);
				КонецЕсли;				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	Возврат МассивДанных.Количество() > 0;
КонецФункции

Функция ВСтроку(JSON)
	Возврат JSONМодуль.ЗаписатьJSON1(JSON);
КонецФункции

Функция Подтвердить_ЗаказКаспи2(КодЗаказа)
	
	АдресРесурса = "https://kaspi.kz/shop/api/v2/orders?filter[orders][code]=%1";
	ПараметрИсточник = ПолучитьПараметрИсточника("GET_ORDERS");
	АдресРесурса = СтрШаблон(АдресРесурса, КодЗаказа);
	
	Заголовки 	= ПолучитьЗаголовкиЗапросаHTTP();
	
	Попытка 
		Результат 	= КоннекторHTTP.GetJson(АдресРесурса, Неопределено, Новый Структура("Заголовки,Таймаут", Заголовки,180));
		
	Исключение
		ЗаписатьВЖурналРегистра(ПараметрИсточник, КодЗаказа, ЛОжь, "Ошибка при отправке запроса "+ АдресРесурса +":" +ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
	МассивДанных = Результат.Получить("data"); 
	
	Для Каждого ТекСтрока Из МассивДанных Цикл 
		
		orderId = ТекСтрока.Получить("id");
		
		Подтвердить_ЗаказКаспи(КодЗаказа,orderId);
		
	КонецЦикла;
	

	
КонецФункции

Функция ОбработатьОтменыЗаказов(Знач АдресРесурса)
	
	ДатаНачало = ДатуВTimestamp(ТекущаяДатаСеанса() - 86400*3);
	ДатаКонец  = ДатуВTimestamp(ТекущаяДатаСеанса() + 10800, "999");
	
	АдресРесурса = СтрШаблон(АдресРесурса, ДатаНачало, ДатаКонец);
	
	Заголовки 	= ПолучитьЗаголовкиЗапросаHTTP();
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Заголовки", Заголовки);
	ДопПараметры.Вставить("Таймаут", 1800);
	
	Результат 	= КоннекторHTTP.GetJson(АдресРесурса, Неопределено, ДопПараметры);
	
	МассивДанных = Результат.Получить("data");
	Если МассивДанных = Неопределено Тогда
		ПараметрИсточник = ПолучитьПараметрИсточника("GET_ORDERS");
		ЗаписатьВЖурналРегистра(ПараметрИсточник, Результат.Получить("cause"), Ложь, Результат.Получить("message"));
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из МассивДанных Цикл
		ТоварыКорзины.Очистить();
		НомерЗаказа = ТекСтрока.Получить("id");
		Аттрибуты   = ТекСтрока.Получить("attributes");
		
		Если Аттрибуты <> Неопределено Тогда 
			
			КодЗаказа = Аттрибуты.Получить("code");
			Статус	  = Аттрибуты.Получить("status");
			
			Если  Статус = "CANCELLED" Тогда
				ПроверитьСтатусЗаказа(КодЗаказа);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	Возврат МассивДанных.Количество() > 0;
КонецФункции

Функция ПолучитьЗаказ(НомерЗаказаНаСайте)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерЗаказаНаСайте",НомерЗаказаНаСайте);
	Запрос.УстановитьПараметр("ИМ",ИнтернетМагазин);
	Запрос.УстановитьПараметр("Дата",ДобавитьМесяц(ТекущаяДатаСеанса(),-6));
	Запрос.Текст  = "ВЫБРАТЬ
	                |	ЗаказПокупателя.Ссылка КАК Ссылка
	                |ИЗ
	                |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	                |ГДЕ
	                |	ЗаказПокупателя.Проведен
	                |	И ЗаказПокупателя.НомерЗаказаНаСайте = &НомерЗаказаНаСайте
	                |	И ЗаказПокупателя.ИнтернетСклад.Владелец = &ИМ
	                |	И ЗаказПокупателя.Дата >= &Дата";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	
	
КонецФУнкции

Функция СоздатьДокРеализациюТоваров(ДокЗаказ)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ЗаказПокупателя", ДокЗаказ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваров.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.РеализацияТоваров КАК РеализацияТоваров
	               |ГДЕ
	               |	РеализацияТоваров.ЗаказПокупателя = &ЗаказПокупателя
	               |	И РеализацияТоваров.Проведен";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
	Иначе 
		
		Док = Документы.РеализацияТоваров.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(Док, ДокЗаказ,, "Номер, Дата");
		
		Док.Дата = ТекущаяДатаСеанса();
		
		Для Каждого ТекТовар Из ДокЗаказ.Товары Цикл 
			НовСтрока = Док.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, ТекТовар);
		КонецЦикла;
		
		Док.ЗаказПокупателя = ДокЗаказ;
		
		Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		
	КонецЕсли;
	
КонецФункции

Функция ВозвратЗаказа(ДокЗаказ)
	
	//Возврат товара от покупателя
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ЗаказПокупателя", ДокЗаказ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваров.Ссылка КАК Реализация,
	               |	ЕСТЬNULL(ВозвратТоваровОтПокупателя.Ссылка, ЗНАЧЕНИЕ(Документ.ВозвратТоваровОтПокупателя.ПустаяСсылка)) КАК Возврат
	               |ИЗ
	               |	Документ.РеализацияТоваров КАК РеализацияТоваров
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровОтПокупателя КАК ВозвратТоваровОтПокупателя
	               |		ПО РеализацияТоваров.Ссылка = ВозвратТоваровОтПокупателя.ДокументОснование
	               |			И (ВозвратТоваровОтПокупателя.Проведен)
	               |ГДЕ
	               |	РеализацияТоваров.ЗаказПокупателя = &ЗаказПокупателя
	               |	И РеализацияТоваров.Проведен";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Если Не ЗначениеЗаполнено(Выборка.Возврат) Тогда 
			
			Реализация = Выборка.Реализация;
			Док = Документы.ВозвратТоваровОтПокупателя.СоздатьДокумент();
			
			ЗаполнитьЗначенияСвойств(Док, Реализация,, "Номер, Дата");
			
			Док.АналитикаХозяйственнойОперации = Справочники.АналитикаХозяйственныхОпераций.ВозвратТоваровОтПокупателя;
			Док.ДокументОснование = Реализация;
			Док.Дата 			  = ТекущаяДатаСеанса();
			
			Для Каждого ТекТовар Из Реализация.Товары Цикл 
				НовСтрока = Док.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, ТекТовар);
				НовСтрока.ДокументПродажи = Реализация;
			КонецЦикла;
			
			Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			
			СозадтьОбратноеПеремещение(ДокЗаказ);
			
			
		КонецЕсли;
	Иначе 
	КонецЕсли;
	
КонецФункции

Процедура СоздатьПеремещенияТоваровВозврата(ДокЗаказ)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДокументОснование", ДокЗаказ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПеремещениеТоваров.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
	               |ГДЕ
	               |	ПеремещениеТоваров.ДокументОснование = &ДокументОснование
	               |	И ПеремещениеТоваров.Проведен";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		
		ДокСсылка = Выборка.Ссылка;
		
		Док = Документы.ПеремещениеТоваров.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(Док, ДокСсылка, ,"Номер, Дата, ВходящийНомер");
		
		Док.Дата = ТекущаяДатаСеанса();
		Док.МагазинОтправитель =  ДокСсылка.МагазинПолучатель;
		Док.СкладОтправитель   =  ДокСсылка.СкладОтправитель;
		Док.МагазинПолучатель  =  ДокСсылка.МагазинОтправитель;
		Док.СкладПолучатель	   =  ДокСсылка.СкладОтправитель;
		
		Для Каждого ТекТовар Из ДокСсылка.Товары Цикл 
			
			НовСтрока = Док.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, ТекТовар);
			
		КонецЦикла;
		
		Док.Записать();
		Док.ВходящийНомер = Док.Номер;
		
		Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		
		ДокКоробка = Документы.ПеремещениеТоваровДетали.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(ДокКоробка, Док, , "Номер");
		ДокКоробка.ДокументОснование = Док.Ссылка;
		
		УИД = Новый УникальныйИдентификатор;
		УИДСтрока = Строка(УИД);		
		
		НовКоробка = ДокКоробка.Коробки.Добавить();
		НовКоробка.НомерКоробки  = ДокКоробка.ВходящийНомер + "IntBx1";
		НовКоробка.УИДКоробки	 = УИДСтрока;
		НовКоробка.ДатаПрибытие  = ДокКоробка.Дата;
		НовКоробка.ДатаЗакрытие  = ДокКоробка.Дата;
		НовКоробка.НомерОтгрузки = ДокКоробка.ВходящийНомер;
		НовКоробка.Статус		 = Перечисления.СтатусыКоробок.Закрыт;
		
		Для Каждого ТекТовар Из ДокСсылка.Товары  Цикл 
			НовСтрока = ДокКоробка.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, ТекТовар);
			НовСтрока.УИДКоробки = УИДСтрока;
			НовСтрока.ФактическоеКоличество = ТекТовар.Количество;
		КонецЦикла;
		
		НовКоробка.Количество = ДокКоробка.Товары.Итог("Количество");
		
		ДокКоробка.Статус = Перечисления.СтатусыПеремещениеТоваровДетали.Закрыт;
		
		ДокКоробка.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Функция СоздатьЗаказ(КодЗаказа)
	ТоварыКорзины.Очистить();
	АдресРесурса = "https://kaspi.kz/shop/api/v2/orders?filter[orders][code]=%1";
	ПараметрИсточник = ПолучитьПараметрИсточника("GET_ORDERS");
	АдресРесурса = СтрШаблон(АдресРесурса, КодЗаказа);
	
	Заголовки 	= ПолучитьЗаголовкиЗапросаHTTP();
	
	Попытка 
		Результат 	= КоннекторHTTP.GetJson(АдресРесурса, Неопределено, Новый Структура("Заголовки,Таймаут", Заголовки,180));
		
	Исключение
		ЗаписатьВЖурналРегистра(ПараметрИсточник, КодЗаказа, ЛОжь, "Ошибка при отправке запроса "+ АдресРесурса +":" +ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
	
	МассивДанных = Результат.Получить("data"); 
	
	АдресДоставки    = "";
	НомерТелефона    = "";
	Покупатель	     = "";
	ДатаЗаказаUnix 	 = "";
	ДатаДоставкиUnix = "";
	СтатусЗаказа 	 = "";
	
	ТаблицаТоваров = ПолучитьТЗТоваров();
	
	Для Каждого ТекСтрока Из МассивДанных Цикл 
		
		orderId = ТекСтрока.Получить("id");
		
		Аттрибуты = ТекСтрока.Получить("attributes");
		
		Если Аттрибуты <> Неопределено Тогда 
			
			ДатаЗаказаUnix = Аттрибуты.Получить("creationDate"); 
			СтатусЗаказа   = Аттрибуты.Получить("status");
			
			ЭтоКаспиДоставка = Аттрибуты.Получить("isKaspiDelivery");
			
			Если АдресДоставки = "" Тогда 
				deliveryAddress = Аттрибуты.Получить("deliveryAddress");
				Если deliveryAddress <> Неопределено Тогда 
					АдресДоставки = deliveryAddress.Получить("formattedAddress");
				КонецЕсли;
			КонецЕсли;
			
			Если Покупатель = "" Тогда 
				customer = Аттрибуты.Получить("customer");
				Если customer <> Неопределено Тогда 
					НомерТелефона = customer.Получить("cellPhone");
					Покупатель    = customer.Получить("firstName") + " " +customer.Получить("lastName");
				КонецЕсли;
			КонецЕсли;
			
			СуммаТоваров = Аттрибуты.Получить("totalPrice");
						
			КаспиДоставка = Аттрибуты.Получить("kaspiDelivery");
			
			Если КаспиДоставка <> Неопределено Тогда 
				ДатаДоставкиUnix = КаспиДоставка.Получить("courierTransmissionPlanningDate");
			КонецЕсли;
			
			СтруктураТоварИСклад = ПолучитьorderOrderEntries(orderId, ЭтоКаспиДоставка);
			
			Если  СтруктураТоварИСклад =  Неопределено Тогда
				Возврат "";
			КонецЕсли;
			
			
			Если СтруктураТоварИСклад.Свойство("Склад") Тогда 
				
				НовТЗ = ТаблицаТоваров.Добавить();
				Если СтруктураТоварИСклад.СтруктураТовара <> неопределено Тогда 
					НовТЗ.Номенклатура   = СтруктураТоварИСклад.СтруктураТовара.Номенклатура;
					НовТЗ.Характеристика = СтруктураТоварИСклад.СтруктураТовара.Характеристика;
				КонецЕсли;
				НовТЗ.Склад			 = СтруктураТоварИСклад.Склад;
				НовТЗ.Количество	 = СтруктураТоварИСклад.Количество;
	 			НовТЗ.Цена			 = СуммаТоваров/СтруктураТоварИСклад.Количество;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Если ДатаЗаказаUnix <> "" Тогда 
		ДатаЗаказа = TimestampВДату(ДатаЗаказаUnix/1000);
	Иначе 
		ДатаЗаказа = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ДатаДоставкиUnix <> ""
		И ДатаДоставкиUnix <> Неопределено Тогда
		ДатаДоставки = TimestampВДату(ДатаДоставкиUnix/1000);
	Иначе  		
		ДатаДоставки = ТекущаяДатаСеанса()+24*60*60;
	КонецЕсли;
	
	Если  ТоварыКорзины.Количество() > 0 Тогда
		
		СоздатьДокументЗаказа(ТаблицаТоваров, Покупатель, НомерТелефона, АдресДоставки, ДатаЗаказа, КодЗаказа, ДатаДоставки, СтатусЗаказа, OrderId, ЭтоКаспиДоставка);
		
	Иначе
		
		ЗаписатьВЖурналРегистра(ПараметрИсточник, КодЗаказа, ЛОжь, "Товары не заполнены");

		
	КонецЕсли;

КонецФункции

Функция ПроверитьСтатусЗаказа(НомерЗаказа) 

	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("НомерЗаказаНаСайте", НомерЗаказа);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДокЗаказПокупателя.Ссылка КАК Ссылка,
	               |	ДокЗаказПокупателя.Статус КАК Статус,
	               |	ДокЗаказПокупателя.Проведен КАК Проведен,
	               |	ДокЗаказПокупателя.Отменено КАК Отменено,
	               |	ЕСТЬNULL(ВозвратТоваровОтПокупателя.Ссылка, ЗНАЧЕНИЕ(Документ.ВозвратТоваровОтПокупателя.ПустаяСсылка)) КАК ДокВозврат,
	               |	ДокЗаказПокупателя.Магазин КАК Магазин
	               |ИЗ
	               |	Документ.ЗаказПокупателя КАК ДокЗаказПокупателя
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваров КАК РеализацияТоваров
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровОтПокупателя КАК ВозвратТоваровОтПокупателя
	               |			ПО РеализацияТоваров.Ссылка = ВозвратТоваровОтПокупателя.ДокументОснование
	               |				И (ВозвратТоваровОтПокупателя.Проведен)
	               |		ПО (РеализацияТоваров.ЗаказПокупателя = ДокЗаказПокупателя.Ссылка)
	               |ГДЕ
	               |	ДокЗаказПокупателя.НомерЗаказаНаСайте = &НомерЗаказаНаСайте
	               |	И ДокЗаказПокупателя.Проведен";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Если Выборка.Отменено Тогда 
			Возврат Истина;
		ИначеЕсли  Не Выборка.Отменено Тогда 
			ОбработатьЗаказ(Выборка.Ссылка);
			Возврат Истина;
		КонецЕсли;			
	КонецЕсли;
	
КонецФункции

Функция ОбработатьЗаказ(ДокЗаказ)
	
	ПараметрИсточник = ПолучитьПараметрИсточника("GET_ORDERS");

	Док = ДокЗаказ.ПолучитьОбъект();
	
	
	Попытка
		
		Док.Статус   = Перечисления.СтатусыЗаказовПокупателей.Закрыт;
		Док.Отменено = Истина;
		Для Каждого ТекТовар Из Док.Товары Цикл 
			ТекТовар.Отменено = Истина;
			ТекТовар.ПричинаОтмены =  ПолучитьПричинуОтмены(); 
		КонецЦикла;  
		
		Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		//СозадтьОбратноеПеремещение(Док.Ссылка);
		ЗаписатьВЖурналРегистра(ПараметрИсточник, Док.НомерЗаказаНаСайте, Истина, "CANCELLED");
	Исключение
		
		ЗаписатьВЖурналРегистра(ПараметрИсточник, Док.НомерЗаказаНаСайте, Ложь, ОписаниеОшибки());
	КонецПопытки;
	
	
КонецФункции

Функция ПолучитьПричинуОтмены()
	Запрос  = Новый Запрос;
	Запрос.УстановитьПараметр("Код","00003");
	Запрос.Текст =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                |	Причины.Ссылка КАК Ссылка
	                |ИЗ
	                |	Справочник.ПричиныОтменыЗаказовПокупателей КАК Причины
	                |ГДЕ
	                |	Причины.Код = &Код";
	Выборка  =   Запрос.Выполнить().Выбрать();
	Если  Выборка.Следующий() Тогда
		Возврат  Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции

Функция СоздатьДокументЗаказа(ТаблицаТоваров, Покупатель, НомерТелефона, АдресДоставки, ДатаЗаказа, НомерЗаказа, ДатаДоставки, СтатусЗаказа, OrderId, ЭтоКаспиДоставка)
	
	МассивПакетов = ПолучитьПакетЗаказов(ТаблицаТоваров);
	ТЗ_Склады 	  = МассивПакетов[2].Выгрузить();
	СкладПродаж  = Справочники.Склады.ПустаяСсылка(); 
	Для каждого Тек из ТЗ_Склады Цикл
		СкладПродаж     =  Тек.Склад;		
	КонецЦикла;
	
	Страна  = СкладПродаж.Страна;
	Магазин = СкладПродаж.Магазин; 
	Склад	= СкладПродаж;
	
		
	Контрагент =  Страна.КонтрагентРозничныйПокупатель;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("НомерЗаказаНаСайте", НомерЗаказа);
	Запрос.УстановитьПараметр("Дата", ДатаЗаказа);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказПокупателя.Ссылка КАК Ссылка,
	               |	ЗаказПокупателя.Статус КАК Статус,
	               |	ЗаказПокупателя.Проведен КАК Проведен
	               |ИЗ
	               |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	               |ГДЕ
	               |	ЗаказПокупателя.НомерЗаказаНаСайте = &НомерЗаказаНаСайте
	               |	И ЗаказПокупателя.Дата = &Дата
	               |	И ЗаказПокупателя.Проведен";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 		
		Док = Выборка.Ссылка.ПолучитьОбъект();
	Иначе 
		Док = Документы.ЗаказПокупателя.СоздатьДокумент();
	КонецЕсли;
	
	Док.Дата 			    = ДатаЗаказа+14400;
	Док.Магазин      	    = Магазин;
	Док.Склад        	    = Склад;
	Док.Контрагент   	    = Контрагент;
	Док.УчитыватьНДС        = Истина;
	Док.ЦенаВключаетНДС     = Истина;
	Док.Организация 	    = Склад.Организация;
	Док.Страна			    = Страна;
	Если ЭтоКаспиДоставка  Тогда
		Док.Самовывоз = Ложь;
	Иначе
		Док.Самовывоз = Истина;
	КонецЕсли;
	
	Док.Статус				= Перечисления.СтатусыЗаказовПокупателей.НеСогласован;
	Док.АдресДоставки	    = АдресДоставки;
	Док.Комментарий		    = Покупатель + " " + НомерТелефона;
	Док.НомерЗаказаНаСайте  = НомерЗаказа;
	Док.ДатаЗаказаНаСайте   = ДатаЗаказа + 14400;
	Док.ЖелаемаяДатаПродажи = ДатаДоставки + 14400;
	Док.ИнтернетСклад       = ПолучитьИнтернетСклад(ИнтернетМагазин);
	Док.ИдентификаторЗаказа = OrderId; 
	Товары = МассивПакетов[1].Выгрузить();
	
	Док.Товары.Очистить();
	
	Для Каждого ТекСтрока Из ТоварыКорзины.Выгрузить() Цикл 
		
		Если ТекСтрока.Количество > 1 Тогда
			Для Счетчик = 1 по ТекСтрока.Количество Цикл;
				НовСтрока = Док.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, ТекСтрока);
				НовСтрока.Количество = 1;
				НовСтрока.КоличествоУпаковок = 1;
				НовСтрока.Сумма				 = ТекСтрока.Цена*1;
				НовСтрока.СтавкаНДС           = Перечисления.СтавкиНДС.НДС16;
				НовСтрока.СуммаНДС	          = ОбработкаТабличнойЧастиТоварыСервер.РассчитатьСуммуНДС(НовСтрока.Сумма, НовСтрока.СтавкаНДС, Истина);
			КонецЦикла;
		Иначе
			НовСтрока = Док.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, ТекСтрока);
			НовСтрока.КоличествоУпаковок = ТекСтрока.Количество;
			НовСтрока.Сумма				 = ТекСтрока.Цена*ТекСтрока.Количество;
		 	НовСтрока.СтавкаНДС           = Перечисления.СтавкиНДС.НДС16;
	 		НовСтрока.СуммаНДС	          = ОбработкаТабличнойЧастиТоварыСервер.РассчитатьСуммуНДС(НовСтрока.Сумма, НовСтрока.СтавкаНДС, Истина);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрИсточник = ПолучитьПараметрИсточника("GET_ORDERS");
	
	Док.Ответственный = Пользователи.ТекущийПользователь();


	Попытка
		
		Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		Подтвердить_ЗаказКаспи(НомерЗаказа, OrderId );
		ЗаписатьВЖурналРегистра(ПараметрИсточник, НомерЗаказа, Истина, Док.АдресДоставки);
	Исключение
		ЗаписатьВЖурналРегистра(ПараметрИсточник, НомерЗаказа, Ложь, ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции

Функция СоздатьПеремещениеТоваров(СкладОтправитель, Товары, СкладПолучатель, ДокЗаказ)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("СкладОтправитель", СкладОтправитель);
	Запрос.УстановитьПараметр("СкладПолучатель",  СкладПолучатель);
	Запрос.УстановитьПараметр("ЗаказПокупателя", ДокЗаказ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОрдерНаПеремещениеТоваров.Ссылка КАК Ссылка,
	               |	ОрдерНаПеремещениеТоваров.Проведен КАК Проведен
	               |ИЗ
	               |	Документ.ОрдерНаПеремещениеТоваров КАК ОрдерНаПеремещениеТоваров
	               |ГДЕ
	               |	ОрдерНаПеремещениеТоваров.ЗаказПокупателя = &ЗаказПокупателя
	               |	И ОрдерНаПеремещениеТоваров.СкладОтправитель = &СкладОтправитель";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Если Выборка.Проведен Тогда 
			Возврат Истина;
		КонецЕсли;
		
		Док = Выборка.Ссылка.ПолучитьОбъект();
	Иначе 
		Док = Документы.ОрдерНаПеремещениеТоваров.СоздатьДокумент();
	КонецЕсли;
		
	СтрПоиска = Новый Структура;
	СтрПоиска.Вставить("Склад", СкладОтправитель);
	
	Док.Дата = ДокЗаказ.Дата - 5;
	Док.СкладОтправитель 	  = СкладОтправитель;
	Док.Магазин 	  		  = СкладОтправитель.Магазин;
	Док.Организация		   	  = СкладОтправитель.Организация;
	Док.СкладПолучатель	   	  = СкладПолучатель;
	Док.МагазинПолучатель  	  = СкладПолучатель.Магазин;
	Док.ЗаказПокупателя		  = ДокЗаказ;
	Док.Страна				  = ДокЗаказ.Страна;
	Док.ДокументОснование	  = ДокЗаказ;
	Док.НомерКоробки		  = ДокЗаказ.НомерЗаказаНаСайте;
	Док.Ответственный		  = Пользователи.ТекущийПользователь();
	
	Док.Товары.Очистить();
	Для Каждого ТекТовар Из ДокЗаказ.Товары Цикл 
		НовСтрока = Док.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, ТекТовар);
		НовСтрока.КоличествоУпаковок = ТекТовар.Количество;
	КонецЦикла;
	
	Док.Комментарий = ДокЗаказ.Комментарий;
	
	Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	
КонецФункции

Функция СозадтьОбратноеПеремещение(ДокЗаказ)
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ЗаказПокупателя", ДокЗаказ);
	Запрос.Текст = "ВЫБРАТЬ
	|	ОрдерНаПеремещениеТоваров.Ссылка КАК Ссылка,
	|	ОрдерНаПеремещениеТоваров.ВерсияДанных КАК ВерсияДанных,
	|	ОрдерНаПеремещениеТоваров.ПометкаУдаления КАК ПометкаУдаления,
	|	ОрдерНаПеремещениеТоваров.Номер КАК Номер,
	|	ОрдерНаПеремещениеТоваров.Дата КАК Дата,
	|	ОрдерНаПеремещениеТоваров.Проведен КАК Проведен,
	|	ОрдерНаПеремещениеТоваров.ДокументОснование КАК ДокументОснование,
	|	ОрдерНаПеремещениеТоваров.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ОрдерНаПеремещениеТоваров.Комментарий КАК Комментарий,
	|	ОрдерНаПеремещениеТоваров.Контрагент КАК Контрагент,
	|	ОрдерНаПеремещениеТоваров.Магазин КАК Магазин,
	|	ОрдерНаПеремещениеТоваров.МагазинПолучатель КАК МагазинПолучатель,
	|	ОрдерНаПеремещениеТоваров.Договор КАК Договор,
	|	ОрдерНаПеремещениеТоваров.Организация КАК Организация,
	|	ОрдерНаПеремещениеТоваров.ОтборЗаполнения КАК ОтборЗаполнения,
	|	ОрдерНаПеремещениеТоваров.Ответственный КАК Ответственный,
	|	ОрдерНаПеремещениеТоваров.СкладОтправитель КАК СкладОтправитель,
	|	ОрдерНаПеремещениеТоваров.СкладПолучатель КАК СкладПолучатель,
	|	ОрдерНаПеремещениеТоваров.Страна КАК Страна,
	|	ОрдерНаПеремещениеТоваров.НомерКоробки КАК НомерКоробки,
	|	ОрдерНаПеремещениеТоваров.СуммаДокумента КАК СуммаДокумента,
	|	ОрдерНаПеремещениеТоваров.Товары.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		Количество КАК Количество,
	|		КоличествоУпаковок КАК КоличествоУпаковок,
	|		Номенклатура КАК Номенклатура,
	|		Упаковка КАК Упаковка,
	|		Характеристика КАК Характеристика,
	|		КлючСвязиСерийныхНомеров КАК КлючСвязиСерийныхНомеров,
	|		СтатусУказанияСерий КАК СтатусУказанияСерий,
	|		Цена КАК Цена,
	|		Сумма КАК Сумма,
	|		КлючСвязи КАК КлючСвязи
	|	) КАК Товары,
	|	ОрдерНаПеремещениеТоваров.Представление КАК Представление,
	|	ОрдерНаПеремещениеТоваров.МоментВремени КАК МоментВремени
	|ИЗ
	|	Документ.ОрдерНаПеремещениеТоваров КАК ОрдерНаПеремещениеТоваров
	|ГДЕ
	|	ОрдерНаПеремещениеТоваров.ЗаказПокупателя = &ЗаказПокупателя
	|	И ОрдерНаПеремещениеТоваров.Проведен";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ДокПерем = Документы.ОрдерНаПеремещениеТоваров.СоздатьДокумент();
		
		ЗаполнитьЗначенияСвойств(ДокПерем, Выборка,, "Номер, Магазин, МагазинПолучатель, СкладОтправитель, СкладПолучатель");
		
		
		ДокПерем.Дата = ТекущаяДатаСеанса();
		ДокПерем.Магазин 		   = Выборка.МагазинПолучатель;
		ДокПерем.МагазинПолучатель = Выборка.Магазин;
		ДокПерем.СкладОтправитель  = Выборка.СкладПолучатель;
		ДокПерем.СкладПолучатель   = Выборка.СкладОтправитель;
		
		ДокПерем.Товары.Загрузить(Выборка.Товары.Выгрузить());
		
		ДокПерем.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		
	Иначе
		
		Запрос1 = Новый Запрос();
		Запрос1.УстановитьПараметр("ЗаказПокупателя", ДокЗаказ);
		Запрос1.Текст = "ВЫБРАТЬ
		|	КомплектыЗаказовТовары.Номенклатура КАК Номенклатура,
		|	КомплектыЗаказовТовары.Характеристика КАК Характеристика,
		|	СУММА(КомплектыЗаказовТовары.Количество) КАК Количество,
		|	КомплектыЗаказовТовары.Цена КАК Цена,
		|	СУММА(КомплектыЗаказовТовары.Сумма) КАК Сумма,
		|	КомплектыЗаказовТовары.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КомплектыЗаказов.Товары КАК КомплектыЗаказовТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОрдерНаПеремещениеТоваров КАК ОрдерНаПеремещениеТоваров
		|		ПО КомплектыЗаказовТовары.Ссылка = ОрдерНаПеремещениеТоваров.ДокументОснование
		|ГДЕ
		|	КомплектыЗаказовТовары.Ссылка.Проведен
		|	И КомплектыЗаказовТовары.ЗаказПокупателя = &ЗаказПокупателя
		|
		|СГРУППИРОВАТЬ ПО
		|	КомплектыЗаказовТовары.Характеристика,
		|	КомплектыЗаказовТовары.Ссылка,
		|	КомплектыЗаказовТовары.Номенклатура,
		|	КомплектыЗаказовТовары.Цена";
		
		Рез = Запрос1.Выполнить().Выбрать();
		Если Рез.Следующий() Тогда
			ДокПерем = Документы.ОрдерНаПеремещениеТоваров.СоздатьДокумент();
			
			ДокПерем.ДокументОснование = Рез.Ссылка;
			ИН = Справочники.ИнтернетМагазины.НайтиПоКоду("000000001");
			ДокПерем.Дата = ТекущаяДатаСеанса();
			ДокПерем.Магазин 		   = ИН.Магазин;
			ДокПерем.МагазинПолучатель = ДокЗаказ.Магазин;
			ДокПерем.СкладОтправитель  = ИН.Магазин.СкладПродажи;
			ДокПерем.СкладПолучатель   = ДокЗаказ.Склад;
			ДокПерем.Комментарий       = ДокЗаказ.Комментарий;
			ДокПерем.НомерКоробки      = ДокЗаказ.НомерЗаказаНаСайте;
			ДокПерем.Страна            = ИН.Страна;
			ДокПерем.Организация       = ИН.Магазин.СкладПродажи.Организация;
			
			
			Если ДокЗаказ.Магазин.КодИсточника = "M0281" Тогда
				Магаз = Справочники.Магазины.НайтиПоРеквизиту("КодИсточника", "M0245");
				ДокПерем.МагазинПолучатель = Магаз;
			    ДокПерем.СкладПолучатель   = Магаз.СкладПродажи;
			КонецЕсли;

			
			
			
			ДокПерем.ЗаказПокупателя   = ДокЗаказ;
			ДокПерем.Товары.Очистить();
			Для Каждого Зак из ДокЗаказ.Товары Цикл
				
				
			Тов = ДокПерем.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(Тов,Зак);
			
			//Тов.Номенклатура   = Рез.Номенклатура;
			//Тов.Характеристика = Рез.Характеристика;
			//Тов.Количество     = Рез.Количество;
			//Тов.КоличествоУпаковок = Рез.Количество;
			//Тов.Сумма          = Рез.Сумма;
			//Тов.Цена           = Рез.Цена;
			
			КонецЦикла;
			
			
			
			
			
			ДокПерем.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			
			
			
		КонецЕсли;
		
		
		
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьПакетЗаказов(ТаблицаТоваров)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Товары", ТаблицаТоваров);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Товары.Номенклатура КАК Номенклатура,
	               |	Товары.Характеристика КАК Характеристика,
	               |	Товары.Цена КАК Цена,
	               |	Товары.Количество КАК Количество,
	               |	Товары.Склад КАК Склад
	               |ПОМЕСТИТЬ ВТ_Товары
	               |ИЗ
	               |	&Товары КАК Товары
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Товары.Номенклатура КАК Номенклатура,
	               |	ВТ_Товары.Характеристика КАК Характеристика,
	               |	ВТ_Товары.Цена КАК Цена,
	               |	СУММА(ВТ_Товары.Количество) КАК Количество
	               |ИЗ
	               |	ВТ_Товары КАК ВТ_Товары
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Товары.Номенклатура,
	               |	ВТ_Товары.Характеристика,
	               |	ВТ_Товары.Цена
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Товары.Склад КАК Склад
	               |ИЗ
	               |	ВТ_Товары КАК ВТ_Товары
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Товары.Номенклатура КАК Номенклатура,
	               |	ВТ_Товары.Характеристика КАК Характеристика,
	               |	СУММА(ВТ_Товары.Количество) КАК Количество,
	               |	ВТ_Товары.Склад КАК Склад
	               |ИЗ
	               |	ВТ_Товары КАК ВТ_Товары
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Товары.Номенклатура,
	               |	ВТ_Товары.Характеристика,
	               |	ВТ_Товары.Склад";
	
	Возврат Запрос.ВыполнитьПакет();
	
КонецФункции

Функция ПолучитьorderOrderEntries(НомерЗаказа, ЭтоКаспиДоставка)
	
	ПараметрИсточник = ПолучитьПараметрИсточника("GET_ORDERS");
	АдресРесурса = "https://kaspi.kz/shop/api/v2/orders/%1/entries";
	
	АдресРесурса = СтрШаблон(АдресРесурса, НомерЗаказа);
	
	Заголовки 	= ПолучитьЗаголовкиЗапросаHTTP();
	Попытка 
		Результат 	= КоннекторHTTP.GetJson(АдресРесурса, Неопределено, Новый Структура("Заголовки,Таймаут", Заголовки,180));
	Исключение
		ЗаписатьВЖурналРегистра(ПараметрИсточник, НомерЗаказа, ЛОжь, "ПолучитьorderOrderEntries: " +ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	МассивДанных = Результат.Получить("data");
	
	СтруктураТоварИСклад = Новый Структура;
	
	Для Каждого ТекСтрока Из МассивДанных Цикл 
		
		orderEntryId = ТекСтрока.Получить("id");
		
		Аттрибуты = ТекСтрока.Получить("attributes");
		
		Количество 	  = Аттрибуты.Получить("quantity");
		
		Если  Количество =  0 Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаТоваров  = Аттрибуты.Получить("totalPrice");
		СуммаДоставки = Аттрибуты.Получить("deliveryCost");
		
		СтруктураТоварИСклад.Вставить("Количество", Количество);
		СтруктураТоварИСклад.Вставить("СуммаДоставки", СуммаДоставки);
		
		relationships = ТекСтрока.Получить("relationships");
		Если relationships <> Неопределено Тогда 
			
			product = relationships.Получить("product");
			Если product <> Неопределено Тогда 
				links =  product.Получить("links");
				
				Если links <> Неопределено Тогда 
					related = links.Получить("related");
					
					СтруктураТовара = ПолучитьТоварыЗаказа(related,НомерЗаказа);
					Если СтруктураТовара = Неопределено Тогда
						Возврат Неопределено; 
					Иначе
						ТТ = ТоварыКорзины.Добавить();
						ТТ.Количество     = Количество;
						ТТ.Номенклатура   = СтруктураТовара.Номенклатура;
						ТТ.Характеристика = СтруктураТовара.Характеристика;
						ТТ.Цена           = СуммаТоваров / Количество; 
						ТТ.ИдентификаторСтроки =  orderEntryId;
					КонецЕсли;
					СтруктураТоварИСклад.Вставить("СтруктураТовара", СтруктураТовара);
					
				КонецЕсли;
				
			КонецЕсли;
			
			deliveryPointOfService = relationships.Получить("deliveryPointOfService");
			
			Если deliveryPointOfService <> Неопределено Тогда 
				
				links = deliveryPointOfService.Получить("links");
				Если links <> Неопределено Тогда 
					related = links.Получить("related");
					
					Склад = ПолучитьТочкиПродаж(related, ЭтоКаспиДоставка, НомерЗаказа);
					
					Если Склад =  Неопределено Тогда
						Возврат Неопределено;
					КонецЕсли;
					
					
					СтруктураТоварИСклад.Вставить("Склад", Склад);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураТоварИСклад;
	
КонецФункции

Функция ПолучитьТочкиПродаж(АдресРесурса, ЭтоКаспиДоставка, НомерЗаказа = "")

	Заголовки = ПолучитьЗаголовкиЗапросаHTTP();
	Результат = КоннекторHTTP.GetJson(АдресРесурса, Неопределено, Новый Структура("Заголовки", Заголовки));

	Данные = Результат.Получить("data");

	Аттрибуты   = Данные.Получить("attributes");
	КодМагазина = Аттрибуты.Получить("displayName");

	Если КодМагазина  = "PP1"  Тогда
		Склад = Справочники.Склады.НайтиПоРеквизиту("КодИсточника", "M07901");
	ИначеЕсли КодМагазина  = "PP2"  Тогда
		Склад = Справочники.Склады.НайтиПоРеквизиту("КодИсточника", "AW02");
	Иначе
		Склад = Неопределено;
		ПараметрИсточник = ПолучитьПараметрИсточника("GET_ORDERS");
		ЗаписатьВЖурналРегистра(ПараметрИсточник, НомерЗаказа, Ложь,
			"ПолучитьТочкиПродаж: неизвестный пункт выдачи '" + КодМагазина
			+ "' (ожидались только PP1 или PP2), склад не определён, заказ не создан.");
	КонецЕсли;

	Возврат Склад;

КонецФункции


Функция ПолучитьТоварыЗаказа(АдресРесурса,НомерЗаказа)
	
	ПараметрИсточник = ПолучитьПараметрИсточника("GET_ORDERS");
	Заголовки = ПолучитьЗаголовкиЗапросаHTTP();
	Попытка
		Результат = КоннекторHTTP.GetJson(АдресРесурса, Неопределено, Новый Структура("Заголовки,Таймаут", Заголовки,180));
	Исключение
		ЗаписатьВЖурналРегистра(ПараметрИсточник, НомерЗаказа, ЛОжь, "ПолучитьТоварыЗаказа: "+ АдресРесурса +": "+ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	Данные = Результат.Получить("data");
	
	Если Данные <> Неопределено Тогда 
		
		КодТовара = Данные.Получить("id");
		
		АдресРесурса = "https://kaspi.kz/shop/api/v2/masterproducts/%1/merchantProduct";
		
		АдресРесурса = СтрШаблон(АдресРесурса, КодТовара);
		
		Заголовки = ПолучитьЗаголовкиЗапросаHTTP();
		
		Попытка
			Результат = КоннекторHTTP.GetJson(АдресРесурса, Неопределено, Новый Структура("Заголовки,Таймаут", Заголовки,180));
		Исключение
			ЗаписатьВЖурналРегистра(ПараметрИсточник,НомерЗаказа , ЛОжь, "ПолучитьТоварыЗаказа "+ АдресРесурса +": " +ОписаниеОшибки());
			Возврат Неопределено;
		КонецПопытки;
		
		Данные = Результат.Получить("data");
		
		Если Данные <> Неопределено Тогда 
			
			Аттрибуты = Данные.Получить("attributes");
			Если Аттрибуты <> Неопределено Тогда 
				
				Штрихкод = Аттрибуты.Получить("code");
				
				Запрос = Новый Запрос();
				Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
				Запрос.Текст = "ВЫБРАТЬ
				               |	Штрихкоды.Владелец КАК Номенклатура,
				               |	Штрихкоды.Характеристика КАК Характеристика
				               |ИЗ
				               |	РегистрСведений.Штрихкоды КАК Штрихкоды
				               |ГДЕ
				               |	Штрихкоды.Штрихкод = &Штрихкод";
				
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Возврат Выборка;
				Иначе
					ЗаписатьВЖурналРегистра(ПараметрИсточник, НомерЗаказа, Ложь,
						"ПолучитьТоварыЗаказа: штрихкод '" + Штрихкод
						+ "' не найден в РегистрСведений.Штрихкоды, заказ не создан.");
					Возврат Неопределено;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ДатуВTimestamp(пДата = Неопределено, МиллиСекунда = "000")
   Возврат Формат(Число(?(ТипЗнч(пДата) = Тип("Дата"), пДата, ТекущаяДата())-Дата("19700101")),"ЧН=0; ЧГ=0") + МиллиСекунда;
КонецФункции

Функция TimestampВДату(unixtime)
	Возврат дата(1970,1,1,1,0,0) + unixtime;
КонецФункции

Функция ПолучитьТЗТоваров()
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Номенклатура",   Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаДанных.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаДанных.Колонки.Добавить("Склад",          Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТаблицаДанных.Колонки.Добавить("Цена",	 		 ОбщегоНазначенияРТКлиентСервер.ПолучитьОписаниеТиповЧисла(15, 2));
	ТаблицаДанных.Колонки.Добавить("Количество",	 ОбщегоНазначенияРТКлиентСервер.ПолучитьОписаниеТиповЧисла(15, 2));
	
	Возврат ТаблицаДанных;
	
КонецФункции

Функция Подтвердить_ЗаказКаспи(НомерЗаказа, rid )
	ПараметрИсточник = ПолучитьПараметрИсточника("GET_ORDERS");
	АдресРесурса = "https://kaspi.kz/shop/api/v2/orders";
	Заголовки = ПолучитьЗаголовкиЗапросаHTTP();
	
	аттрибуты = Новый Структура;
	аттрибуты.Вставить("code", НомерЗаказа);
	аттрибуты.Вставить("status", "ACCEPTED_BY_MERCHANT");
	
	СУбТело = Новый Структура;
	СУбТело.Вставить("type", "orders");
	СУбТело.Вставить("id", rid);
	СУбТело.Вставить("attributes", аттрибуты);
	
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("data", СубТело);
		
	Попытка
		Результат = КоннекторHTTP.PostJsonGetHTTPResponse(АдресРесурса,ТелоЗапроса, Новый Структура("Заголовки,Таймаут",Заголовки,180));
		
		Если Результат.КодСостояния = 201 Тогда
			ЗаписатьВЖурналРегистра(ПараметрИсточник, НомерЗаказа, Истина, "Заказ подтвержден");

			Возврат Истина;	
		Иначе
			ОтветТекст  = КоннекторHTTP.КакТекст(Результат);
			ТекстОшибки ="Не удалось согласовать заказ! КодОшибки:"+Строка(Результат.КодСостояния) +". Ошибка:"+Строка(ОтветТекст);
			ЗаписатьВЖурналРегистра(ПараметрИсточник, НомерЗаказа, Ложь, ТекстОшибки);
			
			Возврат Ложь;
		КонецЕсли;
	Исключение
		ЗаписатьВЖурналРегистра(ПараметрИсточник, НомерЗаказа, Ложь, "Подтвердить_ЗаказКаспи: "+ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

