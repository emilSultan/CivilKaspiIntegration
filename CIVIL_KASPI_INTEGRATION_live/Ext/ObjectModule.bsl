Функция ПолучитьHTMLТело(Данные) 
	HTML = "<html><body>";
	HTML = HTML + "<p>Список новых заказов:</p>";
	HTML = HTML + "<table border='1' cellspacing='0' cellpadding='5' style='border-collapse: collapse; font-family: Arial; font-size: 13px;'>";
	HTML = HTML + "<tr style='background-color:#f2f2f2;'>
	              |<th>Дата</th>
	              |<th>Номер заказа на сайте</th>
	              |<th>СКУ</th>
	              |<th>Количество</th>
	              |</tr>";
	
	Для Каждого Тек Из Данные Цикл
		HTML = HTML + "<tr>";
		HTML = HTML + "<td>" + Формат(Тек.Дата, "ДФ=dd.MM.yyyy") + "</td>";
		HTML = HTML + "<td>" + Тек.НомерЗаказаНаСайте + "</td>";
		HTML = HTML + "<td>" + Тек.СКУ + "</td>";
		HTML = HTML + "<td>" + Формат(Тек.Количество, "ЧГ=0") + "</td>";
		HTML = HTML + "</tr>";
	КонецЦикла;
	HTML = HTML + "</table></body></html>";
	
	Возврат HTML;
КонецФункции

Функция мп_НакладныеЗаписать(Данные)
	Ответ = "";
	НЗ = РегистрыСведений.мп_Накладные.СоздатьНаборЗаписей();
	НЗ.Отбор.Заказ.Установить(Данные.Заказ);
	НЗ.Прочитать();
	Если НЗ.Количество() = 0 Тогда
		ЗаполнитьЗначенияСвойств(НЗ.Добавить(), Данные);
		Если НЗ.ПроверитьЗаполнение() Тогда
			НЗ.ОбменДанными.Загрузка = Истина;
			Попытка
				НЗ.Записать();
			Исключение
				Сообщить(ОписаниеОшибки());
			КонецПопытки;
			
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция ПолучитьОтчет() 
	
	
	Запрос =  Новый  Запрос; 
	Запрос.УстановитьПараметр("Дата", ДобавитьМесяц(ТекущаяДатаСеанса(),-1));
	Запрос.УстановитьПараметр("ИнтернетМагазин",Kaspi());
	Запрос.УстановитьПараметр("НеСогласован", Перечисления.СтатусыЗаказовПокупателей.НеСогласован);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказПокупателя.НомерЗаказаНаСайте КАК НомерЗаказаНаСайте,
	               |	ЗаказПокупателя.Дата КАК Дата,
	               |	СУММА(ЗаказПокупателяТовары.Количество) КАК Количество,
	               |	ЗаказПокупателяТовары.Номенклатура.Артикул + ЗаказПокупателяТовары.Характеристика.Наименование КАК СКУ,
	               |	ЗаказПокупателя.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ НовыеЗаказы
	               |ИЗ
	               |	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ЗаказПокупателя
	               |		ПО ЗаказПокупателяТовары.Ссылка = ЗаказПокупателя.Ссылка
	               |ГДЕ
	               |	ЗаказПокупателя.Проведен
	               |	И ЗаказПокупателя.Дата >= &Дата
	               |	И ЗаказПокупателя.ИнтернетСклад.Владелец = &ИнтернетМагазин
	               |	И ЗаказПокупателя.Статус = &НеСогласован
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказПокупателя.НомерЗаказаНаСайте,
	               |	ЗаказПокупателя.Дата,
	               |	ЗаказПокупателя.Ссылка,
	               |	ЗаказПокупателяТовары.Номенклатура.Артикул + ЗаказПокупателяТовары.Характеристика.Наименование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НовыеЗаказы.Дата КАК Дата,
	               |	НовыеЗаказы.НомерЗаказаНаСайте КАК НомерЗаказаНаСайте,
	               |	НовыеЗаказы.СКУ КАК СКУ,
	               |	НовыеЗаказы.Количество КАК Количество,
	               |	НовыеЗаказы.Ссылка КАК Ссылка
	               |ИЗ
	               |	НовыеЗаказы КАК НовыеЗаказы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.мп_Накладные КАК мп_Накладные
	               |		ПО НовыеЗаказы.Ссылка = мп_Накладные.Заказ
	               |ГДЕ
	               |	мп_Накладные.Заказ ЕСТЬ NULL"; 
	
	Пакет = Запрос.Выполнить().Выгрузить();
	
	Возврат Пакет ;
	
	
КонецФункции

Функция ПолучитьМакетТело(Данные)
	
	Таб = Новый ТабличныйДокумент;
	Таб.Очистить();
	Макет = ПолучитьМакет("Макет");
	ОбластьИмя = Макет.ПолучитьОбласть("ОблатьИмяЗаказыПокупателей");
	ОбластьТело = Макет.ПолучитьОбласть("ОблатьТелоЗаказыПокупателей");
	Таб.Вывести(ОбластьИмя);         	
	Если Данные.Количество() > 0 Тогда 		
		Для Каждого Тек из Данные Цикл 			
			ЗаполнитьЗначенияСвойств(ОбластьТело.Параметры, Тек);
			Таб.Вывести(ОбластьТело);
		КонецЦикла;		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Таб;
	
КонецФункции

