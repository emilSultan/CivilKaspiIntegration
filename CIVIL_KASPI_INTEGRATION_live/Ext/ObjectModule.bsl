Процедура GET_STATUS_DELIVERY() экспорт
	
	
	Выборка = ПолучитьСогласованныеЗаказы();
	Перем_Реал.Очистить();
	Заголовки 	= ПолучитьЗаголовкиЗапросаHTTP();
	Пока Выборка.Следующий() Цикл
		
		
		Попытка 
			АдресРесурса = "https://kaspi.kz/shop/api/v2/orders?filter[orders][code]="+Выборка.НомерЗаказаНаСайте;
			Результат 	= КоннекторHTTP.GetJson(АдресРесурса, Неопределено, Новый Структура("Заголовки", Заголовки));
			МассивДанных = Результат.Получить("data"); 
			Для Каждого ТекСтрока Из МассивДанных Цикл 	
				
				Аттрибуты = ТекСтрока.Получить("attributes");
				
				Если Аттрибуты <> Неопределено Тогда
					
					kaspiDelivery =  Аттрибуты.Получить("kaspiDelivery");
					courierTransmissionDate  =   kaspiDelivery.Получить("courierTransmissionDate");
					status = Аттрибуты.Получить("status");	
					
					
					Если courierTransmissionDate  <> Неопределено Тогда
						Если status =  "COMPLETED"  или  status =  "ACCEPTED_BY_MERCHANT" Тогда
							
							Док  = Выборка.Ссылка.ПолучитьОбъект();
							
							Док.Статус = Перечисления.СтатусыЗаказовПокупателей.Закрыт;
							
							Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
							
							Нова = Перем_Реал.Добавить();
							Нова.ЗаказПокупателя = Выборка.Ссылка;
							Нова.Магазин         = Выборка.Магазин;
							
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		Исключение
			Продолжить;
		КонецПопытки;
		
	КонецЦикла;
	
	Если Перем_Реал.Количество() >   0  Тогда
		Перемещение_Товаров_И_Реализация_Товаров();
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьСогласованныеЗаказы()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата",ДобавитьМесяц(ТекущаяДатаСеанса(),-3));
	Запрос.УстановитьПараметр("Статус",Перечисления.СтатусыЗаказовПокупателей.Согласован);
	Запрос.УстановитьПараметр("ИМ",kaspi());

	Запрос.Текст =  "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                |	ЗаказПокупателя.Ссылка КАК Ссылка,
	                |	ЗаказПокупателя.НомерЗаказаНаСайте КАК НомерЗаказаНаСайте,
	                |	ЗаказПокупателя.Магазин КАК Магазин
	                |ИЗ
	                |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	                |ГДЕ
	                |	ЗаказПокупателя.Проведен
	                |	И ЗаказПокупателя.Дата >= &Дата
	                |	И ЗаказПокупателя.Статус = &Статус
	                |	И ЗаказПокупателя.ИнтернетСклад.Владелец = &ИМ";
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Процедура GET_STATUS_COMPLETED() экспорт
	
	
	Выборка = ПолучитьЗакрытыеЗаказыБезРеализации();
	Реализация.Очистить();
