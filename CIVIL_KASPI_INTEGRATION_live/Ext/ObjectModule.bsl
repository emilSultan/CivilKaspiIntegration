Функция ПолучитьПараметрИсточника(ИмяКоманды)
	Если ТипЗнч(ИмяКоманды) =  Тип("СправочникСсылка.ИнтеграцияПараметры") и ЗначениеЗаполнено(ИмяКоманды) Тогда
		Возврат ИмяКоманды;
	КонецЕсли;
	
	
	
	Параметр = РэтмайндКэш.ПолучитьПараметрПоИмяКоманды(ИмяКоманды, ВнешняяСистема);
	
	Если ЗначениеЗаполнено(Параметр) Тогда 
		Возврат Параметр;
	Иначе 
		//на всякий случай проверим запросом, может создали, ко кэшировать еще не успели!
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("ИмяКоманды", ИмяКоманды);
		Запрос.УстановитьПараметр("Владелец",   ВнешняяСистема);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ИнтеграцияПараметры.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ИнтеграцияПараметры КАК ИнтеграцияПараметры
		               |ГДЕ
		               |	ИнтеграцияПараметры.ИмяКоманды = &ИмяКоманды
		               |	И ИнтеграцияПараметры.Владелец = &Владелец";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	ВнешняяСистема = Справочники.ИнтеграцияВнешниеСистемы.НайтиПоНаименованию("KASPI_OS");
	Если Не ЗначениеЗаполнено(ВнешняяСистема) Тогда 
		Спр = Справочники.ИнтеграцияВнешниеСистемы.СоздатьЭлемент();
		Спр.Наименование = "KASPI_OS";
		Спр.Записать();
		ВнешняяСистема = Спр.Ссылка;
	КонецЕсли;
	
	Спр = Справочники.ИнтеграцияПараметры.СоздатьЭлемент();
	Спр.Наименование = ИмяКоманды;
	Спр.ИмяКоманды   = ИмяКоманды;
	Спр.Владелец     = ВнешняяСистема;
	Спр.Статус		 = Истина;
	Спр.Записать();
	
	Возврат Спр.Ссылка;
	
КонецФункции

Процедура ЗаписатьВЖурналРегистра(ПараметрИсточник, Идентификатор, Статус = Ложь, ТекстОшибки = "")
	
	УИДСтроки = РегистрыСведений.ИнтеграцияЖурналПроцессов.ПолучитьУИДСтрокиЖурнала(ПараметрИсточник, Идентификатор);
	
	Если УИДСтроки = Неопределено Тогда 
		УИДСтроки = Новый УникальныйИдентификатор;
		РегистрыСведений.ИнтеграцияЖурналПроцессов.ЗаписатьВЖурнал(ПараметрИсточник, Идентификатор, УИДСтроки, Статус, ТекстОшибки);
	Иначе 
		РегистрыСведений.ИнтеграцияЖурналПроцессов.ОбновитьЗапись(ПараметрИсточник, Идентификатор, УИДСтроки, Статус, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьИнтернетСклад(ИнтернетМагазин)
	Запрос       = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", ИнтернетМагазин);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИнтернетСклады.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ИнтернетСклады КАК ИнтернетСклады
	               |ГДЕ
	               |	ИнтернетСклады.Владелец = &Ссылка";
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		Возврат Результат.Ссылка;
		
	КонецЦикла;
	
	
КонецФункции

Функция СоздатьРеализацию()
	ИнтернетМагазин  =  kaspi();
	Док = Документы.РеализацияТоваров.СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();
	Магазин = ИнтернетМагазин.Магазин;	
	
	Док.Магазин = Магазин;
	Док.Склад 	= Магазин.СкладПродажи;
	Док.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("(KZ) Kaspi Online Store");
	Док.УчитыватьНДС =  Истина;
	Док.ЦенаВключаетНДС= Истина;
	Док.Страна			  = ИнтернетМагазин.Страна;

	Док.Организация       = Магазин.СкладПродажи.Организация;
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Док.Ссылка;
			
КонецФункции

Процедура НастройкиУстановить()
	ИнтернетМагазин = Справочники.ИнтернетМагазины.НайтиПоКоду("000000001");
КонецПроцедуры

