Функция ПолучитьЗакырытыеЗаказыБезВнПерем()
	
	Запрос =  Новый Запрос;
	Запрос.УстановитьПараметр("ИМ",kaspi());
	Запрос.УстановитьПараметр("Статус",Перечисления.СтатусыЗаказовПокупателей.Закрыт);
	Запрос.УстановитьПараметр("Дата",ТекущаяДатаСеанса()-Сутки(30));
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ЗаказПокупателя.Ссылка КАК Ссылка,
	                |	ЗаказПокупателя.Статус КАК Статус,
	                |	ЗаказПокупателя.НомерЗаказаНаСайте КАК НомерЗаказаНаСайте
	                |ПОМЕСТИТЬ мп_заказы
	                |ИЗ
	                |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	                |ГДЕ
	                |	ЗаказПокупателя.ИнтернетСклад.Владелец = &ИМ
	                |	И ЗаказПокупателя.Статус = &Статус
	                |	И ЗаказПокупателя.Дата >= &Дата
	                |	И ЗаказПокупателя.Проведен
	                |	И ЗаказПокупателя.Отменено = ЛОЖЬ
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	КомплектыЗаказовТовары.ЗаказПокупателя КАК ЗаказПокупателя
	                |ПОМЕСТИТЬ вн_перем
	                |ИЗ
	                |	Документ.КомплектыЗаказов.Товары КАК КомплектыЗаказовТовары
	                |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КомплектыЗаказов КАК КомплектыЗаказов
	                |		ПО КомплектыЗаказовТовары.Ссылка = КомплектыЗаказов.Ссылка
	                |ГДЕ
	                |	КомплектыЗаказов.Дата >= &Дата
	                |	И КомплектыЗаказов.Проведен
	                |	И КомплектыЗаказов.ИнтернетСклад.Владелец = &ИМ
	                |
	                |ОБЪЕДИНИТЬ ВСЕ
	                |
	                |ВЫБРАТЬ
	                |	ОрдерНаПеремещениеТоваров.ЗаказПокупателя
	                |ИЗ
	                |	Документ.ОрдерНаПеремещениеТоваров КАК ОрдерНаПеремещениеТоваров
	                |ГДЕ
	                |	ОрдерНаПеремещениеТоваров.Дата >= &Дата
	                |	И ОрдерНаПеремещениеТоваров.Проведен
	                |	И ОрдерНаПеремещениеТоваров.ЗаказПокупателя.ИнтернетСклад.Владелец = &ИМ
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	мп_заказы.Ссылка КАК Ссылка,
	                |	мп_заказы.Статус КАК Статус,
	                |	мп_заказы.НомерЗаказаНаСайте КАК НомерЗаказаНаСайте,
	                |	мп_заказы.Ссылка.Магазин КАК Магазин
	                |ИЗ
	                |	мп_заказы КАК мп_заказы
	                |		ЛЕВОЕ СОЕДИНЕНИЕ вн_перем КАК вн_перем
	                |		ПО мп_заказы.Ссылка = вн_перем.ЗаказПокупателя
	                |ГДЕ
	                |	вн_перем.ЗаказПокупателя ЕСТЬ NULL";
	
	Выборка  = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка;
	
КонецФункции

Функция Перемещение_Товаров_И_Реализация_Товаров()
	УстановитьПривилегированныйРежим(истина);
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Заказы", Перем_Реал.Выгрузить());
	Запрос.УстановитьПараметр("НазначениеСкладаЦентральный", Перечисления.ВидыНазначенияСкладов.ЦентральныйСклад);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Заказы.ЗаказПокупателя КАК ЗаказПокупателя,
	               |	Заказы.Магазин КАК Магазин
	               |ПОМЕСТИТЬ ВТ_Заказы
	               |ИЗ
	               |	&Заказы КАК Заказы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаказПокупателяТовары.Ссылка КАК ЗаказПокупателя,
	               |	ЗаказПокупателяТовары.Номенклатура КАК Номенклатура,
	               |	ЗаказПокупателяТовары.Характеристика КАК Характеристика,
	               |	СУММА(ЗаказПокупателяТовары.Количество) КАК Количество,
	               |	СУММА(ЗаказПокупателяТовары.Цена) КАК Цена,
	               |	СУММА(ЗаказПокупателяТовары.Сумма) КАК Сумма,
	               |	ЗаказПокупателяТовары.СтавкаНДС КАК СтавкаНДС,
	               |	СУММА(ЗаказПокупателяТовары.СуммаНДС) КАК СуммаНДС,
	               |	ВТ_Заказы.Магазин КАК Магазин,
	               |	СУММА(ЗаказПокупателяТовары.Количество) КАК КоличествоУпаковок
	               |ИЗ
	               |	ВТ_Заказы КАК ВТ_Заказы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	               |		ПО ВТ_Заказы.ЗаказПокупателя = ЗаказПокупателяТовары.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Магазины КАК Магазины
	               |		ПО ВТ_Заказы.Магазин = Магазины.Ссылка
	               |ГДЕ
	               |	ЗаказПокупателяТовары.Отменено = ЛОЖЬ
	               |	И Магазины.НазначениеСклада <> &НазначениеСкладаЦентральный
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказПокупателяТовары.Ссылка,
	               |	ЗаказПокупателяТовары.Номенклатура,
	               |	ЗаказПокупателяТовары.Характеристика,
	               |	ЗаказПокупателяТовары.СтавкаНДС,
	               |	ВТ_Заказы.Магазин
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Заказы.Магазин КАК Магазин
	               |ИЗ
	               |	ВТ_Заказы КАК ВТ_Заказы
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Заказы.Магазин";
	Рез = Запрос.ВыполнитьПакет();
	Магазины = Рез[2].Выгрузить();
	Заказы   = Рез[1].Выгрузить();
	Для Каждого Магазин из Магазины Цикл
		
		//Создаем КомплектЗаказов
		ТоварыМагазина = Заказы.НайтиСтроки(Новый Структура("Магазин", Магазин.Магазин));
		Если ТоварыМагазина.Количество() > 0 Тогда 
			Компл  = ПолучитьКомплектЗаказов(Магазин.Магазин);
			КомплектЗаказов = Компл.ПолучитьОбъект();
			
			Для Каждого Товар из ТоварыМагазина Цикл
				Нов = КомплектЗаказов.Товары.Добавить();
				Нов.Номенклатура    = Товар.Номенклатура;
				Нов.ЗаказПокупателя = Товар.ЗаказПокупателя;
				Нов.Характеристика  = Товар.Характеристика;
				Нов.Количество      = Товар.Количество;
				Нов.Цена            = Товар.Цена;
				Нов.Сумма           = Товар.Сумма;
				Нов.ДатаОбработки   = ТекущаяДатаСеанса();
				
				
				Зак = Товар.ЗаказПокупателя.ПолучитьОбъект();
				Зак.Статус = Перечисления.СтатусыЗаказовПокупателей.Закрыт;
				Зак.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				
				
			КонецЦикла;
			
			КомплектЗаказов.Статус = Перечисления.СтатусыКомплектовЗаказов.Отправлен;
			КомплектЗаказов.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			
			
			//Создаем Перемещение
			Пер = ПолучитьВнутренноеПеремещениеТоваров(КомплектЗаказов.Ссылка);
			Перемещение = Пер.ПолучитьОбъект();
			Перемещение.Товары.Очистить();
			Для Каждого ТоварыПерем из ТоварыМагазина Цикл
				ПеремНов = Перемещение.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(ПеремНов, ТоварыПерем);
			КонецЦикла;
			попытка 
				Перемещение.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			Исключение
				Сообщить(ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;			
	КонецЦикла;
	
	
КонецФункции

Функция РеализацияТоваров()
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Заказы", Реализация.Выгрузить());
	Запрос.Текст = "ВЫБРАТЬ
	               |	Заказы.Магазин КАК Магазин,
	               |	Заказы.ЗаказПокупателя КАК ЗаказПокупателя
	               |ПОМЕСТИТЬ ВТ_Заказы
	               |ИЗ
	               |	&Заказы КАК Заказы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаказПокупателяТовары.Номенклатура КАК Номенклатура,
	               |	ЗаказПокупателяТовары.Характеристика КАК Характеристика,
	               |	ЗаказПокупателяТовары.Цена КАК Цена,
	               |	ЗаказПокупателяТовары.Сумма КАК Сумма,
	               |	ЗаказПокупателяТовары.СтавкаНДС КАК СтавкаНДС,
	               |	ЗаказПокупателяТовары.СуммаНДС КАК СуммаНДС,
	               |	ЗаказПокупателяТовары.Количество КАК Количество,
	               |	ЗаказПокупателяТовары.Ссылка КАК ЗаказПокупателя,
	               |	ЗаказПокупателяТовары.Количество КАК КоличествоУпаковок,
	               |	ЗаказПокупателяТовары.Ссылка.НомерЗаказаНаСайте КАК НомерЗаказа
	               |ИЗ
	               |	ВТ_Заказы КАК ВТ_Заказы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	               |		ПО ВТ_Заказы.ЗаказПокупателя = ЗаказПокупателяТовары.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
	               |		ПО ВТ_Заказы.ЗаказПокупателя = РеализацияТоваровТовары.ЗаказПокупателя
	               |ГДЕ
	               |	РеализацияТоваровТовары.Ссылка ЕСТЬ NULL
	               |	И ЗаказПокупателяТовары.Отменено = ЛОЖЬ";
	
	Рез = Запрос.Выполнить().Выгрузить();

	Если Рез.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Доки = СоздатьРеализацию();
	Док = Доки.ПолучитьОбъект();

	Для Каждого Товар из Рез Цикл;
		Нов = Док.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Нов, Товар);

		Нов.СтавкаНДС           = Перечисления.СтавкиНДС.НДС16;
		Нов.СуммаНДС	        = ОбработкаТабличнойЧастиТоварыСервер.РассчитатьСуммуНДС(Товар.Сумма, Нов.СтавкаНДС, Истина);

	КонецЦикла;
	Док.Записать(РежимЗаписиДокумента.Проведение);
	
	
	
	
КонецФункции

Функция ПолучитьКомплектЗаказов(Магазин)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Магазин", Магазин);
	Запрос.Текст = "ВЫБРАТЬ
	|	КомплектыЗаказов.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КомплектыЗаказов КАК КомплектыЗаказов
	|ГДЕ
	|	КомплектыЗаказов.Магазин = &Магазин
	|	И КомплектыЗаказов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКомплектовЗаказов.Обрабатывается)";
	Рез = Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда
		Возврат Рез.Ссылка;
	КонецЕсли;
	//ИнтернетМагазин = Справочники.ИнтернетМагазины.НайтиПоКоду("000000001");
	Док = Документы.КомплектыЗаказов.СоздатьДокумент();
	Док.Магазин       = Магазин;
	Док.Организация   = Магазин.СкладПродажи.Организация;
	Док.Страна        = Магазин.Страна;
	Док.Ответственный = Пользователи.ТекущийПользователь();
	Док.ИнтернетСклад = ПолучитьИнтернетСклад(ИнтернетМагазин);
	Док.Дата          = ТекущаяДатаСеанса();
	Док.Статус        = Перечисления.СтатусыКомплектовЗаказов.Обрабатывается;
	
	
	Док.Записать(РежимЗаписиДокумента.Запись);
	Возврат Док.Ссылка;
	
	
КонецФункции

Функция ПолучитьВнутренноеПеремещениеТоваров(КомплектЗаказов)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДокументОснование", КомплектЗаказов);
	Запрос.Текст = "ВЫБРАТЬ
	|	ОрдерНаПеремещениеТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОрдерНаПеремещениеТоваров КАК ОрдерНаПеремещениеТоваров
	|ГДЕ
	|	ОрдерНаПеремещениеТоваров.ДокументОснование = &ДокументОснование";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Ссылка;
	Иначе 
		Доки = Документы.ОрдерНаПеремещениеТоваров.СоздатьДокумент();
		Доки.Магазин 		 = КомплектЗаказов.Магазин;
		Доки.СкладОтправитель = КомплектЗаказов.Магазин.СкладПродажи;
		
		ИнтернетМагазин = Справочники.ИнтернетМагазины.НайтиПоКоду("000000001");
		
		МагазинПолучатель = ИнтернетМагазин.Магазин;
		СкладПолучатель   = ИнтернетМагазин.Магазин.СкладПродажи;
		
		Доки.МагазинПолучатель = МагазинПолучатель;
		Доки.СкладПолучатель   = СкладПолучатель;
		Доки.Страна			   = КомплектЗаказов.Страна;
		Доки.ДокументОснование = КомплектЗаказов;
		Доки.Организация       = КомплектЗаказов.Организация;
		Доки.Дата              = ТекущаяДатаСеанса();
		Доки.Записать(РежимЗаписиДокумента.Проведение);
		Возврат Доки.Ссылка;
		
	КонецЕсли;
	
КонецФункции

