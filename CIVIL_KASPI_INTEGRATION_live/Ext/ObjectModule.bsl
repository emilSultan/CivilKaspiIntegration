Процедура UPDATE_BO_STORE_STOCK()   Экспорт

	Магазины = МагазиныПолучить();

	Пока Магазины.Следующий() Цикл
		UPDATE_STORES_STOCK(Магазины);
	КонецЦикла;
	
КонецПроцедуры

Функция МагазиныПолучить()
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ИнтернетМагазиныМагазины.Магазин КАК Магазин,
	                      |	ИнтернетМагазиныМагазины.Склад КАК Склад,
	                      |	ИнтернетМагазиныМагазины.КодВиртуальногоМагазина КАК КодВиртуальногоМагазина,
	                      |	ИнтернетМагазиныМагазины.ЛимитЗаказов КАК ЛимитЗаказов,
	                      |	ИнтернетМагазиныМагазины.МинимальныйОстаток КАК МинимальныйОстаток,
	                      |	ИнтернетМагазиныМагазины.Действует КАК Действует,
	                      |	ИнтернетМагазиныМагазины.Ссылка.ВидЦены КАК ВидЦены1,
	                      |	ИнтернетМагазиныМагазины.Ссылка.ВидЦеныПерваяЦена КАК ВидЦены2
	                      |ИЗ
	                      |	Справочник.ИнтернетМагазины.Магазины КАК ИнтернетМагазиныМагазины
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
	                      |		ПО ИнтернетМагазиныМагазины.Склад = Склады.Ссылка
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Магазины КАК Магазины
	                      |		ПО ИнтернетМагазиныМагазины.Магазин = Магазины.Ссылка
	                      |ГДЕ
	                      |	ИнтернетМагазиныМагазины.Ссылка = &ИнтернетМагазин
	                      |	И ИнтернетМагазиныМагазины.КодВиртуальногоМагазина <> """"
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	КодВиртуальногоМагазина");
	Запрос.УстановитьПараметр("ИнтернетМагазин",	Kaspi());
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Процедура UPDATE_STORES_STOCK(Магазины) Экспорт
	
	СписокСезонов = Новый Массив;
	
	//Если Магазины.КодВиртуальногоМагазина  = "PP1" Тогда
	//	СписокСезонов.Добавить("Winter");
	//КонецЕсли;


	Запрос =  Новый Запрос;
	Запрос.УстановитьПараметр("ИнтернетМагазин", 			Kaspi());
	Запрос.УстановитьПараметр("ДатаН",						ДобавитьМесяц(ТекущаяДатаСеанса(), -3));
	Запрос.УстановитьПараметр("Дата",						КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("warehouse_id",				Магазины.КодВиртуальногоМагазина);
	Запрос.УстановитьПараметр("КодВиртуальногоМагазина",	Магазины.КодВиртуальногоМагазина); 
	Запрос.УстановитьПараметр("ВидЦены1",            		Магазины.ВидЦены1);
	Запрос.УстановитьПараметр("Магазин",					Магазины.Магазин); 
	Запрос.УстановитьПараметр("МинОстаток",					Магазины.МинимальныйОстаток);
	Запрос.УстановитьПараметр("Действует",					Магазины.Действует);
	Запрос.УстановитьПараметр("сезоны",						СписокСезонов);
	Запрос.УстановитьПараметр("ВидЦены2",					Магазины.ВидЦены2);
	Запрос.УстановитьПараметр("ТипСклада",					Перечисления.ТипыСкладов.СкладНаОтражениеИзлишковНедостач);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВТ_Остатки.Номенклатура КАК Номенклатура,
		|	ВТ_Остатки.Характеристика КАК Характеристика,
		|	ВТ_Остатки.Количество - ЕСТЬNULL(ВТ_Заказано.Количество, 0) - ЕСТЬNULL(Недоступные.Количество, 0) - &МинОстаток КАК Количество
		|ПОМЕСТИТЬ ВТ_НовыеОстатки
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ.Номенклатура КАК Номенклатура,
		|		ВТ.Характеристика КАК Характеристика,
		|		СУММА(ВТ.КоличествоОстаток) КАК Количество
		|	ИЗ
		|		РегистрНакопления.ТоварыНаСкладах.Остатки(
		|				&Дата,
		|				Склад.Магазин = &Магазин
		|					И НЕ Номенклатура.ТипСезона.Наименование В (&сезоны)
		|					И Склад.ТипСклада <> &ТипСклада) КАК ВТ
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВТ.Характеристика,
		|		ВТ.Номенклатура
		|	
		|	ИМЕЮЩИЕ
		|		СУММА(ВТ.КоличествоОстаток) > 0) КАК ВТ_Остатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			Заказано.Номенклатура КАК Номенклатура,
		|			Заказано.Характеристика КАК Характеристика,
		|			СУММА(Заказано.Количество) КАК Количество
		|		ИЗ
		|			Документ.ЗаказПокупателя.Товары КАК Заказано
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказ
		|				ПО Заказано.Ссылка = Заказ.Ссылка
		|		ГДЕ
		|			Заказ.Дата > &ДатаН
		|			И Заказ.Проведен = ИСТИНА
		|			И Заказ.Магазин = &Магазин
		|			И Заказ.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателей.Согласован)
		|			И Заказано.Отменено = ЛОЖЬ
		|		
		|		СГРУППИРОВАТЬ ПО
		|			Заказано.Характеристика,
		|			Заказано.Номенклатура) КАК ВТ_Заказано
		|		ПО ВТ_Остатки.Характеристика = ВТ_Заказано.Характеристика
		|			И ВТ_Остатки.Номенклатура = ВТ_Заказано.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ.Номенклатура КАК Номенклатура,
		|			ВТ.Характеристика КАК Характеристика,
		|			СУММА(ВТ.КоличествоОстаток) КАК Количество
		|		ИЗ
		|			РегистрНакопления.НедоступныеТовары.Остатки(
		|					&Дата,
		|					Склад.Магазин = &Магазин
		|						И Склад.ТипСклада <> &ТипСклада) КАК ВТ
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ВТ.Характеристика,
		|			ВТ.Номенклатура) КАК Недоступные
		|		ПО ВТ_Остатки.Характеристика = Недоступные.Характеристика
		|			И ВТ_Остатки.Номенклатура = Недоступные.Номенклатура
		|ГДЕ
		|	ВТ_Остатки.Количество - ЕСТЬNULL(ВТ_Заказано.Количество, 0) - ЕСТЬNULL(Недоступные.Количество, 0) - &МинОстаток > 0
		|	И &Действует = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВТ_НовыеОстатки.Номенклатура, ВТ_ОстаткиИМ.Номенклатура) КАК Номенклатура,
		|	ЕСТЬNULL(ВТ_НовыеОстатки.Характеристика, ВТ_ОстаткиИМ.Характеристика) КАК Характеристика,
		|	ЕСТЬNULL(ВТ_НовыеОстатки.Количество, 0) КАК Количество,
		|	ЕСТЬNULL(ВТ_ОстаткиИМ.Количество, 0) КАК СтараяКоличество
		|ПОМЕСТИТЬ ВТ_Остатки
		|ИЗ
		|	ВТ_НовыеОстатки КАК ВТ_НовыеОстатки
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_Остатки.Характеристика КАК Характеристика,
		|			ВТ_Остатки.Номенклатура КАК Номенклатура,
		|			СУММА(ВТ_Остатки.Количество) КАК Количество
		|		ИЗ
		|			РегистрСведений.ИнтернетМагазинОстатки КАК ВТ_Остатки
		|		ГДЕ
		|			ВТ_Остатки.ИнтернетМагазин = &ИнтернетМагазин
		|			И ВТ_Остатки.КодВиртуальногоМагазина = &КодВиртуальногоМагазина
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ВТ_Остатки.Характеристика,
		|			ВТ_Остатки.Номенклатура) КАК ВТ_ОстаткиИМ
		|		ПО ВТ_НовыеОстатки.Характеристика = ВТ_ОстаткиИМ.Характеристика
		|			И ВТ_НовыеОстатки.Номенклатура = ВТ_ОстаткиИМ.Номенклатура
		|ГДЕ
		|	ЕСТЬNULL(ВТ_НовыеОстатки.Количество, 0) <> ЕСТЬNULL(ВТ_ОстаткиИМ.Количество, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	&КодВиртуальногоМагазина КАК КодВиртуальногоМагазина,
		|	ВТ_Остатки.Характеристика КАК Характеристика,
		|	ВТ_Остатки.Номенклатура КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА НЕ БлокировкаКатегорий.MopDivision ЕСТЬ NULL
		|				ИЛИ НЕ ИнтернетМагазинБлокированныеНоменклатуры.MopDivision ЕСТЬ NULL
		|			ТОГДА 0
		|		ИНАЧЕ ВТ_Остатки.Количество
		|	КОНЕЦ КАК Количество,
		|	ВЫБОР
		|		КОГДА НЕ БлокировкаКатегорий.MopDivision ЕСТЬ NULL
		|				ИЛИ НЕ ИнтернетМагазинБлокированныеНоменклатуры.MopDivision ЕСТЬ NULL
		|			ТОГДА 0
		|		ИНАЧЕ ВТ_Остатки.Количество
		|	КОНЕЦ КАК present,
		|	Товары.Артикул + ХарактеристикиНоменклатуры.Наименование КАК offer_id,
		|	ВТ_Остатки.СтараяКоличество КАК СтараяКоличество
		|ПОМЕСТИТЬ Товары
		|ИЗ
		|	ВТ_Остатки КАК ВТ_Остатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
		|		ПО ВТ_Остатки.Номенклатура = Товары.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|		ПО ВТ_Остатки.Характеристика = ХарактеристикиНоменклатуры.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИнтернетМагазинШтриходы КАК Штрихкоды
		|		ПО ВТ_Остатки.Характеристика = Штрихкоды.Характеристика
		|			И ВТ_Остатки.Номенклатура = Штрихкоды.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнтернетМагазинБлокированныеНоменклатуры КАК ИнтернетМагазинБлокированныеНоменклатуры
		|		ПО (ИнтернетМагазинБлокированныеНоменклатуры.ИнтернетМагазин = &ИнтернетМагазин)
		|			И ВТ_Остатки.Номенклатура = ИнтернетМагазинБлокированныеНоменклатуры.Номенклатура
		|			И ВТ_Остатки.Характеристика = ИнтернетМагазинБлокированныеНоменклатуры.Характеристика
		|			И (ВЫБОР
		|				КОГДА ИнтернетМагазинБлокированныеНоменклатуры.Магазин <> ЗНАЧЕНИЕ(Справочник.Магазины.ПустаяСсылка)
		|					ТОГДА ИнтернетМагазинБлокированныеНоменклатуры.Магазин = &Магазин
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ИнтернетМагазинБлокированныеНоменклатуры.MopDivision КАК MopDivision,
		|			ИнтернетМагазинБлокированныеНоменклатуры.MopDepartment КАК MopDepartment,
		|			ИнтернетМагазинБлокированныеНоменклатуры.MopSubDepartment КАК MopSubDepartment,
		|			ИнтернетМагазинБлокированныеНоменклатуры.MopCategory КАК MopCategory,
		|			ИнтернетМагазинБлокированныеНоменклатуры.MopClass КАК MopClass,
		|			ИнтернетМагазинБлокированныеНоменклатуры.СезонКоллекции КАК СезонКоллекции,
		|			ИнтернетМагазинБлокированныеНоменклатуры.ПрефиксАртикула КАК ПрефиксАртикула,
		|			ИнтернетМагазинБлокированныеНоменклатуры.Номенклатура КАК Номенклатура
		|		ИЗ
		|			РегистрСведений.ИнтернетМагазинБлокированныеНоменклатуры КАК ИнтернетМагазинБлокированныеНоменклатуры
		|		ГДЕ
		|			ИнтернетМагазинБлокированныеНоменклатуры.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|			И ИнтернетМагазинБлокированныеНоменклатуры.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|			И ИнтернетМагазинБлокированныеНоменклатуры.ИнтернетМагазин = &ИнтернетМагазин
		|			И ИнтернетМагазинБлокированныеНоменклатуры.ИнтернетМагазин = &ИнтернетМагазин) КАК БлокировкаКатегорий
		|		ПО (ВЫБОР
		|				КОГДА БлокировкаКатегорий.MopDivision = ЗНАЧЕНИЕ(Справочник.MopDivision.ПустаяСсылка)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_Остатки.Номенклатура._MopDivision = БлокировкаКатегорий.MopDivision
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА БлокировкаКатегорий.MopDepartment = ЗНАЧЕНИЕ(Справочник.MopDepartment.ПустаяСсылка)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_Остатки.Номенклатура._MopDepartment = БлокировкаКатегорий.MopDepartment
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА БлокировкаКатегорий.MopSubDepartment = ЗНАЧЕНИЕ(Справочник.MopSubDepartment.ПустаяСсылка)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_Остатки.Номенклатура._MopSubDepartment = БлокировкаКатегорий.MopSubDepartment
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА БлокировкаКатегорий.MopCategory = ЗНАЧЕНИЕ(Справочник.MopCategory.ПустаяСсылка)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_Остатки.Номенклатура._MopCategory = БлокировкаКатегорий.MopCategory
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА БлокировкаКатегорий.MopClass = ЗНАЧЕНИЕ(Справочник.MopClass.ПустаяСсылка)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_Остатки.Номенклатура._MopClass = БлокировкаКатегорий.MopClass
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА БлокировкаКатегорий.СезонКоллекции = ЗНАЧЕНИЕ(Справочник.НоменклатурныеСезоныКоллекции.ПустаяСсылка)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_Остатки.Номенклатура.СезонКоллекции = БлокировкаКатегорий.СезонКоллекции
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА БлокировкаКатегорий.ПрефиксАртикула = """"
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ПОДСТРОКА(ВТ_Остатки.Номенклатура.Артикул, 1, 2) = БлокировкаКатегорий.ПрефиксАртикула
		|			КОНЕЦ)
		|ГДЕ
		|	Штрихкоды.ИнтернетМагазин = &ИнтернетМагазин
		|	И ВЫБОР
		|			КОГДА НЕ ИнтернетМагазинБлокированныеНоменклатуры.ИнтернетМагазин ЕСТЬ NULL
		|					И ВТ_Остатки.СтараяКоличество > 0
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ИнтернетМагазинБлокированныеНоменклатуры.ИнтернетМагазин ЕСТЬ NULL
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА НЕ БлокировкаКатегорий.MopDivision ЕСТЬ NULL
		|					И ВТ_Остатки.СтараяКоличество > 0
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ БлокировкаКатегорий.MopDivision ЕСТЬ NULL
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.КодВиртуальногоМагазина КАК КодВиртуальногоМагазина,
		|	Товары.Характеристика КАК Характеристика,
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Количество КАК Количество,
		|	Товары.present КАК present,
		|	Товары.offer_id КАК offer_id,
		|	&ИнтернетМагазин КАК ИнтернетМагазин
		|ИЗ
		|	Товары КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних2
		|		ПО Товары.Номенклатура = ЦеныНоменклатурыСрезПоследних2.Номенклатура
		|			И (ЦеныНоменклатурыСрезПоследних2.ВидЦены = &ВидЦены2)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, ) КАК ЦеныНоменклатурыСрезПоследних
		|		ПО Товары.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
		|			И (ЦеныНоменклатурыСрезПоследних.ВидЦены = &ВидЦены1)
		|ГДЕ
		|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних2.Цена, 0)) > 0";
	
	Результат  =  Запрос.Выполнить().Выгрузить();
	
	//Параметры  =  ПолучитьПараметрИсточника("KASPI_BO_STORE_STOCK");

	Для Каждого текТовар из Результат Цикл 
				
		Попытка
			НЗ = РегистрыСведений.ИнтернетМагазинОстатки.СоздатьНаборЗаписей();
			НЗ.Отбор.Характеристика.Установить(текТовар.Характеристика);
			НЗ.Отбор.Номенклатура.Установить(текТовар.Номенклатура);
			НЗ.Отбор.ИнтернетМагазин.Установить(Kaspi());
			НЗ.Отбор.КодВиртуальногоМагазина.Установить(текТовар.КодВиртуальногоМагазина);
			НЗ.Прочитать();
			Если НЗ.Количество() = 0 Тогда
				ЗаполнитьЗначенияСвойств(НЗ.Добавить(), текТовар);
				НаборЗаписейЗаписать(НЗ, "KASPI_BO_STORE_STOCK");
			Иначе
				ТекСтр = НЗ.Получить(0);
				Если ТекСтр.Количество <> текТовар.Количество Тогда
					ТекСтр.Количество = текТовар.present;
					НаборЗаписейЗаписать(НЗ, текТовар.offer_id);
				КонецЕсли;
			КонецЕсли;
			
		Исключение
			//ЗаписатьВЖурналРегистра(Параметры,КодВиртуальногоМагазина, Ложь, ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Функция Сутки(Сколько=1)
	Возврат (86400 * Сколько);
КонецФункции

Функция НаборЗаписейЗаписать(НаборЗаписей, sku)
	//Параметры  =  ПолучитьПараметрИсточника("KASPI_BO_STORE_STOCK");
	Если НаборЗаписей.ПроверитьЗаполнение() Тогда
		Попытка
			НаборЗаписей.Записать();
			Возврат Истина;
		Исключение
			Если НЕ ПустаяСтрока(sku) Тогда
				//ЗаписатьВЖурналРегистра(Параметры,sku, Ложь, ОписаниеОшибки());
			КонецЕсли;
		КонецПопытки;
	ИначеЕсли НЕ ПустаяСтрока(sku) Тогда
		//ЗаписатьВЖурналРегистра(Параметры, sku,Ложь, ПолучитьСообщения(ПолучитьСообщенияПользователю(Истина)));
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ПолучитьСообщения(Знач мСлова)
	Ответ = "";
	Для Каждого ТекЭлемент Из мСлова Цикл
		Ответ = ?(ПустаяСтрока(Ответ), "", Ответ + Символы.ПС) + ТекЭлемент.Текст;
	КонецЦикла;
	Возврат Ответ;
КонецФункции

#КонецОбласти

#Область UPDATE_KASPI_STOCK

Функция  UPDATE_KASPI_STOCK()  Экспорт
	
	Запись = Новый ЗаписьXML;	

	ИмяФайла = КаталогВременныхФайловНаКлиенте() + Строка(Новый УникальныйИдентификатор) + ".xml";
	Запись.ОткрытьФайл(ИмяФайла, "UTF-8");	
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("kaspi_catalog");
	Запись.ЗаписатьАтрибут("date", Формат(ТекущаяДатаСеанса() + 10800, "ДЛФ=ДВ")); 
	Запись.ЗаписатьАтрибут("xmlns", "kaspiShopping");
	Запись.ЗаписатьАтрибут("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance");
	Запись.ЗаписатьАтрибут("xsi:schemaLocation", "kaspiShopping http://kaspi.kz/kaspishopping.xsd");
	ЗаписатьЭлементБезАтрибутовВXML(Запись, "company", "Civil");
	ЗаписатьЭлементБезАтрибутовВXML(Запись, "merchantid", "Civil");
	Запись.ЗаписатьНачалоЭлемента("offers");

	Запрос  =  Новый Запрос;
	Запрос.УстановитьПараметр("ИнтернетМагазин",Kaspi());
	Запрос.УстановитьПараметр("Дата", КонецДня(ТекущаяДатаСеанса()));
	Запрос.Текст  =  "ВЫБРАТЬ
	                 |	ИнтернетМагазинОстатки.Характеристика КАК Характеристика,
	                 |	ИнтернетМагазинОстатки.Номенклатура КАК Номенклатура,
	                 |	ИнтернетМагазинОстатки.НомерСообщения КАК НомерСообщения,
	                 |	ИнтернетМагазинОстатки.ИнтернетМагазин КАК ИнтернетМагазин,
	                 |	ИнтернетМагазинОстатки.КодВиртуальногоМагазина КАК КодВиртуальногоМагазина,
	                 |	МАКСИМУМ(ИнтернетМагазинОстатки.Количество) КАК Количество,
	                 |	МАКСИМУМ(ШтрихкодыГрупп.Штрихкод) КАК Штрихкод,
	                 |	ИнтернетМагазинОстатки.Номенклатура.Артикул КАК НоменклатураАртикул,
	                 |	ИнтернетМагазинОстатки.Номенклатура.Модель КАК НоменклатураМодель,
	                 |	СП_Номенклатура.ТипТовара.Наименование КАК ТипТовараНаименование,
	                 |	ИнтернетМагазинОстатки.ИнтернетМагазин.ВидЦены КАК ИнтернетМагазинВидЦены
	                 |ПОМЕСТИТЬ Остаток
	                 |ИЗ
	                 |	РегистрСведений.ИнтернетМагазинОстатки КАК ИнтернетМагазинОстатки
	                 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СП_Номенклатура
	                 |		ПО ИнтернетМагазинОстатки.Номенклатура = СП_Номенклатура.Ссылка
	                 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                 |			Штрихкоды.Владелец КАК Владелец,
	                 |			Штрихкоды.Характеристика КАК Характеристика,
	                 |			МАКСИМУМ(Штрихкоды.Штрихкод) КАК Штрихкод
	                 |		ИЗ
	                 |			РегистрСведений.Штрихкоды КАК Штрихкоды
	                 |		
	                 |		СГРУППИРОВАТЬ ПО
	                 |			Штрихкоды.Владелец,
	                 |			Штрихкоды.Характеристика) КАК ШтрихкодыГрупп
	                 |		ПО ИнтернетМагазинОстатки.Номенклатура = ШтрихкодыГрупп.Владелец
	                 |			И ИнтернетМагазинОстатки.Характеристика = ШтрихкодыГрупп.Характеристика
	                 |ГДЕ
	                 |	ИнтернетМагазинОстатки.ИнтернетМагазин = &ИнтернетМагазин
	                 |	И ИнтернетМагазинОстатки.Количество > 0
	                 |
	                 |СГРУППИРОВАТЬ ПО
	                 |	ИнтернетМагазинОстатки.Номенклатура,
	                 |	ИнтернетМагазинОстатки.Характеристика,
	                 |	ИнтернетМагазинОстатки.ИнтернетМагазин,
	                 |	ИнтернетМагазинОстатки.КодВиртуальногоМагазина,
	                 |	СП_Номенклатура.ТипТовара.Наименование,
	                 |	ИнтернетМагазинОстатки.Номенклатура.Артикул,
	                 |	ИнтернетМагазинОстатки.Номенклатура.Модель,
	                 |	ИнтернетМагазинОстатки.ИнтернетМагазин.ВидЦены,
	                 |	ИнтернетМагазинОстатки.НомерСообщения
	                 |;
	                 |
	                 |////////////////////////////////////////////////////////////////////////////////
	                 |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                 |	Остаток.Характеристика КАК Характеристика,
	                 |	Остаток.Номенклатура КАК Номенклатура,
	                 |	Остаток.НомерСообщения КАК НомерСообщения,
	                 |	Остаток.ИнтернетМагазин КАК ИнтернетМагазин,
	                 |	Остаток.КодВиртуальногоМагазина КАК КодВиртуальногоМагазина,
	                 |	Остаток.Количество КАК Количество,
	                 |	Остаток.Штрихкод КАК Штрихкод,
	                 |	Остаток.НоменклатураАртикул КАК НоменклатураАртикул,
	                 |	Остаток.НоменклатураМодель КАК НоменклатураМодель,
	                 |	Остаток.ТипТовараНаименование КАК ТипТовараНаименование,
	                 |	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, ЦеныНоменклатурыСрезПоследних2.Цена) КАК Цена
	                 |ПОМЕСТИТЬ Остаток_ВидЦены
	                 |ИЗ
	                 |	Остаток КАК Остаток
	                 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, ) КАК ЦеныНоменклатурыСрезПоследних
	                 |		ПО Остаток.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	                 |			И Остаток.ИнтернетМагазин.ВидЦены = ЦеныНоменклатурыСрезПоследних.ВидЦены
	                 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИнтернетМагазинШтриходы КАК ИнтернетМагазинШтриходы
	                 |		ПО Остаток.Номенклатура = ИнтернетМагазинШтриходы.Номенклатура
	                 |			И Остаток.Характеристика = ИнтернетМагазинШтриходы.Характеристика
	                 |			И Остаток.ИнтернетМагазин = ИнтернетМагазинШтриходы.ИнтернетМагазин
	                 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних2
	                 |		ПО Остаток.Номенклатура = ЦеныНоменклатурыСрезПоследних2.Номенклатура
	                 |			И Остаток.ИнтернетМагазин.ВидЦеныПерваяЦена = ЦеныНоменклатурыСрезПоследних2.ВидЦены
	                 |ГДЕ
	                 |	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних2.Цена, 0)) > 0
	                 |;
	                 |
	                 |////////////////////////////////////////////////////////////////////////////////
	                 |ВЫБРАТЬ
	                 |	Остаток_ВидЦены.Характеристика КАК Характеристика,
	                 |	Остаток_ВидЦены.Номенклатура КАК Номенклатура,
	                 |	Остаток_ВидЦены.КодВиртуальногоМагазина КАК КодВиртуальногоМагазина,
	                 |	СУММА(Остаток_ВидЦены.Количество) КАК Количество,
	                 |	Остаток_ВидЦены.Номенклатура.Артикул + Остаток_ВидЦены.Характеристика.Наименование КАК СКУ
	                 |ИЗ
	                 |	Остаток_ВидЦены КАК Остаток_ВидЦены
	                 |
	                 |СГРУППИРОВАТЬ ПО
	                 |	Остаток_ВидЦены.Характеристика,
	                 |	Остаток_ВидЦены.Номенклатура,
	                 |	Остаток_ВидЦены.КодВиртуальногоМагазина,
	                 |	Остаток_ВидЦены.Номенклатура.Артикул + Остаток_ВидЦены.Характеристика.Наименование
	                 |;
	                 |
	                 |////////////////////////////////////////////////////////////////////////////////
	                 |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	                 |	Остаток_ВидЦены.Характеристика КАК Характеристика,
	                 |	Остаток_ВидЦены.Номенклатура КАК Номенклатура,
	                 |	Остаток_ВидЦены.Штрихкод КАК Штрихкод,
	                 |	Остаток_ВидЦены.НоменклатураАртикул КАК Артикул,
	                 |	Остаток_ВидЦены.НоменклатураМодель КАК Модель,
	                 |	Остаток_ВидЦены.ТипТовараНаименование КАК ТипТовара,
	                 |	Остаток_ВидЦены.Цена КАК Цена,
	                 |	Остаток_ВидЦены.Номенклатура.Артикул + Остаток_ВидЦены.Характеристика.Наименование КАК СКУ
	                 |ИЗ
	                 |	Остаток_ВидЦены КАК Остаток_ВидЦены";
	
	Пакет = Запрос.ВыполнитьПакет();
	
	Склады  =  Пакет[2].Выгрузить();
	Товары  =  Пакет[3].Выгрузить();

	
	СкладыПоКлючу = Новый Соответствие;
	
	Для Каждого Стр Из Склады Цикл
		Ключ = Стр.СКУ;
		Если СкладыПоКлючу.Получить(Ключ) =  Неопределено Тогда
			СкладыПоКлючу.Вставить(Ключ, Новый Массив);
		КонецЕсли;
		СкладыПоКлючу[Ключ].Добавить(Новый Структура("КодВиртуальногоМагазина,КоличествоТовара",Стр.КодВиртуальногоМагазина,Стр.Количество));
	КонецЦикла;
	
	
	Для Каждого ТекТовар Из Товары Цикл 
		Запись.ЗаписатьНачалоЭлемента("offer");
		Запись.ЗаписатьАтрибут("sku", ТекТовар.Штрихкод);
		ЗаписатьЭлементБезАтрибутовВXML(Запись, "model", ТекТовар.ТипТовара + " " + ТекТовар.Артикул);
		ЗаписатьЭлементБезАтрибутовВXML(Запись, "brand", "Civil");		
		Запись.ЗаписатьНачалоЭлемента("availabilities");
		МассивСкладов = СкладыПоКлючу.Получить(ТекТовар.СКУ);
		Если  ТипЗнч(МассивСкладов)  =  Тип("Массив") Тогда
			Если  МассивСкладов.Количество() > 0 Тогда
				Для Каждого ТекСклад Из МассивСкладов Цикл 
					Запись.ЗаписатьНачалоЭлемента("availability");
					Запись.ЗаписатьАтрибут("available", "yes");
					Запись.ЗаписатьАтрибут("storeId", ТекСклад.КодВиртуальногоМагазина);
					//Запись.ЗаписатьАтрибут("stockCount", "0"); 
					Запись.ЗаписатьАтрибут("stockCount", Формат(ТекСклад.КоличествоТовара,"ЧГ=")); 
					Запись.ЗаписатьКонецЭлемента();// available					
				КонецЦикла;	
			КонецЕсли;
		КонецЕсли;		
		Запись.ЗаписатьКонецЭлемента();// availabilities
		ЗаписатьЭлементБезАтрибутовВXML(Запись, "price", ТекТовар.Цена);
		Запись.ЗаписатьКонецЭлемента(); //offer
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента(); //offers
	Запись.ЗаписатьКонецЭлемента(); //kaspi_katalog
	Запись.Закрыть();
	ЗаписатьФайлНаФТП(ИмяФайла);

КонецФункции

