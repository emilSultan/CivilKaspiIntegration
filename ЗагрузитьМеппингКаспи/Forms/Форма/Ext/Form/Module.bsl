
&НаКлиенте
Процедура ЗагрузитКатегории(Команда)
	ЗагрузитКатегорииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитКатегорииНаСервере()
	
	ПоследняяСтрока =  ТабДок.ВысотаТаблицы;
	ТаблицаДанных = Новый ТаблицаЗначений;
	ОписаниеТипаСтрока = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(200));
	ТаблицаДанных.Колонки.Добавить("Division", ОписаниеТипаСтрока, "Раздел");
	ТаблицаДанных.Колонки.Добавить("Department", ОписаниеТипаСтрока, "Отдел");
	ТаблицаДанных.Колонки.Добавить("SubDepartment", ОписаниеТипаСтрока, "Подотдел");
	ТаблицаДанных.Колонки.Добавить("Category", ОписаниеТипаСтрока, "Категория");
	ТаблицаДанных.Колонки.Добавить("Class", ОписаниеТипаСтрока, "Класс");
	ТаблицаДанных.Колонки.Добавить("Пол", ОписаниеТипаСтрока, "Пол");


	Для ТекСтрока = 2 По ПоследняяСтрока Цикл

		НовСтрока = ТаблицаДанных.Добавить();
		НовСтрока.Division =  ТабДок.Область(ТекСтрока, 1).Текст;
		НовСтрока.Department =  ТабДок.Область(ТекСтрока, 2).Текст;
		НовСтрока.SubDepartment =  ТабДок.Область(ТекСтрока, 3).Текст;
		НовСтрока.Category =  ТабДок.Область(ТекСтрока, 4).Текст;
		НовСтрока.Class =  ТабДок.Область(ТекСтрока, 5).Текст;
		НовСтрока.Пол =  ТабДок.Область(ТекСтрока, 6).Текст;

	КонецЦикла;


	Запрос  =  Новый Запрос;

	Запрос.УстановитьПараметр("вр_файл",ТаблицаДанных);
	Запрос.Текст  = "ВЫБРАТЬ
	                |	вр_файл.Division КАК Division,
	                |	вр_файл.Department КАК Department,
	                |	вр_файл.SubDepartment КАК SubDepartment,
	                |	вр_файл.Category КАК Category,
	                |	вр_файл.Class КАК Class,
	                |	вр_файл.Пол КАК Пол
	                |ПОМЕСТИТЬ файл
	                |ИЗ
	                |	&вр_файл КАК вр_файл
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                |	MopCategory.Ссылка КАК MopCategory,
	                |	MopClass.Ссылка КАК MopClass,
	                |	MopDepartment.Ссылка КАК MopDepartment,
	                |	MopDivision.Ссылка КАК MopDivision,
	                |	MopSubDepartment.Ссылка КАК MopSubDepartment,
	                |	НоменклатурныйПол.Ссылка КАК Пол
	                |ИЗ
	                |	файл КАК файл
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopCategory КАК MopCategory
	                |		ПО файл.Category = MopCategory.Наименование
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopClass КАК MopClass
	                |		ПО файл.Class = MopClass.Наименование
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopDepartment КАК MopDepartment
	                |		ПО файл.Department = MopDepartment.Наименование
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopDivision КАК MopDivision
	                |		ПО файл.Division = MopDivision.Наименование
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopSubDepartment КАК MopSubDepartment
	                |		ПО файл.SubDepartment = MopSubDepartment.Наименование
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НоменклатурныйПол КАК НоменклатурныйПол
	                |		ПО файл.Пол = НоменклатурныйПол.Наименование";
	
	Выборка =  Запрос.Выполнить().Выбрать();
	
	Пока  Выборка.Следующий() Цикл
		
		
		ДобКатегория = Справочники.мп_Категории.СоздатьЭлемент();			
		ДобКатегория.Наименование = Выборка.MopClass.Наименование + " " + Выборка.MopCategory.Наименование + " " + Выборка.MopDivision.Наименование + " " +  Выборка.MopDepartment.Наименование + " " + Выборка.MopSubDepartment.Наименование +" "+Выборка.Пол.Наименование;
		ДобКатегория._MopCategory = Выборка.MopCategory;
		ДобКатегория._MopClass = Выборка.MopClass;
		ДобКатегория._MopDepartment = Выборка.MopDepartment;
		ДобКатегория._MopDivision = Выборка.MopDivision;
		ДобКатегория._MopSubDepartment = Выборка.MopSubDepartment;
		ДобКатегория.Пол  =  Выборка.Пол;
		ДобКатегория.Записать();
		
	КонецЦикла;
		

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьМеппинг(Команда)
	ЗагрузитьМеппингНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьМеппингНаСервере()
	ПоследняяСтрока =  ТабДок.ВысотаТаблицы;
	ТаблицаДанных = Новый ТаблицаЗначений;
	ОписаниеТипаСтрока = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(200));
	ТаблицаДанных.Колонки.Добавить("Division", ОписаниеТипаСтрока, "Раздел");
	ТаблицаДанных.Колонки.Добавить("Department", ОписаниеТипаСтрока, "Отдел");
	ТаблицаДанных.Колонки.Добавить("SubDepartment", ОписаниеТипаСтрока, "Подотдел");
	ТаблицаДанных.Колонки.Добавить("Category", ОписаниеТипаСтрока, "Категория");
	ТаблицаДанных.Колонки.Добавить("Class", ОписаниеТипаСтрока, "Класс");
	ТаблицаДанных.Колонки.Добавить("Пол", ОписаниеТипаСтрока, "Пол");
	ТаблицаДанных.Колонки.Добавить("Code", ОписаниеТипаСтрока, "Код");
	

	Для ТекСтрока = 2 По ПоследняяСтрока Цикл 
		
		НовСтрока = ТаблицаДанных.Добавить();
		НовСтрока.Division =  ТабДок.Область(ТекСтрока, 1).Текст; 
		НовСтрока.Department =  ТабДок.Область(ТекСтрока, 2).Текст; 
		НовСтрока.SubDepartment =  ТабДок.Область(ТекСтрока, 3).Текст; 
		НовСтрока.Category =  ТабДок.Область(ТекСтрока, 4).Текст; 
		НовСтрока.Class =  ТабДок.Область(ТекСтрока, 5).Текст; 
		НовСтрока.Пол =  ТабДок.Область(ТекСтрока, 6).Текст;
		НовСтрока.Code =  ТабДок.Область(ТекСтрока, 7).Текст; 
					
	КонецЦикла;
	
	
	Запрос  =  Новый Запрос;
	
	Запрос.УстановитьПараметр("вр_файл",ТаблицаДанных);
	Запрос.Текст  = "ВЫБРАТЬ
	                |	вр_файл.Division КАК Division,
	                |	вр_файл.Department КАК Department,
	                |	вр_файл.SubDepartment КАК SubDepartment,
	                |	вр_файл.Category КАК Category,
	                |	вр_файл.Class КАК Class,
	                |	вр_файл.Пол КАК Пол,
	                |	вр_файл.Code КАК Code
	                |ПОМЕСТИТЬ файл
	                |ИЗ
	                |	&вр_файл КАК вр_файл
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                |	MopCategory.Ссылка КАК MopCategory,
	                |	MopClass.Ссылка КАК MopClass,
	                |	MopDepartment.Ссылка КАК MopDepartment,
	                |	MopDivision.Ссылка КАК MopDivision,
	                |	MopSubDepartment.Ссылка КАК MopSubDepartment,
	                |	файл.Code КАК Code,
	                |	НоменклатурныйПол.Ссылка КАК Ссылка
	                |ПОМЕСТИТЬ мопы
	                |ИЗ
	                |	файл КАК файл
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopCategory КАК MopCategory
	                |		ПО файл.Category = MopCategory.Наименование
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopClass КАК MopClass
	                |		ПО файл.Class = MopClass.Наименование
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopDepartment КАК MopDepartment
	                |		ПО файл.Department = MopDepartment.Наименование
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopDivision КАК MopDivision
	                |		ПО файл.Division = MopDivision.Наименование
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopSubDepartment КАК MopSubDepartment
	                |		ПО файл.SubDepartment = MopSubDepartment.Наименование
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НоменклатурныйПол КАК НоменклатурныйПол
	                |		ПО файл.Пол = НоменклатурныйПол.Наименование
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                |	мопы.MopCategory КАК MopCategory,
	                |	мопы.MopClass КАК MopClass,
	                |	мопы.MopDepartment КАК MopDepartment,
	                |	мопы.MopDivision КАК MopDivision,
	                |	мопы.MopSubDepartment КАК MopSubDepartment,
	                |	мопы.Ссылка КАК Пол,
	                |	мопы.Code КАК Code,
	                |	мп_Категории.Ссылка КАК Ссылка
	                |ИЗ
	                |	мопы КАК мопы
	                |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.мп_Категории КАК мп_Категории
	                |		ПО мопы.MopCategory = мп_Категории._MopCategory
	                |			И мопы.MopClass = мп_Категории._MopClass
	                |			И мопы.MopDepartment = мп_Категории._MopDepartment
	                |			И мопы.MopDivision = мп_Категории._MopDivision
	                |			И мопы.MopSubDepartment = мп_Категории._MopSubDepartment
	                |			И мопы.Ссылка = мп_Категории.Пол";

	Выборка =  Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если НЕ ЗначениеЗаполнено(Выборка.Ссылка) Тогда

			ДобКатегория = Справочники.мп_Категории.СоздатьЭлемент();
			ДобКатегория.Наименование = Выборка.MopClass.Наименование + " " + Выборка.MopCategory.Наименование + " " + Выборка.MopDivision.Наименование + " " +  Выборка.MopDepartment.Наименование + " " + Выборка.MopSubDepartment.Наименование +" "+Выборка.Пол.Наименование;
			ДобКатегория._MopCategory = Выборка.MopCategory;
			ДобКатегория._MopClass = Выборка.MopClass;
			ДобКатегория._MopDepartment = Выборка.MopDepartment;
			ДобКатегория._MopDivision = Выборка.MopDivision;
			ДобКатегория._MopSubDepartment = Выборка.MopSubDepartment;
			ДобКатегория.Пол = Выборка.Пол;
			ДобКатегория.Записать();

			СсылкаКатегории = ДобКатегория.Ссылка;

		Иначе

			СсылкаКатегории = Выборка.Ссылка;

		КонецЕсли;

		ИнтернетМагазин = Справочники.ИнтернетМагазины.НайтиПоКоду("000000001");
		ЗаписьРегитсра = РегистрыСведений.мп_ДанныеКарточек.СоздатьМенеджерЗаписи();
		ЗаписьРегитсра.ИнтернетМагазин = ИнтернетМагазин;
		ЗаписьРегитсра.СсылкаОбъекта = СсылкаКатегории;
		ЗаписьРегитсра.Аттрибут = Аттрибут;
		ЗаписьРегитсра.Значение = Выборка.Code;
		ЗаписьРегитсра.Записать();

	КонецЦикла;



КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИнтернетМагазинРазмеры(Команда)
	ЗаполнитьИнтернетМагазинРазмерыНаСервере();
КонецПроцедуры

// Читает ТабДок и записывает РегистрСведений.ИнтернетМагазинРазмеры.
// Формат строк ТабДок (см. СтруктураДанныхРазмеров.md), колонки слева направо:
//   1 Division, 2 Department, 3 SubDepartment, 4 Category, 5 Class - как в ЗагрузитьМеппинг,
//   6 Размер, 7 Значение, 8 РазмерПродавца, 9 РазмернаяCетка, 10 РосРазмерID, 11 РазмернаяCеткаID.
// В самом регистре измерение "Категория" на самом деле типа MopClass, а измерение "Пол" -
// типа MopSubDepartment (так устроены метаданные регистра, имена не совпадают со смыслом).
&НаСервере
Процедура ЗаполнитьИнтернетМагазинРазмерыНаСервере()

	ПоследняяСтрока = ТабДок.ВысотаТаблицы;
	ТаблицаДанных = Новый ТаблицаЗначений;
	ОписаниеТипаСтрока = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(200));
	ТаблицаДанных.Колонки.Добавить("Division", ОписаниеТипаСтрока, "Раздел");
	ТаблицаДанных.Колонки.Добавить("Department", ОписаниеТипаСтрока, "Отдел");
	ТаблицаДанных.Колонки.Добавить("SubDepartment", ОписаниеТипаСтрока, "Подотдел");
	ТаблицаДанных.Колонки.Добавить("Category", ОписаниеТипаСтрока, "Категория");
	ТаблицаДанных.Колонки.Добавить("Class", ОписаниеТипаСтрока, "Класс");
	ТаблицаДанных.Колонки.Добавить("Размер", ОписаниеТипаСтрока, "Размер");
	ТаблицаДанных.Колонки.Добавить("Значение", ОписаниеТипаСтрока, "Значение");
	ТаблицаДанных.Колонки.Добавить("РазмерПродавца", ОписаниеТипаСтрока, "Размер продавца");
	ТаблицаДанных.Колонки.Добавить("РазмернаяCетка", ОписаниеТипаСтрока, "Размерная сетка");
	ТаблицаДанных.Колонки.Добавить("РосРазмерID", ОписаниеТипаСтрока, "Рос размер ID");
	ТаблицаДанных.Колонки.Добавить("РазмернаяCеткаID", ОписаниеТипаСтрока, "Размерная сетка ID");

	Для ТекСтрока = 2 По ПоследняяСтрока Цикл

		НовСтрока = ТаблицаДанных.Добавить();
		НовСтрока.Division = ТабДок.Область(ТекСтрока, 1).Текст;
		НовСтрока.Department = ТабДок.Область(ТекСтрока, 2).Текст;
		НовСтрока.SubDepartment = ТабДок.Область(ТекСтрока, 3).Текст;
		НовСтрока.Category = ТабДок.Область(ТекСтрока, 4).Текст;
		НовСтрока.Class = ТабДок.Область(ТекСтрока, 5).Текст;
		НовСтрока.Размер = ТабДок.Область(ТекСтрока, 6).Текст;
		НовСтрока.Значение = ТабДок.Область(ТекСтрока, 7).Текст;
		НовСтрока.РазмерПродавца = ТабДок.Область(ТекСтрока, 8).Текст;
		НовСтрока.РазмернаяCетка = ТабДок.Область(ТекСтрока, 9).Текст;
		НовСтрока.РосРазмерID = ТабДок.Область(ТекСтрока, 10).Текст;
		НовСтрока.РазмернаяCеткаID = ТабДок.Область(ТекСтрока, 11).Текст;

	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("вр_файл", ТаблицаДанных);
	Запрос.Текст = "ВЫБРАТЬ
	               |	вр_файл.Division КАК Division,
	               |	вр_файл.Department КАК Department,
	               |	вр_файл.SubDepartment КАК SubDepartment,
	               |	вр_файл.Category КАК Category,
	               |	вр_файл.Class КАК Class,
	               |	вр_файл.Размер КАК Размер,
	               |	вр_файл.Значение КАК Значение,
	               |	вр_файл.РазмерПродавца КАК РазмерПродавца,
	               |	вр_файл.РазмернаяCетка КАК РазмернаяCетка,
	               |	вр_файл.РосРазмерID КАК РосРазмерID,
	               |	вр_файл.РазмернаяCеткаID КАК РазмернаяCеткаID
	               |ПОМЕСТИТЬ файл
	               |ИЗ
	               |	&вр_файл КАК вр_файл
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	MopClass.Ссылка КАК Категория,
	               |	MopCategory.Ссылка КАК MopCategory,
	               |	MopSubDepartment.Ссылка КАК Пол,
	               |	MopDepartment.Ссылка КАК MopDepartment,
	               |	MopDivision.Ссылка КАК MopDivision,
	               |	файл.Размер КАК Размер,
	               |	файл.Значение КАК Значение,
	               |	файл.РазмерПродавца КАК РазмерПродавца,
	               |	файл.РазмернаяCетка КАК РазмернаяCетка,
	               |	файл.РосРазмерID КАК РосРазмерID,
	               |	файл.РазмернаяCеткаID КАК РазмернаяCеткаID
	               |ИЗ
	               |	файл КАК файл
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopDivision КАК MopDivision
	               |		ПО файл.Division = MopDivision.Наименование
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopDepartment КАК MopDepartment
	               |		ПО файл.Department = MopDepartment.Наименование
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopSubDepartment КАК MopSubDepartment
	               |		ПО файл.SubDepartment = MopSubDepartment.Наименование
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopCategory КАК MopCategory
	               |		ПО файл.Category = MopCategory.Наименование
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopClass КАК MopClass
	               |		ПО файл.Class = MopClass.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();

	ИнтернетМагазинКаспи = НайтиИнтернетМагазинКаспиНаСервере();

	Пока Выборка.Следующий() Цикл

		ЗаписьРегистра = РегистрыСведений.ИнтернетМагазинРазмеры.СоздатьМенеджерЗаписи();
		ЗаписьРегистра.ИнтернетМагазин = ИнтернетМагазинКаспи;
		ЗаписьРегистра.Категория = Выборка.Категория;
		ЗаписьРегистра.MopCategory = Выборка.MopCategory;
		ЗаписьРегистра.Пол = Выборка.Пол;
		ЗаписьРегистра.MopDepartment = Выборка.MopDepartment;
		ЗаписьРегистра.MopDivision = Выборка.MopDivision;
		ЗаписьРегистра.Размер = Выборка.Размер;
		ЗаписьРегистра.Значение = Выборка.Значение;
		ЗаписьРегистра.РазмерПродавца = Выборка.РазмерПродавца;
		ЗаписьРегистра.РазмернаяCетка = Выборка.РазмернаяCетка;
		ЗаписьРегистра.РосРазмерID = Выборка.РосРазмерID;
		ЗаписьРегистра.РазмернаяCеткаID = Выборка.РазмернаяCеткаID;
		ЗаписьРегистра.Записать();

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьСпр_ма_Категории(Команда)
	УдалитьСпр_ма_КатегорииНаСервере();
КонецПроцедуры

&НаСервере
Процедура УдалитьСпр_ма_КатегорииНаСервере()
	УстановитьПривилегированныйРежим(истина);
	Запрос  = Новый Запрос;
	Запрос.Текст  = "ВЫБРАТЬ
