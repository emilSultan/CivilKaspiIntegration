&НаСервере
Процедура ПолучитьРостНаСервере()
	ЗаполнитьЗначенияРеквизитаКатегорийНаСервере(ТабДокРост, СтрРазделить("Child body height", ","), "Child body height");
КонецПроцедуры

// Берёт категории мп_Категории и их код в Kaspi напрямую из регистра мп_ДанныеКарточек,
// затем для каждой категории запрашивает у Kaspi значение реквизита, чей код ОКАНЧИВАЕТСЯ
// на одно из ВариантыОкончанийКода (например, ["Size"] или ["Colour","Color"]) - см. пример
// работы с классификатором Kaspi в KASPI_CARDS_RT.Товары_РеквизитыКатегории /
// Товары_ВозможныеЗначенияРеквизита - и выводит результат в табличный документ ТабДокРезультат.
// Полный код реквизита в Kaspi всегда содержит категорийный префикс перед нужным окончанием
// (например, "Baby trousers*Child body height", "Fashion hats and caps*Size"), а написание
// самого окончания может отличаться по категориям (Colour/Color), поэтому сравниваем по
// окончанию строки среди нескольких вариантов, а не по точному совпадению.
&НаСервере
Процедура ЗаполнитьЗначенияРеквизитаКатегорийНаСервере(ТабДокРезультат, ВариантыОкончанийКода, ЗаголовокРеквизита)

	Сообщение = "";
	TitleКатегорийКаспи = КаспиTitleКатегорийНаСервере(Сообщение);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Аттрибут", Справочники.мп_АттрибутыКарточек.Категория);
	Запрос.Текст = "ВЫБРАТЬ
	               |	мп_Категории._MopDivision.Наименование КАК Department,
	               |	мп_Категории._MopDepartment.Наименование КАК Section,
	               |	мп_Категории._MopSubDepartment.Наименование КАК Category,
	               |	мп_Категории._MopCategory.Наименование КАК PurchaseGroup,
	               |	мп_Категории._MopClass.Наименование КАК ProductGroup,
	               |	мп_Категории.Пол.Наименование КАК Gender,
	               |	мп_ДанныеКарточек.Значение КАК Значение
	               |ИЗ
	               |	РегистрСведений.мп_ДанныеКарточек КАК мп_ДанныеКарточек
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.мп_Категории КАК мп_Категории
	               |		ПО мп_ДанныеКарточек.СсылкаОбъекта = мп_Категории.Ссылка
	               |ГДЕ
	               |	мп_ДанныеКарточек.Аттрибут = &Аттрибут";

	Выборка = Запрос.Выполнить().Выбрать();

	ТабДокРезультат.Очистить();
	ТабДокРезультат.Область(1, 1).Текст = "Department";
	ТабДокРезультат.Область(1, 2).Текст = "Section";
	ТабДокРезультат.Область(1, 3).Текст = "Category";
	ТабДокРезультат.Область(1, 4).Текст = "PurchaseGroup";
	ТабДокРезультат.Область(1, 5).Текст = "ProductGroup";
	ТабДокРезультат.Область(1, 6).Текст = "Gender";
	ТабДокРезультат.Область(1, 7).Текст = "Код категории Kaspi";
	ТабДокРезультат.Область(1, 8).Текст = "Title категории Kaspi";
	ТабДокРезультат.Область(1, 9).Текст = "Код " + ЗаголовокРеквизита;
	ТабДокРезультат.Область(1, 10).Текст = "Наименование " + ЗаголовокРеквизита;

	СтрокаТабДок = 2;

	Пока Выборка.Следующий() Цикл

		Если Не ЗначениеЗаполнено(Выборка.Значение) Тогда
			Продолжить;
		КонецЕсли;

		Сообщение = "";
		РеквизитыКатегории = Неопределено;
		Если Не РеквизитыКатегорииКаспиНаСервере(Выборка.Значение, РеквизитыКатегории, Сообщение) Тогда
			Продолжить;
		КонецЕсли;

		НайденныйКодРеквизита = Неопределено;
		Для Каждого СтрокаРеквизита Из РеквизитыКатегории Цикл
			Для Каждого ОкончаниеКода Из ВариантыОкончанийКода Цикл
				Если СтрЗаканчиваетсяНа(СтрокаРеквизита.code, ОкончаниеКода) Тогда
					НайденныйКодРеквизита = СтрокаРеквизита.code;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НайденныйКодРеквизита <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если НайденныйКодРеквизита = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Сообщение = "";
		ВозможныеЗначения = ВозможныеЗначенияРеквизитаКаспиНаСервере(
			Выборка.Значение, НайденныйКодРеквизита, Сообщение);
		Если ВозможныеЗначения = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		TitleКатегории = TitleКатегорийКаспи.Получить(Выборка.Значение);

		Для Каждого Значение Из ВозможныеЗначения Цикл
			ТабДокРезультат.Область(СтрокаТабДок, 1).Текст = Выборка.Department;
			ТабДокРезультат.Область(СтрокаТабДок, 2).Текст = Выборка.Section;
			ТабДокРезультат.Область(СтрокаТабДок, 3).Текст = Выборка.Category;
			ТабДокРезультат.Область(СтрокаТабДок, 4).Текст = Выборка.PurchaseGroup;
			ТабДокРезультат.Область(СтрокаТабДок, 5).Текст = Выборка.ProductGroup;
			ТабДокРезультат.Область(СтрокаТабДок, 6).Текст = Выборка.Gender;
			ТабДокРезультат.Область(СтрокаТабДок, 7).Текст = Выборка.Значение;
			ТабДокРезультат.Область(СтрокаТабДок, 8).Текст = TitleКатегории;
			ТабДокРезультат.Область(СтрокаТабДок, 9).Текст = Значение.Получить("code");
			ТабДокРезультат.Область(СтрокаТабДок, 10).Текст = Значение.Получить("name");
			СтрокаТабДок = СтрокаТабДок + 1;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьChildHeightAIReference(Команда)
	ЗагрузитьChildHeightAIReferenceНаСервере();
КонецПроцедуры

// Читает ТабДокРостAIReference (в него копируют таблицу из ChildHeight_AI_Reference.md,
// шапка в строке 1, данные - со строки 2) и записывает РегистрСведений.ИнтернетМагазинРазмеры.
// Колонки слева направо совпадают с колонками файла: Department, Section, Category,
// PurchaseGroup, ProductGroup, Size, Код Child body height, Наименование Child body height.
// Соответствие измерениям/ресурсам регистра (см. ChildHeight_AI_Reference.md и
// Forms/СтруктураДанныхРазмеров.md):
//   Department -> MopDivision, Section -> MopDepartment, Category -> MopCategory,
//   PurchaseGroup -> Пол (тип MopSubDepartment), ProductGroup -> Категория (тип MopClass),
//   Size -> Размер, "Код Child body height" -> ресурс РазмерПродавца (8-я колонка,
//   "Наименование Child body height", отдельно не записывается). Остальные ресурсы регистра -
//   Значение/РазмернаяCетка/РосРазмерID/РазмернаяCеткаID - этим источником не задаются.
// Как и в ЗаполнитьИнтернетМагазинРазмерыНаСервере, строки без соответствия хотя бы в одном
// из справочников Mop* просто не попадают в выборку (ВНУТРЕННЕЕ СОЕДИНЕНИЕ). Дополнительно
// строка попадает в запись, ТОЛЬКО если запись с такими же измерениями (ИнтернетМагазин +
// MopDivision/MopDepartment/Пол/MopCategory/Категория/Размер) УЖЕ существует в самом регистре
// ИнтернетМагазинРазмеры - новые записи эта кнопка не создаёт, только обновляет РазмерПродавца
// у существующих (тоже ВНУТРЕННЕЕ СОЕДИНЕНИЕ, теперь с самим регистром).
&НаСервере
Процедура ЗагрузитьChildHeightAIReferenceНаСервере()

	ПоследняяСтрока = ТабДокРостAIReference.ВысотаТаблицы;

	ТаблицаДанных = Новый ТаблицаЗначений;
	ОписаниеТипаСтрока = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(200));
	ТаблицаДанных.Колонки.Добавить("Division", ОписаниеТипаСтрока);
	ТаблицаДанных.Колонки.Добавить("Department", ОписаниеТипаСтрока);
	ТаблицаДанных.Колонки.Добавить("SubDepartment", ОписаниеТипаСтрока);
	ТаблицаДанных.Колонки.Добавить("Category", ОписаниеТипаСтрока);
	ТаблицаДанных.Колонки.Добавить("Class", ОписаниеТипаСтрока);
	ТаблицаДанных.Колонки.Добавить("Размер", ОписаниеТипаСтрока);
	ТаблицаДанных.Колонки.Добавить("РазмерПродавца", ОписаниеТипаСтрока);

	Для ТекСтрока = 2 По ПоследняяСтрока Цикл

		Division = СокрЛП(ТабДокРостAIReference.Область(ТекСтрока, 1).Текст);
		Если ПустаяСтрока(Division) Тогда
			Продолжить;
		КонецЕсли;

		НовСтрока = ТаблицаДанных.Добавить();
		НовСтрока.Division       = Division;                                                   // Department
		НовСтрока.Department     = СокрЛП(ТабДокРостAIReference.Область(ТекСтрока, 2).Текст);  // Section
		НовСтрока.Category       = СокрЛП(ТабДокРостAIReference.Область(ТекСтрока, 3).Текст);  // Category -> MopCategory
		НовСтрока.SubDepartment  = СокрЛП(ТабДокРостAIReference.Область(ТекСтрока, 4).Текст);  // PurchaseGroup -> Пол (MopSubDepartment)
		НовСтрока.Class          = СокрЛП(ТабДокРостAIReference.Область(ТекСтрока, 5).Текст);  // ProductGroup -> Категория (MopClass)
		НовСтрока.Размер         = СокрЛП(ТабДокРостAIReference.Область(ТекСтрока, 6).Текст);  // Size
		НовСтрока.РазмерПродавца = СокрЛП(ТабДокРостAIReference.Область(ТекСтрока, 7).Текст);  // Код Child body height

	КонецЦикла;

	Если ТаблицаДанных.Количество() = 0 Тогда
		Сообщить("В ТабДокРостAIReference нет данных (строки со 2-й, колонка 1 - Division/Department)");
		Возврат;
	КонецЕсли;

	ИнтернетМагазинКаспи = НайтиИнтернетМагазинКаспиНаСервере();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("вр_файл", ТаблицаДанных);
	Запрос.УстановитьПараметр("ИнтернетМагазин", ИнтернетМагазинКаспи);
	Запрос.Текст = "ВЫБРАТЬ
	               |	вр_файл.Division КАК Division,
	               |	вр_файл.Department КАК Department,
	               |	вр_файл.SubDepartment КАК SubDepartment,
	               |	вр_файл.Category КАК Category,
	               |	вр_файл.Class КАК Class,
	               |	вр_файл.Размер КАК Размер,
	               |	вр_файл.РазмерПродавца КАК РазмерПродавца
	               |ПОМЕСТИТЬ файл
	               |ИЗ
	               |	&вр_файл КАК вр_файл
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	MopClass.Ссылка КАК Категория,
	               |	MopCategory.Ссылка КАК MopCategory,
	               |	MopSubDepartment.Ссылка КАК Пол,
	               |	MopDepartment.Ссылка КАК MopDepartment,
	               |	MopDivision.Ссылка КАК MopDivision,
	               |	файл.Размер КАК Размер,
	               |	файл.РазмерПродавца КАК РазмерПродавца
	               |ПОМЕСТИТЬ найденныеМОП
	               |ИЗ
	               |	файл КАК файл
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopDivision КАК MopDivision
	               |		ПО файл.Division = MopDivision.Наименование
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopDepartment КАК MopDepartment
	               |		ПО файл.Department = MopDepartment.Наименование
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopSubDepartment КАК MopSubDepartment
	               |		ПО файл.SubDepartment = MopSubDepartment.Наименование
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopCategory КАК MopCategory
	               |		ПО файл.Category = MopCategory.Наименование
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.MopClass КАК MopClass
	               |		ПО файл.Class = MopClass.Наименование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	найденныеМОП.Категория КАК Категория,
	               |	найденныеМОП.MopCategory КАК MopCategory,
	               |	найденныеМОП.Пол КАК Пол,
	               |	найденныеМОП.MopDepartment КАК MopDepartment,
	               |	найденныеМОП.MopDivision КАК MopDivision,
	               |	найденныеМОП.Размер КАК Размер,
	               |	найденныеМОП.РазмерПродавца КАК РазмерПродавца
	               |ИЗ
	               |	найденныеМОП КАК найденныеМОП
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИнтернетМагазинРазмеры КАК ИнтернетМагазинРазмеры
	               |		ПО найденныеМОП.Категория = ИнтернетМагазинРазмеры.Категория
	               |			И найденныеМОП.MopCategory = ИнтернетМагазинРазмеры.MopCategory
	               |			И найденныеМОП.Пол = ИнтернетМагазинРазмеры.Пол
	               |			И найденныеМОП.MopDepartment = ИнтернетМагазинРазмеры.MopDepartment
	               |			И найденныеМОП.MopDivision = ИнтернетМагазинРазмеры.MopDivision
	               |			И найденныеМОП.Размер = ИнтернетМагазинРазмеры.Размер
	               |			И ИнтернетМагазинРазмеры.ИнтернетМагазин = &ИнтернетМагазин";

	Выборка = Запрос.Выполнить().Выбрать();

	КоличествоЗаписано = 0;

	Пока Выборка.Следующий() Цикл

		ЗаписьРегистра = РегистрыСведений.ИнтернетМагазинРазмеры.СоздатьМенеджерЗаписи();
		ЗаписьРегистра.ИнтернетМагазин = ИнтернетМагазинКаспи;
		ЗаписьРегистра.Категория = Выборка.Категория;
		ЗаписьРегистра.MopCategory = Выборка.MopCategory;
		ЗаписьРегистра.Пол = Выборка.Пол;
		ЗаписьРегистра.MopDepartment = Выборка.MopDepartment;
		ЗаписьРегистра.MopDivision = Выборка.MopDivision;
		ЗаписьРегистра.Размер = Выборка.Размер;
		ЗаписьРегистра.РазмерПродавца = Выборка.РазмерПродавца;
		ЗаписьРегистра.Записать();

		КоличествоЗаписано = КоличествоЗаписано + 1;

	КонецЦикла;

	Сообщить("Строк прочитано из ТабДокРостAIReference: " + ТаблицаДанных.Количество()
		+ ". Обновлено существующих записей регистра ИнтернетМагазинРазмеры: " + КоличествоЗаписано
		+ ". Пропущено (нет элемента в справочниках Mop* или нет такой записи в регистре): "
		+ (ТаблицаДанных.Количество() - КоличествоЗаписано) + ".");

КонецПроцедуры

#Область КаспиAPI

// Магазин Kaspi в справочнике ИнтернетМагазины - тот же, что уже используется
// при записи регистра мп_ДанныеКарточек в ЗагрузитьМеппингНаСервере.
&НаСервере
Функция НайтиИнтернетМагазинКаспиНаСервере()

	Возврат Справочники.ИнтернетМагазины.НайтиПоКоду("000000001");

КонецФункции

// Токен и способ вызова взяты из реально работающей обработки CIVIL_KASPI_INTEGRATION_live
// (ПолучитьЗаголовкиЗапросаHTTP + КоннекторHTTP.GetJson): там используется только этот
// X-Auth-Token, без X-Merchant-Uid, и запрос идёт через общий модуль КоннекторHTTP,
// а не через ручную сборку HTTPСоединение/HTTPЗапрос.
&НаСервере
Функция ЗаголовкиКаспиНаСервере()

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/vnd.api+json");
	Заголовки.Вставить("X-Auth-Token", "cE0P0Z2VJQGvrE0g5oYccTNHmrwyV7vIJiheNP5ugVU=");

	Возврат Заголовки;

КонецФункции

// Выполняет GET-запрос к Kaspi API (products/classification/*) через общий модуль
// КоннекторHTTP.GetJson - тот же вызов, что использует CIVIL_KASPI_INTEGRATION_live
// для запросов к shop/api - и возвращает разобранный JSON-ответ.
&НаСервере
Функция ВыполнитьЗапросКаспиНаСервере(Путь, ПараметрыЗапроса, Сообщение)

	АдресРесурса = "https://kaspi.kz" + Путь;
	Если ПараметрыЗапроса <> Неопределено Тогда
		ЧастиЗапроса = Новый Массив;
		Для Каждого Параметр Из ПараметрыЗапроса Цикл
			ЗначениеПараметра = КодироватьСтроку(Параметр.Значение, СпособКодированияСтроки.КодировкаURL);
			ЧастиЗапроса.Добавить(Параметр.Ключ + "=" + ЗначениеПараметра);
		КонецЦикла;
		АдресРесурса = АдресРесурса + "?" + СтрСоединить(ЧастиЗапроса, "&");
	КонецЕсли;

	ДопПараметры = Новый Структура("Заголовки,Таймаут", ЗаголовкиКаспиНаСервере(), 60);

	Попытка
		Возврат КоннекторHTTP.GetJson(АдресРесурса, Неопределено, ДопПараметры);
	Исключение
		Сообщение = ОписаниеОшибки();
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Возвращает Соответствие "код категории Kaspi" -> "title" (человекочитаемое название),
// см. GET /products/classification/categories - список категорий запрашивается один раз
// за вызов процедуры, а не по одному разу на каждую строку.
&НаСервере
Функция КаспиTitleКатегорийНаСервере(Сообщение)

	TitleПоКоду = Новый Соответствие();

	Отклик = ВыполнитьЗапросКаспиНаСервере("/shop/api/products/classification/categories", Неопределено, Сообщение);
	Если Отклик = Неопределено Тогда
		Возврат TitleПоКоду;
	КонецЕсли;

	Для Каждого Элемент Из Отклик Цикл
		TitleПоКоду.Вставить(Элемент.Получить("code"), Элемент.Получить("title"));
	КонецЦикла;

	Возврат TitleПоКоду;

КонецФункции

&НаСервере
Функция РеквизитыКатегорииКаспиНаСервере(КодКатегории, Результат, Сообщение)

	ПараметрыЗапроса = Новый Соответствие();
	ПараметрыЗапроса.Вставить("c", КодКатегории);

	ПутьАтрибутов = "/shop/api/products/classification/attributes";
	Отклик = ВыполнитьЗапросКаспиНаСервере(ПутьАтрибутов, ПараметрыЗапроса, Сообщение);
	Если Отклик = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("code");
	Результат.Колонки.Добавить("type");

	Для Каждого Элемент Из Отклик Цикл
		Строка = Результат.Добавить();
		Строка.code = Элемент.Получить("code");
		Строка.type = Элемент.Получить("type");
	КонецЦикла;

	Возврат Истина;

КонецФункции

&НаСервере
Функция ВозможныеЗначенияРеквизитаКаспиНаСервере(КодКатегории, КодРеквизита, Сообщение)

	ПараметрыЗапроса = Новый Соответствие();
	ПараметрыЗапроса.Вставить("c", КодКатегории);
	ПараметрыЗапроса.Вставить("a", КодРеквизита);

	ПутьЗначений = "/shop/api/products/classification/attribute/values";
	Возврат ВыполнитьЗапросКаспиНаСервере(ПутьЗначений, ПараметрыЗапроса, Сообщение);

КонецФункции

#КонецОбласти
