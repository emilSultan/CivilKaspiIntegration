
&НаКлиенте
Процедура ИсправитьРеализации(Команда)
	ИсправитьРеализацииНаСервере();
КонецПроцедуры

// Читает уникальные непустые номера заказов из ТабДок и для каждого:
//   1) если он уже есть в проведённой реализации требуемого периода (месяц/год реквизита Дата) - пропускает;
//   2) если он есть в проведённой реализации другого периода - переносит строки этого заказа в новую
//      реализацию, датированную Дата, и удаляет их из исходной реализации (саму исходную реализацию не удаляет);
//   3) если его нет ни в одной проведённой реализации - создаёт новую реализацию по документу
//      "Заказ покупателя" (поиск по НомерЗаказаНаСайте).
// Результат по каждому номеру выводится в ТабДокРезультатРеализаций, итоги - через Сообщить.
&НаСервере
Процедура ИсправитьРеализацииНаСервере()

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Сообщить("Не заполнен реквизит ""Дата"".");
		Возврат;
	КонецЕсли;

	НомераЗаказов = СчитатьНомераЗаказовНаСервере();

	ТабДокРезультатРеализаций.Очистить();
	ТабДокРезультатРеализаций.Область(1, 1).Текст = "Номер заказа";
	ТабДокРезультатРеализаций.Область(1, 2).Текст = "Результат";
	ТабДокРезультатРеализаций.Область(1, 3).Текст = "Комментарий";

	Если НомераЗаказов.Количество() = 0 Тогда
		Сообщить("В ""Номера заказов"" не найдено ни одного номера заказа.");
		Возврат;
	КонецЕсли;

	ОбразецСкладМагазин = НайтиСкладИМагазинИзЛюбойРеализацииНаСервере();
	Если ОбразецСкладМагазин = Неопределено Тогда
		Сообщить("В базе нет ни одной проведённой реализации - неоткуда взять склад и магазин для новых документов.");
		Возврат;
	КонецЕсли;

	НачалоПериода = НачалоМесяца(Дата);
	КонецПериода  = НачалоМесяца(ДобавитьМесяц(НачалоПериода, 1));

	СтрокаТабДок = 2;
	КоличествоУспешно  = 0;
	КоличествоПропущено = 0;
	КоличествоОшибок   = 0;

	Для Каждого НомерЗаказа Из НомераЗаказов Цикл

		Статус = "";
		Комментарий = "";

		ОбработатьНомерЗаказаНаСервере(НомерЗаказа, Дата, НачалоПериода, КонецПериода, ОбразецСкладМагазин, Статус, Комментарий);

		ТабДокРезультатРеализаций.Область(СтрокаТабДок, 1).Текст = НомерЗаказа;
		ТабДокРезультатРеализаций.Область(СтрокаТабДок, 2).Текст = ПредставлениеРезультата(Статус);
		ТабДокРезультатРеализаций.Область(СтрокаТабДок, 3).Текст = Комментарий;
		СтрокаТабДок = СтрокаТабДок + 1;

		Если Статус = "УжеВПериоде" Тогда
			КоличествоПропущено = КоличествоПропущено + 1;
		ИначеЕсли Статус = "Перенесен" Или Статус = "СозданаПоЗаказу" Тогда
			КоличествоУспешно = КоличествоУспешно + 1;
		Иначе
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;

	КонецЦикла;

	Сообщить(СтрШаблон(
		"Обработка завершена. Всего номеров: %1. Успешно обработано: %2. Пропущено (уже в периоде): %3. Ошибок: %4.",
		НомераЗаказов.Количество(), КоличествоУспешно, КоличествоПропущено, КоличествоОшибок));

КонецПроцедуры

&НаСервере
Функция ПредставлениеРезультата(Статус)

	Если Статус = "УжеВПериоде" Тогда
		Возврат "Уже находится в требуемом периоде - пропущен";
	ИначеЕсли Статус = "Перенесен" Тогда
		Возврат "Перенесён из реализации другого периода";
	ИначеЕсли Статус = "СозданаПоЗаказу" Тогда
		Возврат "Создана реализация по заказу покупателя";
	ИначеЕсли Статус = "ЗаказНеНайден" Тогда
		Возврат "Заказ покупателя не найден";
	ИначеЕсли Статус = "ОшибкаНовойРеализации" Тогда
		Возврат "Ошибка создания или проведения новой реализации";
	ИначеЕсли Статус = "ОшибкаИсходнойРеализации" Тогда
		Возврат "Ошибка изменения или перепроведения исходной реализации";
	КонецЕсли;

	Возврат Статус;

КонецФункции

// Считывает все непустые ячейки ТабДок (строки и столбцы), убирает пробелы по краям
// и повторы (первое вхождение сохраняется), пустые строки/ячейки пропускаются.
&НаСервере
Функция СчитатьНомераЗаказовНаСервере()

	НомераЗаказов = Новый Массив;
	Просмотренные = Новый Соответствие;

	Для НомерСтроки = 1 По ТабДок.ВысотаТаблицы Цикл
		Для НомерКолонки = 1 По ТабДок.ШиринаТаблицы Цикл

			Значение = СокрЛП(ТабДок.Область(НомерСтроки, НомерКолонки).Текст);

			Если ПустаяСтрока(Значение) Тогда
				Продолжить;
			КонецЕсли;

			Если Просмотренные.Получить(Значение) = Неопределено Тогда
				Просмотренные.Вставить(Значение, Истина);
				НомераЗаказов.Добавить(Значение);
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	Возврат НомераЗаказов;

КонецФункции

// Основная логика по одному номеру заказа - см. описание сценариев 1-3 в ТЗ.
// Статус и Комментарий возвращаются через параметры (Знач не используется - изменяются по ссылке).
&НаСервере
Процедура ОбработатьНомерЗаказаНаСервере(НомерЗаказа, ДатаФормы, НачалоПериода, КонецПериода, ОбразецСкладМагазин, Статус, Комментарий)

	Статус = "";
	Комментарий = "";

	РеализацииСЗаказом = НайтиРеализацииПоНомеруЗаказаНаСервере(НомерЗаказа);

	Для Каждого СтрРеал Из РеализацииСЗаказом Цикл
		Если СтрРеал.Дата >= НачалоПериода И СтрРеал.Дата < КонецПериода Тогда
			Статус = "УжеВПериоде";
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Если РеализацииСЗаказом.Количество() > 0 Тогда

		Попытка
			СоздатьРеализациюИзСтарыхНаСервере(НомерЗаказа, РеализацииСЗаказом, ДатаФормы);
		Исключение
			Статус = "ОшибкаНовойРеализации";
			Комментарий = ОписаниеОшибки();
			Возврат;
		КонецПопытки;

		Попытка
			УдалитьСтрокиИзИсходныхРеализацийНаСервере(НомерЗаказа, РеализацииСЗаказом);
			Статус = "Перенесен";
		Исключение
			Статус = "ОшибкаИсходнойРеализации";
			Комментарий = ОписаниеОшибки();
		КонецПопытки;

		Возврат;

	КонецЕсли;

	Заказ = НайтиЗаказПокупателяНаСервере(НомерЗаказа);

	Если Заказ = Неопределено Тогда
		Статус = "ЗаказНеНайден";
		Возврат;
	КонецЕсли;

	Попытка
		СоздатьРеализациюПоЗаказуНаСервере(Заказ, НомерЗаказа, ДатаФормы, ОбразецСкладМагазин);
		Статус = "СозданаПоЗаказу";
	Исключение
		Статус = "ОшибкаНовойРеализации";
		Комментарий = ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Проведённые реализации, в табличной части Товары которых есть строки с этим НомерЗаказа.
&НаСервере
Функция НайтиРеализацииПоНомеруЗаказаНаСервере(НомерЗаказа)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерЗаказа", НомерЗаказа);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	РеализацияТоваровТовары.Ссылка КАК Ссылка,
	               |	РеализацияТоваровТовары.Ссылка.Дата КАК Дата
	               |ИЗ
	               |	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
	               |ГДЕ
	               |	РеализацияТоваровТовары.НомерЗаказа = &НомерЗаказа
	               |	И РеализацияТоваровТовары.Ссылка.Проведен";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Документ "Заказ покупателя" по точному совпадению НомерЗаказаНаСайте.
&НаСервере
Функция НайтиЗаказПокупателяНаСервере(НомерЗаказа)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерЗаказаНаСайте", НомерЗаказа);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЗаказПокупателя.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	               |ГДЕ
	               |	ЗаказПокупателя.НомерЗаказаНаСайте = &НомерЗаказаНаСайте";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Берёт Склад и Магазин из ЛЮБОЙ проведённой реализации (для сценария 3 - создания реализации по заказу
// покупателя, у заказов бывают разные/некорректные склады, поэтому эти два поля берутся не из заказа).
&НаСервере
Функция НайтиСкладИМагазинИзЛюбойРеализацииНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	РеализацияТоваров.Склад КАК Склад,
	               |	РеализацияТоваров.Магазин КАК Магазин
	               |ИЗ
	               |	Документ.РеализацияТоваров КАК РеализацияТоваров
	               |ГДЕ
	               |	РеализацияТоваров.Проведен";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Склад, Магазин", Выборка.Склад, Выборка.Магазин);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Сценарий 2, шаг 1: собирает строки текущего НомерЗаказа из всех РеализацииСЗаказом (все они здесь
// заведомо вне требуемого периода - проверка периода уже выполнена в ОбработатьНомерЗаказаНаСервере) и
// переносит их в новый документ "Реализация товаров", датированный ДатаФормы. Шапка нового документа
// заполняется по образцу первой найденной исходной реализации (тот же приём, что уже используется
// в CIVIL_KASPI_INTEGRATION_live.СоздатьДокРеализациюТоваров: ЗаполнитьЗначенияСвойств копирует только
// простые реквизиты шапки, табличные части не трогает).
&НаСервере
Процедура СоздатьРеализациюИзСтарыхНаСервере(НомерЗаказа, РеализацииСЗаказом, ДатаФормы)

	НовыйДок = Документы.РеализацияТоваров.СоздатьДокумент();
	ИсходнаяДляШапки = Неопределено;
	ЗаказДляШапки = Неопределено;

	Для Каждого СтрРеал Из РеализацииСЗаказом Цикл

		СтараяРеализация = СтрРеал.Ссылка.ПолучитьОбъект();
		НайденныеСтроки = СтараяРеализация.Товары.НайтиСтроки(Новый Структура("НомерЗаказа", НомерЗаказа));

		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если ИсходнаяДляШапки = Неопределено Тогда
			ИсходнаяДляШапки = СтараяРеализация;
		КонецЕсли;

		Для Каждого СтрТовара Из НайденныеСтроки Цикл
			НоваяСтрока = НовыйДок.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрТовара);
			Если ЗаказДляШапки = Неопределено Тогда
				ЗаказДляШапки = СтрТовара.ЗаказПокупателя;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Если НовыйДок.Товары.Количество() = 0 Тогда
		ВызватьИсключение "Не найдены строки с НомерЗаказа = """ + НомерЗаказа + """ для переноса.";
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(НовыйДок, ИсходнаяДляШапки,, "Номер, Дата, Ссылка");
	НовыйДок.ЗаказПокупателя = ЗаказДляШапки;
	НовыйДок.Дата = ДатаФормы;

	НовыйДок.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);

КонецПроцедуры

// Сценарий 2, шаг 2: только после успешного проведения новой реализации (вызывается отдельно и позже)
// удаляет из каждой исходной реализации строки текущего НомерЗаказа и перепроводит документ. Сам документ
// не удаляется никогда. Если после удаления строк товарная часть опустела (в реализации не осталось других
// заказов) - документ распроводится (Проведен = Ложь), а не остаётся пустым проведённым и не удаляется.
&НаСервере
Процедура УдалитьСтрокиИзИсходныхРеализацийНаСервере(НомерЗаказа, РеализацииСЗаказом)

	Для Каждого СтрРеал Из РеализацииСЗаказом Цикл

		СтараяРеализация = СтрРеал.Ссылка.ПолучитьОбъект();
		НайденныеСтроки = СтараяРеализация.Товары.НайтиСтроки(Новый Структура("НомерЗаказа", НомерЗаказа));

		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СтрТовара Из НайденныеСтроки Цикл
			СтараяРеализация.Товары.Удалить(СтрТовара);
		КонецЦикла;

		Если СтараяРеализация.Товары.Количество() = 0 Тогда
			СтараяРеализация.Проведен = Ложь;
			СтараяРеализация.Записать(РежимЗаписиДокумента.Запись);
		Иначе
			СтараяРеализация.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Сценарий 3: заказ не найден ни в одной проведённой реализации - создаёт новую реализацию по документу
// "Заказ покупателя" (тот же приём копирования шапки/строк, что и в
// CIVIL_KASPI_INTEGRATION_live.СоздатьДокРеализациюТоваров).
// Склад и Магазин НЕ берутся из заказа (у заказов встречаются разные/некорректные склады) -
// вместо этого используется ОбразецСкладМагазин, найденный один раз в любой проведённой реализации.
&НаСервере
Процедура СоздатьРеализациюПоЗаказуНаСервере(Заказ, НомерЗаказа, ДатаФормы, ОбразецСкладМагазин)

	НовыйДок = Документы.РеализацияТоваров.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(НовыйДок, Заказ,, "Номер, Дата, Ссылка, Склад, Магазин");

	Для Каждого СтрЗаказа Из Заказ.Товары Цикл
		НоваяСтрока = НовыйДок.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрЗаказа);
		НоваяСтрока.ЗаказПокупателя = Заказ;
		НоваяСтрока.НомерЗаказа     = Заказ.НомерЗаказаНаСайте;
	КонецЦикла;

	Если НовыйДок.Товары.Количество() = 0 Тогда
		ВызватьИсключение "В заказе покупателя """ + НомерЗаказа + """ нет строк товаров.";
	КонецЕсли;

	НовыйДок.Склад   = ОбразецСкладМагазин.Склад;
	НовыйДок.Магазин = ОбразецСкладМагазин.Магазин;
	НовыйДок.ЗаказПокупателя = Заказ;
	НовыйДок.Дата = ДатаФормы;

	НовыйДок.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);

КонецПроцедуры

#Область Возвраты

&НаКлиенте
Процедура ИсправитьВозвраты(Команда)
	ИсправитьВозвратыНаСервере();
КонецПроцедуры

// Полный аналог ИсправитьРеализацииНаСервере, но для Документ.ВозвратТоваровОтПокупателя:
// использует те же ТабДок (номера заказов) и Дата, ищет проведённые возвраты по Товары.НомерЗаказа.
//   1) уже есть в возврате требуемого периода - пропускает;
//   2) есть в возврате другого периода - переносит строки в новый возврат на Дата, удаляет из исходного;
//   3) нет ни в одном возврате - создаёт новый возврат на основании проведённой РеализацияТоваров
//      с этим НомерЗаказа (см. СоздатьВозвратПоРеализацииНаСервере). Если и реализации нет - ошибка,
//      возврат не создаётся (создавать возврат не от чего).
// Результат выводится в ТабДокРезультатВозвратов, итоги - через Сообщить.
&НаСервере
Процедура ИсправитьВозвратыНаСервере()

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Сообщить("Не заполнен реквизит ""Дата"".");
		Возврат;
	КонецЕсли;

	НомераЗаказов = СчитатьНомераЗаказовНаСервере();

	ТабДокРезультатВозвратов.Очистить();
	ТабДокРезультатВозвратов.Область(1, 1).Текст = "Номер заказа";
	ТабДокРезультатВозвратов.Область(1, 2).Текст = "Результат";
	ТабДокРезультатВозвратов.Область(1, 3).Текст = "Комментарий";

	Если НомераЗаказов.Количество() = 0 Тогда
		Сообщить("В ""Номера заказов"" не найдено ни одного номера заказа.");
		Возврат;
	КонецЕсли;

	НачалоПериода = НачалоМесяца(Дата);
	КонецПериода  = НачалоМесяца(ДобавитьМесяц(НачалоПериода, 1));

	СтрокаТабДок = 2;
	КоличествоУспешно  = 0;
	КоличествоПропущено = 0;
	КоличествоОшибок   = 0;

	Для Каждого НомерЗаказа Из НомераЗаказов Цикл

		Статус = "";
		Комментарий = "";

		ОбработатьНомерЗаказаВозвратНаСервере(НомерЗаказа, Дата, НачалоПериода, КонецПериода, Статус, Комментарий);

		ТабДокРезультатВозвратов.Область(СтрокаТабДок, 1).Текст = НомерЗаказа;
		ТабДокРезультатВозвратов.Область(СтрокаТабДок, 2).Текст = ПредставлениеРезультатаВозврата(Статус);
		ТабДокРезультатВозвратов.Область(СтрокаТабДок, 3).Текст = Комментарий;
		СтрокаТабДок = СтрокаТабДок + 1;

		Если Статус = "УжеВПериоде" Тогда
			КоличествоПропущено = КоличествоПропущено + 1;
		ИначеЕсли Статус = "Перенесен" Или Статус = "СозданПоРеализации" Тогда
			КоличествоУспешно = КоличествоУспешно + 1;
		Иначе
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;

	КонецЦикла;

	Сообщить(СтрШаблон(
		"Обработка возвратов завершена. Всего номеров: %1. Успешно обработано: %2. Пропущено (уже в периоде): %3. Ошибок: %4.",
		НомераЗаказов.Количество(), КоличествоУспешно, КоличествоПропущено, КоличествоОшибок));

КонецПроцедуры

&НаСервере
Функция ПредставлениеРезультатаВозврата(Статус)

	Если Статус = "УжеВПериоде" Тогда
		Возврат "Уже находится в требуемом периоде - пропущен";
	ИначеЕсли Статус = "Перенесен" Тогда
		Возврат "Перенесён из возврата другого периода";
	ИначеЕсли Статус = "СозданПоРеализации" Тогда
		Возврат "Создан возврат по реализации товаров";
	ИначеЕсли Статус = "РеализацияНеНайдена" Тогда
		Возврат "Реализация товаров не найдена - возврат не создан";
	ИначеЕсли Статус = "ОшибкаНовогоВозврата" Тогда
		Возврат "Ошибка создания или проведения нового возврата";
	ИначеЕсли Статус = "ОшибкаИсходногоВозврата" Тогда
		Возврат "Ошибка изменения или перепроведения исходного возврата";
	КонецЕсли;

	Возврат Статус;

КонецФункции

&НаСервере
Процедура ОбработатьНомерЗаказаВозвратНаСервере(НомерЗаказа, ДатаФормы, НачалоПериода, КонецПериода, Статус, Комментарий)

	Статус = "";
	Комментарий = "";

	ВозвратыСЗаказом = НайтиВозвратыПоНомеруЗаказаНаСервере(НомерЗаказа);

	Для Каждого СтрВозврат Из ВозвратыСЗаказом Цикл
		Если СтрВозврат.Дата >= НачалоПериода И СтрВозврат.Дата < КонецПериода Тогда
			Статус = "УжеВПериоде";
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Если ВозвратыСЗаказом.Количество() > 0 Тогда

		Попытка
			СоздатьВозвратИзСтарыхНаСервере(НомерЗаказа, ВозвратыСЗаказом, ДатаФормы);
		Исключение
			Статус = "ОшибкаНовогоВозврата";
			Комментарий = ОписаниеОшибки();
			Возврат;
		КонецПопытки;

		Попытка
			УдалитьСтрокиИзИсходныхВозвратовНаСервере(НомерЗаказа, ВозвратыСЗаказом);
			Статус = "Перенесен";
		Исключение
			Статус = "ОшибкаИсходногоВозврата";
			Комментарий = ОписаниеОшибки();
		КонецПопытки;

		Возврат;

	КонецЕсли;

	РеализацииНомера = НайтиРеализацииПоНомеруЗаказаНаСервере(НомерЗаказа);

	Если РеализацииНомера.Количество() = 0 Тогда
		Статус = "РеализацияНеНайдена";
		Возврат;
	КонецЕсли;

	Попытка
		СоздатьВозвратПоРеализацииНаСервере(РеализацииНомера[0].Ссылка, НомерЗаказа, ДатаФормы);
		Статус = "СозданПоРеализации";
	Исключение
		Статус = "ОшибкаНовогоВозврата";
		Комментарий = ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Проведённые возвраты, в табличной части Товары которых есть строки с этим НомерЗаказа.
&НаСервере
Функция НайтиВозвратыПоНомеруЗаказаНаСервере(НомерЗаказа)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерЗаказа", НомерЗаказа);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВозвратТоваровОтПокупателяТовары.Ссылка КАК Ссылка,
	               |	ВозвратТоваровОтПокупателяТовары.Ссылка.Дата КАК Дата
	               |ИЗ
	               |	Документ.ВозвратТоваровОтПокупателя.Товары КАК ВозвратТоваровОтПокупателяТовары
	               |ГДЕ
	               |	ВозвратТоваровОтПокупателяТовары.НомерЗаказа = &НомерЗаказа
	               |	И ВозвратТоваровОтПокупателяТовары.Ссылка.Проведен";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Сценарий 2 для возвратов, шаг 1: переносит строки текущего НомерЗаказа из всех ВозвратыСЗаказом
// (все здесь заведомо вне требуемого периода) в новый документ ВозвратТоваровОтПокупателя, датированный
// ДатаФормы. Шапка (включая ДокументОснование и АналитикаХозяйственнойОперации) копируется с первого
// найденного исходного возврата тем же приёмом, что и в СоздатьРеализациюИзСтарыхНаСервере.
&НаСервере
Процедура СоздатьВозвратИзСтарыхНаСервере(НомерЗаказа, ВозвратыСЗаказом, ДатаФормы)

	НовыйДок = Документы.ВозвратТоваровОтПокупателя.СоздатьДокумент();
	ИсходныйДляШапки = Неопределено;

	Для Каждого СтрВозврат Из ВозвратыСЗаказом Цикл

		СтарыйВозврат = СтрВозврат.Ссылка.ПолучитьОбъект();
		НайденныеСтроки = СтарыйВозврат.Товары.НайтиСтроки(Новый Структура("НомерЗаказа", НомерЗаказа));

		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если ИсходныйДляШапки = Неопределено Тогда
			ИсходныйДляШапки = СтарыйВозврат;
		КонецЕсли;

		Для Каждого СтрТовара Из НайденныеСтроки Цикл
			НоваяСтрока = НовыйДок.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрТовара);
		КонецЦикла;

	КонецЦикла;

	Если НовыйДок.Товары.Количество() = 0 Тогда
		ВызватьИсключение "Не найдены строки с НомерЗаказа = """ + НомерЗаказа + """ для переноса.";
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(НовыйДок, ИсходныйДляШапки,, "Номер, Дата, Ссылка");
	НовыйДок.Дата = ДатаФормы;

	НовыйДок.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);

КонецПроцедуры

// Сценарий 2 для возвратов, шаг 2: удаляет из каждого исходного возврата строки текущего НомерЗаказа
// и перепроводит документ (сам документ никогда не удаляется). Если после удаления строк товарная часть
// опустела - документ распроводится (Проведен = Ложь), а не остаётся пустым проведённым.
&НаСервере
Процедура УдалитьСтрокиИзИсходныхВозвратовНаСервере(НомерЗаказа, ВозвратыСЗаказом)

	Для Каждого СтрВозврат Из ВозвратыСЗаказом Цикл

		СтарыйВозврат = СтрВозврат.Ссылка.ПолучитьОбъект();
		НайденныеСтроки = СтарыйВозврат.Товары.НайтиСтроки(Новый Структура("НомерЗаказа", НомерЗаказа));

		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СтрТовара Из НайденныеСтроки Цикл
			СтарыйВозврат.Товары.Удалить(СтрТовара);
		КонецЦикла;

		Если СтарыйВозврат.Товары.Количество() = 0 Тогда
			СтарыйВозврат.Проведен = Ложь;
			СтарыйВозврат.Записать(РежимЗаписиДокумента.Запись);
		Иначе
			СтарыйВозврат.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Сценарий 3 для возвратов: номер заказа не найден ни в одном проведённом возврате - создаёт новый
// возврат на основании проведённой реализации с этим НомерЗаказа. Повторяет приём из
// CIVIL_KASPI_INTEGRATION_live.ВозвратЗаказа: ДокументОснование = Реализация, по каждой строке -
// ДокументПродажи = Реализация, обязательный АналитикаХозяйственнойОперации проставляется явно
// (в Документ.РеализацияТоваров такого реквизита нет, скопировать неоткуда).
&НаСервере
Процедура СоздатьВозвратПоРеализацииНаСервере(Реализация, НомерЗаказа, ДатаФормы)

	НайденныеСтроки = Реализация.Товары.НайтиСтроки(Новый Структура("НомерЗаказа", НомерЗаказа));

	Если НайденныеСтроки.Количество() = 0 Тогда
		ВызватьИсключение "В реализации " + Реализация.Номер + " нет строк с НомерЗаказа = """ + НомерЗаказа + """.";
	КонецЕсли;

	НовыйДок = Документы.ВозвратТоваровОтПокупателя.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(НовыйДок, Реализация,, "Номер, Дата, Ссылка");
	НовыйДок.АналитикаХозяйственнойОперации = Справочники.АналитикаХозяйственныхОпераций.ВозвратТоваровОтПокупателя;
	НовыйДок.ДокументОснование = Реализация;

	Для Каждого СтрТовара Из НайденныеСтроки Цикл
		НоваяСтрока = НовыйДок.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрТовара);
		НоваяСтрока.ДокументПродажи = Реализация;
	КонецЦикла;

	НовыйДок.Дата = ДатаФормы;

	НовыйДок.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);

КонецПроцедуры

#КонецОбласти

#Область СравнениеСумм

&НаКлиенте
Процедура СравнитьСуммы(Команда)
	СравнитьСуммыНаСервере();
КонецПроцедуры

// Сравнивает пары "номер заказа - сумма" из ТабДокСравнение с базой за месяц/год реквизита Дата.
// Одинаковые номера заказа могут повторяться (несколько строк/товаров одного заказа) - такие строки
// СУММИРУЮТСЯ по номеру заказа, отдельно сумма всех строк с суммой > 0 и отдельно сумма всех строк
// с суммой <= 0, ПЕРЕД сравнением с базой (не сравнивается построчно). Если по одному и тому же номеру
// заказа присланы и положительные, и неположительные суммы (продажа и возврат по одному заказу) - они
// сравниваются с базой НЕЗАВИСИМО друг от друга:
//   - сумма строк > 0  -> сравнивается с суммой строк Документ.РеализацияТоваров.Товары (Сумма) с этим
//                         НомерЗаказа по всем проведённым реализациям в периоде;
//   - сумма строк <= 0 -> сравнивается с (минус) суммой строк Документ.ВозвратТоваровОтПокупателя.Товары
//                         (Сумма) с этим НомерЗаказа по всем проведённым возвратам в периоде (в базе
//                         Товары.Сумма возврата хранится положительной, поэтому берётся со знаком минус).
// Если в базе по заказу ничего не найдено - сумма базы считается равной 0 (тоже расхождение, если
// введённая сумма не 0).
// Дополнительно: заказы, которые есть в проведённых реализациях/возвратах за этот период, но
// НЕ были присланы в ТабДокСравнение, тоже выводятся - как расхождение "не прислан" (введённая
// сумма считается отсутствующей, вся сумма базы - это разница). "Присланность" реализации и
// возврата отслеживается ОТДЕЛЬНО по каждой стороне одного и того же номера заказа (а не общим
// флагом "номер вообще встречался") - иначе заказ, присланный только как продажа, маскирует
// реально существующий в базе возврат по этому же номеру (и наоборот): такой возврат не попал бы
// ни в основное сравнение (сумма стороны, по которой не прислали ни одной строки, остаётся 0),
// ни в список "не прислано" (номер уже отмечен как встречавшийся - но с другой стороны). Именно
// это было причиной ложных "полное совпадение" при реальном расхождении.
// В ТабДокСравнениеРезультат попадают только строки, где разница после округления до 2 знаков
// не равна нулю.
&НаСервере
Процедура СравнитьСуммыНаСервере()

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Сообщить("Не заполнен реквизит ""Дата"".");
		Возврат;
	КонецЕсли;

	Пары = СчитатьПарыНомерСуммаНаСервере();

	ТабДокСравнениеРезультат.Очистить();
	ТабДокСравнениеРезультат.Область(1, 1).Текст = "Номер заказа";
	ТабДокСравнениеРезультат.Область(1, 2).Текст = "Источник";
	ТабДокСравнениеРезультат.Область(1, 3).Текст = "Введённая сумма";
	ТабДокСравнениеРезультат.Область(1, 4).Текст = "Сумма в базе";
	ТабДокСравнениеРезультат.Область(1, 5).Текст = "Разница";

	НачалоПериода = НачалоМесяца(Дата);
	КонецПериода  = НачалоМесяца(ДобавитьМесяц(НачалоПериода, 1));

	СтрокаТабДок = 2;
	КоличествоОшибок = 0;
	КоличествоНеПрисланных = 0;
	ВведённыеНомераРеализация = Новый Соответствие;
	ВведённыеНомераВозврат = Новый Соответствие;
	ГруппыПоНомеру = Новый Соответствие;
	ПорядокНомеров = Новый Массив;

	Для Каждого Пара Из Пары Цикл

		Если Не Пара.СуммаКорректна Тогда
			ТабДокСравнениеРезультат.Область(СтрокаТабДок, 1).Текст = Пара.НомерЗаказа;
			ТабДокСравнениеРезультат.Область(СтрокаТабДок, 2).Текст = "-";
			ТабДокСравнениеРезультат.Область(СтрокаТабДок, 3).Текст = Пара.ТекстСуммы;
			ТабДокСравнениеРезультат.Область(СтрокаТабДок, 4).Текст = "-";
			ТабДокСравнениеРезультат.Область(СтрокаТабДок, 5).Текст = "Не удалось прочитать сумму";
			СтрокаТабДок = СтрокаТабДок + 1;
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;

		Группа = ГруппыПоНомеру.Получить(Пара.НомерЗаказа);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("СуммаРеализации, СуммаВозврата, ЕстьРеализация, ЕстьВозврат", 0, 0, Ложь, Ложь);
			ГруппыПоНомеру.Вставить(Пара.НомерЗаказа, Группа);
			ПорядокНомеров.Добавить(Пара.НомерЗаказа);
		КонецЕсли;

		// Флаг "эта сторона присылалась" ставим по факту получения строки, а не по итоговой сумме -
		// сумма стороны может законно свернуться в 0 (например, две встречные строки), и это не
		// значит, что сторону не сравнивали. Именно на этом флаге (а не на общем "номер встречался")
		// строится последующая проверка "не прислано" - иначе заказ, присланный только как продажа,
		// маскирует реально существующий в базе возврат по этому же номеру (и наоборот).
		Если Пара.Сумма > 0 Тогда
			Группа.СуммаРеализации = Группа.СуммаРеализации + Пара.Сумма;
			Группа.ЕстьРеализация = Истина;
			ВведённыеНомераРеализация.Вставить(Пара.НомерЗаказа, Истина);
		Иначе
			Группа.СуммаВозврата = Группа.СуммаВозврата + Пара.Сумма;
			Группа.ЕстьВозврат = Истина;
			ВведённыеНомераВозврат.Вставить(Пара.НомерЗаказа, Истина);
		КонецЕсли;

	КонецЦикла;

	КоличествоСРазницей = 0;

	Для Каждого НомерЗаказа Из ПорядокНомеров Цикл

		Группа = ГруппыПоНомеру.Получить(НомерЗаказа);

		Если Группа.ЕстьРеализация Тогда
			СуммаБазы = СуммаРеализацийПоЗаказуНаСервере(НомерЗаказа, НачалоПериода, КонецПериода);
			Разница = Окр(Группа.СуммаРеализации - СуммаБазы, 2);
			Если Разница <> 0 Тогда
				ТабДокСравнениеРезультат.Область(СтрокаТабДок, 1).Текст = НомерЗаказа;
				ТабДокСравнениеРезультат.Область(СтрокаТабДок, 2).Текст = "Реализация товаров";
				ТабДокСравнениеРезультат.Область(СтрокаТабДок, 3).Текст = Формат(Группа.СуммаРеализации, "ЧДЦ=2; ЧГ=0");
				ТабДокСравнениеРезультат.Область(СтрокаТабДок, 4).Текст = Формат(СуммаБазы, "ЧДЦ=2; ЧГ=0");
				ТабДокСравнениеРезультат.Область(СтрокаТабДок, 5).Текст = Формат(Разница, "ЧДЦ=2; ЧГ=0");
				СтрокаТабДок = СтрокаТабДок + 1;
				КоличествоСРазницей = КоличествоСРазницей + 1;
			КонецЕсли;
		КонецЕсли;

		Если Группа.ЕстьВозврат Тогда
			СуммаБазы = -СуммаВозвратовПоЗаказуНаСервере(НомерЗаказа, НачалоПериода, КонецПериода);
			Разница = Окр(Группа.СуммаВозврата - СуммаБазы, 2);
			Если Разница <> 0 Тогда
				ТабДокСравнениеРезультат.Область(СтрокаТабДок, 1).Текст = НомерЗаказа;
				ТабДокСравнениеРезультат.Область(СтрокаТабДок, 2).Текст = "Возврат товаров от покупателя";
				ТабДокСравнениеРезультат.Область(СтрокаТабДок, 3).Текст = Формат(Группа.СуммаВозврата, "ЧДЦ=2; ЧГ=0");
				ТабДокСравнениеРезультат.Область(СтрокаТабДок, 4).Текст = Формат(СуммаБазы, "ЧДЦ=2; ЧГ=0");
				ТабДокСравнениеРезультат.Область(СтрокаТабДок, 5).Текст = Формат(Разница, "ЧДЦ=2; ЧГ=0");
				СтрокаТабДок = СтрокаТабДок + 1;
				КоличествоСРазницей = КоличествоСРазницей + 1;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Для Каждого Стр Из СуммыРеализацийЗаПериодНаСервере(НачалоПериода, КонецПериода) Цикл

		Если ВведённыеНомераРеализация.Получить(Стр.НомерЗаказа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ТабДокСравнениеРезультат.Область(СтрокаТабДок, 1).Текст = Стр.НомерЗаказа;
		ТабДокСравнениеРезультат.Область(СтрокаТабДок, 2).Текст = "Реализация товаров";
		ТабДокСравнениеРезультат.Область(СтрокаТабДок, 3).Текст = "не прислан";
		ТабДокСравнениеРезультат.Область(СтрокаТабДок, 4).Текст = Формат(Стр.СуммаБазы, "ЧДЦ=2; ЧГ=0");
		ТабДокСравнениеРезультат.Область(СтрокаТабДок, 5).Текст = Формат(-Стр.СуммаБазы, "ЧДЦ=2; ЧГ=0");
		СтрокаТабДок = СтрокаТабДок + 1;
		КоличествоНеПрисланных = КоличествоНеПрисланных + 1;

	КонецЦикла;

	Для Каждого Стр Из СуммыВозвратовЗаПериодНаСервере(НачалоПериода, КонецПериода) Цикл

		Если ВведённыеНомераВозврат.Получить(Стр.НомерЗаказа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СуммаБазыСоЗнаком = -Стр.СуммаБазы;
		ТабДокСравнениеРезультат.Область(СтрокаТабДок, 1).Текст = Стр.НомерЗаказа;
		ТабДокСравнениеРезультат.Область(СтрокаТабДок, 2).Текст = "Возврат товаров от покупателя";
		ТабДокСравнениеРезультат.Область(СтрокаТабДок, 3).Текст = "не прислан";
		ТабДокСравнениеРезультат.Область(СтрокаТабДок, 4).Текст = Формат(СуммаБазыСоЗнаком, "ЧДЦ=2; ЧГ=0");
		ТабДокСравнениеРезультат.Область(СтрокаТабДок, 5).Текст = Формат(-СуммаБазыСоЗнаком, "ЧДЦ=2; ЧГ=0");
		СтрокаТабДок = СтрокаТабДок + 1;
		КоличествоНеПрисланных = КоличествоНеПрисланных + 1;

	КонецЦикла;

	Сообщить(СтрШаблон(
		"Сравнение завершено. Всего строк прислано: %1 (уникальных номеров заказа: %2). С расхождением: %3. "
		+ "Ошибок чтения суммы: %4. Найдено в базе, но не прислано: %5.",
		Пары.Количество(), ПорядокНомеров.Количество(), КоличествоСРазницей, КоличествоОшибок, КоличествоНеПрисланных));

КонецПроцедуры

// Считывает пары (номер заказа, сумма) из первых двух столбцов ТабДокСравнение начиная с первой строки
// (без заголовка). Строка пропускается, если оба значения пустые или пустой номер заказа. Сумма
// парсится через Число() с заменой запятой на точку и удалением пробелов/неразрывных пробелов
// (частый артефакт копирования из Excel); если распознать не удалось - СуммаКорректна = Ложь.
&НаСервере
Функция СчитатьПарыНомерСуммаНаСервере()

	Пары = Новый Массив;

	Для НомерСтроки = 1 По ТабДокСравнение.ВысотаТаблицы Цикл

		НомерЗаказа = СокрЛП(ТабДокСравнение.Область(НомерСтроки, 1).Текст);
		ТекстСуммы  = СокрЛП(ТабДокСравнение.Область(НомерСтроки, 2).Текст);

		Если ПустаяСтрока(НомерЗаказа) Тогда
			Продолжить;
		КонецЕсли;

		Пара = Новый Структура("НомерЗаказа, ТекстСуммы, Сумма, СуммаКорректна");
		Пара.НомерЗаказа = НомерЗаказа;
		Пара.ТекстСуммы = ТекстСуммы;

		ТекстДляЧисла = СтрЗаменить(ТекстСуммы, " ", "");
		ТекстДляЧисла = СтрЗаменить(ТекстДляЧисла, Символ(160), "");
		ТекстДляЧисла = СтрЗаменить(ТекстДляЧисла, ",", ".");

		Попытка
			Пара.Сумма = Число(ТекстДляЧисла);
			Пара.СуммаКорректна = Истина;
		Исключение
			Пара.Сумма = 0;
			Пара.СуммаКорректна = Ложь;
		КонецПопытки;

		Пары.Добавить(Пара);

	КонецЦикла;

	Возврат Пары;

КонецФункции

// Сумма строк Товары.Сумма по проведённым реализациям в периоде [НачалоПериода, КонецПериода)
// с указанным НомерЗаказа. 0, если ничего не найдено.
&НаСервере
Функция СуммаРеализацийПоЗаказуНаСервере(НомерЗаказа, НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерЗаказа", НомерЗаказа);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(СУММА(РеализацияТоваровТовары.Сумма), 0) КАК СуммаБазы
	               |ИЗ
	               |	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
	               |ГДЕ
	               |	РеализацияТоваровТовары.НомерЗаказа = &НомерЗаказа
	               |	И РеализацияТоваровТовары.Ссылка.Проведен
	               |	И РеализацияТоваровТовары.Ссылка.Дата >= &НачалоПериода
	               |	И РеализацияТоваровТовары.Ссылка.Дата < &КонецПериода";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаБазы;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Сумма строк Товары.Сумма по проведённым возвратам в периоде [НачалоПериода, КонецПериода)
// с указанным НомерЗаказа (положительное число). 0, если ничего не найдено.
&НаСервере
Функция СуммаВозвратовПоЗаказуНаСервере(НомерЗаказа, НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерЗаказа", НомерЗаказа);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(СУММА(ВозвратТоваровОтПокупателяТовары.Сумма), 0) КАК СуммаБазы
	               |ИЗ
	               |	Документ.ВозвратТоваровОтПокупателя.Товары КАК ВозвратТоваровОтПокупателяТовары
	               |ГДЕ
	               |	ВозвратТоваровОтПокупателяТовары.НомерЗаказа = &НомерЗаказа
	               |	И ВозвратТоваровОтПокупателяТовары.Ссылка.Проведен
	               |	И ВозвратТоваровОтПокупателяТовары.Ссылка.Дата >= &НачалоПериода
	               |	И ВозвратТоваровОтПокупателяТовары.Ссылка.Дата < &КонецПериода";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаБазы;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Все НомерЗаказа (кроме пустого) с суммой строк Товары.Сумма, встречающиеся в проведённых реализациях
// за период [НачалоПериода, КонецПериода) - используется, чтобы найти заказы, которые есть в базе,
// но не были присланы в ТабДокСравнение.
&НаСервере
Функция СуммыРеализацийЗаПериодНаСервере(НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваровТовары.НомерЗаказа КАК НомерЗаказа,
	               |	СУММА(РеализацияТоваровТовары.Сумма) КАК СуммаБазы
	               |ИЗ
	               |	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
	               |ГДЕ
	               |	РеализацияТоваровТовары.Ссылка.Проведен
	               |	И РеализацияТоваровТовары.Ссылка.Дата >= &НачалоПериода
	               |	И РеализацияТоваровТовары.Ссылка.Дата < &КонецПериода
	               |	И РеализацияТоваровТовары.НомерЗаказа <> """"
	               |СГРУППИРОВАТЬ ПО
	               |	РеализацияТоваровТовары.НомерЗаказа";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Все НомерЗаказа (кроме пустого) с суммой строк Товары.Сумма (хранится положительной), встречающиеся
// в проведённых возвратах за период [НачалоПериода, КонецПериода).
&НаСервере
Функция СуммыВозвратовЗаПериодНаСервере(НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВозвратТоваровОтПокупателяТовары.НомерЗаказа КАК НомерЗаказа,
	               |	СУММА(ВозвратТоваровОтПокупателяТовары.Сумма) КАК СуммаБазы
	               |ИЗ
	               |	Документ.ВозвратТоваровОтПокупателя.Товары КАК ВозвратТоваровОтПокупателяТовары
	               |ГДЕ
	               |	ВозвратТоваровОтПокупателяТовары.Ссылка.Проведен
	               |	И ВозвратТоваровОтПокупателяТовары.Ссылка.Дата >= &НачалоПериода
	               |	И ВозвратТоваровОтПокупателяТовары.Ссылка.Дата < &КонецПериода
	               |	И ВозвратТоваровОтПокупателяТовары.НомерЗаказа <> """"
	               |СГРУППИРОВАТЬ ПО
	               |	ВозвратТоваровОтПокупателяТовары.НомерЗаказа";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти
